        function Chat.pollAnnounce()
            local body = rawGet(ANN_URL .. "?t=" .. tostring(os.time()))
            if not body then return end
            local ok, a = pcall(HttpSvcC.JSONDecode, HttpSvcC, body)
            if not (ok and type(a) == "table") then return end
            if type(a.muted) == "table" then
                for _, id in ipairs(a.muted) do if type(id) == "number" then Chat.blocked[id] = true end end
            end
            if type(a.id) ~= "number" or type(a.message) ~= "string" or a.message == "" then return end
            local seen = 0
            pcall(function() if isfile and isfile("NoVR_AnnSeen.txt") then seen = tonumber(readfile("NoVR_AnnSeen.txt")) or 0 end end)
            if a.id <= seen then return end
            pcall(function() if writefile then writefile("NoVR_AnnSeen.txt", tostring(a.id)) end end)
            if seen == 0 and type(a.time) == "number" and os.time() - a.time > 172800 then return end   -- first run: skip old news
            hudApi.announce(a)
        end
        -- owner only: writes announce.json to your GitHub repo with YOUR token (kept in NoVR_Owner.json on this computer)
        function Chat.publish(title, message, secs)
            message = cleanText(message, 400)
            if message == "" then return false, "Type a message first." end
            if not (readfile and isfile and isfile("NoVR_Owner.json")) then return false, "Save your GitHub token first." end
            local okd, cfg = pcall(function() return HttpSvcC:JSONDecode(readfile("NoVR_Owner.json")) end)
            if not (okd and type(cfg) == "table" and type(cfg.token) == "string" and #cfg.token > 10) then return false, "The token file is empty." end
            local owner, repo, branch = string.match(STATUS_URL, "githubusercontent%.com/([^/]+)/([^/]+)/refs/heads/([^/]+)/")
            if not owner then owner, repo, branch = string.match(STATUS_URL, "githubusercontent%.com/([^/]+)/([^/]+)/([^/]+)/") end
            if not owner then return false, "Can't find your repo in STATUS_URL." end
            local api = "https://api.github.com/repos/" .. owner .. "/" .. repo .. "/contents/announce.json"
            local H = { Authorization = "Bearer " .. cfg.token, Accept = "application/vnd.github+json", ["User-Agent"] = "NoVR-Hands" }
            local g = anyReq({ Url = api .. "?ref=" .. branch, Method = "GET", Headers = H })
            if not g then return false, "Could not reach GitHub." end
            local sha, old = nil, {}
            if g.StatusCode == 200 then
                local okj, j = pcall(HttpSvcC.JSONDecode, HttpSvcC, g.Body)
                if okj and type(j) == "table" then
                    sha = j.sha
                    if type(j.content) == "string" then
                        local ok2, o = pcall(HttpSvcC.JSONDecode, HttpSvcC, b64dec(j.content))
                        if ok2 and type(o) == "table" then old = o end
                    end
                end
            elseif g.StatusCode == 401 or g.StatusCode == 403 then
                return false, "GitHub refused the token."
            elseif g.StatusCode ~= 404 then
                return false, "GitHub answered " .. tostring(g.StatusCode) .. "."
            end
            local new = { id = (tonumber(old.id) or 0) + 1, title = cleanText(title, 50), message = message,
                          secs = math.clamp(tonumber(secs) or 20, 5, 90), time = os.time(), from = lp.DisplayName,
                          muted = type(old.muted) == "table" and old.muted or {} }
            local body = { message = "announcement #" .. new.id, content = b64enc(HttpSvcC:JSONEncode(new)), branch = branch, sha = sha }
            H["Content-Type"] = "application/json"
            local r = anyReq({ Url = api, Method = "PUT", Headers = H, Body = HttpSvcC:JSONEncode(body) })
            if r and (r.StatusCode == 200 or r.StatusCode == 201) then return true, "Published! Everyone running the script gets it within a minute." end
            if r and (r.StatusCode == 401 or r.StatusCode == 403 or r.StatusCode == 404) then return false, "GitHub refused it. The token needs Contents: write on the repo." end
            return false, "Could not publish (" .. tostring(r and r.StatusCode or "no answer") .. ")."
        end
        function Chat.saveToken(tok)
            tok = string.match(tostring(tok or ""), "^%s*(.-)%s*$") or ""
            if #tok < 20 or #tok > 200 then return false, "That doesn't look like a GitHub token." end
            if not writefile then return false, "This executor can't save files." end
            local ok = pcall(writefile, "NoVR_Owner.json", HttpSvcC:JSONEncode({ token = tok }))
            return ok, ok and "Token saved on this computer." or "Could not save the token."
        end
        function Chat.hasToken()
            local ok, v = pcall(function() return isfile and isfile("NoVR_Owner.json") end)
            return ok and v == true
        end
        function Chat.start()
            if Chat.started then return end
            Chat.started = true
            task.spawn(function()   -- heartbeat: tell the list you are here now and every 8 minutes, so nobody has to ask (only if "Show me" is on)
                task.wait(6)
                while true do
                    if S.live.vis then pcall(function() postTopic(Chat.presence()) end) end
                    task.wait(480)
                end
            end)
            -- ----- owner badge on Roblox's own name labels (leaderboard, player menu, VR name tag), event driven so opening the leaderboard stays fast -----
            -- crash guard: touching Roblox's own (CoreGui) menus can crash the client on some executors. If the last run didn't survive 60 seconds,
            -- the CoreGui part stays off until you switch it back on in the Requirements window.
            local function fexists(n) local ok, v = pcall(function() return isfile and isfile(n) end) return ok and v == true end
