            local function makeHolder(z)
                local h = Instance.new("Frame")
                h.AnchorPoint = Vector2.new(0.5, 0.5)
                h.Position = UDim2.fromOffset(cx0, cy0)
                h.Size = UDim2.fromOffset(W, H)
                h.BackgroundTransparency = 1
                h.ZIndex = z
                h.Parent = mHold
                return h
            end
            -- four bars: left, right, and the two diagonals that meet in the middle
            local function makePieces(parent, col)
                local list = {}
                local function piece(x, y, w, h, rot)
                    local f = Instance.new("Frame")
                    f.AnchorPoint = Vector2.new(0.5, 0.5)
                    f.Position = UDim2.fromOffset(x, y)
                    f.Size = UDim2.fromOffset(w, h)
                    f.Rotation = rot
                    f.BackgroundColor3 = col
                    f.BorderSizePixel = 0
                    f.Parent = parent
                    corner(f, 8)
                    list[#list + 1] = f
                end
                piece(T / 2, H / 2, T, H, 0)
                piece(W - T / 2, H / 2, T, H, 0)
                local sx, sy = T / 2 + 3, T * 0.55
                local ex, ey = W / 2, H * 0.68
                local dx, dy = ex - sx, ey - sy
                local len = math.sqrt(dx * dx + dy * dy) + T * 0.5
                local ang = math.deg(math.atan2(dy, dx))
                piece((sx + ex) / 2, (sy + ey) / 2, len, T, ang)
                piece(W - (sx + ex) / 2, (sy + ey) / 2, len, T, -ang)
                return list
            end

