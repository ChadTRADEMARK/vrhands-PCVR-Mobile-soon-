        -- Polls UPDATE_URL. A change = a different SCRIPT_VERSION, or (if the version was not bumped)
        -- any change to the file since the first check. Then: countdown toast -> performUpdate().
        _G.NoVR_Gen = (_G.NoVR_Gen or 0) + 1
        local myGen = _G.NoVR_Gen
