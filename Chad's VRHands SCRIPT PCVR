        function S.suckProf(roam)
            if roam then
                if S.perfLow() then return { models = 60, parts = 500, frags = 50, water = 60, chunks = 16, emit = 24, hl = 0, boomN = 14, bigs = 20 } end
                return { models = 160, parts = 1500, frags = 150, water = 140, chunks = 40, emit = 80, hl = 24, boomN = 40, bigs = 45 }
            end
            if S.perfLow() then
                return { models = 35, parts = 300, frags = 30, water = 60, chunks = 12, emit = 24, hl = 0, boomN = 14, bigs = 12 }
            end
            return { models = 110, parts = 900, frags = 100, water = 140, chunks = 26, emit = 80, hl = 24, boomN = 40, bigs = 30 }
        end
        function S.sfxLP(st, k, x, a) local v = (st[k] or 0) + a * (x - (st[k] or 0)) st[k] = v return v end
        function S.sfxSoft(x) return x / (1 + math.abs(x)) end
        S.SFX = {
            { "rumble", "NoVR_sfx_rumble2.wav", 4.0, function(t, i, n, st, sr)   -- a deep rolling rumble with far-off rock crackle (loops)
                local x = st.r:NextNumber() * 2 - 1
                local a = S.sfxLP(st, "a", x, 0.012)
                a = S.sfxLP(st, "a2", a, 0.05)
                local m = 0.7 + 0.3 * math.sin(2 * math.pi * 0.5 * t)
                local v = a * 14 * m + 0.3 * math.sin(2 * math.pi * 34 * t) * m + 0.18 * math.sin(2 * math.pi * 47 * t + 1.3) * (1.2 - m)
                if st.r:NextNumber() < 0.0006 then st.k = 0.6 end
                st.k = (st.k or 0) * 0.97
                v = v + (x - S.sfxLP(st, "h", x, 0.4)) * st.k * 0.5
                local w = math.min(1, t / 0.05, (n / sr - t) / 0.05)
                return S.sfxSoft(v * 1.1) * w * 0.7
            end, 22050 },
            { "rip", "NoVR_sfx_rip2.wav", 1.8, function(t, i, n, st, sr)   -- ground tearing loose: a sharp crack, stick-slip grinding, a heavy thump, snaps and falling gravel
                if not st.ev then
                    st.ev = {}
                    for k = 1, 10 do st.ev[k] = { t = 0.02 + st.r:NextNumber() * 0.9, f = 250 + st.r:NextNumber() * 1700, d = 0.02 + st.r:NextNumber() * 0.05, a = 0.3 + st.r:NextNumber() * 0.6 } end
                    st.ph, st.sl = 0, 0
                end
                local x = st.r:NextNumber() * 2 - 1
                local hp = x - S.sfxLP(st, "l1", x, 0.35)
                local crack = hp * math.exp(-t / 0.018) * 1.1
                st.sl = st.sl + (2 * math.pi * (14 + 22 * math.min(t, 1))) / sr
                local slip = 0.55 + 0.45 * math.sin(st.sl + 3 * math.sin(t * 9))
                local band = S.sfxLP(st, "b1", x, 0.16) - S.sfxLP(st, "b2", x, 0.025)
                local grind = band * 5 * slip * math.min(t / 0.04, 1) * math.exp(-math.max(t - 0.1, 0) / 0.55)
                st.ph = st.ph + 2 * math.pi * (30 + 70 * math.exp(-t * 7)) / sr
                local thump = math.sin(st.ph) * math.min(t / 0.01, 1) * math.exp(-t / 0.3) * 0.9
                local pings = 0
                for _, e in ipairs(st.ev) do
                    local dt = t - e.t
                    if dt > 0 and dt < e.d * 8 then pings = pings + e.a * math.sin(2 * math.pi * e.f * dt) * math.exp(-dt / e.d) * 0.5 end
                end
                if t > 0.4 and st.r:NextNumber() < 0.004 * math.exp(-(t - 0.4) / 0.6) then st.k = 0.7 end
                st.k = (st.k or 0) * 0.93
                local clat = hp * st.k * 0.6
                return S.sfxSoft((crack * 0.9 + grind + thump + pings + clat) * 0.9) * math.min(1, (n / sr - t) / 0.05) * 0.8
            end, 32000 },
            { "debris", "NoVR_sfx_debris2.wav", 1.4, function(t, i, n, st, sr)   -- rocks and wood breaking and tumbling: dozens of tiny knocks and splinters
                if not st.ev then
                    st.ev = {}
                    for k = 1, 45 do
                        local tt = st.r:NextNumber() ^ 1.4 * 1.2
                        st.ev[k] = { t = tt, f = 500 + st.r:NextNumber() * 3000, d = 0.006 + st.r:NextNumber() * 0.03, a = (1 - tt / 1.5) * (0.3 + st.r:NextNumber() * 0.7) }
                    end
                end
                local x = st.r:NextNumber() * 2 - 1
                local v = 0
                for _, e in ipairs(st.ev) do
                    local dt = t - e.t
                    if dt > 0 and dt < e.d * 8 then v = v + e.a * (math.sin(2 * math.pi * e.f * dt) * 0.6 + x * 0.4) * math.exp(-dt / e.d) end
                end
                return S.sfxSoft(v * 0.9) * math.min(1, (n / sr - t) / 0.05) * 0.8
            end, 32000 },
            { "boom", "NoVR_sfx_boom2.wav", 4.5, function(t, i, n, st, sr)   -- an explosion: a hard crack, a huge low thud that drops in pitch, a long rolling tail
                st.ph = st.ph or 0
                local x = st.r:NextNumber() * 2 - 1
                local crack = (x - S.sfxLP(st, "c", x, 0.3)) * math.exp(-t / 0.02) * 1.3
                local cut = 0.4 * math.exp(-t / 0.45) + 0.008
                local b = S.sfxLP(st, "b", x, cut)
                b = S.sfxLP(st, "b2", b, cut * 1.5)
                local body = b * 4 * math.min(t / 0.004, 1) * math.exp(-t / 0.8)
                st.ph = st.ph + 2 * math.pi * (22 + 55 * math.exp(-t * 2.6)) / sr
                local sub = math.sin(st.ph) * math.min(t / 0.01, 1) * math.exp(-t / 1.25) * 0.9
                local roll = S.sfxLP(st, "rl", x, 0.02) * 10 * math.exp(-t / 2.0) * (0.75 + 0.25 * math.sin(2 * math.pi * 6 * t)) * math.min(t / 0.2, 1)
                return S.sfxSoft((crack + body + sub + roll) * 1.6) * math.min(1, (n / sr - t) / 0.3) * 0.85
            end, 32000 },
            { "whoosh", "NoVR_sfx_whoosh2.wav", 2.4, function(t, i, n, st, sr)   -- something huge passing by, or water torn away
                local x = st.r:NextNumber() * 2 - 1
                local s = t / (n / sr)
                local a1 = 0.03 + 0.25 * math.sin(math.pi * s)
                local band = S.sfxLP(st, "w1", x, a1) - S.sfxLP(st, "w2", x, a1 * 0.25)
                return math.clamp(band * 2, -0.9, 0.9) * math.sin(math.pi * s) ^ 1.5
            end, 22050 },
            { "groan", "NoVR_sfx_groan2.wav", 2.0, function(t, i, n, st, sr)   -- stone, wood and metal under strain right before they break
                local s = t / (n / sr)
                st.ph = (st.ph or 0) + 2 * math.pi * (95 + 45 * s + 4 * math.sin(t * 11)) / sr
                local env = math.sin(math.pi * s) ^ 1.2
                local mod = 0.6 + 0.4 * math.sin(2 * math.pi * (9 + 5 * s) * t)
                local v = 0
                for k = 1, 6 do v = v + math.sin(st.ph * k + k) / k end
                local x = st.r:NextNumber() * 2 - 1
                return S.sfxSoft(v * 0.6 * mod * env + S.sfxLP(st, "g", x, 0.08) * 1.5 * env * mod) * 0.6
            end, 22050 },
        }
        function S.sfxPreload()   -- the pictures and sounds for the dome scene are made once, a few seconds after the script starts, and kept as files
            if S.sfxBusy or S.sfxAssets then return end
            S.sfxBusy = true
            task.spawn(function()
                task.wait(5)
                local made = {}
                local gca = getcustomasset or getsynasset
                if writefile and gca and S.bhB64 and S.AUD then
                    for k, parts in pairs(S.AUD) do
                        local fn = "NoVR_a2_" .. k .. ".mp3"
                        pcall(function()
                            if not (isfile and isfile(fn)) then writefile(fn, S.bhB64(table.concat(parts))) end
                            local ok, a = pcall(gca, fn)
                            if ok and a then made[k] = a end
                        end)
                        task.wait()
                    end
                    local ql = {}   -- the four earthquake pieces, used for rock and ground breaking
                    for i = 1, 4 do if made["qk" .. i] then ql[#ql + 1] = made["qk" .. i] end end
                    if #ql > 0 then made.qkList = ql end
                end
                for _, s in ipairs(S.SFX) do
                    local ok, a = pcall(S.sfxMake, s[2], s[3], s[4], s[5])
                    if ok and a then made[s[1]] = a end
                end
                S.sfxAssets = made
                S.sfxBusy = false
            end)
        end
        S.sfxPreload()
        S.SFX_FALL = { boomL = "boom", boomS = "boom" }
        function S.sfxPlayId(id, parent, vol, speed, maxD, glob, fxName)
            pcall(function()
                local so = Instance.new("Sound")
                so.SoundId = id
                so.Volume = vol
                so.PlaybackSpeed = speed or 1
                if not glob then
                    so.RollOffMode = Enum.RollOffMode.InverseTapered
                    so.RollOffMinDistance = 400
                    so.RollOffMaxDistance = maxD or 6000
                end
                if not S.perfLow() then
                    if fxName == "boomL" or fxName == "boomS" or fxName == "boom" then   -- a big open space and a lot of bass
                        local eq = Instance.new("EqualizerSoundEffect")
                        eq.LowGain, eq.MidGain, eq.HighGain = 5, 0, -5
                        eq.Parent = so
                        local rv = Instance.new("ReverbSoundEffect")
                        rv.DecayTime, rv.Density, rv.Diffusion, rv.DryLevel, rv.WetLevel = 3.5, 0.9, 0.9, 0, -6
                        rv.Parent = so
                    elseif fxName == "rip" or fxName == "groan" or fxName == "qk" then
                        local rv = Instance.new("ReverbSoundEffect")
                        rv.DecayTime, rv.Density, rv.Diffusion, rv.DryLevel, rv.WetLevel = 2.4, 0.8, 0.8, -1, -9
                        rv.Parent = so
                    end
                end
                so.Parent = parent
                so:Play()
                game:GetService("Debris"):AddItem(so, 14)
            end)
        end
        function S.sfxPlay(name, parent, vol, speed, maxD, glob)
            if S.pop.nosnd then return end
            local A = S.sfxAssets
            if not A then return end
            local id = A[name]
            if not id and S.SFX_FALL[name] then
                name = S.SFX_FALL[name]
                id = A[name]
                vol = vol * 1.6
            end
            if not id then return end
            S.sfxPlayId(id, parent, vol, speed, maxD, glob, name)
        end
        function S.suckSnd(name, parent, vol, speed, maxD)   -- a 3D sound that plays once at a part
            S.sfxPlay(name, parent, vol, speed, maxD, false)
            local L = ({ rip = 0.9, debris = 0.4, groan = 0.9 })[name]
            local ql = S.sfxAssets and S.sfxAssets.qkList
            if L and ql and not S.pop.nosnd then   -- the real earthquake recording under it: rock and ground breaking
                local r = Random.new()
                local sp = name == "groan" and (0.5 + r:NextNumber() * 0.2) or (0.8 + r:NextNumber() * 0.5)
                S.sfxPlayId(ql[r:NextInteger(1, #ql)], parent, vol * L, sp, maxD, false, "qk")
            end
        end
        function S.sfxGlobal(name, vol, speed)   -- the same, heard everywhere (the big explosion)
            S.sfxPlay(name, game:GetService("SoundService"), vol, speed, nil, true)
        end
        function S.suckRumble(c, vol)   -- the ground rumble that grows while more and more of the world is torn away
            local id = S.sfxAssets and (S.sfxAssets.quakeLoop or S.sfxAssets.rumble)
            if S.pop.nosnd or not id then return end
            if not (c.rumble and c.rumble.Parent) then
                if vol <= 0 then return end
                local so = Instance.new("Sound")
                so.Name = "NoVR_SuckRumble"
                so.SoundId = id
                so.Looped = true
                so.Volume = 0
                so.Parent = game:GetService("SoundService")
                so:Play()
                c.rumble = so
            end
            c.rumble.Volume = vol
            if vol <= 0 then
                pcall(function() c.rumble:Destroy() end)
                c.rumble = nil
            end
        end

        -- ===== THE WORLD GETS PULLED IN: real trees, ships, rocks, chunks of ground and the water of the map spiral into the black hole =====
        function S.suckScan(c, center)   -- (runs beside the scene) picks the real things to pull in; nothing in the game is changed, only copies move
            local Players = game:GetService("Players")
            local rnd = Random.new(math.floor(os.clock() * 1000))
            local prof = S.suckProf(c.roam)
            c.prof = prof
            local RADIUS = c.roam and 6000 or 2600   -- free roam: the whole map
            local excl = { cam }
            if S.domeFolder then excl[#excl + 1] = S.domeFolder end
            if S.roamF then excl[#excl + 1] = S.roamF end
            for _, pl in ipairs(Players:GetPlayers()) do if pl.Character then excl[#excl + 1] = pl.Character end end
            -- 1) real objects: the smallest model that is a whole object (a tree, a ship, a table), or a single part
            local stat, cand, listed = {}, {}, {}
            local function modelOk(a)
                local s = stat[a]
                if s == nil then
                    local cnt, ok = 0, true
                    for _, d in ipairs(a:GetDescendants()) do
                        if d:IsA("BasePart") then cnt = cnt + 1 elseif d:IsA("Humanoid") then ok = false break end
                        if cnt > 45 then ok = false break end
                    end
                    if ok then
                        local okE, sz = pcall(function() return a:GetExtentsSize() end)
                        if not okE or math.max(sz.X, sz.Y, sz.Z) > 160 then ok = false end
                    end
                    s = ok and cnt or false
                    stat[a] = s
                end
                return s
            end
            local function underPlayer(p)   -- the island you stand on stays
                local lp = p.CFrame:PointToObjectSpace(center)
                local h = p.Size / 2
                return math.abs(lp.X) <= h.X + 15 and math.abs(lp.Z) <= h.Z + 15 and math.abs(lp.Y) <= h.Y + 60
            end
            local n = 0
            local tw, twDim, twY
            local allp, bigs = {}, {}
            for _, d in ipairs(workspace:GetDescendants()) do
                n = n + 1
                if n % 2500 == 0 then task.wait() if c.suckDead then return end end
                if not tw and (d:IsA("Model") or d:IsA("BasePart")) and not d:IsA("Terrain") and string.find(string.lower(d.Name), "tower", 1, true) and string.sub(d.Name, 1, 4) ~= "NoVR" then   -- the tower on the middle island gets its own fall
                    local okE, pv = pcall(function() return d:IsA("Model") and d:GetPivot().Position or d.Position end)
                    local okS, sz = pcall(function() return d:IsA("Model") and d:GetExtentsSize() or d.Size end)
                    if okE and okS then
                        local dd = (pv - center).Magnitude
                        local dm = math.max(sz.X, sz.Y, sz.Z)
                        if dd < RADIUS and dd > 25 and dm >= 20 and dm <= 500 then
                            local skip = false
                            for _, e in ipairs(excl) do if d:IsDescendantOf(e) then skip = true break end end
                            if not skip then tw, twDim, twY = d, dm, sz.Y end
                        end
                    end
                end
                if d:IsA("BasePart") and not d:IsA("Terrain") and d.Transparency < 0.9 and d ~= tw and not (tw and d:IsDescendantOf(tw)) then
                    local sz = d.Size
                    local big = math.max(sz.X, sz.Y, sz.Z)
                    local dist = (d.Position - center).Magnitude
                    if big >= 1.5 and dist < RADIUS and (c.roam or dist > 25) and string.sub(d.Name, 1, 4) ~= "NoVR" then
                        local skip = false
                        for _, e in ipairs(excl) do if d:IsDescendantOf(e) then skip = true break end end
                        if not skip then
                            if big > 160 then
                                bigs[#bigs + 1] = d   -- the islands themselves
                            else
                                local top = d
                                local a = d.Parent
                                while a and a ~= workspace do
                                    if string.sub(a.Name, 1, 4) == "NoVR" then skip = true break end
                                    if a:IsA("Model") then
                                        if modelOk(a) then top = a else break end
                                    end
                                    a = a.Parent
                                end
                                if not skip then
                                    allp[#allp + 1] = { d, top }
                                    if not listed[top] then
                                        listed[top] = true
                                        local dim, cnt = big, 1
                                        if top:IsA("Model") then
                                            cnt = modelOk(top) or 1
                                            local okE, ez = pcall(function() return top:GetExtentsSize() end)
                                            if okE then dim = math.max(ez.X, ez.Y, ez.Z) end
                                        end
                                        cand[#cand + 1] = { orig = top, dim = dim, cnt = cnt, w = rnd:NextNumber() * (1 + math.min(dim / 25, 3)) }
                                    end
                                end
                            end
                        end
                    end
                end
            end
            table.sort(cand, function(a, b) return a.w > b.w end)
            local objs, parts = {}, 0
            local chosen = {}
            for _, q in ipairs(cand) do
                if #objs >= prof.models or parts + q.cnt > prof.parts then break end
                parts = parts + q.cnt
                local pv = q.orig:IsA("Model") and q.orig:GetPivot() or q.orig.CFrame
                objs[#objs + 1] = { kind = "model", orig = q.orig, dim = q.dim, cf0 = pv }
                chosen[q.orig] = true
            end
            if tw then
                local pv = tw:IsA("Model") and tw:GetPivot() or tw.CFrame
                table.insert(objs, 1, { kind = "model", orig = tw, dim = twDim, dimY = twY, cf0 = pv, tower = true })
                chosen[tw] = true
            end
            local rest = {}   -- everything else on the map: it crumbles away while the islands break apart
            for _, rec in ipairs(allp) do
                if not chosen[rec[2]] and (c.roam or (rec[1].Position - center).Magnitude > 60) then rest[#rest + 1] = rec[1] end
            end
            -- the islands: each big part breaks into slabs that lift off and drift towards the black hole, then the rest of it fades away in dust
            table.sort(bigs, function(a, b) return a.Size.X * a.Size.Z > b.Size.X * b.Size.Z end)
            local bigRecs, fragN = {}, 0
            for bi, bp in ipairs(bigs) do
                local rec = { p = bp, d = (bp.Position - center).Magnitude, under = (not c.roam) and underPlayer(bp) }
                if not rec.under then
                    bigRecs[#bigRecs + 1] = rec
                    if bi <= prof.bigs then
                        local sz = bp.Size
                        local n2 = math.clamp(math.floor(sz.X * sz.Z / 2800), 3, 12)
                        for _ = 1, n2 do
                            if fragN >= prof.frags then break end
                            local lp = Vector3.new((rnd:NextNumber() - 0.5) * sz.X * 0.85, sz.Y / 2, (rnd:NextNumber() - 0.5) * sz.Z * 0.85)
                            local pos = bp.CFrame:PointToWorldSpace(lp)
                            objs[#objs + 1] = { kind = "chunk", frag = true, rec = rec, ch = { pos = pos, nrm = bp.CFrame.UpVector, mat = bp.Material, col = bp.Color }, dim = 60, cf0 = CFrame.new(pos) }
                            fragN = fragN + 1
                        end
                    end
                end
            end
            c.suckRest, c.suckBigs, c.suckCenter, c.suckRad = rest, bigRecs, center, RADIUS
            if c.suckDead then return end
            -- 2) chunks of ground: found by shooting rays down at random spots, whatever the ground is made of
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = excl
            rp.IgnoreWater = true
            local chunks = {}
            for k = 1, 220 do
                if #chunks >= prof.chunks then break end
                local ang = rnd:NextNumber() * 2 * math.pi
                local rad = 30 + rnd:NextNumber() ^ 0.7 * (RADIUS - 30)
                local o = center + Vector3.new(math.cos(ang) * rad, 900, math.sin(ang) * rad)
                local hit = workspace:Raycast(o, Vector3.new(0, -3000, 0), rp)
                if hit and hit.Normal.Y > 0.7 then
                    local ok = true
                    for _, q in ipairs(chunks) do if (q.pos - hit.Position).Magnitude < 90 then ok = false break end end
                    if ok then
                        local col = Color3.fromRGB(120, 120, 120)
                        if hit.Instance:IsA("BasePart") and not hit.Instance:IsA("Terrain") then col = hit.Instance.Color
                        else pcall(function() col = workspace.Terrain:GetMaterialColor(hit.Material) end) end
                        chunks[#chunks + 1] = { pos = hit.Position, nrm = hit.Normal, mat = hit.Material, col = col }
                    end
                end
                if k % 20 == 0 then task.wait() if c.suckDead then return end end
            end
            for _, ch in ipairs(chunks) do
                objs[#objs + 1] = { kind = "chunk", ch = ch, dim = 60, cf0 = CFrame.new(ch.pos) }
            end
            -- 3) water: the pond is found with rays that stop at water; it is lifted away in blobs while the real water fades out
            local rpw = RaycastParams.new()
            rpw.FilterType = Enum.RaycastFilterType.Exclude
            rpw.FilterDescendantsInstances = excl
            rpw.IgnoreWater = false
            local wpts = {}
            local gi = 0
            local thit = {}
            local GS = c.roam and 120 or 50
            for gx = -RADIUS, RADIUS, GS do
                for gz = -RADIUS, RADIUS, GS do
                    if gx * gx + gz * gz < RADIUS * RADIUS then
                        local hit = workspace:Raycast(center + Vector3.new(gx, 900, gz), Vector3.new(0, -3000, 0), rpw)
                        if hit and hit.Material == Enum.Material.Water then wpts[#wpts + 1] = hit.Position
                        elseif hit and hit.Instance and hit.Instance:IsA("Terrain") and rnd:NextNumber() < 0.08 then thit[#thit + 1] = hit.Position end
                    end
                end
                gi = gi + 1
                if gi % 6 == 0 then task.wait() if c.suckDead then return end end
            end
            do   -- the terrain water close to you (the pond next to the dome) is read straight from the terrain too
                local T = workspace.Terrain
                local okv, r3, mats = pcall(function()
                    local rg = Region3.new(center - Vector3.new(480, 112, 480), center + Vector3.new(480, 112, 480)):ExpandToGrid(4)
                    local m = T:ReadVoxels(rg, 4)
                    return rg, m
                end)
                if okv and mats then
                    local org = r3.CFrame.Position - r3.Size / 2
                    local vsz = mats.Size
                    for x = 1, vsz.X do
                        for z = 1, vsz.Z do
                            for y = vsz.Y, 1, -1 do
                                local m0 = mats[x][y][z]
                                if m0 ~= Enum.Material.Air then
                                    if m0 == Enum.Material.Water and rnd:NextNumber() < 0.04 then wpts[#wpts + 1] = org + Vector3.new(x - 0.5, y - 0.5, z - 0.5) * 4 end
                                    break
                                end
                            end
                        end
                        if x % 16 == 0 then task.wait() if c.suckDead then return end end
                    end
                end
            end
            print("[NoVR] pond points found: " .. #wpts)
            if #wpts > 0 and not S.perfLow() then   -- the box around all the water: it is removed from the terrain itself when the time comes
                local mn, mx = wpts[1], wpts[1]
                for _, q in ipairs(wpts) do mn = Vector3.new(math.min(mn.X, q.X), math.min(mn.Y, q.Y), math.min(mn.Z, q.Z)) mx = Vector3.new(math.max(mx.X, q.X), math.max(mx.Y, q.Y), math.max(mx.Z, q.Z)) end
                local mid = (mn + mx) / 2
                local sx, sy, sz = math.clamp(mx.X - mn.X + 40, 40, 640), math.clamp(mx.Y - mn.Y + 70, 40, 120), math.clamp(mx.Z - mn.Z + 40, 40, 640)
                c.waterBox = { cf = Vector3.new(mid.X, mn.Y + sy / 2 - 56 + 10, mid.Z), size = Vector3.new(sx, sy, sz) }
            end
            if #wpts == 0 and #thit > 0 then   -- no water found from above: look inside the terrain around the ground that was hit
                local T = workspace.Terrain
                for _ = 1, 30 do
                    if #wpts >= 400 or c.suckDead then break end
                    local p = thit[rnd:NextInteger(1, #thit)]
                    local ok, r3, mats = pcall(function()
                        local rg = Region3.new(p - Vector3.new(128, 48, 128), p + Vector3.new(128, 48, 128)):ExpandToGrid(4)
                        local m = T:ReadVoxels(rg, 4)
                        return rg, m
                    end)
                    if ok and mats then
                        local org = r3.CFrame.Position - r3.Size / 2
                        local sz = mats.Size
                        for x = 1, sz.X do
                            for z = 1, sz.Z do
                                for y = sz.Y, 1, -1 do
                                    if mats[x][y][z] == Enum.Material.Water then
                                        if rnd:NextNumber() < 0.2 then wpts[#wpts + 1] = org + Vector3.new(x - 0.5, y - 0.5, z - 0.5) * 4 end
                                        break
                                    end
                                end
                            end
                        end
                    end
                    task.wait()
                end
            end
            for k = #wpts, 2, -1 do local j = rnd:NextInteger(1, k) wpts[k], wpts[j] = wpts[j], wpts[k] end
            for k = 1, math.min(#wpts, prof.water) do
                objs[#objs + 1] = { kind = "water", dim = 24 + rnd:NextNumber() * 34, cf0 = CFrame.new(wpts[k] + Vector3.new(rnd:NextNumber() * 20 - 10, 12, rnd:NextNumber() * 20 - 10)) }
            end
            do
                local T = workspace.Terrain
                c.water0 = { T.WaterTransparency, T.WaterReflectance, T.WaterWaveSize, T.WaterColor }   -- the terrain water always fades away, found or not
            end
            c.suckObjs = objs
            c.suckRnd = rnd
        end
        function S.suckClean(root)   -- a copy that only moves: no scripts, no sounds, no physics
            local function prep(d)
                if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("Humanoid") or d:IsA("Constraint") then
                    pcall(function() d:Destroy() end)
                elseif d:IsA("BasePart") then
                    d.Anchored, d.CanCollide, d.CanTouch, d.CanQuery = true, false, false, false
                end
            end
            prep(root)
            for _, d in ipairs(root:GetDescendants()) do prep(d) end
        end
        function S.suckInit(c, ob)   -- makes the moving copy (just before it is needed)
            local rnd = c.suckRnd
            ob.init = true
            local A = c.suckA
            if ob.kind == "model" then
                local cl
                pcall(function() cl = ob.orig:Clone() end)
                if not cl then ob.done = true return end
                S.suckClean(cl)
                ob.hid = {}
                if ob.orig:IsA("BasePart") then ob.hid[1] = ob.orig end
                for _, d in ipairs(ob.orig:GetDescendants()) do if d:IsA("BasePart") then ob.hid[#ob.hid + 1] = d end end
                for _, p in ipairs(ob.hid) do pcall(function() p.LocalTransparencyModifier = 1 end) end
                cl.Parent = c.suckf
                ob.inst = cl
                ob.main = cl:IsA("BasePart") and cl or cl:FindFirstChildWhichIsA("BasePart", true)
            elseif ob.kind == "chunk" then
                local ch = ob.ch
                local right = ch.nrm:Cross(Vector3.zAxis)
                if right.Magnitude < 0.1 then right = ch.nrm:Cross(Vector3.xAxis) end
                local cfG = CFrame.fromMatrix(ch.pos, right.Unit, ch.nrm)
                local w, d = 35 + rnd:NextNumber() * 50, 35 + rnd:NextNumber() * 50
                if ob.frag then w, d = 50 + rnd:NextNumber() * 80, 50 + rnd:NextNumber() * 80 end
                local th, dep = 5 + rnd:NextNumber() * 3, 16 + rnd:NextNumber() * 18
                local m = Instance.new("Model")
                m.Name = "Chunk"
                local function blk(size, cf, col, mat)
                    local p = Instance.new("Part")
                    p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, true
                    p.Size, p.CFrame, p.Color, p.Material = size, cf, col, mat
                    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
                    p.Parent = m
                    return p
                end
                local mat = ch.mat == Enum.Material.Water and Enum.Material.Ground or ch.mat
                local top
                local lowP = S.perfLow()
                local N = lowP and 2 or 3   -- the slab is a grid of square blocks with a ragged edge, like torn-up voxel ground
                local cw, cd = w / N, d / N
                for ix = 1, N do
                    for iz = 1, N do
                        local edge = (ix == 1 or ix == N or iz == 1 or iz == N)
                        if not (edge and N == 3 and rnd:NextNumber() < 0.22 and top) then
                            local hh = th * (0.8 + rnd:NextNumber() * 0.9)
                            local ox, oz = (ix - (N + 1) / 2) * cw, (iz - (N + 1) / 2) * cd
                            local t = blk(Vector3.new(cw * 0.98, hh, cd * 0.98), cfG * CFrame.new(ox, -hh / 2 + 0.25 + (rnd:NextNumber() < 0.3 and 1.2 or 0), oz), ch.col, mat)
                            top = top or t
                            if hh > th * 1.3 then   -- a stepped block: a grass-colored cap on a lighter dirt block
                                t.Color = ch.col:Lerp(Color3.fromRGB(120, 98, 76), 0.35)
                            end
                        end
                    end
                end
                local nU = lowP and 2 or 4
                for k = 1, nU do   -- square stone and dirt layers hang under it
                    local ux, uz = ((k - 1) % 2 - 0.5) * w * 0.5, (math.floor((k - 1) / 2) - 0.5) * d * 0.5
                    local dh = dep * (0.55 + rnd:NextNumber() * 0.5)
                    blk(Vector3.new(w * 0.46, dh, d * 0.46), cfG * CFrame.new(ux, -th - dh / 2 + 0.6, uz), (k % 2 == 0) and Color3.fromRGB(104, 88, 72) or Color3.fromRGB(92, 82, 76), (k % 2 == 0) and Enum.Material.Ground or Enum.Material.Slate)
                end
                for _ = 1, (ob.frag and 0 or (lowP and 1 or 3)) do   -- loose cubes dangling off the bottom
                    local s0 = 4 + rnd:NextNumber() * 8
                    blk(Vector3.new(s0, s0, s0), cfG * CFrame.new((rnd:NextNumber() - 0.5) * w * 0.7, -th - dep + (rnd:NextNumber() - 0.5) * 6, (rnd:NextNumber() - 0.5) * d * 0.7), Color3.fromRGB(70, 62, 58), Enum.Material.Slate)
                end
                m.PrimaryPart = top
                m.Parent = c.suckf
                ob.inst, ob.main = m, top
                ob.cf0 = top.CFrame
                local scar = Instance.new("Part")   -- the dark hole it leaves behind
                scar.Anchored, scar.CanCollide, scar.CanTouch, scar.CanQuery, scar.CastShadow = true, false, false, false, false
                scar.Size = Vector3.new(w * 1.08, 0.3, d * 1.08)
                scar.CFrame = cfG * CFrame.new(0, 0.12, 0)
                scar.Color = Color3.fromRGB(28, 22, 19)
                scar.Material = Enum.Material.Slate
                scar.Transparency = 1
                scar.Parent = c.suckf
                ob.scar = scar
                ob.cfG, ob.cw, ob.cd = cfG, w, d
                ob.dim = math.max(w, d)
            else   -- water blob
                local p = Instance.new("Part")
                p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
                local w0 = c.water0   -- it looks like the pond water: the same color, see-through and shiny
                local wc = (w0 and w0[4]) or Color3.fromRGB(12, 84, 91)
                p.Material = Enum.Material.Glass
                p.Color = wc:Lerp(Color3.new(1, 1, 1), 0.22)
                p.Reflectance = 0.25
                p.Transparency = 0.3 + 0.3 * ((w0 and w0[1]) or 0.3)
                p.Size = Vector3.one * ob.dim
                p.CFrame = ob.cf0
                p.Parent = c.suckf
                ob.inst, ob.main = p, p
            end
            if ob.tower and ob.inst then   -- the tower tips over about its foot before it is pulled away
                local okb, bb = pcall(function() local cf0 = ob.orig:IsA("Model") and ob.orig:GetBoundingBox() or ob.orig.CFrame return cf0 end)
                if okb and bb then
                    local dirH = (c.S0 - ob.cf0.Position) * Vector3.new(1, 0, 1)
                    dirH = dirH.Magnitude > 1 and dirH.Unit or Vector3.xAxis
                    local axis = Vector3.yAxis:Cross(dirH).Unit
                    local base = bb.Position - Vector3.new(0, (ob.dimY or ob.dim) / 2, 0)
                    ob.cfStart = ob.cf0
                    ob.topple = { base = base, axis = axis, A = 1.45, T = 3.5 }
                    ob.cf0 = CFrame.new(base) * CFrame.fromAxisAngle(axis, 1.45) * CFrame.new(-base) * ob.cfStart
                end
            end
            -- how it will travel: it lifts, then spirals in around the disc and plunges into the middle, faster and faster
            local v0 = ob.cf0.Position - c.S0
            local ha = v0:Dot(A)
            local vr = v0 - A * ha
            ob.r0, ob.ha = vr.Magnitude, ha
            ob.phi0 = math.atan2(vr:Dot(c.suckE2), vr:Dot(c.suckE1))
            ob.sgn = 1
            ob.turns = 0.05 + rnd:NextNumber() * 0.15
            ob.lift = 25 + rnd:NextNumber() * 70 + ob.dim * 0.4
            if ob.kind == "water" then ob.lift = 90 + rnd:NextNumber() * 170 end   -- the pond floats up before it flows away
            ob.spinAxis = Vector3.new(rnd:NextNumber() - 0.5, rnd:NextNumber() - 0.5, rnd:NextNumber() - 0.5).Unit
            ob.spinRate = 0.3 + rnd:NextNumber() * 1.1
            ob.rot0 = ob.cf0.Rotation
            if ob.main and (c.emitN or 0) < (c.prof and c.prof.emit or 80) and (ob.dim > 12 or ob.kind ~= "model") then
                c.emitN = (c.emitN or 0) + 1
                local e = Instance.new("ParticleEmitter")
                e.Texture = "rbxasset://textures/particles/smoke_main.dds"
                e.Rate = ob.kind == "chunk" and 45 or 22
                e.Enabled = false
                e.Lifetime = NumberRange.new(1.4, 2.6)
                e.Speed = NumberRange.new(0, 5)
                e.Rotation = NumberRange.new(0, 360)
                e.RotSpeed = NumberRange.new(-30, 30)
                local sz = math.clamp(ob.dim * 0.9, 8, 110)
                e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, sz * 0.5), NumberSequenceKeypoint.new(1, sz * 1.7) })
                e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
                e.Color = ob.kind == "water" and ColorSequence.new(Color3.fromRGB(200, 225, 255)) or ColorSequence.new(Color3.fromRGB(125, 108, 95))
                e.LockedToPart = false
                e.LightInfluence = 0.5
                e.Parent = ob.main
                ob.emit = e
            end
        end
        function S.suckBurst(c, ob)   -- the moment it tears loose: a cloud of dust and flying chips, and the sound of it breaking
            local pos = (ob.cfStart or ob.cf0).Position - Vector3.new(0, ob.dim * 0.35, 0)
            pcall(S.suckShake, c, ob.dim, pos, ob.kind == "chunk" and 1.5 or 1)
            local bp = Instance.new("Part")
            bp.Anchored, bp.CanCollide, bp.CanTouch, bp.CanQuery, bp.CastShadow = true, false, false, false, false
            bp.Transparency = 1
            bp.Size = Vector3.one
            bp.CFrame = CFrame.new(pos)
            bp.Parent = c.suckf
            local sz = math.clamp(ob.dim * 0.7, 8, 60)
            local e = Instance.new("ParticleEmitter")
            e.Texture = "rbxasset://textures/particles/smoke_main.dds"
            e.Rate = 0
            e.Lifetime = NumberRange.new(2, 4)
            e.Speed = NumberRange.new(10, 40)
            e.SpreadAngle = Vector2.new(70, 70)
            e.Acceleration = Vector3.new(0, -5, 0)
            e.Rotation = NumberRange.new(0, 360)
            e.RotSpeed = NumberRange.new(-40, 40)
            e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, sz * 0.4), NumberSequenceKeypoint.new(1, sz * 1.6) })
            e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
            e.Color = ob.kind == "water" and ColorSequence.new(Color3.fromRGB(215, 235, 255)) or ColorSequence.new(Color3.fromRGB(150, 130, 105))
            e.LightInfluence = 0.6
            e.Parent = bp
            e:Emit(math.floor((ob.kind == "model" and 24 or 46) * (S.perfLow() and 0.5 or 1)))
            if ob.kind ~= "water" then   -- a second, darker and bigger cloud
                local e2 = e:Clone()
                e2.Color = ColorSequence.new(Color3.fromRGB(70, 60, 55))
                e2.Lifetime = NumberRange.new(3, 6)
                e2.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, sz * 0.8), NumberSequenceKeypoint.new(1, sz * 2.6) })
                e2.Parent = bp
                e2:Emit(math.floor(14 * (S.perfLow() and 0.5 or 1)))
            end
            if ob.kind ~= "water" then
                local ch = Instance.new("ParticleEmitter")   -- chips of rock and wood thrown out
                ch.Texture = "rbxasset://textures/particles/sparkles_main.dds"
                ch.Rate = 0
                ch.Lifetime = NumberRange.new(1.5, 3)
                ch.Speed = NumberRange.new(30, 90)
                ch.SpreadAngle = Vector2.new(80, 80)
                ch.Acceleration = Vector3.new(0, -60, 0)
                ch.Size = NumberSequence.new(1.6)
                ch.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
                ch.Color = ColorSequence.new(Color3.fromRGB(110, 90, 70))
                ch.LightInfluence = 1
                ch.Parent = bp
                ch:Emit(ob.kind == "chunk" and 40 or 14)
            end
            game:GetService("Debris"):AddItem(bp, 8)
            local big = math.clamp(ob.dim / 40, 0.25, 1.4)
            if ob.kind == "chunk" then
                S.suckSnd("rip", bp, 1.0 * big, 0.85 + (c.suckRnd:NextNumber() * 0.3))
                task.delay(0.2, function() S.suckSnd("debris", bp, 0.8, 0.9 + c.suckRnd:NextNumber() * 0.2) end)
            elseif ob.kind == "water" then
                S.suckSnd("whoosh", bp, 0.35, 0.9 + c.suckRnd:NextNumber() * 0.4)
            else
                S.suckSnd(ob.dim > 25 and "rip" or "debris", bp, 0.55 * big, 0.9 + c.suckRnd:NextNumber() * 0.3)
            end
            if ob.tower then S.suckSnd("boomS", bp, 0.7, 0.9, 6000) S.suckSnd("rip", bp, 1.2, 0.6, 6000) end
            if ob.scar and not ob.frag then
                ob.scar.Transparency = 0
                pcall(S.suckCrater, c, ob)
            end
        end
        function S.suckCrater(c, ob)   -- the hole is a stepped pit: terraces get darker and smaller toward the middle, a ridge of blocks rings it, and little rocks keep falling off the edge
            local rnd = c.suckRnd
            local cfG, w, d = ob.cfG, ob.cw, ob.cd
            if not cfG then return end
            local lowP = S.perfLow()
            local function bk(sz, cf, col, mat)
                local p = Instance.new("Part")
                p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, true
                p.Size, p.CFrame, p.Color, p.Material = sz, cf, col, mat
                p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
                p.Parent = c.suckf
                return p
            end
            local R = math.max(w, d) * 0.5
            local gc = (ob.ch and ob.ch.col) or Color3.fromRGB(104, 88, 72)   -- the crater is made of the ground it was torn from
            local gm = (ob.ch and ob.ch.mat and ob.ch.mat ~= Enum.Material.Water) and ob.ch.mat or Enum.Material.Ground
            local dk = Color3.fromRGB(30, 26, 24)
            local function ring(n, r, hMin, hMax, thick, tilt, col, mat)   -- a ring of real solid blocks: they make the walls of the pit
                for i = 1, n do
