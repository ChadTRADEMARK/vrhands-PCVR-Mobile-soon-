            end
            function Mic.meter()   -- a level meter fed from your mic (peak / rms)
                local m = Mic.find()
                if not m then return nil end
                if not (Mic.analyzer and Mic.analyzer.Parent) then
                    pcall(function()
                        local an = Instance.new("AudioAnalyzer")
                        an.Name = "NoVR_MicMeter"
                        an.Parent = lp
                        local w = Instance.new("Wire")
