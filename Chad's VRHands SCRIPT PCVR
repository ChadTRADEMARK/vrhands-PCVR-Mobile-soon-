        -- Role lookup: reads ROLES_URL once and remembers the answer (retries if it was unreachable).
        local roleState = { done = false, text = nil, found = false, busy = false, waiting = {} }
        local function fetchRole(cb)
            if roleState.done and os.clock() - (roleState.at or 0) < 10 then cb(roleState.text, roleState.found) return end
            roleState.waiting[#roleState.waiting + 1] = cb
            if roleState.busy then return end
            roleState.busy = true
            task.spawn(function()
                local text, found, ok = "Unavailable", false, false
                if type(ROLES_URL) ~= "string" or ROLES_URL == "" then
                    text, ok = "Not configured", true
                else
                    local body = rawGet(ROLES_URL)
                    if body then
                        local okj, data = pcall(HttpSvcD.JSONDecode, HttpSvcD, body)
                        if okj and type(data) == "table" then
                            ok = true
                            local v = data[tostring(lp.UserId)]
                            if type(v) == "table" then v = v.role end
                            if type(v) == "string" and v ~= "" then
                                text, found = v, true
                            else
                                text = "No role (not linked)"
                            end
                        end
                    end
                end
                if ok then roleState.done, roleState.text, roleState.found, roleState.at = true, text, found, os.clock() end
                roleState.busy = false
                local list = roleState.waiting
                roleState.waiting = {}
                for _, f in ipairs(list) do pcall(f, text, found) end
            end)
