            -- ===== ESP window =====
            local function openEsp()
                local p, ent = overlay("esp", 90, 14, 320, 360, "ESP", "See players through walls")
                if not p then return end
                local note = lbl(p, "VR = purple   PC = blue   Mobile = green   Other = white", 22, 50, 276, 14, 10, MUTED, Enum.Font.GothamMedium)
                local btns = {}
                local function pill(y, fn)
                    local b = Instance.new("TextButton")
