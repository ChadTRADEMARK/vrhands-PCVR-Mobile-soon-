            local hoverIdx = nil
            local t0 = os.clock()
            local closingAt = nil
            local rc, ic
            local function done()
                if rc then rc:Disconnect() rc = nil end
                if ic then ic:Disconnect() ic = nil end
                folder:Destroy()
                S.uiLook = false
                tw(dof, 0.5, { NearIntensity = 0, FarIntensity = 0 }, Enum.EasingStyle.Sine)
                task.delay(0.6, function() dof:Destroy() end)
                pcall(function() UIS.MouseIconEnabled = true end)
            end
            rc = RunService.RenderStepped:Connect(function(dtp)
                if not folder.Parent then done() return end
                base0 = CFrame.new(base0.Position:Lerp(cam.CFrame.Position, 1 - math.exp(-(dtp or 0.016) * 3))) * (base0 - base0.Position)
                if pauseGui ~= g and not closingAt then closingAt = os.clock() end
                local a = closingAt and (1 - (os.clock() - closingAt) / 0.35) or (((os.clock() - t0) / 0.9))
                if closingAt and a <= 0 then done() return end
                a = math.clamp(a, 0, 1)
                local ea = closingAt and a or (1 + 2.70158 * (a - 1) ^ 3 + 1.70158 * (a - 1) ^ 2)   -- ease-out-back going in
                if not closingAt then
                    UIS.MouseBehavior = Enum.MouseBehavior.LockCenter   -- the cursor stays on the crosshair; the mouse turns your head
                    UIS.MouseIconEnabled = false
                end
                local base = cam.CFrame   -- where you are looking now
                for _, p in ipairs(panels) do   -- the panels never move (apart from flying in); only your view does
                    local d = DIST * (0.55 + 0.45 * ea)
                    local pos = CFrame.Angles(0, p.theta * ea, 0) * Vector3.new(0, p.yOff, -d)
                    local cf = CFrame.lookAt(pos, Vector3.new(0, pos.Y, 0))
                    local k = 0.5 + 0.5 * ea
                    p.part.Size = Vector3.new(p.w * k, p.h * k, 0.1)
                    p.part.CFrame = base0 * cf
                end
                veil.CFrame = base * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.pi, 0)
                veil.Transparency = 1 - 0.55 * (closingAt and a or math.clamp((os.clock() - t0) / 0.6, 0, 1))
                -- what is under the crosshair? (the ray from the camera centre against the centre panel)
                local newIdx = nil
                if not closingAt and ea > 0.85 then
                    local pcf = center.part.CFrame
                    local n = pcf.LookVector
                    local dn = base.LookVector:Dot(n)
                    if math.abs(dn) > 1e-4 then
                        local tHit = (pcf.Position - base.Position):Dot(n) / dn
                        if tHit > 0 then
                            local l = pcf:PointToObjectSpace(base.Position + base.LookVector * tHit)
                            local w, h = center.part.Size.X, center.part.Size.Y
                            if math.abs(l.X) <= w / 2 and math.abs(l.Y) <= h / 2 then
                                local px, py = (0.5 - l.X / w) * center.cw, (0.5 - l.Y / h) * center.ch
                                for i, o in ipairs(rowObjs) do
                                    if px >= 20 and px <= 580 and py >= o.y and py <= o.y + 72 then newIdx = i break end
                                end
                            end
                        end
                    end
                end
                if newIdx ~= hoverIdx then
                    if hoverIdx then rowLeave(rowObjs[hoverIdx]) end
                    hoverIdx = newIdx
                    if hoverIdx then rowEnter(rowObjs[hoverIdx]) end
                    tw(rsc, 0.25, { Scale = hoverIdx and 1.45 or 1 }, Enum.EasingStyle.Back)
                    tw(rst, 0.2, { Color = hoverIdx and PINK or WHITE }, Enum.EasingStyle.Quad)
                end
            end)
            ic = UIS.InputBegan:Connect(function(io, gp)
                if closingAt then return end
                if io.UserInputType == Enum.UserInputType.MouseButton1 and hoverIdx then
                    local f = ROWS[hoverIdx][3]
                    task.defer(f)
                end
            end)
        end

