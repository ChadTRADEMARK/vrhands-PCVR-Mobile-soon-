                    return b
                end
                local tabs = { mkBtn(p, "CAMERA + HANDS", 20, 50, 150, 28, 11), mkBtn(p, "VR CONTROLLERS", 176, 50, 150, 28, 11), mkBtn(p, "KEYS + TOOLS", 332, 50, 150, 28, 11) }
                local function showPage(i)
                    for k, pg in ipairs(pages) do
                        pg.Visible = (k == i)
                        tabs[k].BackgroundTransparency = (k == i) and 0.15 or 0.8
                    end
                end
                for i, t in ipairs(tabs) do t.Activated:Connect(function() showPage(i) end) end
                local function note(parent, text, x, y, w, h, size, col)
                    local l = lbl(parent, text, x, y, w, h, size or 11, col or MUTED, Enum.Font.GothamMedium)
                    l.Size = UDim2.fromOffset(w, h)
                    l.TextWrapped = true
                    l.TextTruncate = Enum.TextTruncate.None
                    l.TextYAlignment = Enum.TextYAlignment.Top
                    return l
                end
                local function toggleBtn(parent, text, x, y, w, get, set)
                    local b = mkBtn(parent, "", x, y, w, 30, 11)
                    local function paint() b.Text = text .. ":  " .. (get() and "ON" or "OFF"); b.BackgroundTransparency = get() and 0.15 or 0.8 end
                    b.Activated:Connect(function() set(not get()); paint(); U.touch() end)
                    paint()
                    return b
                end

                -- ===== page 1: camera + hands =====
                local P1 = pages[1]
                lbl(P1, "Camera", 20, 90, 200, 18, 13)
                local CAMS = {
                    { "free", "FREE PC CAMERA", "Normal PC third person: the mouse turns the view, I / O change the distance, walls push the camera in." },
                    { "first", "FIRST PERSON", "Eye view. Your head is hidden and your body turns with the camera." },
                    { "pov", "REALISTIC POV", "First person like a handheld camera: it trails the mouse, drifts and bobs while you walk." },
                    { "smooth", "SMOOTH (GAME CAM)", "The game's own PC camera, with VR snap-turning switched off." },
                    { "own", "OWN FIRST PERSON", "This script's plain first-person camera (older mode)." },
                    { "game", "GAME VR CAMERA", "Leave the game's VR camera alone." },
                }
                local camBtns = {}
                local camHint = note(P1, "", 20, 190, 650, 34, 11)
                local function paintCams()
                    for _, cb in ipairs(camBtns) do
                        cb.b.BackgroundTransparency = (U.camMode == cb.m) and 0.1 or 0.8
                        if U.camMode == cb.m then camHint.Text = cb.hint end
                    end
                end
                for i, c in ipairs(CAMS) do
                    local col, row = (i - 1) % 3, math.floor((i - 1) / 3)
                    local b = mkBtn(P1, c[2], 20 + col * 218, 116 + row * 36, 210, 30, 11)
                    camBtns[#camBtns + 1] = { b = b, m = c[1], hint = c[3] }
                    b.Activated:Connect(function() if U.setCamMode then U.setCamMode(c[1]) end paintCams(); U.touch() end)
                end
                paintCams()
                local camKeyBtn = mkBtn(P1, "", 20, 232, 316, 30, 11)
                local function paintKey() camKeyBtn.Text = "CAMERA KEY (cycles the modes):  " .. U.opt.camKey end
                paintKey()
                camKeyBtn.Activated:Connect(function()
                    camKeyBtn.Text = "press a key...  (Esc = cancel)"
                    U.capture = function(kc)
                        if kc ~= Enum.KeyCode.Escape and kc ~= Enum.KeyCode.Unknown then U.opt.camKey = kc.Name; U.touch() end
                        paintKey()
                    end
                end)
                toggleBtn(P1, "OWN MOVEMENT + TURNING", 346, 232, 324, function() return U.opt.moveCtl end, function(v) U.opt.moveCtl = v end)
                note(P1, "Turn OWN MOVEMENT off in games that move your character themselves (vehicles, custom controllers).", 346, 264, 324, 30, 10)

                lbl(P1, "Feel", 20, 300, 200, 18, 13)
                local function sliderRow(y, label, initF, fmt, onSet)
                    lbl(P1, label, 20, y, 200, 16, 11, WHITE, Enum.Font.GothamBold)
                    local val = lbl(P1, "", 580, y, 90, 16, 11, MUTED, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
                    val.Text = fmt(initF)
                    hslider(P1, 20, y + 26, 560, initF, false, function(f, done)
                        val.Text = fmt(f)
                        onSet(f)
                        if done then U.touch() end
                    end)
                end
                sliderRow(322, "REALISTIC POV strength (sway, bob, hand motion)", U.opt.povAmt / 2, function(f) return math.floor(f * 200 + 0.5) .. "%" end, function(f) U.opt.povAmt = f * 2 end)
                sliderRow(372, "Mouse look speed", (U.cfg.sens - 0.001) / 0.011, function(f) return string.format("%.1f", (0.001 + f * 0.011) * 1000) end, function(f) U.cfg.sens = 0.001 + f * 0.011 end)
                toggleBtn(P1, "SMOOTH HANDS", 20, 424, 316, function() return U.opt.smooth end, function(v) U.opt.smooth = v end)
                toggleBtn(P1, "HANDS FOLLOW BODY (3rd person)", 346, 424, 324, function() return U.opt.bodyHands end, function(v) U.opt.bodyHands = v end)
                toggleBtn(P1, "FAR VIEW (End key)", 20, 458, 316, function() return U.far == true end, function(v) U.setFar(v) end)
                note(P1, "Far view removes fog and raises detail so distant things stay visible. Smooth hands ease toward where you aim; hands follow body keeps them in front of your character.", 346, 456, 330, 40, 10)

                -- ===== page 2: 3D VR controllers =====
                local P2 = pages[2]
                local VW, VH, VX = 340, 340, 160          -- the 3D view sits between the two label columns
                local vp = Instance.new("ViewportFrame")
                vp.Position = UDim2.fromOffset(20 + VX, 88)
                vp.Size = UDim2.fromOffset(VW, VH)
                vp.BackgroundColor3 = C(14, 8, 40)
                vp.BackgroundTransparency = 0
                vp.BorderSizePixel = 0
                vp.Ambient = Color3.fromRGB(170, 160, 210)
                vp.LightColor = Color3.fromRGB(255, 255, 255)
                vp.LightDirection = Vector3.new(-0.4, -0.8, -0.6)
                vp:SetAttribute("tc", true)
                vp.Parent = P2
                corner(vp, 12)
                stroke(vp, WHITE, 1.5, 0.7)
                local vcam = Instance.new("Camera")
                vcam.FieldOfView = 40
                vcam.CFrame = CFrame.lookAt(Vector3.new(0, 1.6, 9.6), Vector3.new(0, -0.3, 0))
                vcam.Parent = vp
                vp.CurrentCamera = vcam
                local world = Instance.new("Model")
                world.Parent = vp
                local BODY, KEYC, LIT = Color3.fromRGB(46, 40, 76), Color3.fromRGB(190, 160, 255), Color3.fromRGB(150, 255, 205)
                local pad = {}   -- every part with its place on the controller
                local function mk(rel, size, color, shape, cx)
                    local pt = Instance.new("Part")
                    pt.Anchored = true; pt.CanCollide = false; pt.CanTouch = false
                    pt.Material = Enum.Material.SmoothPlastic
                    pt.Size = size; pt.Color = color
                    if shape then pt.Shape = shape end
                    pt.Parent = world
                    pad[#pad + 1] = { part = pt, rel = rel, cx = cx, base = color }
                    return pad[#pad]
                end
                local CYL, BALL = Enum.PartType.Cylinder, Enum.PartType.Ball
                local ZUP = CFrame.Angles(0, 0, math.rad(90))   -- turns a cylinder's long axis from X to Y
                local marks = {}   -- the buttons that get a label
                for _, sd in ipairs({ "L", "R" }) do
                    local sg = (sd == "L") and -1 or 1
                    local cx = sg * 2.1
                    local HEAD = CFrame.new(0, 0.05, 0) * CFrame.Angles(math.rad(25), 0, 0)
                    mk(CFrame.new(0, -1.15, 0.35) * CFrame.Angles(math.rad(-18), 0, 0) * ZUP, Vector3.new(2.3, 0.6, 0.6), BODY, CYL, cx)   -- handle
                    mk(HEAD * ZUP, Vector3.new(0.22, 1.55, 1.55), BODY, CYL, cx)                                                            -- head
                    for i = 0, 13 do   -- tracking ring
                        local a = i / 14 * math.pi * 2
                        mk(HEAD * CFrame.new(math.cos(a) * 1.0, 0.0, math.sin(a) * 1.0 - 0.1), Vector3.new(0.14, 0.14, 0.14), Color3.fromRGB(90, 80, 130), BALL, cx)
                    end
                    local trig = mk(CFrame.new(0, -0.5, -0.5) * CFrame.Angles(math.rad(-20), 0, 0), Vector3.new(0.32, 0.6, 0.26), KEYC, nil, cx)
                    local grip = mk(CFrame.new(sg * 0.32, -1.0, 0.3) * CFrame.Angles(math.rad(-18), 0, 0), Vector3.new(0.14, 0.9, 0.34), KEYC, nil, cx)
                    local stick = mk(HEAD * CFrame.new(-sg * 0.22, 0.2, 0.32) * ZUP, Vector3.new(0.18, 0.3, 0.3), KEYC, CYL, cx)
                    local b1 = mk(HEAD * CFrame.new(sg * 0.42, 0.16, 0.28) * ZUP, Vector3.new(0.12, 0.26, 0.26), KEYC, CYL, cx)
                    local b2 = mk(HEAD * CFrame.new(sg * 0.26, 0.16, -0.2) * ZUP, Vector3.new(0.12, 0.26, 0.26), KEYC, CYL, cx)
                    local right = (sd == "R")
                    marks[#marks + 1] = { rec = trig, side = sd, title = right and "TRIGGER" or "TRIGGER", get = function() return right and "Left click" or "Right click" end, down = function() return U.buttons[right and Enum.KeyCode.ButtonR2 or Enum.KeyCode.ButtonL2] end }
                    marks[#marks + 1] = { rec = grip, side = sd, title = "GRIP", get = function() return U.opt.keymap[right and "R1" or "L1"] end, down = function() return U.buttons[right and Enum.KeyCode.ButtonR1 or Enum.KeyCode.ButtonL1] end }
                    marks[#marks + 1] = { rec = b1, side = sd, title = right and "BUTTON A" or "BUTTON X", get = function() return U.opt.keymap[right and "A" or "X"] end, down = function() return U.buttons[right and Enum.KeyCode.ButtonA or Enum.KeyCode.ButtonX] end }
                    marks[#marks + 1] = { rec = b2, side = sd, title = right and "BUTTON B" or "BUTTON Y", get = function() return U.opt.keymap[right and "B" or "Y"] end, down = function() return U.buttons[right and Enum.KeyCode.ButtonB or Enum.KeyCode.ButtonY] end }
                    marks[#marks + 1] = { rec = stick, side = sd, title = "THUMBSTICK", get = function() return right and "Arrow keys" or "W A S D" end,
                        down = function() local v = U.stick[right and Enum.KeyCode.Thumbstick2 or Enum.KeyCode.Thumbstick1]; return v and v.Magnitude > 0.1 end }
                end
                -- label cards + leader lines (positions follow the 3D parts every frame)
                local overlayF = Instance.new("Frame")
                overlayF.Position = UDim2.fromOffset(20, 88)
                overlayF.Size = UDim2.fromOffset(660, VH)
                overlayF.BackgroundTransparency = 1
                overlayF.BorderSizePixel = 0
                overlayF.Active = false
                overlayF.ZIndex = 4
                overlayF.Parent = P2
                local cnt = { L = 0, R = 0 }
                for _, m in ipairs(marks) do
                    cnt[m.side] = cnt[m.side] + 1
                    local slot = cnt[m.side] - 1
                    local lx = (m.side == "L") and 0 or (660 - 150)
                    local card = Instance.new("Frame")
                    card.Position = UDim2.fromOffset(lx, 6 + slot * 66)
                    card.Size = UDim2.fromOffset(150, 52)
                    card.BackgroundColor3 = Color3.new(1, 1, 1)
                    card.BackgroundTransparency = 0.84
                    card.BorderSizePixel = 0
                    card.ZIndex = 4
                    card.Parent = overlayF
                    corner(card, 10)
                    local cs = stroke(card, Color3.new(1, 1, 1), 1.2, 0.7)
                    local t1 = lbl(card, (m.side == "L" and "LEFT  " or "RIGHT  ") .. m.title, 8, 6, 134, 16, 10, MUTED, Enum.Font.GothamBold)
                    local t2 = lbl(card, "", 8, 24, 134, 22, 14, WHITE, Enum.Font.GothamBlack)
                    t1.ZIndex, t2.ZIndex = 5, 5
                    local dot = Instance.new("Frame")
                    dot.AnchorPoint = Vector2.new(0.5, 0.5)
                    dot.Size = UDim2.fromOffset(8, 8)
                    dot.BackgroundColor3 = LIT
                    dot.BorderSizePixel = 0
                    dot.ZIndex = 6
                    dot:SetAttribute("tc", true)
                    dot.Parent = overlayF
                    corner(dot, 4)
                    local ln = Instance.new("Frame")
                    ln.AnchorPoint = Vector2.new(0.5, 0.5)
                    ln.BackgroundColor3 = Color3.new(1, 1, 1)
                    ln.BackgroundTransparency = 0.45
                    ln.BorderSizePixel = 0
                    ln.ZIndex = 4
                    ln.Parent = overlayF
                    m.card, m.t2, m.dot, m.ln, m.cs, m.cardPos = card, t2, dot, ln, cs, Vector2.new(lx + ((m.side == "L") and 150 or 0), 6 + slot * 66 + 26)
                end
                local hit = Instance.new("TextButton")
                hit.Text = ""
                hit.BackgroundTransparency = 1
                hit.Position = vp.Position
                hit.Size = vp.Size
                hit.ZIndex = 6
                hit.Parent = P2
                local yawAng, dragging = 0, false
                hit.InputBegan:Connect(function(io) if isPress(io) then dragging = true end end)
                hit.InputEnded:Connect(function(io) if isPress(io) then dragging = false end end)
                hit.InputChanged:Connect(function(io)
                    if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then
                        yawAng = yawAng + io.Delta.X * 0.012
                    end
                end)
                note(P2, "Drag the controllers to turn them. A button lights up while you press its key. Keys can be changed on the KEYS + TOOLS page.", 20, 434, 660, 30, 11)
                note(P2, "Moving the hands: hold Alt and move the mouse (Shift = left only, Ctrl = right only), or use Hand mode (N) / Aim mode (V).", 20, 466, 660, 30, 11)
                local th = math.tan(math.rad(vcam.FieldOfView / 2))
                local function proj(pos)
                    local l = vcam.CFrame:PointToObjectSpace(pos)
                    local d = -l.Z
                    if d < 0.1 then return nil end
                    return VX + VW / 2 * (1 + l.X / (d * th * (VW / VH))), VH / 2 * (1 - l.Y / (d * th))
                end
                local lastKeys = 0
                local conn
                conn = RunService.RenderStepped:Connect(function()
                    if not vp.Parent or not vp:IsDescendantOf(game) then conn:Disconnect(); return end
                    if not P2.Visible then return end
                    local sway = math.sin(os.clock() * 0.7) * 0.35
                    for _, r in ipairs(pad) do
                        local B = CFrame.new(r.cx, 0.2, 0) * CFrame.Angles(math.rad(-10), yawAng * ((r.cx < 0) and 1 or 1) + sway * ((r.cx < 0) and 1 or -1), 0)
                        r.part.CFrame = B * r.rel
                    end
                    for _, m in ipairs(marks) do
                        local isDown = m.down() and true or false
                        m.rec.part.Color = isDown and LIT or m.rec.base
                        m.cs.Color = isDown and LIT or Color3.new(1, 1, 1)
                        m.cs.Transparency = isDown and 0 or 0.7
                        m.t2.Text = m.get()
                        local px, py = proj(m.rec.part.Position)
                        if px then
                            m.dot.Position = UDim2.fromOffset(px, py)
                            local a, b = m.cardPos, Vector2.new(px, py)
                            local d = b - a
                            m.ln.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
                            m.ln.Size = UDim2.fromOffset(d.Magnitude, 2)
                            m.ln.Rotation = math.deg(math.atan2(d.Y, d.X))
                            m.ln.BackgroundColor3 = isDown and LIT or Color3.new(1, 1, 1)
                        end
                    end
                end)

                -- ===== page 3: key map + profiles + compatibility =====
                local P3 = pages[3]
                lbl(P3, "Controller buttons -> keys", 20, 90, 300, 18, 13)
                note(P3, "Click a button, then press the key you want. Triggers stay on the mouse (left click = right trigger, right click = left trigger).", 20, 112, 330, 44, 10)
                local NAMES = { { "R1", "RIGHT GRIP" }, { "L1", "LEFT GRIP" }, { "A", "A BUTTON" }, { "B", "B BUTTON" }, { "X", "X BUTTON" }, { "Y", "Y BUTTON" } }
                for i, nm in ipairs(NAMES) do
                    local col, row = (i - 1) % 2, math.floor((i - 1) / 2)
                    local b = mkBtn(P3, "", 20 + col * 170, 160 + row * 36, 164, 30, 11)
                    local function paint() b.Text = nm[2] .. ":  " .. U.opt.keymap[nm[1]] end
                    paint()
                    b.Activated:Connect(function()
                        b.Text = "press a key..."
                        U.capture = function(kc)
                            if kc ~= Enum.KeyCode.Escape and kc ~= Enum.KeyCode.Unknown then U.opt.keymap[nm[1]] = kc.Name; U.rebuildMap(); U.touch() end
                            paint()
                        end
                    end)
                end
                local resetKeys = mkBtn(P3, "RESET KEYS", 20, 274, 334, 28, 11)
                resetKeys.Activated:Connect(function()
                    U.opt.keymap = { R1 = "E", L1 = "Q", A = "F", B = "G", X = "R", Y = "T" }
                    U.rebuildMap(); U.touch()
                    resetKeys.Text = "RESET - reopen this page to see the keys"
                    task.delay(2, function() if resetKeys.Parent then resetKeys.Text = "RESET KEYS" end end)
                end)

                lbl(P3, "Profile for this game", 370, 90, 300, 18, 13)
                local profLbl = note(P3, "", 370, 112, 310, 32, 11)
