    KB.reserved = { Escape = true, Unknown = true, F7 = true }
    local KB_NAMES = { One = "1", Two = "2", Three = "3", Four = "4", Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9", Zero = "0",
                       Equals = "=", Minus = "-", Plus = "+", Space = "Space", Comma = ",", Period = ".", Slash = "/", Backquote = "`",
                       LeftBracket = "[", RightBracket = "]", Semicolon = ";", Quote = "'", Backslash = "|", Return = "Enter" }
    function KB.label(n)
        if not n then return "-" end
        if KB_NAMES[n] then return KB_NAMES[n] end
        local pad = string.match(n, "^Keypad(.+)$")
        if pad then return "Num " .. (KB_NAMES[pad] or pad) end
        return (string.gsub(n, "(%l)(%u)", "%1 %2"))
    end
    function KB.rebuild()
        KB.map, KB.blocked, KB.byDef = {}, {}, {}
        local owned = {}
        for _, a in ipairs(KB.actions) do
            local c = KB.cur[a[1]]
            owned[c] = true
            KB.byDef[a[3]] = c
            if c ~= a[3] then
                local ok1, ce = pcall(function() return Enum.KeyCode[c] end)
                local ok2, de = pcall(function() return Enum.KeyCode[a[3]] end)
                if ok1 and ok2 and ce and de then KB.map[ce] = de end
            end
        end
        for _, a in ipairs(KB.actions) do
            if not owned[a[3]] then
                local ok, de = pcall(function() return Enum.KeyCode[a[3]] end)
                if ok and de then KB.blocked[de] = true end
            end
        end
    end
    function KB.save()
        pcall(function()
            if writefile then writefile(KB.file, game:GetService("HttpService"):JSONEncode(KB.cur)) end
        end)
    end
    function KB.load()
        pcall(function()
            if not (isfile and readfile and isfile(KB.file)) then return end
            local t = game:GetService("HttpService"):JSONDecode(readfile(KB.file))
            if type(t) ~= "table" then return end
            local new = {}
            for id, a in pairs(KB.byId) do
                local v = t[id]
                local okk = type(v) == "string" and pcall(function() return Enum.KeyCode[v] end) and not KB.reserved[v]
                new[id] = okk and v or KB.cur[id]
            end
            local seen = {}
            for _, a in ipairs(KB.actions) do
                if seen[new[a[1]]] then return end   -- a damaged file: keep the default keys
                seen[new[a[1]]] = true
            end
            KB.cur = new
        end)
    end
    function KB.set(id, key)   -- returns ok, message
        local a = KB.byId[id]
        if not a then return false, "Unknown action." end
        if KB.reserved[key] or key == S.keyPause or key == S.keyStop or key == S.keyPlay then return false, KB.label(key) .. " is reserved by the script." end
        local okk = pcall(function() return Enum.KeyCode[key] end)
        if not okk then return false, "That key can't be used." end
        local swapped, old = nil, KB.cur[id]
        for _, b in ipairs(KB.actions) do
            if b[1] ~= id and KB.cur[b[1]] == key then
                KB.cur[b[1]] = KB.cur[id]   -- the key was used by another action: the two swap keys
                swapped = b[2]
                break
            end
        end
        KB.cur[id] = key
        KB.rebuild()
        KB.save()
        return true, a[2] .. " = " .. KB.label(key) .. (swapped and ("  (" .. swapped .. " now uses " .. KB.label(old) .. ")") or "")
    end
    function KB.resetAll()
        for _, a in ipairs(KB.actions) do KB.cur[a[1]] = a[3] end
        KB.rebuild()
        KB.save()
    end
    function KB.down(code)   -- is the (possibly moved) key for this action held?
        local n = KB.byDef[code.Name] or code.Name
        local ok, kc = pcall(function() return Enum.KeyCode[n] end)
        return ok and kc and UIS:IsKeyDown(kc) or false
    end
    function KB.xlate(io)    -- what the script should believe was pressed
        if io.UserInputType ~= Enum.UserInputType.Keyboard then return io end
        local kc = io.KeyCode
        local to
        if KB.capture then to = Enum.KeyCode.Unknown
        elseif KB.map[kc] then to = KB.map[kc]
        elseif KB.blocked[kc] then to = Enum.KeyCode.Unknown
        else return io end
        return { UserInputType = io.UserInputType, KeyCode = to, UserInputState = io.UserInputState, Position = io.Position, Delta = io.Delta }
    end
    KB.load()
    KB.rebuild()
