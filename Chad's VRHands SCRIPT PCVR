                pill.Position = UDim2.new(0.5, 0, 0, 5)
                pill.Size = UDim2.fromOffset(40, 4)
                pill.BackgroundColor3 = WHITE
                pill.BackgroundTransparency = 0.55
                pill.BorderSizePixel = 0
                pill.ZIndex = 9
                pill.Active = false
                pill.Parent = grip
                corner(pill, 2)
                grip.MouseEnter:Connect(function() tw(pill, 0.2, { BackgroundTransparency = 0.1, Size = UDim2.fromOffset(54, 4) }) end)
                grip.MouseLeave:Connect(function() tw(pill, 0.25, { BackgroundTransparency = 0.55, Size = UDim2.fromOffset(40, 4) }) end)
                grip.InputBegan:Connect(function(input)
                    if not isPress(input) then return end
                    local from = sp(input)
                    local ox, oy = ent.x, ent.y
                    tw(pill, 0.1, { BackgroundTransparency = 0 })
                    local conns = {}
                    local held = true
                    local tx, ty = ent.x, ent.y
                    local function stop()
                        for _, c in ipairs(conns) do c:Disconnect() end
                        conns = {}
                    end
                    local function release()
                        if not held then return end
                        held = false
                        tw(pill, 0.25, { BackgroundTransparency = 0.55 })
                    end
                    conns[1] = RunService.RenderStepped:Connect(function(dt)
                        if held then
                            local d = (sp(input) - from) / math.max(fit.Scale, 0.01)
                            -- the target is clamped (never refused), so a fast drag slides along the window border instead of stopping
                            tx, ty = clampXY(ox + d.X, oy + d.Y)
                        end
                        -- ease toward the target so the panel glides instead of jumping
                        local a = 1 - math.exp(-dt * 30)
                        local nx = ent.x + (tx - ent.x) * a
                        local ny = ent.y + (ty - ent.y) * a
                        if not held and math.abs(tx - nx) + math.abs(ty - ny) < 0.3 then
                            moveTo(tx, ty)
                            stop()
                        else
                            moveTo(nx, ny)
                        end
                    end)
                    conns[2] = UIS.InputEnded:Connect(function(io) if io == input then release() end end)
                    conns[3] = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then release() end
                    end)
                end)

