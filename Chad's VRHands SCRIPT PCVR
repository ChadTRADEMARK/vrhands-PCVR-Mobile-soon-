            -- ---------- GESTURE STUDIO (3D hand preview, per-hand finger + position + rotation editor, two-hand gestures, animations) ----------
            -- The game gives each hand THREE finger controls: Thumb, Index finger, and "Other fingers" (middle / ring / pinky curl
            -- together), so those are what the finger sliders set. Each hand can also be placed and rotated freely (X / Y / Reach,
            -- Turn / Tilt / Roll). A gesture is BOTH hands at once, so two-hand shapes like a heart are just two matching hands.
            -- FLIP OFF: a closed fist raised in front of you, palm toward you (back of the hand toward whoever you face), middle finger up.
            -- pitch 1.45 stands the fingers up, roll 3.14 turns the palm round to face you. mid = 0 is the middle finger straight, 1 = curled.
            local UP, TURN = 1.45, 3.14
            local function HAND(x, y, reach, pitch, roll, mid)
                return { fist = 1, index = 1, thumb = 0.2, mid = mid, ring = 1, pinky = 1, x = x, y = y, reach = reach, yaw = 0, pitch = pitch, roll = roll }
            end
            local function BOTH(y, reach, pitch, roll, mid)   -- same pose for both hands, mirrored sideways
                return { L = HAND(0.14, y, reach, pitch, roll, mid), R = HAND(-0.14, y, reach, pitch, roll, mid) }
            end
            local FLIP_REST   = BOTH(-0.1, 1.8, 0, 0, 1)        -- relaxed fists
