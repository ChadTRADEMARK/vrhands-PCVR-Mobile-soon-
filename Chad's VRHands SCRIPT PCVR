-- Easter moves every year: this is the standard calendar rule for the date
local function easterDate(Y)
    local a, b, c = Y % 19, Y // 100, Y % 100
    local d, e = b // 4, b % 4
    local f = (b + 8) // 25
    local g = (b - f + 1) // 3
    local h = (19 * a + b - d - g + 15) % 30
    local i, k = c // 4, c % 4
    local l = (32 + 2 * e + 2 * i - h - k) % 7
    local m = (a + 11 * h + 22 * l) // 451
    local month = (h + l - 7 * m + 114) // 31
    local day = ((h + l - 7 * m + 114) % 31) + 1
    return month, day
end
local function xmasDayNum(y, m, d) return math.floor(os.time({ year = y, month = m, day = d, hour = 12 }) / 86400 + 0.5) end
-- which holiday is within its 10-day run-up (or is today); the nearest one wins when two overlap
function Xmas.today()
    local t = os.date("*t")
    local today = xmasDayNum(t.year, t.month, t.day)
    local best, bestUntil, bestPri
    local function consider(id, y, m, d, pri)
        local u = xmasDayNum(y, m, d) - today
        if u >= 0 and u <= 10 and (not best or u < bestUntil or (u == bestUntil and pri < bestPri)) then best, bestUntil, bestPri = id, u, pri end
    end
    for y = t.year, t.year + 1 do
        consider("christmas", y, 12, 25, 1)
        consider("halloween", y, 10, 31, 2)
        consider("nye", y, 12, 31, 3)
        consider("nyd", y, 1, 1, 4)
        local em, ed = easterDate(y)
        consider("easter", y, em, ed, 5)
    end
    return best, bestUntil
end
