            -- ---------- horizontal slider helper ----------
            -- onSet(f, done): f is 0..1, done is true when the finger / mouse lets go
            local function hslider(parent, x, y, w, initF, rainbow, onSet)
                local track = Instance.new("Frame")
                track.Position = UDim2.fromOffset(x, y)
                track.Size = UDim2.fromOffset(w, 12)
                track.BackgroundColor3 = Color3.new(1, 1, 1)
                track.BackgroundTransparency = rainbow and 0 or 0.8
                track.BorderSizePixel = 0
                track.Parent = parent
                corner(track, 6)
                if rainbow then
                    track:SetAttribute("tc", true)   -- keep the rainbow un-themed
                    local kp = {}
                    for i = 0, 6 do kp[#kp + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.85, 1)) end
                    local gr = Instance.new("UIGradient")
                    gr.Color = ColorSequence.new(kp)
                    gr.Parent = track
                end
                local thumb = Instance.new("Frame")
                thumb.AnchorPoint = Vector2.new(0.5, 0.5)
                thumb.Position = UDim2.new(initF, 0, 0.5, 0)
                thumb.Size = UDim2.fromOffset(22, 22)
                thumb.BackgroundColor3 = WHITE
                thumb.BorderSizePixel = 0
                thumb.ZIndex = 3
                thumb.Parent = track
                corner(thumb, 11)
                stroke(thumb, PINK, 2, 0)

                local hit = Instance.new("TextButton")
                hit.Text = ""
                hit.BackgroundTransparency = 1
                hit.Position = UDim2.fromOffset(x - 10, y - 12)
                hit.Size = UDim2.fromOffset(w + 20, 36)
                hit.ZIndex = 6
                hit.Parent = parent
                hit.InputBegan:Connect(function(input)
                    if not isPress(input) then return end
                    local lastF = initF
                    local function apply()
                        lastF = math.clamp((sp(input).X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                        thumb.Position = UDim2.new(lastF, 0, 0.5, 0)
                        onSet(lastF, false)
                    end
                    apply()
                    local conns = {}
                    local function stop()
                        if #conns == 0 then return end
                        for _, c in ipairs(conns) do c:Disconnect() end
                        conns = {}
                        onSet(lastF, true)
                    end
                    conns[1] = RunService.RenderStepped:Connect(apply)
                    conns[2] = UIS.InputEnded:Connect(function(io) if io == input then stop() end end)
                    conns[3] = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then stop() end
                    end)
                end)
                return track, thumb
            end

