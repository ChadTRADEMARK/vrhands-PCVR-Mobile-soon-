                            local ex = getJson("https://users.roblox.com/v1/usernames/users", "POST", HttpService:JSONEncode({ usernames = { q }, excludeBannedUsers = false }))
                            for _, u in ipairs(ex and ex.data or {}) do
                                if u.id and not seen[u.id] then seen[u.id] = true; found[#found + 1] = { id = u.id, name = u.name, displayName = u.displayName } end
                            end
                        end
                        local sr, why = getJson("https://users.roblox.com/v1/users/search?keyword=" .. HttpService:UrlEncode(q) .. "&limit=10")
                        for _, u in ipairs(sr and sr.data or {}) do
