                -- everything below can be hidden with the Hide button
                local main = Instance.new("Frame")
                main.Name = "Main"
                main.BackgroundTransparency = 1
                main.Size = UDim2.fromScale(1, 1)
                main.ZIndex = 2
                main.Parent = root

                -- ---------- generic joystick ----------
                -- onChange(v, phase, raw)
                --   v     : -1..1 with a dead zone, clamped to the circle (used by the move stick)
                --   phase : "begin" | "move" | "end"
                --   raw   : finger offset from the stick centre / radius, NOT clamped
                --           (used by the hand sticks so you can drag past the circle)
                -- The knob always sits under your finger / mouse while you hold.
                -- Returns the base frame and a release() function.
                local function makeStick(name, anchor, pos, diameter, tint, label, onChange)
                    local base = Instance.new("Frame")
                    base.Name = name
                    base.AnchorPoint = anchor
                    base.Position = pos
                    base.Size = UDim2.fromOffset(diameter, diameter)
                    base.BackgroundColor3 = IDLE
                    base.BackgroundTransparency = 0.45
                    base.Active = true
                    base.ZIndex = 3
                    base.Parent = main
                    local bc = Instance.new("UICorner")
                    bc.CornerRadius = UDim.new(1, 0)
                    bc.Parent = base
                    local bs = Instance.new("UIStroke")
                    bs.Color = tint
                    bs.Thickness = 2
                    bs.Transparency = 0.25
                    bs.Parent = base

                    if label then
                        local t = Instance.new("TextLabel")
                        t.BackgroundTransparency = 1
                        t.AnchorPoint = Vector2.new(0.5, 1)
                        t.Position = UDim2.new(0.5, 0, 0, -2)
                        t.Size = UDim2.fromOffset(diameter, px(16))
                        t.Font = Enum.Font.GothamBold
                        t.TextSize = px(11)
                        t.TextColor3 = tint
                        t.Text = label
                        t.Active = false
                        t.ZIndex = 3
                        t.Parent = base
                    end

                    local knobSize = math.floor(diameter * 0.43)
                    local knob = Instance.new("Frame")
                    knob.AnchorPoint = Vector2.new(0.5, 0.5)
                    knob.Position = UDim2.fromScale(0.5, 0.5)
                    knob.Size = UDim2.fromOffset(knobSize, knobSize)
                    knob.BackgroundColor3 = tint
                    knob.BackgroundTransparency = 0.2
                    knob.Active = false
                    knob.ZIndex = 4
                    knob.Parent = base
                    local kc = Instance.new("UICorner")
                    kc.CornerRadius = UDim.new(1, 0)
                    kc.Parent = knob

                    local radius = diameter / 2
                    local travel = radius - knobSize / 2 + 4
                    local current = nil
                    local conns = {}

                    local function update(phase)
                        if not current then return end
                        local c = base.AbsolutePosition + base.AbsoluteSize / 2
                        local raw = (screenPos(current) - c) / math.max(base.AbsoluteSize.X / 2, 1)
                        local v = raw.Magnitude > 1 and raw.Unit or raw
                        knob.Position = UDim2.new(0.5, v.X * travel, 0.5, v.Y * travel)  -- knob follows the finger
                        if v.Magnitude < 0.15 then v = Vector2.zero end                   -- dead zone
                        onChange(v, phase, raw)
                    end

                    local function release()
                        if not current then return end
                        current = nil
                        for _, cn in ipairs(conns) do cn:Disconnect() end
                        conns = {}
                        knob.Position = UDim2.fromScale(0.5, 0.5)
                        onChange(Vector2.zero, "end", nil)
                    end

                    base.InputBegan:Connect(function(input)
                        if current or not isPress(input) then return end
                        current = input
                        update("begin")

                        -- Poll every frame: works for touch AND mouse (a mouse
                        -- button input never fires Changed with new positions).
                        conns[#conns + 1] = RunService.RenderStepped:Connect(function()
                            update("move")
                        end)
                        conns[#conns + 1] = UIS.InputEnded:Connect(function(io)
                            if io == input then release() end
                        end)
                        conns[#conns + 1] = input.Changed:Connect(function()
                            if input.UserInputState == Enum.UserInputState.End
                               or input.UserInputState == Enum.UserInputState.Cancel then
                                release()
                            end
                        end)
                    end)

                    return base, release
                end

                -- ---------- movement joystick (WASD) ----------
                local moveSize = px(122)
                local moveBase = makeStick("MoveStick", Vector2.new(0, 1),
                    UDim2.new(0, px(22), 1, -px(22)), moveSize, Color3.new(1, 1, 1), "MOVE",
                    function(v) touch.move = v end)

                -- ---------- fly up / down (Space / Shift) ----------
                local flyX = px(22) + moveSize + px(8)
                local upBtn = mkBtn(main, "UP",   Vector2.new(0, 1), UDim2.new(0, flyX, 1, -px(22) - px(54)), UDim2.fromOffset(px(54), px(52)))
                local dnBtn = mkBtn(main, "DOWN", Vector2.new(0, 1), UDim2.new(0, flyX, 1, -px(22)),         UDim2.fromOffset(px(54), px(52)))
                upBtn.ZIndex, dnBtn.ZIndex = 3, 3
                bindHold(upBtn, function() keys[Enum.KeyCode.Space] = true end,
                                function() keys[Enum.KeyCode.Space] = false end)
                bindHold(dnBtn, function() keys[Enum.KeyCode.LeftShift] = true end,
                                function() keys[Enum.KeyCode.LeftShift] = false end)

                -- ---------- grab + pinch (LMB / RMB, Q / E) ----------
                local gW, gH, gap = px(78), px(78), px(8)
                local grabR  = mkBtn(main, "GRAB\nRIGHT", Vector2.new(1, 1), UDim2.new(1, -px(20), 1, -px(20)), UDim2.fromOffset(gW, gH))
                local grabL  = mkBtn(main, "GRAB\nLEFT",  Vector2.new(1, 1), UDim2.new(1, -px(20) - gW - gap, 1, -px(20)), UDim2.fromOffset(gW, gH))
                local pinchR = mkBtn(main, "PINCH R", Vector2.new(1, 1), UDim2.new(1, -px(20), 1, -px(20) - gH - gap), UDim2.fromOffset(gW, px(46)))
                local pinchL = mkBtn(main, "PINCH L", Vector2.new(1, 1), UDim2.new(1, -px(20) - gW - gap, 1, -px(20) - gH - gap), UDim2.fromOffset(gW, px(46)))
                for _, b in ipairs({ grabR, grabL, pinchR, pinchL }) do b.ZIndex = 3 end
                bindHold(grabL, function() mev(Enum.UserInputType.MouseButton1, true) end,
                                function() mev(Enum.UserInputType.MouseButton1, false) end)
                bindHold(grabR, function() mev(Enum.UserInputType.MouseButton2, true) end,
                                function() mev(Enum.UserInputType.MouseButton2, false) end)
                bindHold(pinchL, function() kev(Enum.KeyCode.Q, true) end,
                                 function() kev(Enum.KeyCode.Q, false) end)
                bindHold(pinchR, function() kev(Enum.KeyCode.E, true) end,
                                 function() kev(Enum.KeyCode.E, false) end)

                -- ---------- HAND JOYSTICKS (only visible in Hand Mode) ----------
                -- Left stick moves the LEFT hand, right stick moves the RIGHT hand.
                -- The hand follows your finger / mouse 1:1 while you hold the stick
                -- (even if you drag outside the circle). Let go and the hand stays
                -- where it is; the next press carries on from there with no jump.
                -- Speed is S.handRange.
                local handSize = px(104)
                local lastL, lastR

                local leftHandBase, releaseL = makeStick("LeftHandStick", Vector2.new(0, 1),
                    UDim2.new(0, flyX + px(54) + px(26), 1, -px(22)), handSize, LEFT_C, "LEFT HAND",
                    function(v, phase, raw)
                        if phase == "begin" then
                            lastL = raw
                        elseif phase == "move" and lastL and raw then
                            local d = raw - lastL
                            lastL = raw
                            S.handLX = math.clamp(S.handLX + d.X * S.handRange, -4, 4)
                            S.handLY = math.clamp(S.handLY - d.Y * S.handRange, -4, 4)
                        else
                            lastL = nil
                        end
                    end)

                local rightHandBase, releaseR = makeStick("RightHandStick", Vector2.new(1, 1),
                    UDim2.new(1, -(px(20) + gW * 2 + gap + px(26)), 1, -px(22)), handSize, RIGHT_C, "RIGHT HAND",
                    function(v, phase, raw)
                        if phase == "begin" then
                            lastR = raw
                        elseif phase == "move" and lastR and raw then
                            local d = raw - lastR
                            lastR = raw
                            S.handRX = math.clamp(S.handRX + d.X * S.handRange, -4, 4)
                            S.handRY = math.clamp(S.handRY - d.Y * S.handRange, -4, 4)
                        else
                            lastR = nil
                        end
                    end)
                leftHandBase.Visible = false
                rightHandBase.Visible = false

                -- ---------- "More" panel: poses, zoom, size, reach, slow ----------
                local more = Instance.new("ScrollingFrame")
                more.Name = "More"
                more.AnchorPoint = Vector2.new(1, 1)
                more.Position = UDim2.new(1, -px(20), 1, -px(20) - gH - px(46) - gap * 2 - px(6))
                more.Size = UDim2.fromOffset(px(3 * 84 + 2 * 6 + 8), px(150))
                more.BackgroundTransparency = 1
                more.BorderSizePixel = 0
                more.ScrollBarThickness = px(4)
                more.CanvasSize = UDim2.new()
                more.AutomaticCanvasSize = Enum.AutomaticSize.Y
                more.ScrollingDirection = Enum.ScrollingDirection.Y
                more.Visible = false
                local moreScale = Instance.new("UIScale")
                moreScale.Parent = more
                more.ZIndex = 5
                more.Parent = root
                local grid = Instance.new("UIGridLayout")
                grid.CellSize = UDim2.fromOffset(px(84), px(36))
                grid.CellPadding = UDim2.fromOffset(px(6), px(6))
                grid.SortOrder = Enum.SortOrder.LayoutOrder
                grid.HorizontalAlignment = Enum.HorizontalAlignment.Right
                grid.Parent = more

                local order = 0
                local function moreBtn(text)
                    order += 1
                    local b = Instance.new("TextButton")
                    b.Text = text
                    b.LayoutOrder = order
                    style(b)
                    b.TextSize = px(12)
                    b.ZIndex = 6
                    b.Parent = more
                    return b
                end

                local poseBtns = {}
                local function poseBtn(text, kc)
                    local b = moreBtn(text)
                    bindTap(b, function() togglePose(kc) end)
                    poseBtns[#poseBtns + 1] = { b = b, kc = kc }
                end
                poseBtn("L Point", Enum.KeyCode.R)
                poseBtn("L Thumb", Enum.KeyCode.F)
                poseBtn("L Poke",  Enum.KeyCode.One)
                poseBtn("R Point", Enum.KeyCode.T)
                poseBtn("R Thumb", Enum.KeyCode.G)
                poseBtn("R Poke",  Enum.KeyCode.Three)

                local zoomInB   = moreBtn("Zoom In")
                local zoomOutB  = moreBtn("Zoom Out")
                local slowB     = moreBtn("Slow")
                local sizeUpB   = moreBtn("Size +")
                local sizeDnB   = moreBtn("Size -")
                local reachInB  = moreBtn("Reach +")
                local reachOutB = moreBtn("Reach -")
                local hudB      = moreBtn("PC Menu")

                bindHold(zoomInB,  function() touch.zoomIn = true end,  function() touch.zoomIn = false end)
                bindHold(zoomOutB, function() touch.zoomOut = true end, function() touch.zoomOut = false end)
                bindTap(slowB, function()
                    keys[Enum.KeyCode.LeftControl] = not keys[Enum.KeyCode.LeftControl]
                end)
                bindRepeat(sizeUpB, function() setScale(S.scale + 1) end)
                bindRepeat(sizeDnB, function() setScale(S.scale - 1) end)
                bindHold(reachInB,  function() touch.reachDir = 1 end,  function() touch.reachDir = 0 end)
                bindHold(reachOutB, function() touch.reachDir = -1 end, function() touch.reachDir = 0 end)
                bindTap(hudB, function()
                    -- show / hide the PC text menu on demand
                    _G.NoVR_HUD_Visible = not _G.NoVR_HUD_Visible
                    if hudLabel then hudLabel.Visible = _G.NoVR_HUD_Visible end
                end)

                -- ---------- MOBILE CONTROLS MENU ----------
                -- Shows only while Mobile mode (the M circle) is on. The PC menu is
                -- hidden meanwhile. Drag the MOVE bar to move it, the SIZE corner to
                -- resize it. It never blocks touches except on those two handles.
                local MW, MH, BAR = 330, 350, 34
                local menu = Instance.new("Frame")
                menu.Name = "ControlsMenu"
                menu.BackgroundTransparency = 1
                menu.Active = false
                menu.ZIndex = 4
                menu.Size = UDim2.fromOffset(MW, MH + BAR)
