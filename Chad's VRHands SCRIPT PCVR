                        if mirror then S.poseMirror(side) end
                        val.Text = fmt(f, v)
                        if f[2] == "fist" then refreshRows() end
                    end)
                    rows[#rows + 1] = { f = f, val = val, thumb = thumb }
                end
                tabL.Activated:Connect(function() side = "L"; refreshRows() end)
                tabR.Activated:Connect(function() side = "R"; refreshRows() end)
                lbl(P1, "View angle", 20, 340, 150, 14, 11, MUTED)
                hslider(P1, 20, 366, 310, orbit / 6.2832, false, function(fr) orbit = fr * 6.2832; draw() end)
                local mirB = mkBtn(P1, "MIRROR: OFF", 20, 394, 150, 28, 11)
                mirB.Activated:Connect(function()
                    mirror = not mirror
