            -- ---------- EMULATOR panel (camera, hands, 3D VR controllers, key mapping, per-game profiles, compatibility check) ----------
            local function openEmu(startPage)
                local p, ent = overlay("emu", 80, 10, 700, 520, "Emulator", "VR Emulator")
