    -- ============ AUTO SAVE ============
    -- Settings and your last changes (hands, reach, camera view, crosshair, theme ...) are written to
    -- NoVR_Settings.json (executor workspace folder) a moment after they change, and loaded at the next start.
    -- Delete that file to go back to the defaults.
    local SAVE_FILE = "NoVR_Settings.json"
    -- ===== key / usage time (Profile > STATUS > KEY ACCESS) =====
    -- The key service's loader doesn't tell the script when the key ends, so the countdown only shows if the loader (or you) sets
    --   getgenv().NOVR_KEY_EXPIRES = <unix seconds when the key ends>   (or "lifetime")
    -- before this script runs. The "using the script for" counters always work: this session, and the total across sessions.
    do
        local U = { start = os.time(), base = 0, first = os.time() }
        S.usage = U
        local FILE = "NoVR_Usage.json"
        local HS = game:GetService("HttpService")
        if type(readfile) == "function" and type(isfile) == "function" then
            local ok, raw = pcall(function() return isfile(FILE) and readfile(FILE) or nil end)
            if ok and type(raw) == "string" then
                local okd, d = pcall(HS.JSONDecode, HS, raw)
                if okd and type(d) == "table" then
                    if type(d.total) == "number" and d.total >= 0 and d.total < 1e9 then U.base = d.total end
                    if type(d.first) == "number" and d.first > 0 then U.first = d.first end
                end
            end
        end
        function U.session() return math.max(os.time() - U.start, 0) end
        function U.total() return U.base + U.session() end
        function U.expires()   -- unix seconds, "lifetime", or nil when nothing was provided
            local env = (getgenv and getgenv()) or _G
            local v = env.NOVR_KEY_EXPIRES
            if type(v) == "string" then
                if string.lower(v) == "lifetime" then return "lifetime" end
                v = tonumber(v)
            end
            if type(v) ~= "number" or v ~= v then return nil end
            if v <= 0 or v == math.huge then return "lifetime" end
            if v > 1e12 then v = v / 1000 end   -- milliseconds
            return v
        end
        function U.fmt(sec)
            sec = math.max(math.floor(sec), 0)
            local d, h, m, s = sec // 86400, (sec % 86400) // 3600, (sec % 3600) // 60, sec % 60
            if d > 0 then return string.format("%dd %02dh %02dm %02ds", d, h, m, s) end
            return string.format("%dh %02dm %02ds", h, m, s)
        end
        local function save()
            if type(writefile) == "function" then
                pcall(function() writefile(FILE, HS:JSONEncode({ total = U.total(), first = U.first })) end)
            end
        end
        task.spawn(function()
            while true do
                task.wait(30)
                save()
            end
        end)
    end

    local S_KEYS = {
        "scale", "sens", "moveK", "slowFactor", "tpDist", "spread", "height", "handSens", "aimSens", "handRange",
        "reachL", "reachR", "handLX", "handLY", "handRX", "handRY",
        "aimLYaw", "aimLPitch", "aimRYaw", "aimRPitch", "aimLRoll", "aimRRoll",
        "thirdPerson", "camView", "handMode", "aimMode", "hudZoom", "keyPause", "keyStop", "keyPlay",
    }
    local Save = { last = nil, ok = (type(writefile) == "function" and type(readfile) == "function") }
    function Save.snapshot()
        local d = { s = {}, xh = {}, theme = { hue = Theme.hue, size = Theme.size }, panels = S.panelSize, pscale = S.panelScale, bg = S.bg, favs = S.favs, bar = S.bar, pop = S.pop, ui = S.ui, chat = S.chat, live = S.live }
        for _, k in ipairs(S_KEYS) do d.s[k] = S[k] end
        for k, v in pairs(XH) do
            if k ~= "dirty" then
                if typeof(v) == "Color3" then d.xh[k] = { v.R, v.G, v.B } else d.xh[k] = v end
            end
        end
        return d
    end
    function Save.load()
        if not Save.ok then return end
        local okf, raw = pcall(function() return isfile and isfile(SAVE_FILE) and readfile(SAVE_FILE) or nil end)
        if not (okf and type(raw) == "string" and #raw > 2) then return end
        local HttpService = game:GetService("HttpService")
        local okd, d = pcall(HttpService.JSONDecode, HttpService, raw)
        if not (okd and type(d) == "table") then return end
        if type(d.s) == "table" then
            for _, k in ipairs(S_KEYS) do
                local v = d.s[k]
                if v ~= nil and type(v) == type(S[k]) then
                    if type(v) ~= "number" or (v == v and math.abs(v) < 1e7) then S[k] = v end
                end
            end
            local valid = false
            for _, n in ipairs(S.CAM_VIEWS) do if n == S.camView then valid = true end end
            if not valid then S.camView = "Normal" end
        end
        if type(d.xh) == "table" then
            for k, v in pairs(XH) do
                local sv = d.xh[k]
                if k ~= "dirty" and sv ~= nil then
                    if typeof(v) == "Color3" then
                        if type(sv) == "table" and type(sv[1]) == "number" and type(sv[2]) == "number" and type(sv[3]) == "number" then
                            XH[k] = Color3.new(math.clamp(sv[1], 0, 1), math.clamp(sv[2], 0, 1), math.clamp(sv[3], 0, 1))
                        end
                    elseif type(sv) == type(v) then
                        XH[k] = sv
                    end
                end
            end
            XH.dirty = true
        end
        if type(d.bg) == "table" then
            local b = d.bg
            if type(b.src) == "string" and #b.src < 400 then S.bg.src = b.src end
            if b.mode == "Fill" or b.mode == "Fit" or b.mode == "Tile" then S.bg.mode = b.mode end
            if type(b.panelOp) == "number" and b.panelOp >= 0.3 and b.panelOp <= 1 then S.bg.panelOp = b.panelOp end
            if type(b.strength) == "number" and b.strength >= 0 and b.strength <= 1 then S.bg.strength = b.strength end
        end
        if type(d.live) == "table" then
            for _, k in ipairs({ "vis", "share", "inv" }) do
                if type(d.live[k]) == "boolean" then S.live[k] = d.live[k] end
            end
        end
        if type(d.chat) == "table" then
            if type(d.chat.on) == "boolean" then S.chat.on = d.chat.on end
            if type(d.chat.ann) == "boolean" then S.chat.ann = d.chat.ann end
        end
        if type(d.ui) == "table" then
            if type(d.ui.shadow) == "boolean" then S.ui.shadow = d.ui.shadow end
            if type(d.ui.accent) == "boolean" then S.ui.accent = d.ui.accent end
        end
        if type(d.pop) == "table" then
            if type(d.pop.auto) == "boolean" then S.pop.auto = d.pop.auto end
            if type(d.pop.asked) == "boolean" then S.pop.asked = d.pop.asked end
            if type(d.pop.show) == "boolean" then S.pop.show = d.pop.show end
            if type(d.pop.secs) == "number" and d.pop.secs >= 3 and d.pop.secs <= 30 then S.pop.secs = d.pop.secs end
        end
        if type(d.bar) == "table" then
            local b = d.bar
            for _, k in ipairs({ "x", "y", "mx", "my" }) do
                if type(b[k]) == "number" and b[k] == b[k] and b[k] >= 0 and b[k] <= 1 then S.bar[k] = b[k] end
            end
            if type(b.min) == "boolean" then S.bar.min = b.min end
            if type(b.off) == "boolean" then S.bar.off = b.off end
            if type(b.scale) == "number" and b.scale >= 0.6 and b.scale <= 1.3 then S.bar.scale = b.scale end
        end
        if type(d.favs) == "table" then
            for k, v in pairs(d.favs) do
                if type(k) == "string" and #k < 40 and v == true then S.favs[k] = true end
            end
        end
        if type(d.pscale) == "table" then
            for slot, v in pairs(d.pscale) do
                if type(slot) == "string" and type(v) == "number" and v >= 0.6 and v <= 1.5 then S.panelScale[slot] = v end
            end
        end
        if type(d.panels) == "table" then
            for slot, v in pairs(d.panels) do
                if type(slot) == "string" and type(v) == "table" and type(v[1]) == "number" and type(v[2]) == "number"
                   and v[1] > 100 and v[1] < 4000 and v[2] > 100 and v[2] < 4000 then
                    S.panelSize[slot] = { v[1], v[2] }
                end
            end
        end
        if type(d.theme) == "table" then
            pcall(Theme.set, tonumber(d.theme.hue), tonumber(d.theme.size))
        end
        Save.last = raw
        print("[NoVR] loaded saved settings")
    end
    Save.load()
    if U.emu then U.start(lp, S) end
    if Save.ok then
        task.spawn(function()
            local HttpService = game:GetService("HttpService")
            while true do
                task.wait(1.5)
                local okE, raw = pcall(HttpService.JSONEncode, HttpService, Save.snapshot())
                if okE and raw ~= Save.last then
                    if pcall(writefile, SAVE_FILE, raw) then Save.last = raw end
                end
            end
        end)
    end
