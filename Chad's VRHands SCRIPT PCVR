        function S.domeCells()   -- the dome as one honeycomb: the cells of a geodesic sphere (162 of them: 150 hexagons and the 12 corners that have to be pentagons)
            if S.domeCellCache then return S.domeCellCache end
            local t = (1 + math.sqrt(5)) / 2
            local v = {
                Vector3.new(-1, t, 0), Vector3.new(1, t, 0), Vector3.new(-1, -t, 0), Vector3.new(1, -t, 0),
                Vector3.new(0, -1, t), Vector3.new(0, 1, t), Vector3.new(0, -1, -t), Vector3.new(0, 1, -t),
                Vector3.new(t, 0, -1), Vector3.new(t, 0, 1), Vector3.new(-t, 0, -1), Vector3.new(-t, 0, 1),
            }
            for i = 1, #v do v[i] = v[i].Unit end
            local f = { { 1, 12, 6 }, { 1, 6, 2 }, { 1, 2, 8 }, { 1, 8, 11 }, { 1, 11, 12 }, { 2, 6, 10 }, { 6, 12, 5 }, { 12, 11, 3 }, { 11, 8, 7 }, { 8, 2, 9 },
                        { 4, 10, 5 }, { 4, 5, 3 }, { 4, 3, 7 }, { 4, 7, 9 }, { 4, 9, 10 }, { 5, 10, 6 }, { 3, 5, 12 }, { 7, 3, 11 }, { 9, 7, 8 }, { 10, 9, 2 } }
            for _ = 1, 2 do   -- cut every triangle into four, twice
                local cache, nf = {}, {}
                local function mid(a, b)
                    local key = math.min(a, b) * 100000 + math.max(a, b)
                    if not cache[key] then
                        v[#v + 1] = ((v[a] + v[b]) / 2).Unit
                        cache[key] = #v
                    end
                    return cache[key]
                end
                for _, tri in ipairs(f) do
                    local a, b, c = tri[1], tri[2], tri[3]
                    local ab, bc, ca = mid(a, b), mid(b, c), mid(c, a)
                    nf[#nf + 1] = { a, ab, ca }
                    nf[#nf + 1] = { b, bc, ab }
                    nf[#nf + 1] = { c, ca, bc }
                    nf[#nf + 1] = { ab, bc, ca }
                end
                f = nf
            end
            local nb = {}
            for i = 1, #v do nb[i] = {} end
            for _, tri in ipairs(f) do
                for k = 1, 3 do
                    local a, b = tri[k], tri[k % 3 + 1]
                    nb[a][b] = true
                    nb[b][a] = true
                end
            end
            local lists = {}
            for i = 1, #v do
                local list = {}
                for j in pairs(nb[i]) do list[#list + 1] = j end
                lists[i] = list
            end
            local cells = {}
            for i = 1, #v do
                local list = lists[i]
                local r = v[i]
                local sum = 0
                for _, j in ipairs(list) do sum = sum + (v[j] - r).Magnitude end
                local e1 = (math.abs(r.Y) < 0.9 and r:Cross(Vector3.yAxis) or r:Cross(Vector3.xAxis)).Unit
                local e2 = r:Cross(e1)
                local n = #list
                local sx, sy = 0, 0
                for _, j in ipairs(list) do   -- the best turn of the panel: its flat sides face the neighbours (average over all of them)
                    local d = v[j] - r
                    local ang = math.atan2(d:Dot(e2), d:Dot(e1))
                    sx = sx + math.cos(n * ang)
                    sy = sy + math.sin(n * ang)
                end
                local th = math.atan2(sy, sx) / n
                cells[i] = { dir = r, sides = n, dn = sum / n, tan = e1 * math.cos(th) + e2 * math.sin(th) }
            end
            S.domeCellCache = cells
            return cells
        end
        -- ===== SOUNDS: made inside the script (noise, low sweeps) and saved as small wav files, so nothing has to be downloaded =====
        function S.sfxMake(fn, secs, gen, sr0)
            local gca = getcustomasset or getsynasset
            if not (writefile and gca and buffer) then return nil end
            if not (isfile and isfile(fn)) then
                local sr = sr0 or 22050
                local n = math.floor(secs * sr)
                local buf = buffer.create(44 + n * 2)
                buffer.writestring(buf, 0, "RIFF")
                buffer.writeu32(buf, 4, 36 + n * 2)
                buffer.writestring(buf, 8, "WAVEfmt ")
                buffer.writeu32(buf, 16, 16)
                buffer.writeu16(buf, 20, 1)
                buffer.writeu16(buf, 22, 1)
                buffer.writeu32(buf, 24, sr)
                buffer.writeu32(buf, 28, sr * 2)
                buffer.writeu16(buf, 32, 2)
                buffer.writeu16(buf, 34, 16)
                buffer.writestring(buf, 36, "data")
                buffer.writeu32(buf, 40, n * 2)
                local st = { r = Random.new(11) }
                local t0 = os.clock()
                for i = 0, n - 1 do
                    local v = gen(i / sr, i, n, st, sr)
                    buffer.writei16(buf, 44 + i * 2, math.floor(math.clamp(v, -1, 1) * 30000))
                    if i % 512 == 0 and os.clock() - t0 > 0.006 then task.wait() t0 = os.clock() end
                end
                writefile(fn, buffer.tostring(buf))
            end
            local ok, a = pcall(gca, fn)
            if ok and a then return a end
            return nil
        end
