                OPT_DOWN[key] = true
                Opt[key] = false
                pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = OPT_NAME[key], Text = "Unavailable - it could not load. Tap it to try again.", Duration = 4 }) end)
