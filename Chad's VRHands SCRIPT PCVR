                    if not instant then cs.Scale = 0.4; tw(cs, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end
                    root.Visible = false
                else
                    root.Visible = true
                    circ.Visible = false
                    if not instant then
                        local k = fitScale()
                        rs.Scale = k * 0.6
                        tw(rs, 0.45, { Scale = k }, Enum.EasingStyle.Back)
                    end
                end
            end
            -- generic drag: handle moves `fx,fy` (fractions); a press without movement is a click
            local function dragger(handle, getHalf, keyX, keyY, onClick)
                handle.InputBegan:Connect(function(input)
                    if not isPress(input) then return end
                    local start = sp(input)
                    local v = view()
                    local bx, by = (B[keyX] or B.x) * v.X, (B[keyY] or B.y) * v.Y
                    local moved, held = false, true
                    local conns = {}
                    local function done()
                        if not held then return end
                        held = false
                        for _, c in ipairs(conns) do c:Disconnect() end
                        if not moved and onClick then onClick() end
                    end
                    conns[1] = RunService.RenderStepped:Connect(function()
                        if not held then return end
                        local d = sp(input) - start
                        if not moved and d.Magnitude > 6 then moved = true end
                        if moved then
                            local hw, hh = getHalf()
                            local vv = view()
                            local fx, fy = (bx + d.X) / vv.X, (by + d.Y) / vv.Y
                            local nx, ny = clampFrac(fx, fy, hw, hh)
                            B[keyX], B[keyY] = nx / vv.X, ny / vv.Y
                            place()
                        end
                    end)
                    conns[2] = UIS.InputEnded:Connect(function(io) if io == input then done() end end)
                    conns[3] = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then done() end
                    end)
                end)
            end
            local function barHalf() return BW * rs.Scale / 2, BH * rs.Scale / 2 end
            dragger(stats, barHalf, "x", "y")
            dragger(icons, barHalf, "x", "y")
            dragger(circ, function() return 23, 23 end, "mx", "my", function() setMin(false) end)
            xb.Activated:Connect(function()
                if B.mx == nil then B.mx, B.my = B.x, B.y end
                setMin(true)
            end)
            gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(place)
            setMin(B.min == true, true)
            function hudApi.barApply() place(); gui.Enabled = not B.off end
            hudApi.barApply()

            -- ===== live numbers =====
            local frames, acc = 0, 0
            RunService.Heartbeat:Connect(function(dt)
                frames = frames + 1
                acc = acc + dt
            end)
            local netStat
            pcall(function() netStat = game:GetService("Stats").Network.ServerStatsItem["Data Ping"] end)
            local function col(v, good, bad, inv)
                local ok = inv and v <= good or (not inv and v >= good)
                local mid = inv and v <= bad or (not inv and v >= bad)
                return ok and C(150, 255, 205) or (mid and C(255, 220, 120) or C(255, 130, 130))
            end
            while gui.Parent do
                task.wait(0.5)
                if chatDot then chatDot.Visible = hudApi.Chat ~= nil and hudApi.Chat.unread > 0 end
                local fps = acc > 0 and math.floor(frames / acc + 0.5) or 0
                frames, acc = 0, 0
                if root.Visible then
                fpsT.Text = fps .. " fps"
                fpsT.TextColor3 = col(fps, 45, 25, false)
                plT.Text = #Players:GetPlayers() .. "/" .. Players.MaxPlayers
                local pm
                if netStat then local ok, v = pcall(function() return netStat:GetValue() end); if ok and v then pm = math.floor(v + 0.5) end end
                pingT.Text = pm and (pm .. " ms") or "-- ms"
                pingT.TextColor3 = pm and col(pm, 120, 250, true) or WHITE
                end
            end
        end)

        -- always-visible button that opens / closes the start menu
        task.spawn(function()
            local tg = S.mkFollow("NoVR_StartToggle", 101, lp:WaitForChild("PlayerGui"))
            tg.Enabled = false   -- the compact bar (M button) replaces this round button

            local btn = Instance.new("TextButton")
            btn.AnchorPoint = Vector2.new(1, 0)
            btn.Position = UDim2.new(1, -14, 0, 64)
            btn.Size = UDim2.fromOffset(46, 46)
            btn.AutoButtonColor = false
            btn.BackgroundColor3 = C(86, 50, 175)
            btn.BackgroundTransparency = 0.2
            btn.BorderSizePixel = 0
            btn.Text = ""
            btn.Parent = tg
            corner(btn, 23)
            local st = stroke(btn, C(215, 185, 255), 2, 0.3)
            drawIcon(btn, "list")
            local sc = Instance.new("UIScale")
            sc.Parent = btn
            btn.MouseEnter:Connect(function() tw(sc, 0.4, { Scale = 1.1 }, Enum.EasingStyle.Back) end)
            btn.MouseLeave:Connect(function() tw(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end)
            btn.InputBegan:Connect(function(io) if isPress(io) then tw(sc, 0.1, { Scale = 0.9 }) end end)
            btn.InputEnded:Connect(function(io) if isPress(io) then tw(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end end)
            btn.Activated:Connect(function()
                if startGui then closeStart() else openStart() end
            end)
            RunService.Heartbeat:Connect(function()
                local on = startGui ~= nil
                local c = Theme.tint(on and C(186, 98, 255) or C(86, 50, 175))
                if btn:GetAttribute("tc") ~= c then
                    btn:SetAttribute("tc", c)
                    tw(btn, 0.4, { BackgroundColor3 = c }, Enum.EasingStyle.Sine)
                end
            end)
        end)
        function S.domeToggle()   -- Delete (or the Quick row): lock / unlock the dome; opens the menu first if it is closed
            if S.domeLock then S.domeLockSet(false) return end
            if not startGui then openStart() end
            task.delay(0.25, function() S.domeLockSet(true) end)
        end
        UIS.InputBegan:Connect(function(io0)
            local io = (S.KB and S.KB.xlate(io0)) or io0   -- menu / pause keys can be moved in Keybinds
            if UIS:GetFocusedTextBox() then return end
            if io.KeyCode == Enum.KeyCode.Backquote or io.KeyCode == Enum.KeyCode.Pause then   -- pause menu
                if hudApi.isPaused() then hudApi.closePause() else hudApi.openPause() end
                return
            end
            if io.KeyCode == Enum.KeyCode.Escape and hudApi.isPaused() then hudApi.closePause() return end
            local ctrlK = io.KeyCode == Enum.KeyCode.K and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl))
            if io.KeyCode == Enum.KeyCode.Home or ctrlK then
                if startGui then closeStart() else openStart() end
            end
            if io.KeyCode == Enum.KeyCode.Delete then S.domeToggle() end
            if io.KeyCode == Enum.KeyCode.M and S.openGameSettings then S.openGameSettings() end   -- Open / close the game settings (can be moved in Keybinds)
        end)

        -- welcome screen first; START leads into the loading screen. If it fails to build, go straight to loading.
        Boot.close()
        do
            local okG, eG = pcall(showGate)
            if not okG then
                warn("[NoVR] welcome screen failed: " .. tostring(eG))
                pcall(function()
                    local og = lp.PlayerGui:FindFirstChild("NoVR_Gate")
                    if og then og:Destroy() end
                    local ob = Lighting:FindFirstChild("NoVR_GateBlur")
                    if ob then ob:Destroy() end
                end)
                showLoader()
            end
        end
    end

    print("[NoVR] control active.")
end)
]==]

-- The queued copy carries its own source as NOVR_SELF, so the Server Browser / Join Friend buttons can queue
-- the script again before teleporting to a specific server (a plain rejoin would pick a random one).
local function wrapSelf(src)
    return "local NOVR_SELF = " .. string.format("%q", src) .. "\n" .. src
end

if C.queue then
    C.queue(wrapSelf(hrs))
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "No-VR",
            Text = "Rejoining to apply the VR hook. If the script does not come back within ~20 seconds, this executor did not re-run it after the rejoin.",
            Duration = 10,
        })
    end)
    TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
else
    -- no way to carry the script across a teleport, so just run it now
    task.spawn(function()
        local f, err = (C.loadstring or loadstring or load)(wrapSelf(hrs))
        if f then
            local ok, e = pcall(f)
            if not ok then warn("[VR Hands No-VR] " .. tostring(e)) end
        else
            warn("[VR Hands No-VR] load failed: " .. tostring(err))
        end
    end)
end
