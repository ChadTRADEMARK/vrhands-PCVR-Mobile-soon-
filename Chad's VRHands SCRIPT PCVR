-- The queued copy carries its own source as NOVR_SELF, so the Server Browser / Join Friend buttons can queue
-- the script again before teleporting to a specific server (a plain rejoin would pick a random one).
local function wrapSelf(src)
    return "local NOVR_SELF = " .. string.format("%q", src) .. "\n" .. src
end

if C.queue then
    C.queue(wrapSelf(hrs))
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "No-VR",
            Text = "Rejoining to apply the VR hook. If the script does not come back within ~20 seconds, this executor did not re-run it after the rejoin.",
            Duration = 10,
        })
    end)
    TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
else
    -- no way to carry the script across a teleport, so just run it now
    task.spawn(function()
        local f, err = (C.loadstring or loadstring or load)(wrapSelf(hrs))
        if f then
            local ok, e = pcall(f)
            if not ok then warn("[VR Hands No-VR] " .. tostring(e)) end
        else
            warn("[VR Hands No-VR] load failed: " .. tostring(err))
        end
    end)
end
