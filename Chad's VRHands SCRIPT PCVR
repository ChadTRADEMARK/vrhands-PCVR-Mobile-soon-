        -- the cutscene cameras: where the camera is and what it looks at, shot by shot
        function S.cineCamPose(c, age0, now, ro)
            local tI, tE = FX.tImp, FX.tEnd
            local D, up = FX.D, Vector3.yAxis
            local right = D:Cross(up)
            local hp = ro.p
            local center = hp - Vector3.new(0, FLOOR_DY, 0)
            local function sm(x) x = math.clamp(x, 0, 1) return x * x * (3 - 2 * x) end
            local toBH = (c.S0 - center).Unit
            local cf, fov, shake = nil, 60, 0
            if age0 < 5.5 then   -- 1) deep space seen from the ground: a slow pan from the doomed moon across to the black hole
                local u = age0 / 5.5
                cf = CFrame.lookAt(center + Vector3.new(0, 2.5, 0) + right * (-6 + 3 * u), c.moonPos:Lerp(c.S0, sm(u)))
                fov = 62 - 4 * u
            elseif age0 < 11 then   -- 2) over your shoulder, telephoto
                local u = (age0 - 5.5) / 5.5
                cf = CFrame.lookAt(hp - D * 11 + right * (4 - 3 * u) + Vector3.new(0, 1.5 + 0.5 * u, 0), c.S0)
                fov = 48 - 6 * u
            elseif age0 < 19 then   -- 3) a long push in towards the black hole while everything streams into it
                local u = sm((age0 - 11) / 8)
                cf = CFrame.lookAt(center + right * (700 - 250 * u) + Vector3.new(0, 250, 0) + toBH * (900 * u), c.S0)
                fov = 62 - 10 * u
                shake = 0.0012
            elseif age0 < 26 then   -- 4) low on the ground, looking up at it
                local u = (age0 - 19) / 7
                cf = CFrame.lookAt(center + Vector3.new(0, 3, 0) + right * (3 - 3 * u), c.S0)
                fov = 66 + 16 * u
                shake = 0.003 + 0.03 * u * u
            elseif age0 < tI + 3 then   -- 5) your own eyes: the black hole explodes
                local u = (age0 - tI) / 3
                cf = CFrame.lookAt(hp, c.S0)
                fov = 82 + 18 * sm(u)
                shake = 0.05 * math.exp(-(age0 - tI) * 0.6)
            elseif age0 < tE - 4.5 then   -- 6) circling around you while the dome forms
                local u = (age0 - (tI + 3)) / ((tE - 4.5) - (tI + 3))
                local a = math.pi + u * math.pi * 1.3
                local r = 13 + 4 * u
                cf = CFrame.lookAt((hp - up * 1.5) + right * math.cos(a) * r + D * math.sin(a) * r + Vector3.new(0, 2.5 + 2.5 * u, 0), hp - up)
                fov = 55
                c.lastCF = cf
            else   -- 7) glides back into your own view
                local u = sm((age0 - (tE - 4.5)) / 3)
                cf = (c.lastCF or c.home):Lerp(c.home, u)
                fov = 55 + (c.fov0 - 55) * u
                if u >= 1 then S.cineCamRelease(c) return end
            end
            if not FX.quick and age0 < tI then
                local sc, sfv, ssk = S.suckCamPose(c, age0, now)
                if sc then cf, fov, shake = sc, sfv, shake + (ssk or 0) end
            end
            shake = shake + (c.suckShake or 0)
            if shake > 0 then
                cf = cf * CFrame.Angles(math.noise(now * 11, 0.3) * shake, math.noise(now * 13, 7.1) * shake, math.noise(now * 9, 3.3) * shake * 0.6)
            end
            c.camCF, c.camFov = cf, fov
        end
