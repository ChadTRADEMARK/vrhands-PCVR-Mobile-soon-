                local function getJson(url)
                    local body
                    local ok, res = pcall(function() return game:HttpGet(url, true) end)
                    if ok and type(res) == "string" and #res > 0 then body = res end
                    if not body and req then
                        local ok2, r = pcall(req, { Url = url, Method = "GET" })
                        if ok2 and r then
                            if r.StatusCode == 429 then return nil, "rate" end
                            if r.Success or r.StatusCode == 200 then body = r.Body end
                        end
                    end
                    if not body then return nil, "fail" end
                    local ok3, data = pcall(HttpService.JSONDecode, HttpService, body)
                    if not (ok3 and type(data) == "table") then return nil, "fail" end
                    if data.errors then return nil, "rate" end
                    return data
                end

                local function fetchServers(order, pages)
                    local out, cursor = {}, nil
                    for _ = 1, pages do
                        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder="
                            .. order .. "&limit=100" .. (cursor and ("&cursor=" .. cursor) or "")
                        local data, why = getJson(url)
                        if not data then return out, why end
                        for _, sv in ipairs(data.data or {}) do out[#out + 1] = sv end
                        cursor = data.nextPageCursor
                        if not cursor then break end
                        task.wait(0.4)
                    end
                    return out
                end

                -- fast = lowest ping (full servers hidden) | highest = most players (full ones too) | lowest = fewest players
                local function arrange(list, m)
                    local r = {}
                    for _, sv in ipairs(list) do
                        if type(sv) == "table" and sv.id and sv.id ~= game.JobId and tonumber(sv.playing) and tonumber(sv.maxPlayers) then
                            if m ~= "fast" or sv.playing < sv.maxPlayers then r[#r + 1] = sv end
                        end
                    end
                    if m == "fast" then
                        table.sort(r, function(a, b) return (tonumber(a.ping) or 1e9) < (tonumber(b.ping) or 1e9) end)
                    elseif m == "highest" then
                        table.sort(r, function(a, b) return a.playing > b.playing end)
                    else
                        table.sort(r, function(a, b) return a.playing < b.playing end)
                    end
                    while #r > 60 do r[#r] = nil end
                    return r
                end

                local failConn
                local function joinServer(placeId, jobId, label, sameGame)
                    if joining then return end
                    joining = true
                    status.Text = "Joining " .. label .. "..."
