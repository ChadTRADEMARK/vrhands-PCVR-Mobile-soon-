        function S.bhPng(raw, W, H)   -- raw = RGBA bytes with a 0 filter byte in front of every row; stored (uncompressed) deflate keeps the encoder tiny
            local rawLen = H * (1 + W * 4)
            local nblk = math.ceil(rawLen / 65535)
            local zlen = 2 + nblk * 5 + rawLen + 4
            local total = 8 + 25 + 12 + zlen + 12
            local out = buffer.create(total)
            local crcT = S.bhCrcT
            if not crcT then
                crcT = {}
                for n = 0, 255 do
                    local cc = n
                    for _ = 1, 8 do
                        if cc % 2 == 1 then cc = bit32.bxor(bit32.rshift(cc, 1), 0xEDB88320) else cc = bit32.rshift(cc, 1) end
                    end
                    crcT[n] = cc
                end
                S.bhCrcT = crcT
            end
            local function crc(off, len)
                local cc = 0xFFFFFFFF
                for i = off, off + len - 1 do
                    cc = bit32.bxor(crcT[bit32.band(bit32.bxor(cc, buffer.readu8(out, i)), 255)], bit32.rshift(cc, 8))
                end
                return bit32.bxor(cc, 0xFFFFFFFF)
            end
            local function w32be(off, v)
                buffer.writeu8(out, off, bit32.band(bit32.rshift(v, 24), 255))
                buffer.writeu8(out, off + 1, bit32.band(bit32.rshift(v, 16), 255))
                buffer.writeu8(out, off + 2, bit32.band(bit32.rshift(v, 8), 255))
                buffer.writeu8(out, off + 3, bit32.band(v, 255))
            end
            local sig = { 137, 80, 78, 71, 13, 10, 26, 10 }
            for i = 1, 8 do buffer.writeu8(out, i - 1, sig[i]) end
            local o = 8
            w32be(o, 13)
            buffer.writestring(out, o + 4, "IHDR")
            w32be(o + 8, W)
            w32be(o + 12, H)
            buffer.writeu8(out, o + 16, 8)
            buffer.writeu8(out, o + 17, 6)
            buffer.writeu8(out, o + 18, 0)
            buffer.writeu8(out, o + 19, 0)
            buffer.writeu8(out, o + 20, 0)
            w32be(o + 21, crc(o + 4, 17))
            o = o + 25
            w32be(o, zlen)
            buffer.writestring(out, o + 4, "IDAT")
            local z = o + 8
            buffer.writeu8(out, z, 0x78)
            buffer.writeu8(out, z + 1, 0x01)
            local p, src = z + 2, 0
            for bI = 1, nblk do
                local len = math.min(65535, rawLen - src)
                buffer.writeu8(out, p, bI == nblk and 1 or 0)
                buffer.writeu8(out, p + 1, len % 256)
                buffer.writeu8(out, p + 2, math.floor(len / 256))
                buffer.writeu8(out, p + 3, 255 - len % 256)
                buffer.writeu8(out, p + 4, 255 - math.floor(len / 256))
                buffer.copy(out, p + 5, raw, src, len)
                p = p + 5 + len
                src = src + len
            end
            local a1, a2 = 1, 0
            for i = 0, rawLen - 1 do
                a1 = a1 + buffer.readu8(raw, i)
                if a1 >= 65521 then a1 = a1 - 65521 end
                a2 = a2 + a1
                if a2 >= 65521 then a2 = a2 - 65521 end
            end
            w32be(p, a2 * 65536 + a1)
            w32be(o + 8 + zlen, crc(o + 4, 4 + zlen))
            o = o + 12 + zlen
            w32be(o, 0)
            buffer.writestring(out, o + 4, "IEND")
            w32be(o + 8, crc(o + 4, 4))
            return buffer.tostring(out)
        end
