                fetchRole(function(t) if roleL.Parent then roleL.Text = t end end)
                local friendsL = info("Friends", "loading...")
                task.spawn(function()
                    local ok, n = pcall(function()
                        local pages = Players:GetFriendsAsync(lp.UserId)
                        local count = 0
                        while true do
                            count += #pages:GetCurrentPage()
                            if pages.IsFinished then break end
                            pages:AdvanceToNextPageAsync()
                        end
                        return count
                    end)
                    if friendsL.Parent then friendsL.Text = ok and tostring(n) or "unavailable" end
                end)
                local team = lp.Team and lp.Team.Name or "None"
                info("Team", team)

                -- ===== WEB PROFILE (needs the executor's request function) =====
                section("WEB PROFILE")
                local createdL   = info("Created", "loading...")
                local followersL = info("Followers", "loading...")
                local followingL = info("Following", "loading...")
                local descL      = info("About", "loading...")

                task.spawn(function()
                    local HttpService = game:GetService("HttpService")
                    local req = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)

                    if not req then
                        for _, l in ipairs({ createdL, followersL, followingL, descL }) do
                            if l.Parent then l.Text = "needs request()" end
                        end
                        return
                    end

                    local function getJson(url)
                        local ok, res = pcall(req, { Url = url, Method = "GET" })
                        if not ok or not res then return nil end
                        if not (res.Success or res.StatusCode == 200) then return nil end
                        local ok2, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
                        return ok2 and data or nil
                    end

                    local MONTHS = { "Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec" }
                    local function commas(n)
                        local s = tostring(n)
                        while true do
                            local r, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
                            s = r
                            if k == 0 then break end
                        end
                        return s
                    end

                    local base = tostring(lp.UserId)

                    -- created date + description
                    local u = getJson("https://users.roblox.com/v1/users/" .. base)
                    if u then
                        if createdL.Parent then
                            local y, m, d = tostring(u.created or ""):match("(%d+)-(%d+)-(%d+)")
                            createdL.Text = y and (MONTHS[tonumber(m)] .. " " .. tonumber(d) .. ", " .. y) or "unknown"
                        end
                        if descL.Parent then
                            local desc = tostring(u.description or ""):gsub("%s+", " ")
