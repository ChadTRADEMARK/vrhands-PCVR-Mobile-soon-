            -- ===== placement + dragging =====
            local function view() local v = gui.AbsoluteSize; return (v.X > 0 and v or Vector2.new(1280, 720)) end
            local function fitScale() return math.min(0.92 * math.clamp(B.scale or 1, 0.6, 1.3), view().X * 0.94 / (BW + 6)) end
            local function clampFrac(fx, fy, halfW, halfH)
                local v = view()
                local nx = math.clamp(fx * v.X, halfW, math.max(halfW, v.X - halfW))
                local top = 0   -- the whole screen, top edge included   -- same limit as the Mois7 window: never under Roblox's top bar
                local ny = math.clamp(fy * v.Y, top + halfH, math.max(top + halfH, v.Y - halfH))
                return nx, ny
            end
            local function place()
                rs.Scale = fitScale()
                local nx, ny = clampFrac(B.x, B.y, BW * rs.Scale / 2, BH * rs.Scale / 2)
