                local function play(placeId, jobId, label, sameGame)
                    if joining then return end
                    if not placeId then
                        if popMsg then popMsg.Text = "No place id for this game." end
                        return
                    end
                    joining = true
                    if popMsg then popMsg.Text = "Joining " .. label .. "..." end
                    if sameGame then
                        local payload = queuePayload()
                        if EXEC.queue and payload then pcall(EXEC.queue, payload)
                        elseif popMsg then popMsg.Text = "Joining " .. label .. " (this executor can't carry the script across)..." end
                    end
                    local ok, err = pcall(function()
                        if jobId then TeleportService:TeleportToPlaceInstance(placeId, jobId, lp)
                        else TeleportService:Teleport(placeId, lp) end
                    end)
                    if not ok then
                        joining = false
                        if popMsg then popMsg.Text = "Join failed: " .. string.sub(tostring(err), 1, 60) end
                    end
                    task.delay(20, function() joining = false end)
                end
                local failConn
                failConn = TeleportService.TeleportInitFailed:Connect(function(_, result, msg)
                    if ent.closed then failConn:Disconnect() return end
                    joining = false
                    if popMsg then popMsg.Text = "Join failed: " .. string.sub(tostring(msg ~= "" and msg or result), 1, 60) end
                end)

