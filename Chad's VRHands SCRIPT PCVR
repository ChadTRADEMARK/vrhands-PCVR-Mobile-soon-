                -- ===== the two pages: Home and Search =====
                local function showHome(force)
                    loadToken += 1
                    local my = loadToken
                    local function stale() return my ~= loadToken or ent.closed end
                    mode = "home"
                    clearPage()
                    status.Text = ""
                    local fSec = newSection(1, "Friends", 104)
                    addBubble(fSec.row)
                    fSec.note.Position = UDim2.fromOffset(100, 40)
                    local cSec = newSection(2, "Continue", ROW_H)
                    local recentGames = {}
                    for _, e in ipairs(Recent) do recentGames[#recentGames + 1] = { u = e.u, p = e.p, n = e.n } end
                    if #recentGames == 0 then cSec.note.Text = "Games you start this script in show up here."
                    else fillGames(cSec, recentGames) end

                    local cache = _G.NoVR_RbCache
                    if cache and not force and os.time() - cache.at < 180 then
                        fillFriends(fSec, cache.friends)
                        for i, row in ipairs(cache.rows) do fillGames(newSection(10 + i, row.name, ROW_H), row.games) end
                        refreshStats()
                        return
                    end
                    status.Text = "Loading Roblox..."
                    task.spawn(function()
                        local fd = loadFriendData()
                        if stale() then return end
                        fillFriends(fSec, fd)
                        if #recentGames > 0 then
                            enrichList(recentGames)
                            if stale() then return end
                            refreshStats()
                        end
                        local rows = {}
                        local count, why = fetchHome(function(name, list)
                            rows[#rows + 1] = { name = name, games = list }
                            fillGames(newSection(10 + #rows, name, ROW_H), list)
                        end, stale)
                        if stale() then return end
                        if count == 0 then
                            status.Text = "Couldn't load Roblox's game lists (" .. tostring(why or "no data") .. "). Press REFRESH to retry."
                        else
                            status.Text = ""
