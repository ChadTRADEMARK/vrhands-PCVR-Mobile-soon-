        -- turns the status file into a detection reading: detection field, else derived from "script"
        local function detectionOf(remote)
            local d = string.lower(tostring(remote.detection or ""))
            if d == "" then
                local sc = string.lower(tostring(remote.script or ""))
                if sc == "working" then d = "undetected"
                elseif sc == "updating" then d = "unknown"
                elseif sc == "patched" then d = "detected" end
            end
            if d == "undetected" then return "Undetected", "ok" end
            if d == "risky" then return "Risky", "warn" end
            if d == "detected" then return "DETECTED", "bad" end
            return "Unknown", "warn"
        end
