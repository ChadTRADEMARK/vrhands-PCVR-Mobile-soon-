                        conns[1] = RunService.RenderStepped:Connect(function()
                            if ent.closed then stop() return end
                            local k = math.max(fit.Scale, 0.01)
                            local d = (sp(input) - from) / k
                            local v = cam.ViewportSize
                            local ap = p.AbsolutePosition
                            local maxW = math.max(ent.minW, (v.X - ap.X) / k - 8)
                            local maxH = math.max(ent.minH, (v.Y - ap.Y) / k - 30)
                            ent.applySize(math.clamp(w0 + d.X, ent.minW, maxW), math.clamp(h0 + d.Y, ent.minH, maxH))
                        end)
                        conns[2] = UIS.InputEnded:Connect(function(io) if io == input then stop() end end)
                        conns[3] = input.Changed:Connect(function()
