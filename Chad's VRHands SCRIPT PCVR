                    end
                end
                if me[slot] and not me[slot].closed then me[slot].close(); me[slot] = nil; return nil end
                x = x + 28 * math.min(cascade, 6)
                y = y + 24 * math.min(cascade, 6)
                local defW, defH = w, h
                local fixed = false
                local minW, minH = math.max(340, math.floor(defW * 0.75)), math.max(300, math.floor(defH * 0.75))
                if slot == "profile" then minW = defW end
                if not fixed and type(S.panelSize) == "table" and type(S.panelSize[slot]) == "table" then
                    local sw, sh2 = tonumber(S.panelSize[slot][1]), tonumber(S.panelSize[slot][2])
                    if sw and sh2 then
                        local v = cam.ViewportSize
                        local k = math.max(fit.Scale, 0.01)
                        w = math.clamp(sw, minW, math.max(minW, v.X / k - x - 8))
                        h = math.clamp(sh2, minH, math.max(minH, v.Y / k - y - 30))
                    end
                end
                local p, ent = makePanel(x, y, w, h, name, 0)
                me[slot] = ent
                ent.defW, ent.defH, ent.w, ent.h, ent.minW, ent.minH = defW, defH, w, h, minW, minH
                ent.stretchList = {}
                -- Call after setting the instance's offset Size: the panel grows / shrinks it together with itself.
                -- kw / kh = how much of the width / height change it takes (1 = all of it).
                function ent.stretchAdd(inst, kw, kh)
                    local rec = { inst = inst, w = inst.Size.X.Offset, h = inst.Size.Y.Offset, kw = kw or 0, kh = kh or 0 }
                    ent.stretchList[#ent.stretchList + 1] = rec
                    local dw, dh = ent.w - ent.defW, ent.h - ent.defH
                    inst.Size = UDim2.fromOffset(math.max(rec.w + dw * rec.kw, 40), math.max(rec.h + dh * rec.kh, 40))
                end
                -- For menus laid out with fixed positions: moves everything below topY into a scrolling area that
                -- stretches with the menu, so a smaller menu scrolls instead of cutting off / overlapping buttons.
                function ent.scrollify(topY)
                    local body = Instance.new("ScrollingFrame")
                    body.Name = "Body"
                    body.Position = UDim2.fromOffset(0, topY)
                    body.Size = UDim2.fromOffset(ent.defW, ent.defH - topY)
                    body.BackgroundTransparency = 1
                    body.BorderSizePixel = 0
                    body.ScrollBarThickness = 4
                    body.ScrollingDirection = Enum.ScrollingDirection.Y
                    body.CanvasSize = UDim2.new()
                    body.ZIndex = 2
                    body.Parent = p
                    local bottom = 0
                    for _, c in ipairs(p:GetChildren()) do
                        if c:IsA("GuiObject") and c ~= body and c.Name ~= "Bg" and c.Name ~= "Grip" and c.Name ~= "Resize"
                           and c.AnchorPoint.Y == 0 and c.Position.Y.Scale == 0 and c.Position.Y.Offset >= topY then
                            local ny = c.Position.Y.Offset - topY
                            c.Position = UDim2.new(c.Position.X.Scale, c.Position.X.Offset, 0, ny)
                            bottom = math.max(bottom, ny + c.Size.Y.Offset)
                            c.Parent = body
                        end
                    end
                    body.CanvasSize = UDim2.fromOffset(0, bottom + 14)
                    ent.stretchAdd(body, 1, 1)
                end
                function ent.applySize(nw, nh)
                    ent.w, ent.h = nw, nh
                    ent.resize(nw, nh)
                    local dw, dh = nw - ent.defW, nh - ent.defH
                    for _, r in ipairs(ent.stretchList) do
                        if r.inst.Parent then
                            r.inst.Size = UDim2.fromOffset(math.max(r.w + dw * r.kw, 40), math.max(r.h + dh * r.kh, 40))
                        end
                    end
                    if ent.onResize then ent.onResize(nw, nh) end
                end
                p.Active = true
                local bgf = p:FindFirstChild("Bg")
                if bgf then bgf.Active = true end
                lbl(p, title, 20, 18, w - 90, 26, 16)

                local cb = Instance.new("TextButton")
                cb.AnchorPoint = Vector2.new(1, 0)
                cb.Position = UDim2.new(1, -12, 0, 13)
                cb.Size = UDim2.fromOffset(28, 28)
                cb.AutoButtonColor = false
                cb.BackgroundColor3 = Color3.new(1, 1, 1)
                cb.BackgroundTransparency = 1
                cb.BorderSizePixel = 0
                cb.Text = "x"
                cb.Font = Enum.Font.GothamMedium
                cb.TextSize = 20
                cb.TextColor3 = WHITE
                cb.ZIndex = 9
                cb.Parent = p
                corner(cb, 14)
                local csc = Instance.new("UIScale")
                csc.Parent = cb
                cb.MouseEnter:Connect(function() tw(cb, 0.25, { BackgroundTransparency = 0.85 }, Enum.EasingStyle.Sine) end)
                cb.MouseLeave:Connect(function() tw(cb, 0.3, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine) end)
                cb.InputBegan:Connect(function(io) if isPress(io) then tw(csc, 0.1, { Scale = 0.9 }) end end)
                cb.InputEnded:Connect(function(io) if isPress(io) then tw(csc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back) end end)
                cb.Activated:Connect(function() ent.close(); me[slot] = nil end)

                -- resize handle (bottom-right corner): drag to make the menu bigger / smaller
                if not fixed then
                    local rh = Instance.new("TextButton")
                    rh.Name = "Resize"
                    rh.AnchorPoint = Vector2.new(1, 1)
                    rh.Position = UDim2.new(1, -4, 1, -4)
                    rh.Size = UDim2.fromOffset(24, 24)
                    rh.AutoButtonColor = false
                    rh.BackgroundTransparency = 1
                    rh.Text = ""
                    rh.ZIndex = 12
                    rh.Parent = p
                    for i = 1, 2 do
                        local line = Instance.new("Frame")
                        line.AnchorPoint = Vector2.new(0.5, 0.5)
                        line.Position = UDim2.new(0.5, 3 + (i - 1) * 4, 0.5, 3 + (i - 1) * 4)
                        line.Size = UDim2.fromOffset(i == 1 and 14 or 8, 2)
                        line.Rotation = -45
                        line.BackgroundColor3 = WHITE
                        line.BackgroundTransparency = 0.45
                        line.BorderSizePixel = 0
                        line.ZIndex = 13
                        line.Active = false
                        line.Parent = rh
                    end
                    rh.InputBegan:Connect(function(input)
                        if not isPress(input) then return end
                        local from = sp(input)
                        local w0, h0 = ent.w, ent.h
                        local conns = {}
                        local function stop()
                            if #conns == 0 then return end
                            for _, c in ipairs(conns) do c:Disconnect() end
                            conns = {}
                            S.panelSize = S.panelSize or {}
                            S.panelSize[slot] = { math.floor(ent.w), math.floor(ent.h) }
                        end
                        conns[1] = RunService.RenderStepped:Connect(function()
                            if ent.closed then stop() return end
                            local k = math.max(fit.Scale, 0.01)
                            local d = (sp(input) - from) / k
                            local v = cam.ViewportSize
                            local ap = p.AbsolutePosition
                            local maxW = math.max(ent.minW, (v.X - ap.X) / k - 8)
                            local maxH = math.max(ent.minH, (v.Y - ap.Y) / k - 30)
                            ent.applySize(math.clamp(w0 + d.X, ent.minW, maxW), math.clamp(h0 + d.Y, ent.minH, maxH))
                        end)
                        conns[2] = UIS.InputEnded:Connect(function(io) if io == input then stop() end end)
                        conns[3] = input.Changed:Connect(function()
                            if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then stop() end
                        end)
                    end)
                end
                return p, ent
            end

