    -- camPos is the position of your HEAD. In third person the camera sits
    -- behind it; in first person they are the same point.
    -- FREE HEAD (Numpad 7): the mouse turns your head about its OWN axes, Numpad 4 / 6 roll it, Numpad 5 levels it,
    -- so you can go upside down, sideways, any way. Your view and hands follow the head.
    S.freeHead = false
    S.freeRot = CFrame.new()
    S.flip = false      -- Numpad 9: locked upside down (normal look mode)
    S.flipAng = 0       -- animated roll toward 0 / pi
    function S.lookTurn(dx, dy)
        local zk = 1 / (S.zoom or 1) ^ 0.85   -- zoomed in = the mouse turns the view slower, so aiming stays precise
        dx, dy = dx * zk, dy * zk
        if S.freeHead then
            S.freeRot = S.freeRot * CFrame.fromAxisAngle(Vector3.new(0, 1, 0), -dx * S.sens) * CFrame.fromAxisAngle(Vector3.new(1, 0, 0), -dy * S.sens)
        else
            local k = S.flip and -1 or 1   -- upside down: the mouse directions flip so the view still follows your hand
            yaw   = yaw - k * dx * S.sens
            pitch = math.clamp(pitch - k * dy * S.sens, -1.45, 1.45)
        end
    end
    function S.flipUpsideDown()
        if S.freeHead then
            S.freeRot = S.freeRot * CFrame.fromAxisAngle(Vector3.new(0, 0, 1), math.pi)   -- free head: flip over right now
        else
            S.flip = not S.flip
        end
    end
    function S.toggleFreeHead()
        if not S.freeHead then
            S.freeRot = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0) * CFrame.fromAxisAngle(Vector3.new(0, 0, 1), S.flipAng)
            S.freeHead = true
        else
            local lv = S.freeRot.LookVector   -- keep facing the same way, drop the roll
            yaw   = math.atan2(-lv.X, -lv.Z)
            pitch = math.asin(math.clamp(lv.Y, -1, 1))
            S.flip = S.freeRot.UpVector.Y < 0   -- still upside down? stay upside down (locked)
            S.flipAng = S.flip and math.pi or 0
            S.freeHead = false
        end
    end
    local camPos = cam.CFrame.Position
    local headCF = cam.CFrame   -- where your head should be (camPos + your look direction)
    local camBack = cam.CFrame  -- where the screen is drawn from (head pulled back in 3rd person)
