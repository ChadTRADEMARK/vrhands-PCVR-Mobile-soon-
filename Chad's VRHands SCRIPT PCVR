            end
            function Mic.setMonitor(on)   -- hear your own mic through your speakers / headphones (local only, nobody else hears this)
                if on then
                    local m = Mic.find()
                    if not m then return false end
                    if not (Mic.mon and Mic.mon.Parent) then
                        local ok = pcall(function()
                            local f = Instance.new("AudioFader")
                            f.Name = "NoVR_MonFader"
                            f.Volume = 1
