        -- Copies the invite, then asks the local Discord app to open it (falls back to the browser).
        -- Returns the text the button should flash.
        local function joinDiscord()
            local clip = setclipboard or toclipboard or (Clipboard and Clipboard.set)
            local copied = false
            if clip then copied = pcall(clip, DISCORD_INVITE) end
            task.spawn(function()
                local opened = false
                local req = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
                if req then
                    local ok, res = pcall(req, {
                        Url = "http://127.0.0.1:6463/rpc?v=1",
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json", ["Origin"] = "https://discord.com" },
                        Body = HttpSvcD:JSONEncode({
                            cmd = "INVITE_BROWSER",
                            args = { code = DISCORD_CODE },
                            nonce = HttpSvcD:GenerateGUID(false),
                        }),
                    })
                    if ok and res and (res.Success or res.StatusCode == 200) then opened = true end
                end
                if not opened then
                    pcall(function() game:GetService("GuiService"):OpenBrowserWindow(DISCORD_INVITE) end)
                end
            end)
            return copied and "INVITE COPIED!" or "discord.gg/mgmgJ7rZUa"
        end

        -- Role lookup: reads ROLES_URL once and remembers the answer (retries if it was unreachable).
        local roleState = { done = false, text = nil, found = false, busy = false, waiting = {} }
        local function fetchRole(cb)
            if roleState.done then cb(roleState.text, roleState.found) return end
            roleState.waiting[#roleState.waiting + 1] = cb
            if roleState.busy then return end
            roleState.busy = true
            task.spawn(function()
                local text, found, ok = "Unavailable", false, false
                if type(ROLES_URL) ~= "string" or ROLES_URL == "" then
                    text, ok = "Not configured", true
                else
                    local body = rawGet(ROLES_URL)
                    if body then
                        local okj, data = pcall(HttpSvcD.JSONDecode, HttpSvcD, body)
                        if okj and type(data) == "table" then
                            ok = true
                            local v = data[tostring(lp.UserId)]
                            if type(v) == "table" then v = v.role end
                            if type(v) == "string" and v ~= "" then
                                text, found = v, true
                            else
                                text = "No role (not linked)"
                            end
                        end
                    end
                end
                if ok then roleState.done, roleState.text, roleState.found = true, text, found end
                roleState.busy = false
                local list = roleState.waiting
                roleState.waiting = {}
                for _, f in ipairs(list) do pcall(f, text, found) end
            end)
        end
