                -- keep the preview and the sliders in step with the hands (presets and animations move them too)
                task.spawn(function()
                    while p.Parent and not ent.closed do
                        draw()
                        if pages[1].Visible then refreshRows() end
                        if pages[1].Visible then jstat.Text = S.fingerSummary() end
                        if S.animRunning and S.animRunning ~= playTok then playTok = S.animRunning; setPlaying(true) end
