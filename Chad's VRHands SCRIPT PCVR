                if mode == "free" and U.opt.bodyHands then
                    local rl = root.CFrame.LookVector
                    hyT = (math.atan2(-rl.X, -rl.Z) - yaw + math.pi) % (2 * math.pi) - math.pi
                end
                U.handYaw = (U.handYaw or 0) + ((hyT - (U.handYaw or 0) + math.pi) % (2 * math.pi) - math.pi) * (1 - math.exp(-dt * 8))
