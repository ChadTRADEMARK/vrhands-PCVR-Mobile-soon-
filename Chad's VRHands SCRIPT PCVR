                    end
                    if b.breakAt and age0 >= b.breakAt then
                        S.dbrSplit(c, b, age0)
                        alive = false
                    elseif dB < c.bhR * 0.6 or t > b.maxT or (t > b.liftT + b.rampT + 1 and dB < c.bhR * 1.2) then
                        S.dbrSwallow(c, b, now)
                        alive = false
                    end
                end
                if alive then i = i + 1 else table.remove(list, i) end
            end
        end
        function S.suckPuff(c, pos, dim, impact, col)   -- a puff of dust and a knock where something lands
