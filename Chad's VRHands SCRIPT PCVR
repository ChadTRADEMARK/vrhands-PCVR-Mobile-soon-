    -- ============ TRIGGER (J) ============
    -- Hold a gun (fist closed), press J to pull the trigger (index finger curls).
    -- Only hands that are currently gripping (fist = 1) pull the trigger.
    local trigger = { held = false }
    local function restoreIndex()
        if not Input then return end
        -- put each index finger back to what the other inputs say it should be
        if not anyPoseLocked("L") then
            Input.lIndex = (mouseDown.L or keys[Enum.KeyCode.Q]) and 1 or 0
        end
        if not anyPoseLocked("R") then
            Input.rIndex = (mouseDown.R or keys[Enum.KeyCode.E]) and 1 or 0
        end
    end
    -- =====================================

    local hudLabel = nil
    local hudApi = {}   -- mobile controls menu: scaleBy(f), reset(), toggle()

    -- Named so the mobile buttons can feed the exact same logic as the keyboard/mouse.
    local function onInputBegan(io, gameProcessed)
        if gameProcessed then return end

        if io.UserInputType == Enum.UserInputType.Keyboard then
            keys[io.KeyCode] = true
            if io.KeyCode == Enum.KeyCode.LeftAlt then setLook(not S.look) end
            if io.KeyCode == Enum.KeyCode.Equals  then setScale(S.scale + 1) end
            if io.KeyCode == Enum.KeyCode.Minus   then setScale(S.scale - 1) end

            -- Third person toggle
            if io.KeyCode == Enum.KeyCode.P then
                S.thirdPerson = not S.thirdPerson
            end

            -- Hand mode (N): hands are moved separately from the camera
            -- (PC: mouse, mobile: the two hand joysticks)
            if io.KeyCode == Enum.KeyCode.N then
                S.handMode = not S.handMode
                if S.handMode then S.aimMode = false end
            end

            -- Aim mode (V): the mouse ROTATES the hands, so you can aim a gun yourself
            -- (hold LMB = left hand only, RMB = right hand only, none = both)
            if io.KeyCode == Enum.KeyCode.V then
                S.aimMode = not S.aimMode
                if S.aimMode then S.handMode = false end
            end

            -- Reset hands (B): back to the default position and reach
            if io.KeyCode == Enum.KeyCode.B then
                S.handLX, S.handLY = 0, 0
                S.handRX, S.handRY = 0, 0
                S.aimLYaw, S.aimLPitch, S.aimRYaw, S.aimRPitch = 0, 0, 0, 0
                S.reachL, S.reachR = 2, 2
            end

            if io.KeyCode == Enum.KeyCode.RightControl then
                _G.NoVR_HUD_Visible = not _G.NoVR_HUD_Visible
                if hudLabel then
                    hudLabel.Visible = _G.NoVR_HUD_Visible
                end
            end

            if Input and io.KeyCode == Enum.KeyCode.E then Input.rIndex = 1; Input.rFist = 0; Input.rThumb = 0 end
            if Input and io.KeyCode == Enum.KeyCode.Q then Input.lIndex = 1; Input.lFist = 0; Input.lThumb = 0 end
            if io.KeyCode == Enum.KeyCode.J and not UIS:GetFocusedTextBox() then trigger.held = true end

            local pose = poseData[io.KeyCode]
            if pose then
                pose.held = true
                if not pose.locked then
                    pose.apply()
                end
            end

        elseif io.UserInputType == Enum.UserInputType.MouseButton1 then
            mouseDown.L = true
            if anyPoseKeyHeld("L") then
                for _, pose in pairs(poseData) do
                    if pose.held and pose.side == "L" then
                        pose.locked = true
                    end
                end
            elseif anyPoseLocked("L") then
                for _, pose in pairs(poseData) do
                    if pose.locked and pose.side == "L" then
                        pose.locked = false
                        pose.release()
                    end
                end
            else
                if Input then Input.lFist = 1; Input.lIndex = 1 end
            end
        elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
            mouseDown.R = true
            if anyPoseKeyHeld("R") then
                for _, pose in pairs(poseData) do
                    if pose.held and pose.side == "R" then
                        pose.locked = true
                    end
                end
            elseif anyPoseLocked("R") then
                for _, pose in pairs(poseData) do
                    if pose.locked and pose.side == "R" then
                        pose.locked = false
                        pose.release()
                    end
                end
            else
                if Input then Input.rFist = 1; Input.rIndex = 1 end
            end
        end
    end
    UIS.InputBegan:Connect(onInputBegan)

    local function onInputEnded(io, gameProcessed)
        if io.UserInputType == Enum.UserInputType.Keyboard then
            keys[io.KeyCode] = false
            if Input and io.KeyCode == Enum.KeyCode.E then Input.rIndex = 0 end
            if Input and io.KeyCode == Enum.KeyCode.Q then Input.lIndex = 0 end
            if io.KeyCode == Enum.KeyCode.J and trigger.held then
                trigger.held = false
                restoreIndex()
            end

            local pose = poseData[io.KeyCode]
            if pose then
                pose.held = false
                if not pose.locked then
                    pose.release()
                end
            end

        elseif io.UserInputType == Enum.UserInputType.MouseButton1 then
            mouseDown.L = false
            if not anyPoseKeyHeld("L") and not anyPoseLocked("L") then
                if Input then Input.lFist = 0; Input.lIndex = 0 end
            end
        elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
            mouseDown.R = false
            if not anyPoseKeyHeld("R") and not anyPoseLocked("R") then
                if Input then Input.rFist = 0; Input.rIndex = 0 end
            end
        end
    end
    UIS.InputEnded:Connect(onInputEnded)

    UIS.InputChanged:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseWheel then
            addReach(-io.Position.Z * 0.25)
        end
    end)

    local function isTyping()
        return UIS:GetFocusedTextBox() ~= nil
    end

    local reachHold, reachHoldDir = 0, 0   -- how long Numpad +/- has been held (for acceleration)

    RunService:BindToRenderStep("NoVR_Control", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if S.look and not isTyping() then
            local md = UIS:GetMouseDelta()
            if S.handMode then
                -- PC: mouse right = hand right, mouse up = hand up.
                -- Hold LMB = left hand only, hold RMB = right hand only,
                -- nothing (or both) held = both hands together.
                local moveL = mouseDown.L or not mouseDown.R
                local moveR = mouseDown.R or not mouseDown.L
                if moveL then
                    S.handLX = math.clamp(S.handLX + md.X * S.handSens, -4, 4)
                    S.handLY = math.clamp(S.handLY - md.Y * S.handSens, -4, 4)
                end
                if moveR then
                    S.handRX = math.clamp(S.handRX + md.X * S.handSens, -4, 4)
                    S.handRY = math.clamp(S.handRY - md.Y * S.handSens, -4, 4)
                end
                -- Mobile: dragging on empty screen still turns the camera,
                -- because the hands are driven by the two joysticks instead.
                yaw   = yaw - touch.look.X * S.sens
                pitch = math.clamp(pitch - touch.look.Y * S.sens, -1.45, 1.45)
            elseif S.aimMode then
                -- PC: mouse right = gun turns right, mouse up = gun tilts up.
                -- Hold LMB = left hand only, hold RMB = right hand only,
                -- nothing (or both) held = both hands together.
                local moveL = mouseDown.L or not mouseDown.R
                local moveR = mouseDown.R or not mouseDown.L
                if moveL then
                    S.aimLYaw   = math.clamp(S.aimLYaw   - md.X * S.aimSens, -3.1, 3.1)
                    S.aimLPitch = math.clamp(S.aimLPitch - md.Y * S.aimSens, -1.5, 1.5)
                end
                if moveR then
                    S.aimRYaw   = math.clamp(S.aimRYaw   - md.X * S.aimSens, -3.1, 3.1)
                    S.aimRPitch = math.clamp(S.aimRPitch - md.Y * S.aimSens, -1.5, 1.5)
                end
                -- touch drag still turns the camera
                yaw   = yaw - touch.look.X * S.sens
                pitch = math.clamp(pitch - touch.look.Y * S.sens, -1.45, 1.45)
            else
                local d = md + touch.look
                yaw   = yaw - d.X * S.sens
                pitch = math.clamp(pitch - d.Y * S.sens, -1.45, 1.45)
            end
            UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
        elseif isTyping() then
            UIS.MouseBehavior = Enum.MouseBehavior.Default
            UIS.MouseIconEnabled = true
        end

        touch.look = Vector2.zero   -- drag deltas are used up (or ignored) each frame

        -- (Mobile hand joysticks now move the hands directly from their own
        -- drag handlers, so nothing needs to be integrated here.)

        local rot = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)

        local hs  = cam.HeadScale; if hs <= 1 then hs = S.scale * 60 end
        local spd = (100 + S.scale * 4) * hs * S.moveK

        if keys[Enum.KeyCode.LeftControl] and not isTyping() then
            spd = spd * S.slowFactor
        end

        local mv  = Vector3.zero

        if not isTyping() then
            if keys[Enum.KeyCode.W] then mv += Vector3.new(0,0,-1) end
            if keys[Enum.KeyCode.S] then mv += Vector3.new(0,0, 1) end
            if keys[Enum.KeyCode.A] then mv += Vector3.new(-1,0,0) end
            if keys[Enum.KeyCode.D] then mv += Vector3.new( 1,0,0) end
            if keys[Enum.KeyCode.Space]     then mv += Vector3.new(0, 1,0) end
            if keys[Enum.KeyCode.LeftShift] then mv += Vector3.new(0,-1,0) end
            mv += Vector3.new(touch.move.X, 0, touch.move.Y)   -- mobile joystick
        else
            for k in pairs(keys) do keys[k] = false end
        end

        if S.menuOpen then mv = Vector3.zero end   -- opening menu is up: don't fly around
        -- amt is 1 for keys, and less than 1 for a partly pushed joystick
        if mv.Magnitude > 0 then
            local amt = math.min(mv.Magnitude, 1)
            camPos = camPos + (rot * mv.Unit) * spd * dt * amt
        end

        -- mobile hand reach buttons (same job as the mouse wheel)
        if touch.reachDir ~= 0 then
            addReach(touch.reachDir * 3 * dt)
        end
        -- Numpad + / - : hand reach out / in (hold to keep going)
        if not isTyping() then
            local kd = 0
            if UIS:IsKeyDown(Enum.KeyCode.KeypadPlus)  then kd += 1 end
            if UIS:IsKeyDown(Enum.KeyCode.KeypadMinus) then kd -= 1 end
            if kd ~= 0 then
                if kd ~= reachHoldDir then reachHold = 0 end   -- switched direction: start slow again
                reachHoldDir = kd
                reachHold = reachHold + dt
                -- starts at 3 studs/sec and speeds up the longer you hold
                -- (REACH_ACCEL = how fast it ramps, REACH_MAX = top speed)
                local REACH_ACCEL, REACH_MAX = 1.5, 1000000
                local speed = math.min(3 * math.exp(reachHold * REACH_ACCEL), REACH_MAX)
                addReach(kd * speed * dt)
            else
                reachHold, reachHoldDir = 0, 0
            end
        end
        headCF = CFrame.new(camPos) * rot

        -- Third person zoom: hold I = zoom in, O = zoom out.
        -- (IsKeyDown so the game can't swallow the keys; exponential speed.)
        if not isTyping() then
            local zoomRate = 0.9
            -- Hard limit on how far the camera can go IN STUDS, so the map can
            -- never be pushed out past the draw distance (it vanishes there).
            -- Bigger avatars are allowed proportionally more room.
            local maxMult = math.max(1500 / headUnit(), 3)
            S.tpDist = math.min(S.tpDist, maxMult)
            if UIS:IsKeyDown(Enum.KeyCode.O) or touch.zoomOut then
                S.tpDist = math.clamp(S.tpDist * math.exp(zoomRate * dt), 0.3, maxMult)
            end
            if UIS:IsKeyDown(Enum.KeyCode.I) or touch.zoomIn then
                S.tpDist = math.clamp(S.tpDist * math.exp(-zoomRate * dt), 0.3, maxMult)
            end
        end

        -- How far in front of the camera the head sits (0 in first person).
        local D = 0
        if S.thirdPerson then D = S.tpDist * headUnit() end
        S.curD   = D
        TP.D     = D
        TP.scale = resolveScale()

        cam.CameraType = Enum.CameraType.Scriptable
        -- The game positions your real (replicated) head from the camera, so the
        -- camera stays ON the head while the game runs. It is only pulled back
        -- right before the frame is drawn (see NoVR_CamView below), so other
        -- players never see your head follow the third-person camera.
        camBack = CFrame.new(camPos - rot.LookVector * D) * rot
        cam.CFrame = headCF

        if Input then
            Input.directionLateral  = Vector2.zero
            Input.directionVertical = 0
            Input.turnDirection     = 0

            for _, pose in pairs(poseData) do
                if pose.locked then pose.apply() end
            end

            -- J = pull the trigger on every hand that is gripping something
            if trigger.held then
                if Input.lFist == 1 then Input.lIndex = 1 end
                if Input.rFist == 1 then Input.rIndex = 1 end
            end
        end
    end)

    -- camera sits on the head at the start of every frame (what the game reads)...
    RunService:BindToRenderStep("NoVR_CamHead", Enum.RenderPriority.First.Value, function()
        cam.CFrame = headCF
    end)
    -- ...and is moved back to the third-person view after everything else ran,
    -- so only YOUR screen sees it there.
    RunService:BindToRenderStep("NoVR_CamView", Enum.RenderPriority.Last.Value + 10000, function()
        cam.CFrame = camBack
    end)

    -- ============ CROSSHAIR (shows where a held gun points) ============
    -- Settings live in XH and are edited from Start Menu > dock > crosshair icon.
    -- A crosshair only shows for a hand that is gripping something (see "detect").
    local XH = {
        enabled = true,
        style = "Cross",        -- Cross | T | Circle | Dot
        size = 14, gap = 5, thickness = 2,
        color = Color3.fromRGB(0, 255, 140),
        opacity = 1,
        outline = true,
        dot = false,            -- extra centre dot
        axis = "Forward",       -- which way the gun points: Forward | Back | Up | Down | Right | Left
        detect = "Held object", -- "Held object" (needs an item near the hand) | "Grip only" (any closed fist)
        radius = 4,             -- how close (studs) an item must be to the hand to count as held
        always = false,         -- show even when not holding anything (aims from the hand)
        dirty = true,
    }
    local XH_DEFAULTS = {}
    for k, v in pairs(XH) do XH_DEFAULTS[k] = v end

    local AXES = {
        Forward = function(cf) return cf.LookVector end,
        Back    = function(cf) return -cf.LookVector end,
        Up      = function(cf) return cf.UpVector end,
        Down    = function(cf) return -cf.UpVector end,
        Right   = function(cf) return cf.RightVector end,
        Left    = function(cf) return -cf.RightVector end,
    }

    task.spawn(function()
        local pg = lp:WaitForChild("PlayerGui")
        local gui = Instance.new("ScreenGui")
        gui.Name = "NoVR_Crosshair"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 40
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.Parent = pg

        local sides = {}
        local function newSide(name)
            local f = Instance.new("Frame")
            f.Name = name
            f.AnchorPoint = Vector2.new(0.5, 0.5)
            f.Size = UDim2.fromOffset(0, 0)
            f.BackgroundTransparency = 1
            f.Visible = false
            f.Parent = gui
            return { f = f }
        end
        sides.L = newSide("Left")
        sides.R = newSide("Right")

        -- centred rectangle (with optional black outline)
        local function mk(parent, x, y, w, h)
            local b = Instance.new("Frame")
            b.AnchorPoint = Vector2.new(0.5, 0.5)
            b.Position = UDim2.fromOffset(x, y)
            b.Size = UDim2.fromOffset(w, h)
            b.BackgroundColor3 = XH.color
            b.BackgroundTransparency = 1 - XH.opacity
            b.BorderSizePixel = 0
            b.Parent = parent
            if XH.outline then
                local st = Instance.new("UIStroke")
                st.Color = Color3.new(0, 0, 0)
                st.Thickness = 1
                st.Transparency = 1 - XH.opacity
                st.Parent = b
            end
            return b
        end
        local function ring(parent, d, th, color)
            local r = Instance.new("Frame")
            r.AnchorPoint = Vector2.new(0.5, 0.5)
            r.Position = UDim2.fromOffset(0, 0)
            r.Size = UDim2.fromOffset(d, d)
            r.BackgroundTransparency = 1
            r.BorderSizePixel = 0
            r.Parent = parent
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(1, 0)
            c.Parent = r
            local s = Instance.new("UIStroke")
            s.Color = color
            s.Thickness = th
            s.Transparency = 1 - XH.opacity
            s.Parent = r
            return r
        end

        local function rebuild()
            XH.dirty = false
            for _, s in pairs(sides) do
                s.f:ClearAllChildren()
                local t, g, L, st = XH.thickness, XH.gap, XH.size, XH.style
                if st == "Cross" or st == "T" then
                    local off = g + L / 2
                    mk(s.f, -off, 0, L, t)
                    mk(s.f, off, 0, L, t)
                    mk(s.f, 0, off, t, L)
                    if st == "Cross" then mk(s.f, 0, -off, t, L) end
                elseif st == "Circle" then
                    local d = L * 2
                    if XH.outline then ring(s.f, d, t + 2, Color3.new(0, 0, 0)) end
                    ring(s.f, d, t, XH.color)
                end
                if st == "Dot" or XH.dot then
                    mk(s.f, 0, 0, t + 2, t + 2)
                end
            end
        end

        local ovp = OverlapParams.new()
        ovp.FilterType = Enum.RaycastFilterType.Exclude
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        local held = { L = nil, R = nil }
        local lastScan = 0

        local function pivotOf(inst)
            if not inst then return nil end
            if inst:IsA("BasePart") then return inst.CFrame end
            if inst:IsA("Model") then return inst:GetPivot() end
            return nil
        end
        local function gripping(side)
            if Input then
                return (side == "L" and Input.lFist or Input.rFist) == 1
            end
            return mouseDown[side] or anyPoseLocked(side)
        end

        -- nearest loose (unanchored) item to the hand, ignoring characters and rigs
        local function scan(handCF)
            local excl = { rig }
            if cloneFolder then excl[#excl + 1] = cloneFolder end
            if lp.Character then excl[#excl + 1] = lp.Character end
            ovp.FilterDescendantsInstances = excl
            local parts = workspace:GetPartBoundsInRadius(handCF.Position, XH.radius, ovp)
            local best, bd = nil, math.huge
            for _, p in ipairs(parts) do
                if not p.Anchored and not p:IsDescendantOf(vrPlayers) then
                    local m = p:FindFirstAncestorOfClass("Model")
                    if not (m and m:FindFirstChildOfClass("Humanoid")) then
                        local d = (p.Position - handCF.Position).Magnitude
                        if d < bd then best, bd = p, d end
                    end
                end
            end
            return best
        end

        RunService:BindToRenderStep("NoVR_Crosshair", Enum.RenderPriority.Camera.Value + 2, function()
            if XH.dirty then rebuild() end
            local doScan = os.clock() - lastScan > 0.1
            if doScan then lastScan = os.clock() end
            local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
            local toolSide = gripping("R") and "R" or (gripping("L") and "L" or nil)

            for _, side in ipairs({ "L", "R" }) do
                local s = sides[side]
                local show = false
                if XH.enabled and not S.menuOpen then
                    local hcf = pivotOf(rig:FindFirstChild(side == "L" and "LeftHand" or "RightHand"))
                    if hcf then
                        local cf, part, ok = hcf, nil, false
                        if XH.always then
                            ok = true
                        elseif gripping(side) then
                            if XH.detect == "Held object" then
                                if doScan then
                                    local h = nil
                                    if tool and side == toolSide then h = tool:FindFirstChild("Handle") end
                                    held[side] = h or scan(hcf)
                                end
                                part = held[side]
                                if part and not part.Parent then part, held[side] = nil, nil end
                                if part then cf, ok = part.CFrame, true end
                            else
                                ok = true
                            end
                        else
                            held[side] = nil
                        end

                        if ok then
                            local dir = AXES[XH.axis](cf)
                            local ex = { rig }
                            if cloneFolder then ex[#ex + 1] = cloneFolder end
                            if lp.Character then ex[#ex + 1] = lp.Character end
                            if part then
                                ex[#ex + 1] = part
                                local m = part:FindFirstAncestorOfClass("Model")
                                if m and not m:FindFirstChildOfClass("Humanoid") then ex[#ex + 1] = m end
                            end
                            rp.FilterDescendantsInstances = ex
                            local res = workspace:Raycast(cf.Position, dir * 3000, rp)
                            local pt = res and res.Position or (cf.Position + dir * 3000)
                            local v = cam:WorldToViewportPoint(pt)
                            if v.Z > 0 then
                                s.f.Position = UDim2.fromOffset(v.X, v.Y)
                                show = true
                            end
                        end
                    end
                end
                s.f.Visible = show
            end
        end)
    end)
    -- =====================================================

    -- ============ MOBILE HUD (touch controls) ============
    -- A black "M" circle opens/closes this touch HUD. Every button feeds the
    -- same handlers the keyboard and mouse use, so it behaves exactly like PC.
    --
    -- Layout (landscape):
    --   bottom-left   : move joystick + UP / DOWN
    --   bottom-right  : GRAB / PINCH buttons
    --   top row       : 3rd Person | Hand Mode | Reset Hands | More | Hide
    --   Hand Mode ON  : two extra joysticks appear, one per hand
    --                   (left = LEFT hand, right = RIGHT hand)
    --   empty screen  : drag to look around
    do
        task.spawn(function()
            local okUI, errUI = pcall(function()
                local pg = lp:WaitForChild("PlayerGui")
                local GuiService = game:GetService("GuiService")
                local TweenService = game:GetService("TweenService")

                -- scale all sizes to the screen so buttons stay finger-sized
                local vp = cam.ViewportSize
                -- Everything is laid out in fixed "design units" (a 760x380 screen).
                -- One UIScale (rootScale, below) then fits it to the real screen and is
                -- re-fitted whenever the screen size changes (rotation, window resize...).
                local function px(n) return n end
                local function fitScale()
                    local v = cam.ViewportSize
                    return math.clamp(math.min(v.X / 760, v.Y / 380), 0.7, 1.6) * Theme.size
                end

                local mobileOpen = false
                local gui = Instance.new("ScreenGui")
                gui.Name = "NoVR_Mobile"
                gui.ResetOnSpawn = false
                gui.IgnoreGuiInset = true
                gui.DisplayOrder = 50
                gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
                gui.Enabled = false   -- closed until the M circle is pressed
                gui.Parent = pg

                local root = Instance.new("Frame")
                root.Name = "Root"
                root.BackgroundTransparency = 1
                root.BorderSizePixel = 0
                root.Active = false
                root.ZIndex = 5
                local rootScale = Instance.new("UIScale")
                rootScale.Scale = fitScale()
                rootScale.Parent = root
                root.Size = UDim2.fromScale(1 / rootScale.Scale, 1 / rootScale.Scale)  -- ends up exactly full-screen
                root.Parent = gui

                -- theme: dark flat panels, soft green "deploy" buttons, red tab underline
                local IDLE   = Color3.fromRGB(86, 50, 175)     -- glass violet buttons (start-menu colour)
                local ACTIVE = Color3.fromRGB(186, 98, 255)   -- bright purple (toggled on)
                local RED    = Color3.fromRGB(225, 190, 255)  -- active-tab underline (light lavender)
                local PANEL  = Color3.fromRGB(40, 20, 96)     -- window / bar background (deep violet)
                local STROKE = Color3.fromRGB(215, 185, 255)  -- soft white-violet glass edge
                local TEXTC  = Color3.fromRGB(240, 240, 240)
                local LEFT_C  = Color3.fromRGB(186, 98, 255)   -- same colours as the PC menu
                local RIGHT_C = Color3.fromRGB(225, 205, 255)
                local LOOK_MULT = 1.6

                local function isPress(input)
                    return input.UserInputType == Enum.UserInputType.Touch
                        or input.UserInputType == Enum.UserInputType.MouseButton1
                end

                -- Finger / mouse position in the SAME space as AbsolutePosition
                -- (our ScreenGuis use IgnoreGuiInset = true).
                --  * Touch: input.Position excludes the top-bar inset, so add it back.
                --  * Mouse: a MouseButton1 input object never updates its Position,
                --    so read the live cursor instead.
                local function screenPos(input)
                    if input.UserInputType == Enum.UserInputType.Touch then
                        local inset = GuiService:GetGuiInset()
                        return Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
                    end
                    return UIS:GetMouseLocation()
                end

                -- fake keyboard / mouse events into the real handlers
                local function kev(kc, down)
                    local io = { UserInputType = Enum.UserInputType.Keyboard, KeyCode = kc }
                    if down then onInputBegan(io, false) else onInputEnded(io, false) end
                end
                local function mev(btn, down)
                    local io = { UserInputType = btn, KeyCode = Enum.KeyCode.Unknown }
                    if down then onInputBegan(io, false) else onInputEnded(io, false) end
                end


                -- ---------- liquid motion helpers ----------
                local function liquidTw(inst, t, props, style, dir)
                    TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props):Play()
                end
                -- colours flow into each other instead of snapping
                local function liquidColor(b, c)
                    c = Theme.tint(c)
                    if b:GetAttribute("tc") ~= c then
                        b:SetAttribute("tc", c)
                        liquidTw(b, 0.45, { BackgroundColor3 = c }, Enum.EasingStyle.Sine)
                    end
                end
                -- a soft ring of light spreads from the finger
                local function ripple(host, input)
                    local ap, as = host.AbsolutePosition, host.AbsoluteSize
                    local p = screenPos(input)
                    local k = math.max(rootScale.Scale, 0.01)
                    local r = Instance.new("Frame")
                    r.AnchorPoint = Vector2.new(0.5, 0.5)
                    r.Position = UDim2.fromOffset((p.X - ap.X) / k, (p.Y - ap.Y) / k)
                    r.Size = UDim2.fromOffset(0, 0)
                    r.BackgroundColor3 = Color3.new(1, 1, 1)
                    r.BackgroundTransparency = 0.55
                    r.BorderSizePixel = 0
                    r.ZIndex = host.ZIndex + 1
                    r.Active = false
                    local rc = Instance.new("UICorner")
                    rc.CornerRadius = UDim.new(1, 0)
                    rc.Parent = r
                    r.Parent = host
                    local d = math.max(as.X, as.Y) / k * 2.3
                    liquidTw(r, 0.6, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 })
                    task.delay(0.65, function() r:Destroy() end)
                end
                -- panels pop open like a drop of liquid settling
                local function popOpen(frame, sc)
                    local target = sc.Scale
                    sc.Scale = target * 0.9
                    frame.Visible = true
                    liquidTw(sc, 0.5, { Scale = target }, Enum.EasingStyle.Quint)
                end

                local function style(b)
                    b.AutoButtonColor = false
                    b.BackgroundColor3 = IDLE
                    b.BackgroundTransparency = 0.25
                    b.TextColor3 = TEXTC
                    b.Font = Enum.Font.GothamBold
                    b.Text = string.upper(b.Text)
                    b.TextSize = px(13)
                    b.TextWrapped = true
                    b.BorderSizePixel = 0
                    b.Active = true
                    b.Selectable = false
                    local c = Instance.new("UICorner")
                    c.CornerRadius = UDim.new(0, 10)
                    c.Parent = b
                    local s = Instance.new("UIStroke")
                    s.Color = STROKE
                    s.Thickness = 1.5
                    s.Transparency = 0.4
                    s.Parent = b
                    -- liquid press: squish down, jelly back up, ripple from the finger
                    b.ClipsDescendants = true
                    local sc = Instance.new("UIScale")
                    sc.Parent = b
                    b.InputBegan:Connect(function(input)
                        if isPress(input) then
                            liquidTw(sc, 0.15, { Scale = 0.9 }, Enum.EasingStyle.Quad)
                            ripple(b, input)
                        end
                    end)
                    b.InputEnded:Connect(function(input)
                        if isPress(input) then liquidTw(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end
                    end)
                end

                local function mkBtn(parent, text, anchor, pos, size)
                    local b = Instance.new("TextButton")
                    b.Text = text
                    b.AnchorPoint = anchor
                    b.Position = pos
                    b.Size = size
                    style(b)
                    b.Parent = parent
                    return b
                end

                -- onDown when a finger lands, onUp when it lifts.
                -- Each finger is tracked on its own so several buttons can be
                -- held at the same time (e.g. move stick + GRAB).
                local function bindHold(b, onDown, onUp)
                    local held = false
                    b.InputBegan:Connect(function(input)
                        if held or not isPress(input) then return end
                        held = true
                        b.BackgroundTransparency = 0
                        onDown()
                        local conn
                        conn = input.Changed:Connect(function()
                            if input.UserInputState == Enum.UserInputState.End
                               or input.UserInputState == Enum.UserInputState.Cancel then
                                conn:Disconnect()
                                held = false
                                b.BackgroundTransparency = 0.25
                                onUp()
                            end
                        end)
                    end)
                end
                local function bindTap(b, fn)
                    bindHold(b, fn, function() end)
                end
                -- tap once = one step, keep holding = repeats
                local function bindRepeat(b, fn)
                    local on = false
                    bindHold(b, function()
                        on = true
                        fn()
                        task.spawn(function()
                            task.wait(0.35)
                            while on do
                                fn()
                                task.wait(0.08)
                            end
                        end)
                    end, function() on = false end)
                end

                -- tap a pose to lock it, tap again to release (replaces hold-key + click)
                local function togglePose(kc)
                    local p = poseData[kc]
                    if not p then return end
                    if p.locked then
                        p.locked = false
                        p.release()
                    else
                        for _, q in pairs(poseData) do
                            if q.side == p.side and q.locked then
                                q.locked = false
                                q.release()
                            end
                        end
                        p.locked = true
                        p.apply()
                    end
                end

                -- ---------- look pad (drag anywhere that has no button) ----------
                local pad = Instance.new("Frame")
                pad.Name = "LookPad"
                pad.BackgroundTransparency = 1
                pad.Size = UDim2.fromScale(1, 1)
                pad.Active = true
                pad.ZIndex = 1
                pad.Parent = gui

                local lookInput, lastPos
                pad.InputBegan:Connect(function(input)
                    if lookInput or not isPress(input) then return end
                    lookInput = input
                    lastPos = Vector2.new(input.Position.X, input.Position.Y)
                    local conn
                    conn = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End
                           or input.UserInputState == Enum.UserInputState.Cancel then
                            conn:Disconnect()
