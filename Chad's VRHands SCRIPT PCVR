    -- Named so the mobile buttons can feed the exact same logic as the keyboard/mouse.
    local function onInputBegan(io, gameProcessed)
        -- LMB / RMB still work while the pointer is over (or clicking) the menu; other keys keep Roblox's own rule
        local isMouseBtn = io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.MouseButton2
        if gameProcessed and not (isMouseBtn and not UIS:GetFocusedTextBox()) then return end

        if io.UserInputType == Enum.UserInputType.Keyboard then
            keys[io.KeyCode] = true
            if io.KeyCode == Enum.KeyCode.LeftAlt then if S.world and S.world.count > 0 then S.world.free = not S.world.free else setLook(not S.look) end end
            if io.KeyCode == Enum.KeyCode.Equals  then setScale(S.scale + 1) end
            if io.KeyCode == Enum.KeyCode.Minus   then setScale(S.scale - 1) end

            -- Camera view (C): Normal > Front (2nd POV) > Hands > Left Hand > Right Hand
            if io.KeyCode == Enum.KeyCode.C and not UIS:GetFocusedTextBox() then S.cycleCam() end

            -- Free head (Numpad 7): rotate your head any way, upside down and sideways included
            if io.KeyCode == Enum.KeyCode.KeypadSeven and not UIS:GetFocusedTextBox() then S.toggleFreeHead() end
            -- Numpad 9: lock upside down (press again to flip back)
            if io.KeyCode == Enum.KeyCode.KeypadNine and not UIS:GetFocusedTextBox() then S.flipUpsideDown() end

            -- Third person toggle
            if io.KeyCode == Enum.KeyCode.P then
                S.thirdPerson = not S.thirdPerson
            end

            -- Hand mode (N): hands are moved separately from the camera
            -- (PC: mouse, mobile: the two hand joysticks)
            if io.KeyCode == Enum.KeyCode.N then
                S.handMode = not S.handMode
                if S.handMode then S.aimMode = false end
            end

            -- Aim mode (V): the mouse ROTATES the hands, so you can aim a gun yourself
            -- (hold LMB = left hand only, RMB = right hand only, none = both)
            if io.KeyCode == Enum.KeyCode.V then
                S.aimMode = not S.aimMode
                if S.aimMode then S.handMode = false end
            end

            -- Reset hands (B): back to the default position and reach
            if io.KeyCode == Enum.KeyCode.B then
                S.handLX, S.handLY = 0, 0
                S.handRX, S.handRY = 0, 0
                S.aimLYaw, S.aimLPitch, S.aimRYaw, S.aimRPitch = 0, 0, 0, 0
                S.aimLRoll, S.aimRRoll = 0, 0
                S.reachL, S.reachR = 2, 2
            end

            if io.KeyCode == Enum.KeyCode.RightControl then
                _G.NoVR_HUD_Visible = not _G.NoVR_HUD_Visible
                if hudLabel then
                    hudLabel.Visible = _G.NoVR_HUD_Visible
                end
            end

            if io.KeyCode == Enum.KeyCode.E then S.eSuppress = false end
            if Input and io.KeyCode == Enum.KeyCode.E and not S.eSuppress then Input.rIndex = 1; Input.rFist = 0; Input.rThumb = 0 end
            if Input and io.KeyCode == Enum.KeyCode.Q then Input.lIndex = 1; Input.lFist = 0; Input.lThumb = 0 end
            if io.KeyCode == Enum.KeyCode.J and not UIS:GetFocusedTextBox() then trigger.held = true end

            local pose = poseData[io.KeyCode]
            if pose then
                pose.held = true
                if not pose.locked then
                    pose.apply()
                end
            end

        elseif io.UserInputType == Enum.UserInputType.MouseButton1 then
            mouseDown.L = true
            if anyPoseKeyHeld("L") then
                for _, pose in pairs(poseData) do
                    if pose.held and pose.side == "L" then
                        pose.locked = true
                    end
                end
            elseif anyPoseLocked("L") then
                for _, pose in pairs(poseData) do
                    if pose.locked and pose.side == "L" then
                        pose.locked = false
                        pose.release()
                    end
                end
            else
                if Input then Input.lFist = 1; Input.lIndex = 1 end
            end
        elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
            mouseDown.R = true
            if anyPoseKeyHeld("R") then
                for _, pose in pairs(poseData) do
                    if pose.held and pose.side == "R" then
                        pose.locked = true
                    end
                end
            elseif anyPoseLocked("R") then
                for _, pose in pairs(poseData) do
                    if pose.locked and pose.side == "R" then
                        pose.locked = false
                        pose.release()
                    end
                end
            else
                if Input then Input.rFist = 1; Input.rIndex = 1 end
            end
        end
    end
    UIS.InputBegan:Connect(function(io, gp) onInputBegan(KB.xlate(io), gp) end)
    -- the wave key works even when the game itself uses that number key (hotbar), but never while typing
    UIS.InputBegan:Connect(function(io)
        if io.UserInputType ~= Enum.UserInputType.Keyboard or KB.capture or UIS:GetFocusedTextBox() then return end
        if KB.xlate(io).KeyCode == Enum.KeyCode.Five then S.waveHi() end
    end)

    local function onInputEnded(io, gameProcessed)
        if io.UserInputType == Enum.UserInputType.Keyboard then
            keys[io.KeyCode] = false
            if io.KeyCode == Enum.KeyCode.E then S.eSuppress = false end
            if Input and io.KeyCode == Enum.KeyCode.E then Input.rIndex = 0 end
            if Input and io.KeyCode == Enum.KeyCode.Q then Input.lIndex = 0 end
            if io.KeyCode == Enum.KeyCode.J and trigger.held then
                trigger.held = false
                restoreIndex()
            end

            local pose = poseData[io.KeyCode]
            if pose then
                pose.held = false
                if not pose.locked then
                    pose.release()
                end
            end

        elseif io.UserInputType == Enum.UserInputType.MouseButton1 then
            mouseDown.L = false
            if not anyPoseKeyHeld("L") and not anyPoseLocked("L") then
                if Input then Input.lFist = 0; Input.lIndex = 0 end
            end
        elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
            mouseDown.R = false
            if not anyPoseKeyHeld("R") and not anyPoseLocked("R") then
                if Input then Input.rFist = 0; Input.rIndex = 0 end
            end
        end
    end
    UIS.InputEnded:Connect(function(io, gp) onInputEnded(KB.xlate(io), gp) end)

    UIS.InputChanged:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseWheel then
            addReach(-io.Position.Z * 0.25)
        end
    end)

    local function isTyping()
        return UIS:GetFocusedTextBox() ~= nil
    end

    function U.emuStep(dt)
        if S.uiLook and not isTyping() then
            -- VR-style menu: the mouse turns your head, smoothed (an exponential glide, so the total turn is the same but it never jerks)
            UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
            UIS.MouseIconEnabled = false
            touch.look = Vector2.zero
            -- creep along slowly (10% speed) so you can walk without outrunning the menu; it drifts after you anyway
            local m = Vector3.zero
            if keys[Enum.KeyCode.W] then m += Vector3.new(0,0,-1) end
            if keys[Enum.KeyCode.S] then m += Vector3.new(0,0, 1) end
            if keys[Enum.KeyCode.A] then m += Vector3.new(-1,0,0) end
            if keys[Enum.KeyCode.D] then m += Vector3.new( 1,0,0) end
            m += Vector3.new(touch.move.X, 0, touch.move.Y)
            if m.Magnitude > 0 then
                local hs0 = cam.HeadScale; if hs0 <= 1 then hs0 = S.scale * 60 end
                local rt = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
                camPos = camPos + (rt * m.Unit) * (100 + S.scale * 4) * hs0 * S.moveK * (S.menuSpeed or 0.1) * dt * math.min(m.Magnitude, 1)
                if S.domeLock and S.domeClamp then camPos = S.domeClamp(camPos) end
                headCF = CFrame.new(camPos) * rt
                if S.ball == nil or not S.ball.vr then cam.CFrame = headCF end
            end
            return
        end
        if S.menuOpen or isTyping() then return end
        local md = UIS:GetMouseDelta()
        if S.handMode then
            local moveL = mouseDown.L or not mouseDown.R
            local moveR = mouseDown.R or not mouseDown.L
            if moveL then
                S.handLX = math.clamp(S.handLX + md.X * S.handSens, -4, 4)
                S.handLY = math.clamp(S.handLY - md.Y * S.handSens, -4, 4)
            end
            if moveR then
                S.handRX = math.clamp(S.handRX + md.X * S.handSens, -4, 4)
                S.handRY = math.clamp(S.handRY - md.Y * S.handSens, -4, 4)
            end
        elseif S.aimMode then
            local moveL = mouseDown.L or not mouseDown.R
            local moveR = mouseDown.R or not mouseDown.L
            local rolling = keys[Enum.KeyCode.Y]
            if moveL then
                if rolling then S.aimLRoll = S.wrapAng(S.aimLRoll - md.X * S.aimSens)
                else S.aimLYaw = S.wrapAng(S.aimLYaw - md.X * S.aimSens) end
                S.aimLPitch = S.wrapAng(S.aimLPitch - md.Y * S.aimSens)
            end
            if moveR then
                if rolling then S.aimRRoll = S.wrapAng(S.aimRRoll - md.X * S.aimSens)
                else S.aimRYaw = S.wrapAng(S.aimRYaw - md.X * S.aimSens) end
                S.aimRPitch = S.wrapAng(S.aimRPitch - md.Y * S.aimSens)
            end
        end
        local kd = 0
        if KB.down(Enum.KeyCode.KeypadPlus) then kd += 1 end
        if KB.down(Enum.KeyCode.KeypadMinus) then kd -= 1 end
        if kd ~= 0 then addReach(kd * 3 * dt) end
    end

    local reachHold, reachHoldDir = 0, 0   -- how long Numpad +/- has been held (for acceleration)

    U.bind("NoVR_Control", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if S.look and not isTyping() then
            local md = UIS:GetMouseDelta()
            if S.handMode then
                -- PC: mouse right = hand right, mouse up = hand up.
                -- Hold LMB = left hand only, hold RMB = right hand only,
                -- nothing (or both) held = both hands together.
                local moveL = mouseDown.L or not mouseDown.R
                local moveR = mouseDown.R or not mouseDown.L
                if moveL then
                    S.handLX = math.clamp(S.handLX + md.X * S.handSens, -4, 4)
                    S.handLY = math.clamp(S.handLY - md.Y * S.handSens, -4, 4)
                end
                if moveR then
                    S.handRX = math.clamp(S.handRX + md.X * S.handSens, -4, 4)
                    S.handRY = math.clamp(S.handRY - md.Y * S.handSens, -4, 4)
                end
                -- Mobile: dragging on empty screen still turns the camera,
                -- because the hands are driven by the two joysticks instead.
                S.lookTurn(touch.look.X, touch.look.Y)
            elseif S.aimMode then
                -- PC: mouse right = gun turns right, mouse up = gun tilts up.
                -- Hold LMB = left hand only, hold RMB = right hand only,
                -- nothing (or both) held = both hands together.
                local moveL = mouseDown.L or not mouseDown.R
                local moveR = mouseDown.R or not mouseDown.L
                -- full 360 degrees: no limits, the angle just wraps around. Hold Y to roll the hand instead of turning it.
                local rolling = keys[Enum.KeyCode.Y]
                if moveL then
                    if rolling then S.aimLRoll = S.wrapAng(S.aimLRoll - md.X * S.aimSens)
                    else S.aimLYaw = S.wrapAng(S.aimLYaw - md.X * S.aimSens) end
                    S.aimLPitch = S.wrapAng(S.aimLPitch - md.Y * S.aimSens)
                end
                if moveR then
                    if rolling then S.aimRRoll = S.wrapAng(S.aimRRoll - md.X * S.aimSens)
                    else S.aimRYaw = S.wrapAng(S.aimRYaw - md.X * S.aimSens) end
                    S.aimRPitch = S.wrapAng(S.aimRPitch - md.Y * S.aimSens)
                end
                -- touch drag still turns the camera
                S.lookTurn(touch.look.X, touch.look.Y)
            else
                local d = md + touch.look
                if S.smoothLook then   -- optional: glides the turn instead of applying every mouse tick raw
                    S.smLook = (S.smLook or Vector2.zero):Lerp(d, 1 - math.exp(-dt * 22))
                    d = S.smLook
                end
                S.lookTurn(d.X, d.Y)
            end
            UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
        elseif isTyping() then
            UIS.MouseBehavior = Enum.MouseBehavior.Default
            UIS.MouseIconEnabled = true
        end

        touch.look = Vector2.zero   -- drag deltas are used up (or ignored) each frame

        -- (Mobile hand joysticks now move the hands directly from their own
        -- drag handlers, so nothing needs to be integrated here.)

        if S.freeHead then
            local r = 0
            if not isTyping() then
                if KB.down(Enum.KeyCode.KeypadFour) then r = r + 1 end    -- roll left
                if KB.down(Enum.KeyCode.KeypadSix) then r = r - 1 end     -- roll right
                if KB.down(Enum.KeyCode.KeypadFive) then               -- level the head (keep where you look)
                    local lv0 = S.freeRot.LookVector
                    if math.abs(lv0.Y) < 0.999 then S.freeRot = CFrame.lookAt(Vector3.zero, lv0) end
                end
            end
            if r ~= 0 then S.freeRot = S.freeRot * CFrame.fromAxisAngle(Vector3.new(0, 0, 1), r * 1.6 * dt) end
            S.freeRot = CFrame.fromMatrix(Vector3.zero, S.freeRot.RightVector, S.freeRot.UpVector)   -- keep it a clean rotation
        end
        local rot
        if S.freeHead then
            rot = S.freeRot
        else
            local goal = S.flip and math.pi or 0
            S.flipAng = S.flipAng + (goal - S.flipAng) * math.min(1, dt * 12)
            if math.abs(goal - S.flipAng) < 0.01 then S.flipAng = goal end
            rot = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
            if S.flipAng ~= 0 then rot = rot * CFrame.fromAxisAngle(Vector3.new(0, 0, 1), S.flipAng) end
        end

        local hs  = cam.HeadScale; if hs <= 1 then hs = S.scale * 60 end
        local spd = (100 + S.scale * 4) * hs * S.moveK

        if keys[Enum.KeyCode.LeftControl] and not isTyping() then
            spd = spd * S.slowFactor
        end

        local mv  = Vector3.zero

        if not isTyping() then
            if keys[Enum.KeyCode.W] then mv += Vector3.new(0,0,-1) end
            if keys[Enum.KeyCode.S] then mv += Vector3.new(0,0, 1) end
            if keys[Enum.KeyCode.A] then mv += Vector3.new(-1,0,0) end
            if keys[Enum.KeyCode.D] then mv += Vector3.new( 1,0,0) end
            if keys[Enum.KeyCode.Space]     then mv += Vector3.new(0, 1,0) end
            if keys[Enum.KeyCode.LeftShift] then mv += Vector3.new(0,-1,0) end
            mv += Vector3.new(touch.move.X, 0, touch.move.Y)   -- mobile joystick
        else
            for k in pairs(keys) do keys[k] = false end
        end

        if S.menuOpen then mv = S.uiLook and mv * (S.menuSpeed or 0.1) or Vector3.zero end   -- a menu is up: stand still, or creep along (10%) if it hangs in the world
        -- amt is 1 for keys, and less than 1 for a partly pushed joystick
        if S.ball and S.ball.vr then
            camPos, rot = S.ballVR(dt, camPos, rot, mv)   -- Bouncy Ball: the ball decides where the head goes
        elseif mv.Magnitude > 0 then
            local amt = math.min(mv.Magnitude, 1)
            camPos = camPos + (rot * mv.Unit) * spd * dt * amt
        end

        -- mobile hand reach buttons (same job as the mouse wheel)
        if touch.reachDir ~= 0 then
            addReach(touch.reachDir * 3 * dt)
        end
        -- Numpad + / - : hand reach out / in (hold to keep going)
        if not isTyping() then
            local kd = 0
            if KB.down(Enum.KeyCode.KeypadPlus)  then kd += 1 end
            if KB.down(Enum.KeyCode.KeypadMinus) then kd -= 1 end
            if kd ~= 0 then
                if kd ~= reachHoldDir then reachHold = 0 end   -- switched direction: start slow again
                reachHoldDir = kd
                reachHold = reachHold + dt
                -- starts at 3 studs/sec and speeds up the longer you hold
                -- (REACH_ACCEL = how fast it ramps, REACH_MAX = top speed)
                local REACH_ACCEL, REACH_MAX = 1.5, 1000000
                local speed = math.min(3 * math.exp(reachHold * REACH_ACCEL), REACH_MAX)
                addReach(kd * speed * dt)
            else
                reachHold, reachHoldDir = 0, 0
            end
        end
        if S.domeLock and S.domeClamp then camPos = S.domeClamp(camPos) end   -- locked dome: the plates are a wall
        headCF = CFrame.new(camPos) * rot

        -- Third person zoom: hold I = zoom in, O = zoom out.
        -- (IsKeyDown so the game can't swallow the keys; exponential speed.)
        if not isTyping() then
            local zoomRate = 0.9
            -- Hard limit on how far the camera can go IN STUDS, so the map can
            -- never be pushed out past the draw distance (it vanishes there).
            -- Bigger avatars are allowed proportionally more room.
            local maxMult = math.max(1500 / headUnit(), 3)
            S.tpDist = math.min(S.tpDist, maxMult)
            if KB.down(Enum.KeyCode.O) or touch.zoomOut then
                S.tpDist = math.clamp(S.tpDist * math.exp(zoomRate * dt), 0.3, maxMult)
            end
            if KB.down(Enum.KeyCode.I) or touch.zoomIn then
                S.tpDist = math.clamp(S.tpDist * math.exp(-zoomRate * dt), 0.3, maxMult)
            end
        end

        -- How far in front of the camera the head sits (0 in first person).
        local D = 0
        if S.thirdPerson then D = S.tpDist * headUnit() end
        S.curD   = D
        TP.D     = D
        TP.scale = resolveScale()

        cam.CameraType = Enum.CameraType.Scriptable
        -- The game positions your real (replicated) head from the camera, so the
        -- camera stays ON the head while the game runs. It is only pulled back
        -- right before the frame is drawn (see NoVR_CamView below), so other
        -- players never see your head follow the third-person camera.
        camBack = CFrame.new(camPos - rot.LookVector * D) * rot
        if S.camView ~= "Normal" then
            -- zoom (I / O) sets how far the camera sits from whatever it follows
            local dist = math.max(S.tpDist * headUnit(), 0.5)
            local sc = resolveScale()
            local function handPos(side)
                local off
                if side < 0 then off = Vector3.new(-S.spread + S.handLX, S.height + S.handLY, -S.reachL)
                else off = Vector3.new(S.spread + S.handRX, S.height + S.handRY, -S.reachR) end
                return headCF:PointToWorldSpace(off * sc)
            end
            if S.camView == "Front" then
                -- 2nd POV: camera in front of you, looking back at your avatar
                camBack = CFrame.lookAt(camPos + rot.LookVector * dist, camPos)
            else
                -- Hand POV: the camera rides along with the hand(s) (your head stays put).
                -- You still steer with the mouse; reach out far and the view follows your hand out there.
                local target
                if S.camView == "Left Hand" then target = handPos(-1)
                elseif S.camView == "Right Hand" then target = handPos(1)
                else target = (handPos(-1) + handPos(1)) / 2 end
                camBack = CFrame.new(target - rot.LookVector * dist) * rot
            end
        end
        if S.ball and S.ball.vr then headCF, camBack = S.ballVRView(headCF, camBack, rot) end
        cam.CFrame = headCF

        if Input then
            Input.directionLateral  = Vector2.zero
            Input.directionVertical = 0
            Input.turnDirection     = 0

            for _, pose in pairs(poseData) do
                if pose.locked then pose.apply() end
            end
            S.gestApply()   -- a held custom gesture wins over everything else

            -- J = pull the trigger on every hand that is gripping something
            if trigger.held then
                if Input.lFist == 1 then Input.lIndex = 1 end
                if Input.rFist == 1 then Input.rIndex = 1 end
            end
        end
    end)

    -- camera sits on the head at the start of every frame (what the game reads)...
    U.bind("NoVR_CamHead", Enum.RenderPriority.First.Value, function()
        cam.CFrame = headCF
    end)
    -- ...and is moved back to the third-person view after everything else ran,
    -- so only YOUR screen sees it there.
    -- Sound: the game's voice chat is positional, and it is heard from the camera. Since your head stays where it
    -- is while the camera rides along with a hand (or the front view), the listener is pinned to the VIEW camera
    -- in every non-Normal view, so you hear whoever is near the camera / hand. Normal view = Roblox default.
    local SoundService = game:GetService("SoundService")
    local listenerPinned = false
    -- Newer voice chat setups put their own AudioListener on the character / head, and then SetListener is ignored.
    -- So in a non-Normal view every AudioListener the game made is moved onto an invisible part that rides on the
    -- view camera, and is put back when you return to Normal view.
    local viewPart
    local movedListeners = {}   -- AudioListener -> its original parent
    local lastListenerScan = -100
    local function ensureViewPart()
        if viewPart and viewPart.Parent then return viewPart end
        viewPart = Instance.new("Part")
        viewPart.Name = "NoVR_ListenerPart"
        viewPart.Anchored = true
        viewPart.CanCollide = false
        viewPart.CanQuery = false
        viewPart.CanTouch = false
        viewPart.Transparency = 1
        viewPart.Size = Vector3.new(0.2, 0.2, 0.2)
        viewPart.Parent = workspace
        return viewPart
    end
    local function scanListeners(part)
        local n = 0
        for _, d in ipairs(game:GetDescendants()) do
            if d.ClassName == "AudioListener" and d.Parent ~= part and movedListeners[d] == nil then
                movedListeners[d] = d.Parent
                local ok = pcall(function() d.Parent = part end)
                if ok then n = n + 1 else movedListeners[d] = nil end
            end
        end
        if n > 0 then print("[NoVR] audio: moved " .. n .. " AudioListener(s) onto the view camera") end
    end
    local function releaseListeners()
        for l, par in pairs(movedListeners) do
            pcall(function()
                if l.Parent == viewPart and par and par.Parent then l.Parent = par end
            end)
            movedListeners[l] = nil
        end
    end
    S.zoom = 1
    S.dolly = 0   -- studs the view has flown forward past full zoom
    U.bind("NoVR_CamView", Enum.RenderPriority.Last.Value + 10000, function()
        cam.CFrame = camBack
        do   -- zoom: hold Z to zoom in, X to zoom out. The field of view narrows (down to 1 degree, about 70x)
            local now = os.clock()
            local dt = math.min(now - (S.zoomT or now), 0.1)
            S.zoomT = now
            local zin, zout = keys[Enum.KeyCode.Z], keys[Enum.KeyCode.X]
            if zin ~= zout then
                if not S.zoomBase then S.zoomBase = cam.FieldOfView end
                local zmax = math.max(S.zoomBase, 1)
                local f = math.exp(dt * 1.6)
                if zin then
                    if S.zoom < zmax - 0.01 then S.zoom = math.min(S.zoom * f, zmax)
                    else S.dolly = math.min(math.max(S.dolly, 3) * math.exp(dt * 3), 1e9) end   -- fully zoomed in: the view flies forward, no limit
                elseif S.dolly > 0 then
                    S.dolly = S.dolly / math.exp(dt * 3)
                    if S.dolly < 3 then S.dolly = 0 end
                else
                    S.zoom = math.max(S.zoom / f, 1)
                end
            end
            if S.zoomBase then
                if S.zoom <= 1.001 and S.dolly == 0 then
                    S.zoom = 1
                    cam.FieldOfView = S.zoomBase
                    S.zoomBase = nil
                else
                    cam.FieldOfView = math.max(S.zoomBase / S.zoom, 1)
                end
            end
            if S.dolly > 0 then cam.CFrame = cam.CFrame + cam.CFrame.LookVector * S.dolly end
        end
        if S.camView ~= "Normal" then
            if not listenerPinned then
                listenerPinned = true
                lastListenerScan = -100
                print("[NoVR] audio: listening from the " .. S.camView .. " camera")
            end
            pcall(function() SoundService:SetListener(Enum.ListenerType.CFrame, camBack) end)
            local part = ensureViewPart()
            part.CFrame = camBack
            if os.clock() - lastListenerScan > 3 then
                lastListenerScan = os.clock()
                pcall(scanListeners, part)
            end
        elseif listenerPinned then
            listenerPinned = false
            pcall(releaseListeners)
            pcall(function() SoundService:SetListener(Enum.ListenerType.Camera) end)
        end
    end)

    -- ============ CROSSHAIR (shows where a held gun points) ============
    -- Settings live in XH and are edited from Start Menu > dock > crosshair icon.
    -- A crosshair only shows for a hand that is gripping something (see "detect").
    local XH = {
        enabled = true,
        style = "Cross",        -- Cross | T | Circle | Dot
        size = 14, gap = 5, thickness = 2,
        color = Color3.fromRGB(0, 255, 140),
        opacity = 1,
        outline = true,
        dot = false,            -- extra centre dot
        axis = "Forward",       -- which way the gun points: Forward | Back | Up | Down | Right | Left
        detect = "Held object", -- "Held object" (needs an item near the hand) | "Grip only" (any closed fist)
        radius = 4,             -- how close (studs) an item must be to the hand to count as held
        always = false,         -- show even when not holding anything (aims from the hand)
        aimbot = false,         -- the held gun steers toward the nearest player inside the aim cone
        abFov = 20,             -- aim cone in degrees around where the gun points
        abSmooth = 30,          -- aim speed in percent (low = gentle, high = snaps)
        abKey = "Always",       -- Always | Hold right mouse | Hold shift
        abPart = "Head",        -- Head | Body
        dirty = true,
    }
    local XH_DEFAULTS = {}
    for k, v in pairs(XH) do XH_DEFAULTS[k] = v end

    -- ============ AUTO SAVE ============
    -- Settings and your last changes (hands, reach, camera view, crosshair, theme ...) are written to
    -- NoVR_Settings.json (executor workspace folder) a moment after they change, and loaded at the next start.
    -- Delete that file to go back to the defaults.
    local SAVE_FILE = "NoVR_Settings.json"
    -- ===== key / usage time (Profile > STATUS > KEY ACCESS) =====
    -- The key service's loader doesn't tell the script when the key ends, so the countdown only shows if the loader (or you) sets
    --   getgenv().NOVR_KEY_EXPIRES = <unix seconds when the key ends>   (or "lifetime")
    -- before this script runs. The "using the script for" counters always work: this session, and the total across sessions.
    do
        local U = { start = os.time(), base = 0, first = os.time() }
        S.usage = U
        local FILE = "NoVR_Usage.json"
        local HS = game:GetService("HttpService")
        if type(readfile) == "function" and type(isfile) == "function" then
            local ok, raw = pcall(function() return isfile(FILE) and readfile(FILE) or nil end)
            if ok and type(raw) == "string" then
                local okd, d = pcall(HS.JSONDecode, HS, raw)
                if okd and type(d) == "table" then
                    if type(d.total) == "number" and d.total >= 0 and d.total < 1e9 then U.base = d.total end
                    if type(d.first) == "number" and d.first > 0 then U.first = d.first end
                end
            end
        end
        function U.session() return math.max(os.time() - U.start, 0) end
        function U.total() return U.base + U.session() end
        function U.expires()   -- unix seconds, "lifetime", or nil when nothing was provided
            local env = (getgenv and getgenv()) or _G
            local v = env.NOVR_KEY_EXPIRES
            if type(v) == "string" then
                if string.lower(v) == "lifetime" then return "lifetime" end
                v = tonumber(v)
            end
            if type(v) ~= "number" or v ~= v then return nil end
            if v <= 0 or v == math.huge then return "lifetime" end
            if v > 1e12 then v = v / 1000 end   -- milliseconds
            return v
        end
        function U.fmt(sec)
            sec = math.max(math.floor(sec), 0)
            local d, h, m, s = sec // 86400, (sec % 86400) // 3600, (sec % 3600) // 60, sec % 60
            if d > 0 then return string.format("%dd %02dh %02dm %02ds", d, h, m, s) end
            return string.format("%dh %02dm %02ds", h, m, s)
        end
        local function save()
            if type(writefile) == "function" then
                pcall(function() writefile(FILE, HS:JSONEncode({ total = U.total(), first = U.first })) end)
            end
        end
