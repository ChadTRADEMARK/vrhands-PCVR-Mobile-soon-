                -- Chat: the game's public chat (read + send). Roblox direct messages need roblox.com.
                local function showChat()
                    local my = startPage("chat", "")
                    heading(1, "Chat")
                    noteLine(2, "This is the chat of the game you are in. Direct messages with friends are only on roblox.com.")
                    local TCS = game:GetService("TextChatService")
                    local channel
                    pcall(function()
                        local chs = TCS:FindFirstChild("TextChannels")
                        channel = chs and (chs:FindFirstChild("RBXGeneral") or chs:GetChildren()[1])
                    end)
                    local log = Instance.new("Frame")
                    log.LayoutOrder = 3
                    log.Size = UDim2.new(1, -8, 0, 0)
                    log.AutomaticSize = Enum.AutomaticSize.Y
                    log.BackgroundTransparency = 1
                    log.Parent = page
                    local ll2 = Instance.new("UIListLayout")
                    ll2.Padding = UDim.new(0, 3)
                    ll2.SortOrder = Enum.SortOrder.LayoutOrder
                    ll2.Parent = log
                    local n = 0
                    local function addLine(who, text, mine)
                        n += 1
                        local l = Instance.new("TextLabel")
                        l.LayoutOrder = n
                        l.Size = UDim2.new(1, 0, 0, 0)
                        l.AutomaticSize = Enum.AutomaticSize.Y
                        l.BackgroundTransparency = 1
                        l.TextWrapped = true
                        l.TextXAlignment = Enum.TextXAlignment.Left
                        l.Font = Enum.Font.GothamMedium
                        l.TextSize = 12
                        l.RichText = false
                        l.TextColor3 = mine and GREEN or WHITE
                        l.Text = who .. ":  " .. text
                        l.Parent = log
                        if n > 80 then for _, c in ipairs(log:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() break end end end
                    end
                    if channel then
                        chatConn = channel.MessageReceived:Connect(function(msg)
                            if not log.Parent then if chatConn then chatConn:Disconnect() chatConn = nil end return end
                            local src = msg.TextSource
                            local pl = src and PlayersSvc:GetPlayerByUserId(src.UserId)
                            addLine(pl and pl.DisplayName or (src and src.Name) or "system", tostring(msg.Text or ""):gsub("<[^>]+>", ""), pl == lp)
                        end)
                    end
                    local inputRow = Instance.new("Frame")
                    inputRow.LayoutOrder = 4
                    inputRow.Size = UDim2.new(1, -8, 0, 34)
                    inputRow.BackgroundTransparency = 1
                    inputRow.Parent = page
                    local tb = Instance.new("TextBox")
                    tb.Size = UDim2.new(1, -96, 0, 32)
                    tb.BackgroundColor3 = PINK
                    tb.BackgroundTransparency = 0.85
                    tb.BorderSizePixel = 0
                    tb.Text = ""
