    local function avApply()
        local ch = lp.Character
        if ch then
            for _, d in ipairs(ch:GetDescendants()) do
                if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency >= 0.99 then
                    if U.avSaved[d] == nil then U.avSaved[d] = d.Transparency end
                    d.Transparency = 0
                end
            end
            local hm = ch:FindFirstChildOfClass("Humanoid")
            if hm then
                if cam.CameraSubject ~= hm then cam.CameraSubject = hm end
                hm.AutoRotate = true
            end
        end
        local r = vrPlayers and vrPlayers:FindFirstChild(uid)
        if r then avHide(r) end
        -- laser pointers / rays the game keeps beside the rig or on the camera
        for _, holder in ipairs({ cam, workspace }) do
            for _, d in ipairs(holder:GetChildren()) do
                local nm = string.lower(d.Name)
                local kind = string.find(nm, "laser", 1, true) or string.find(nm, "pointer", 1, true) or string.find(nm, "beam", 1, true)
                -- on the camera any such thing is ours; in the workspace only if its name carries your id / name
                local mine = holder == cam or string.find(nm, uid, 1, true) or string.find(nm, string.lower(lp.Name), 1, true)
                if kind and mine and (d:IsA("BasePart") or d:IsA("Beam") or d:IsA("Model") or d:IsA("Folder")) and not d:FindFirstChildOfClass("Humanoid") then
                    if d:IsA("Beam") then
                        if d.Enabled then U.avOff[d] = true; d.Enabled = false end
                    elseif d:IsA("BasePart") then
                        d.LocalTransparencyModifier = 1
                    else
                        avHide(d)
                    end
                end
            end
        end
    end
