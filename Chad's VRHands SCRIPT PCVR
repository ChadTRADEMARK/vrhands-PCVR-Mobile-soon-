                        local side = v - dir * v:Dot(dir)   -- sideways speed is bled off so nothing keeps circling: everything falls into the hole
                        v = v - side * math.min(1, (0.4 + 3 * k) * dt)
                        if not b.hl and b.dim >= 10 and dB < 2200 and (c.hlN or 0) < (c.prof and c.prof.hl or 24) and not b.water then   -- heated by the fall
                            pcall(function()
                                local h = Instance.new("Highlight")
                                h.FillColor, h.OutlineColor = Color3.fromRGB(255, 110, 35), Color3.fromRGB(255, 215, 140)
                                h.FillTransparency, h.OutlineTransparency = 0.8, 0.4
                                h.DepthMode = Enum.HighlightDepthMode.Occluded
                                h.Adornee = b.p
                                h.Parent = b.p
                                b.hl = h
                                c.hlN = (c.hlN or 0) + 1
                            end)
                        end
                        if b.hl then b.hl.FillTransparency = math.clamp(0.85 - 0.8 * (1 - dB / 2200), 0.05, 1) end
                    end
                    local np = pos + v * dt
                    if not b.water and t < b.liftT + 1.2 then   -- look down at what is really under it, a few at a time
                        b.rayT = (b.rayT or 0) - dt
                        if b.rayT <= 0 and (c.rayN or 0) < (S.perfLow() and 5 or 12) then
                            c.rayN = (c.rayN or 0) + 1
                            b.rayT = 0.2 + (i % 5) * 0.03
                            if not c.rayP then
                                c.rayP = RaycastParams.new()
                                c.rayP.FilterType = Enum.RaycastFilterType.Exclude
                            end
                            c.rayP.FilterDescendantsInstances = { c.suckf, lp.Character }
                            local hit = workspace:Raycast(np + Vector3.new(0, 40, 0), Vector3.new(0, -260, 0), c.rayP)
                            if hit then b.gy = hit.Position.Y + b.dim * 0.3 end
                        end
                    end
                    if not b.water and t < b.liftT + 1 and np.Y < b.gy then   -- it hits the ground: bounces, slides, loses speed and spin
                        local impact = -v.Y
                        np = Vector3.new(np.X, b.gy, np.Z)
                        if impact > 0 then
                            v = Vector3.new(v.X * 0.7, impact * 0.28, v.Z * 0.7)
                            w = w * 0.65
                            if impact > 22 and b.dim >= 5 then pcall(S.suckPuff, c, np, b.dim, impact, b.col) end
                        end
                    end
                    local rot = b.cf.Rotation
                    if w.Magnitude > 0.01 then rot = rot * CFrame.fromAxisAngle(w.Unit, w.Magnitude * dt) end
                    b.v, b.w = v, w
                    local cf
                    if b.water then   -- a blob that wobbles, then stretches along its way
                        local sp = v.Magnitude
                        local look = sp > 5 and CFrame.lookAt(Vector3.zero, v) or rot
