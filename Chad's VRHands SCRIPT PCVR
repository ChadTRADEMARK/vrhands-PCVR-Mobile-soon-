                            w1.SourceInstance = m
                            w1.TargetInstance = f
                            w1.Parent = f
                            local w2 = Instance.new("Wire")
                            w2.SourceInstance = f
                            w2.TargetInstance = o
                            w2.Parent = o
                            Mic.mon, Mic.monOut = f, o
                        end)
                        if not ok then return false end
                    end
                    Mic.monitorOn = true
                else
                    Mic.monitorOn = false
