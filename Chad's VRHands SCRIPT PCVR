        function S.suckStep(c, age0, now, dt)
            if c.suckFreed then return end
            if not c.suckObjs then return end
            local tI = c.tIo or (FX and FX.tImp or 26)
            local ddt = math.clamp(dt or 0.016, 0, 0.1)
            if not c.suckT then   -- the scan is done: every object gets its moment
                c.suckT = true
                local rnd = c.suckRnd
                local base = math.max(age0 + 0.5, 4)
                local window = math.max(tI - 1.5 - base, 3)
                for _, ob in ipairs(c.suckObjs) do
                    local early = ob.kind == "chunk" and 0.15 or (ob.kind == "water" and 0.35 or 0)
                    ob.ts = base + (early + rnd:NextNumber() * 0.5) * window * 0.8
                    ob.dur = math.clamp(6.5 + rnd:NextNumber() * 4, 2.5, math.max(tI - 0.8 - ob.ts, 2.5))
                    if ob.kind == "water" and not c.waterT then c.waterT = ob.ts end
                end
                c.waterT = c.waterT or (c.roam and 20 or 14.8)
                c.dbrDeadline = tI - 0.6
                local cen = c.suckCenter
                for _, rec in ipairs(c.suckBigs or {}) do   -- the islands crumble from the far ones to the near ones
                    rec.Th = base + 1.5 + (1 - math.clamp(rec.d / (c.suckRad or 2600), 0, 1)) * window * 0.7 + rnd:NextNumber() * 1.5
                end
                for _, ob in ipairs(c.suckObjs) do
                    if ob.frag then
                        ob.ts = math.max(ob.rec.Th - 0.8 + rnd:NextNumber() * 2, base)
                        ob.dur = math.clamp(9 + rnd:NextNumber() * 4, 4, math.max(tI - 0.8 - ob.ts, 2.5))   -- slow
                    end
                end
                c.restQ, c.restI, c.hidden = {}, 1, {}
                for _, p in ipairs(c.suckRest or {}) do
                    local dd = (p.Position - cen).Magnitude
                    c.restQ[#c.restQ + 1] = { p, base + 2 + (1 - math.clamp(dd / (c.suckRad or 2600), 0, 1)) * window * 0.7 + rnd:NextNumber() * 2 }
                end
                table.sort(c.restQ, function(a, b) return a[2] < b[2] end)
