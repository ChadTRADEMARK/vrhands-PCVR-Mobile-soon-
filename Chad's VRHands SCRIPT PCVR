            -- generic overlay: panel + title + close button. Calling it again
            -- while it is open closes it (toggle).
            local function overlay(slot, x, y, w, h, name, title)
                local cascade = 0
                for _, other in ipairs({ "controls", "settings", "crosshair", "teleport", "profile", "servers", "roblox", "search", "gesture", "emu", "people", "accounts", "chat", "owner", "live", "req", "mic" }) do
                    if other ~= slot and me[other] and not me[other].closed then
                        cascade = cascade + 1   -- windows stay open side by side: each new one is offset a little
                    end
                end
                if me[slot] and not me[slot].closed then me[slot].close(); me[slot] = nil; return nil end
                x = x + 28 * math.min(cascade, 6)
                y = y + 24 * math.min(cascade, 6)
                local defW, defH = w, h
                local fixed = false
                local minW, minH = math.max(340, math.floor(defW * 0.75)), math.max(300, math.floor(defH * 0.75))
                if slot == "profile" then minW = defW end
                if not fixed and type(S.panelSize) == "table" and type(S.panelSize[slot]) == "table" then
                    local sw, sh2 = tonumber(S.panelSize[slot][1]), tonumber(S.panelSize[slot][2])
                    if sw and sh2 then
                        local v = cam.ViewportSize
                        local k = math.max(fit.Scale, 0.01)
                        w = math.clamp(sw, minW, math.max(minW, v.X / k - x - 8))
                        h = math.clamp(sh2, minH, math.max(minH, v.Y / k - y - 30))
                    end
                end
                local p, ent = makePanel(x, y, w, h, name, 0)
                me[slot] = ent
                ent.defW, ent.defH, ent.w, ent.h, ent.minW, ent.minH = defW, defH, w, h, minW, minH
                ent.stretchList = {}
                -- Call after setting the instance's offset Size: the panel grows / shrinks it together with itself.
                -- kw / kh = how much of the width / height change it takes (1 = all of it).
                function ent.stretchAdd(inst, kw, kh)
                    local rec = { inst = inst, w = inst.Size.X.Offset, h = inst.Size.Y.Offset, kw = kw or 0, kh = kh or 0 }
                    ent.stretchList[#ent.stretchList + 1] = rec
                    local dw, dh = ent.w - ent.defW, ent.h - ent.defH
                    inst.Size = UDim2.fromOffset(math.max(rec.w + dw * rec.kw, 40), math.max(rec.h + dh * rec.kh, 40))
                end
                -- For menus laid out with fixed positions: moves everything below topY into a scrolling area that
                -- stretches with the menu, so a smaller menu scrolls instead of cutting off / overlapping buttons.
                function ent.scrollify(topY)
                    local body = Instance.new("ScrollingFrame")
                    body.Name = "Body"
                    body.Position = UDim2.fromOffset(0, topY)
                    body.Size = UDim2.fromOffset(ent.defW, ent.defH - topY)
                    body.BackgroundTransparency = 1
                    body.BorderSizePixel = 0
                    body.ScrollBarThickness = 4
                    body.ScrollingDirection = Enum.ScrollingDirection.Y
                    body.CanvasSize = UDim2.new()
                    body.ZIndex = 2
                    body.Parent = p
                    local bottom = 0
                    for _, c in ipairs(p:GetChildren()) do
                        if c:IsA("GuiObject") and c ~= body and c.Name ~= "Bg" and c.Name ~= "Grip" and c.Name ~= "Resize"
                           and c.AnchorPoint.Y == 0 and c.Position.Y.Scale == 0 and c.Position.Y.Offset >= topY then
                            local ny = c.Position.Y.Offset - topY
                            c.Position = UDim2.new(c.Position.X.Scale, c.Position.X.Offset, 0, ny)
                            bottom = math.max(bottom, ny + c.Size.Y.Offset)
                            c.Parent = body
                        end
                    end
                    body.CanvasSize = UDim2.fromOffset(0, bottom + 14)
                    ent.stretchAdd(body, 1, 1)
                end
                function ent.applySize(nw, nh)
                    ent.w, ent.h = nw, nh
                    ent.resize(nw, nh)
                    local dw, dh = nw - ent.defW, nh - ent.defH
                    for _, r in ipairs(ent.stretchList) do
                        if r.inst.Parent then
                            r.inst.Size = UDim2.fromOffset(math.max(r.w + dw * r.kw, 40), math.max(r.h + dh * r.kh, 40))
                        end
                    end
                    if ent.onResize then ent.onResize(nw, nh) end
                end
