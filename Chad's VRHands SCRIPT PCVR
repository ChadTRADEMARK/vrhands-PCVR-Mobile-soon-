        end
        function Chat.invite(uid)
            if not Chat.iAmOwner() then return false, "Only the owner can bring people." end
            if game.PrivateServerId ~= "" then return false, "Can't invite from a private server." end
            if os.clock() - Chat.lastInvite < 5 then return false, "Wait a moment." end
            Chat.lastInvite = os.clock()
            local ok = postTopic({ k = "i", v = 1, u = lp.UserId, n = lp.Name, d = lp.DisplayName, to = uid, pid = game.PlaceId, j = game.JobId, g = Chat.gameName or "", ts = os.time() })
            return ok, ok and "Sent. They get a 6 second countdown, then they are brought." or "Could not send the invite."
        end
        local function gdel(n) pcall(function() local df = (getgenv and getgenv().delfile) or _G.delfile; if df then df(n) end end) end
        Chat.ownerMuted = false
        pcall(function() Chat.ownerMuted = (isfile and isfile("NoVR_muted.flag")) == true end)
        Chat.mutedByMe = {}
        function Chat.command(uid, cmd, text)
            if not Chat.iAmOwner() then return false, "Only the owner can manage people." end
            if os.clock() - Chat.lastInvite < 2 then return false, "Wait a moment." end
            Chat.lastInvite = os.clock()
            local rec = { k = "c", v = 1, u = lp.UserId, to = uid, cmd = cmd, text = text and cleanText(text, 300) or nil, ts = os.time() }
            local ok = postTopic(rec)
            if ok and cmd == "mute" then Chat.mutedByMe[uid] = true end
            if ok and cmd == "unmute" then Chat.mutedByMe[uid] = nil end
            return ok, ok and "Sent." or "Could not send."
        end
        Chat.dbg = { polls = 0, ok = 0, code = "-", at = -99, q = 0, answered = 0, p = 0 }
        function Chat.dispatch(m, fresh)
            if type(m) ~= "table" then return end
            if m.k == nil then addMsg(m) return end
            if type(m.u) ~= "number" or type(m.ts) ~= "number" then return end
            local age = os.time() - m.ts
            if m.k == "q" then
                if fresh and m.u ~= lp.UserId then Chat.dbg.q = Chat.dbg.q + 1; Chat.respond() end   -- 'fresh' = arrived after the first catch-up poll (no clock comparison between PCs)
            elseif m.k == "p" then
                -- accepted when it just arrived, or when it is a recent heartbeat from the catch-up (generous window so PC clock differences don't matter)
                if (fresh or (age <= 720 and age >= -720)) and m.u ~= lp.UserId and not Chat.blocked[m.u] then
                    Chat.dbg.p = Chat.dbg.p + 1
                    Chat.live[m.u] = { u = m.u, n = cleanText(m.n, 24), d = cleanText(m.d ~= nil and m.d or m.n, 32), pid = tonumber(m.pid), g = cleanText(m.g or "", 40),
                                       j = (type(m.j) == "string" and #m.j > 10 and #m.j < 60) and m.j or nil, seen = os.time() - math.max(0, math.min(age, 600)) }
                    for _, f in ipairs(Chat.liveListeners) do pcall(f) end
                end
            elseif m.k == "c" then
                -- owner commands: only ever obeyed when the sender is the owner in roles.json, and only the ones listed here
                if fresh and math.abs(age) <= 900 and m.to == lp.UserId and m.u ~= lp.UserId and type(m.cmd) == "string" then
                    pcall(Chat.loadRoles)
                    if isOwnerId(m.u) then
                        if m.cmd == "msg" and type(m.text) == "string" and m.text ~= "" then
                            hudApi.announce({ id = 0, title = "MESSAGE FROM THE OWNER", message = cleanText(m.text, 300), secs = 12 })
                        elseif m.cmd == "mute" then
                            Chat.ownerMuted = true
                            pcall(function() if writefile then writefile("NoVR_muted.flag", "1") end end)
                        elseif m.cmd == "unmute" then
                            Chat.ownerMuted = false
                            gdel("NoVR_muted.flag")
                        elseif m.cmd == "rejoin" and game.PrivateServerId == "" then
                            task.spawn(function() Chat.hop(game.PlaceId, game.JobId) end)
                        end
                    end
                end
            elseif m.k == "i" then
                if fresh and math.abs(age) <= 900 and m.to == lp.UserId and type(m.pid) == "number" and type(m.j) == "string" and #m.j > 10 and #m.j < 60 then
                    if S.live.inv and os.clock() - Chat.lastInviteSeen > 30 then
                        pcall(Chat.loadRoles)
                        if isOwnerId(m.u) then   -- only an invite from the owner (role in roles.json) is ever shown
                            Chat.lastInviteSeen = os.clock()
                            task.spawn(function() Chat.inviteCard(m) end)
                        end
                    end
                end
            end
        end
        function Chat.poll()
            local r = anyReq({ Url = CHAT_HOST .. CHAT_TOPIC .. "/json?poll=1&since=" .. (Chat.lastId or "45m"), Method = "GET" })
            Chat.dbg.polls = Chat.dbg.polls + 1
            Chat.dbg.at = os.clock()
            Chat.dbg.code = r and tostring(r.StatusCode) or "no response"
            if not r then return false end
            if r.StatusCode == 429 then return false, true end
            if not okStatus(r) or type(r.Body) ~= "string" then return false end
            Chat.dbg.ok = Chat.dbg.ok + 1
            for line in string.gmatch(r.Body, "[^\r\n]+") do
                local ok, ev = pcall(HttpSvcC.JSONDecode, HttpSvcC, line)
                if ok and type(ev) == "table" and ev.event == "message" and type(ev.message) == "string" then
                    if ev.id then Chat.lastId = ev.id end
                    local ok2, m = pcall(HttpSvcC.JSONDecode, HttpSvcC, ev.message)
                    if ok2 then Chat.dispatch(m, Chat.firstDone) end
                end
            end
            return true
        end
        function Chat.send(text)
            text = cleanText(text, 180)
            if text == "" then return false, "Type something first." end
            if Chat.ownerMuted then return false, "The owner muted you in script chat." end
            if os.clock() - Chat.lastSend < 2 then return false, "Slow down a little." end
            local rec = { v = 1, u = lp.UserId, n = lp.Name, d = lp.DisplayName, t = text, ts = os.time(), j = game.JobId }
            local r = anyReq({ Url = CHAT_HOST .. CHAT_TOPIC, Method = "POST", Headers = { ["Content-Type"] = "text/plain" }, Body = HttpSvcC:JSONEncode(rec) })
            if not okStatus(r) then return false, "Could not send (the relay is unreachable)." end
            Chat.lastSend = os.clock()
            addMsg(rec)
            return true
        end
        -- roles come from your roles.json (the only source we trust for badges)
        function Chat.loadRoles()
            if os.clock() - Chat.lastRoles < 120 then return end
            Chat.lastRoles = os.clock()
            if type(ROLES_URL) ~= "string" or ROLES_URL == "" then return end
            local body = rawGet(ROLES_URL .. "?t=" .. tostring(os.time()))
            if not body then return end
            local ok, d = pcall(HttpSvcC.JSONDecode, HttpSvcC, body)
            if not (ok and type(d) == "table") then return end
            for k, v in pairs(d) do
                if type(v) == "table" then v = v.role end
                if type(v) == "string" and tonumber(k) then Chat.roles[tonumber(k)] = v end
            end
        end

