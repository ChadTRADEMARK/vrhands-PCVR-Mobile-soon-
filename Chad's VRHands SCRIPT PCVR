        function S.crkStep(c)
            local L = c.crk
            if not L then return end
            local now = os.clock()
            for _, r in ipairs(L) do
                if not r.done and now >= r.t0 then
                    local u = math.clamp((now - r.t0) / 0.9, 0, 1)
                    u = 1 - (1 - u) ^ 3
                    r.p.Transparency = 0
                    r.p.Size = Vector3.new(r.p.Size.X, 0.2, math.max(r.len * u, 0.1))
                    r.p.CFrame = r.cf * CFrame.new(0, 0, -r.p.Size.Z / 2)
                    if u >= 1 then r.done = true end
                end
            end
        end
        function S.pebStep(c, dt)
            S.crkStep(c)   -- the little rocks: wait, drop with gravity, bounce once in the pit, then fade
            local L = c.peb
            if not L or #L == 0 then return end
            local i = 1
            while i <= #L do
                local r = L[i]
                r.life = r.life + dt
                if r.life < r.t0 then
                    i = i + 1
                else
                    local u = r.life - r.t0
                    if u > 3.2 then
                        pcall(function() r.p:Destroy() end)
                        L[i] = L[#L]
                        L[#L] = nil
                    else
                        r.v = r.v + 55 * dt
                        r.h = (r.h or 3) - r.v * dt
                        if r.h < -1.2 then r.h = -1.2 r.v = -r.v * 0.35 if math.abs(r.v) < 2 then r.v = 0 end end
                        r.p.Transparency = u > 2.4 and (u - 2.4) / 0.8 or 0
                        local base = CFrame.new(r.o + r.cf.UpVector * r.h)
                        r.p.CFrame = base * CFrame.fromEulerAnglesXYZ(r.rot.X * u, r.rot.Y * u, r.rot.Z * u)
                        i = i + 1
                    end
                end
            end
        end
        function S.suckPos(c, ob, u)
            local w = u ^ 1.15
            local r, h = ob.r0 * (1 - w), ob.ha * (1 - w)
            local phi = ob.phi0 + ob.sgn * 2 * math.pi * ob.turns * u ^ 1.6
            local lift = ob.lift * math.sin(math.min(u / (ob.kind == "water" and 0.3 or 0.1), 1) * math.pi / 2) * (1 - w)
            return c.S0 + c.suckA * h + (c.suckE1 * math.cos(phi) + c.suckE2 * math.sin(phi)) * r + Vector3.yAxis * lift
