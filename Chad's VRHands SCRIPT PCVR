                    root.Visible = false
                else
                    root.Visible = true
                    circ.Visible = false
                    if not instant then
                        local k = fitScale()
                        rs.Scale = k * 0.6
                        tw(rs, 0.45, { Scale = k }, Enum.EasingStyle.Back)
                    end
