        end
        local function addMsg(m)
            if type(m) ~= "table" or type(m.u) ~= "number" or type(m.t) ~= "string" then return end
            local key = m.u .. "|" .. tostring(m.ts) .. "|" .. m.t
            if Chat.dedupe[key] then return end
            Chat.dedupe[key] = true
            if Chat.blocked[m.u] and not isOwnerId(m.u) then return end
            local rec = { u = m.u, n = cleanText(m.d ~= nil and m.d or m.n, 32), un = cleanText(m.n, 24), t = cleanText(m.t, 220),
                          ts = tonumber(m.ts) or os.time(), j = tostring(m.j or ""), me = (m.u == lp.UserId) }
            if rec.t == "" or rec.n == "" then return end
            Chat.msgs[#Chat.msgs + 1] = rec
            while #Chat.msgs > 150 do table.remove(Chat.msgs, 1) end
            if not Chat.open and not rec.me and (not Chat.muted[rec.u] or isOwnerId(rec.u)) and Chat.firstDone then Chat.unread = Chat.unread + 1 end
            for _, f in ipairs(Chat.listeners) do pcall(f) end
        end
        local function postTopic(rec)
            local r = anyReq({ Url = CHAT_HOST .. CHAT_TOPIC, Method = "POST", Headers = { ["Content-Type"] = "text/plain" }, Body = HttpSvcC:JSONEncode(rec) })
