                   and rawget(o,"rFist") ~= nil and rawget(o,"turnDirection") ~= nil then
                    fallback = o
                end
            end)
            return found
        end
        local function sweep(list)   -- phones: the sweep gives the game a breath every few thousand objects so it never freezes
            local k = 0
            for _, o in pairs(list) do
                if look(o) then return true end
                k = k + 1
                if IS_MOBILE and k % 3500 == 0 then task.wait() end
            end
            return false
        end
        -- source 1: the garbage collector (some phone executors only accept getgc() without the argument)
        if C.getgc then
            local okg, list = pcall(function() return C.getgc(true) end)
            if not okg or type(list) ~= "table" then okg, list = pcall(function() return C.getgc() end) end
            if okg and type(list) == "table" and sweep(list) then return end
        end
        -- source 2: the registry
        local gr = (getgenv and getgenv().getreg) or getreg
        if type(gr) == "function" and not found then
            local okr, list = pcall(gr)
            if okr and type(list) == "table" and sweep(list) then return end
        end
        -- source 3: the game's loaded ModuleScripts (works where getgc is missing or blocked): the VR module is often what a require() returns
        local glm = (getgenv and getgenv().getloadedmodules) or getloadedmodules
        if type(glm) == "function" and not found then
            local okm, mods = pcall(glm)
            if okm and type(mods) == "table" then
                local k = 0
                for _, m in pairs(mods) do
                    k = k + 1
                    if k > 400 then break end
                    local okq, r = pcall(require, m)
                    if okq and type(r) == "table" then
                        if look(r) then return end
                        for _, v in pairs(r) do   -- one level down: a module that holds the VR module
                            if look(v) then return end
                        end
                    end
                    if IS_MOBILE and k % 40 == 0 then task.wait() end
                end
            end
        end
        if not found and fallback then Input = fallback end
    end

