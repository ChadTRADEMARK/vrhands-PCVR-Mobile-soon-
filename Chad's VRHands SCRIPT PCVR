                    for _, r in ipairs(c.suckBigs or {}) do
                        local cnt = 0
                        for _, ob in ipairs(c.suckObjs) do if ob.frag and ob.rec == r then cnt = cnt + 1 end end
                        if cnt > bestN and r.d < 2000 then rec, bestN = r, cnt end
                    end
                    if rec then
                        rec.Th = 19.6
                        for _, ob in ipairs(c.suckObjs) do
                            if ob.frag and ob.rec == rec then
                                ob.ts = 19.0 + rnd:NextNumber() * 1.4
                                ob.dur = math.clamp(7 + rnd:NextNumber() * 2, 4, math.max(tI - 0.8 - ob.ts, 3))
