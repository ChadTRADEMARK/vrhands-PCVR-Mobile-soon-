                    b.Position = UDim2.fromOffset(x, y)
                    b.Size = UDim2.fromOffset(w, h)
                    b.AutoButtonColor = false
                    b.BackgroundColor3 = PINK
                    b.BackgroundTransparency = 0.8
                    b.BorderSizePixel = 0
                    b.Text = text
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = size or 11
                    b.TextColor3 = WHITE
                    b.TextTruncate = Enum.TextTruncate.AtEnd
                    b.ZIndex = 5
                    b.Parent = parent
                    corner(b, 9)
                    b.InputBegan:Connect(function(io) if isPress(io) then ripple(b, io, fit.Scale) end end)
                    return b
                end
                local function getJson(url, method, body)
                    local text
                    if not method then
                        local ok, res = pcall(function() return hget(url, true) end)
                        if ok and type(res) == "string" and #res > 0 then text = res end
                    end
                    if not text and req then
                        local ok2, r = pcall(req, { Url = url, Method = method or "GET", Headers = body and { ["Content-Type"] = "application/json" } or nil, Body = body })
                        if ok2 and r then
                            if r.StatusCode == 429 then return nil, "Roblox says too many requests. Wait a few seconds." end
                            if r.Success or r.StatusCode == 200 then text = r.Body end
                        end
                    end
                    if not text then return nil, "Could not reach Roblox (your executor may block web requests)." end
                    local ok3, data = pcall(HttpService.JSONDecode, HttpService, text)
                    if not (ok3 and type(data) == "table") then return nil, "Roblox sent something unexpected." end
                    if data.errors then return nil, "Roblox refused: " .. tostring(data.errors[1] and data.errors[1].message or "error") end
                    return data
                end

