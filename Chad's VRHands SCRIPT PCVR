                            end

                            local okm, mem = pcall(function() return StatsSvc:GetTotalMemoryUsageMb() end)
                            rMem.set(okm and mem and (math.floor(mem + 0.5) .. " MB") or "-")
                            rPl.set(#Players:GetPlayers() .. " / " .. Players.MaxPlayers)
                            rAU.set(AU.text, AU.level)
                            local t = math.floor(workspace.DistributedGameTime)
                            rUp.set(string.format("%dh %02dm %02ds", t // 3600, (t % 3600) // 60, t % 60))
                            do
                                local U = S.usage
                                local ex = U.expires()
                                if ex == nil then
                                    rKeyLeft.set("Not shared by key system", nil)
                                elseif ex == "lifetime" then
                                    rKeyLeft.set("Lifetime", "ok")
                                else
                                    local left = ex - os.time()
                                    if left <= 0 then rKeyLeft.set("Expired", "bad")
                                    else rKeyLeft.set(U.fmt(left), left < 3600 and "bad" or (left < 86400 and "warn" or "ok")) end
                                end
                                rKeyUsed.set(U.fmt(U.session()))
                                rKeyTot.set(U.fmt(U.total()))
                            end

                            task.wait(0.5)
                            sinceWeb += 0.5
                            if sinceWeb >= 10 then   -- web checks repeat every 10 seconds
                                sinceWeb = 0
                                refreshWeb()
                            end
                        end
