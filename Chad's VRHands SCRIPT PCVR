        local function okStatus(r) return r ~= nil and (r.Success == true or r.StatusCode == 200 or r.StatusCode == 201) end
        local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local function b64enc(s)
            local out = {}
            for i = 1, #s, 3 do
                local a, b, c = string.byte(s, i, i + 2)
                local n = a * 65536 + (b or 0) * 256 + (c or 0)
                local c1, c2, c3, c4 = math.floor(n / 262144) % 64, math.floor(n / 4096) % 64, math.floor(n / 64) % 64, n % 64
                out[#out + 1] = string.sub(B64, c1 + 1, c1 + 1) .. string.sub(B64, c2 + 1, c2 + 1)
                    .. (b and string.sub(B64, c3 + 1, c3 + 1) or "=") .. (c and string.sub(B64, c4 + 1, c4 + 1) or "=")
            end
            return table.concat(out)
        end
        local function b64dec(s)
            s = string.gsub(s, "[^%w%+/]", "")
            local rev = {}
            for i = 1, 64 do rev[string.byte(B64, i)] = i - 1 end
            local out = {}
            for i = 1, #s, 4 do
                local a, b, c, d = string.byte(s, i, i + 3)
                local n = (rev[a] or 0) * 262144 + (rev[b] or 0) * 4096 + (c and rev[c] or 0) * 64 + (d and rev[d] or 0)
                out[#out + 1] = string.char(math.floor(n / 65536) % 256)
                if c then out[#out + 1] = string.char(math.floor(n / 256) % 256) end
                if d then out[#out + 1] = string.char(n % 256) end
            end
            return table.concat(out)
        end
        local function cleanText(s, n)
            s = tostring(s or "")
            s = string.gsub(s, "%c", " ")
            s = string.gsub(s, "%s+", " ")
            s = string.match(s, "^%s*(.-)%s*$") or ""
            if #s > n then s = string.sub(s, 1, n) end
            return s
        end
        local Chat = { msgs = {}, dedupe = {}, unread = 0, open = false, listeners = {}, lastId = nil, muted = {}, blocked = {},
