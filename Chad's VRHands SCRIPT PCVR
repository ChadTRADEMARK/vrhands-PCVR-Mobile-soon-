    -- Reach / zoom for each hand. Hold LMB = left hand only, hold RMB = right
    -- hand only, neither (or both) held = both hands together.
    local REACH_LIM = 2000000000.5
    local function addReach(d)
        local moveL = mouseDown.L or not mouseDown.R
        local moveR = mouseDown.R or not mouseDown.L
        if moveL then S.reachL = math.clamp(S.reachL + d, -REACH_LIM, REACH_LIM) end
        if moveR then S.reachR = math.clamp(S.reachR + d, -REACH_LIM, REACH_LIM) end
    end

