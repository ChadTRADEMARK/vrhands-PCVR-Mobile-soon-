                    local init = math.clamp((getV(side, f[2]) - f[3]) / (f[4] - f[3]), 0, 1)
                    local _, thumb = hslider(P1, 350, y + 21, 380, init, false, function(fr)
                        local v = f[3] + fr * (f[4] - f[3])
