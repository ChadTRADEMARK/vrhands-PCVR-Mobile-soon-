                end
            end
            local function note(t) pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Name tag", Text = t, Duration = 3 }) end) end
            local function tpTo(pl)
                if pl == lp then return end
                if S.domeLock then note("Unlock the dome first (Delete).") return end
                local ch, tc = lp.Character, pl.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                local thrp = tc and tc:FindFirstChild("HumanoidRootPart")
                if not (hrp and thrp) then note(pl.DisplayName .. " has no character right now.") return end
                local pos = thrp.Position + thrp.CFrame.LookVector * 4 + Vector3.new(0, 2, 0)
                pcall(function() ch:PivotTo(CFrame.lookAt(pos, Vector3.new(thrp.Position.X, pos.Y, thrp.Position.Z))) end)
