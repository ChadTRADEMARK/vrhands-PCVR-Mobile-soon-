        function S.dbrStep(c, age0, dt, now)
            local list = c.dbr
            if not list then return end
            local S0 = c.S0
            local A = c.suckA
            local i = 1
            while i <= #list do
                local b = list[i]
                local alive = true
                local t = age0 - b.t0
                if not b.p.Parent then
                    alive = false
                elseif t >= 0 then
                    local pos = b.cf.Position
                    local v, w = b.v, b.w
                    local dB = (S0 - pos).Magnitude
                    if t < b.liftT then
                        if b.water then
                            v = (v + Vector3.new(0, 22 * dt, 0)) * math.exp(-0.7 * dt)   -- water floats up and sloshes
                        else
                            local damp = math.exp(-0.5 * dt)
                            v = Vector3.new(v.X * damp, v.Y - 70 * dt, v.Z * damp)
                        end
                        w = w * math.exp(-0.3 * dt)
                    else
                        local k = math.clamp((t - b.liftT) / b.rampT, 0, 1)
                        local dir = (S0 - pos) / math.max(dB, 1)
                        local tang = A:Cross(dir)
                        tang = tang.Magnitude > 0.05 and tang.Unit or Vector3.zero
