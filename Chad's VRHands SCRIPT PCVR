                                   R = { fist = 1, index = 0, thumb = 1, x = 0, y = 0.1, reach = 2.4, yaw = 0.1, pitch = 0.3, roll = 0 } } },
                { "FLIP OFF", FLIP_UP, { { pose = FLIP_RAISED, dur = 0.55, hold = 0 }, { pose = FLIP_UP, dur = 0.45, hold = 0 } } },
                { "OPEN HANDS", { L = { fist = 0, index = 0, thumb = 0, x = 0, y = 0, reach = 2, yaw = 0, pitch = 0, roll = 0 },
                                  R = { fist = 0, index = 0, thumb = 0, x = 0, y = 0, reach = 2, yaw = 0, pitch = 0, roll = 0 } } },
            }
                        local GEST_ANIMS = {
                ["FLIP OFF"] = { loop = true, frames = {
                    { dur = 0.5, hold = 0.1, pose = FLIP_REST },
                    { dur = 0.6, hold = 0.05, pose = FLIP_RAISED },
