                -- ===== page 2: two-hand gestures, saved gestures, animation =====
                local P2 = pages[2]
                lbl(P2, "TWO-HAND GESTURES  (start points: fine-tune them on the HANDS page)", 20, 90, 700, 14, 11, MUTED)
                for i, pr in ipairs(GEST_PRESETS) do
                    local b = mkBtn(P2, pr[1], 20 + (i - 1) * 143, 110, 136, 30, 11)
                    b.Activated:Connect(function()
                        S.animStop()
                        if pr[3] then   -- a preset with steps (FLIP OFF: fists come up first, then the finger)
                            S.animPlay(pr[3], false)
                        else
                            local tok = S.animToken
                            task.spawn(function() S.poseTo(pr[2], 0.5, tok) end)
                        end
                        say(pr[1] .. " - hands are moving into place.")
