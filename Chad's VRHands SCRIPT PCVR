            local FIELDS = {   -- label, key, min, max, how to show it
                { "Thumb", "thumb", 0, 1, "pct" }, { "Index finger", "index", 0, 1, "pct" }, { "Middle finger", "mid", 0, 1, "pct" },
                { "Ring finger", "ring", 0, 1, "pct" }, { "Pinky", "pinky", 0, 1, "pct" }, { "Middle + ring + pinky", "fist", 0, 1, "pct" },
                { "Left / right", "x", -2, 2, "num" }, { "Up / down", "y", -2, 2, "num" }, { "Reach", "reach", 0, 8, "num" },
                { "Turn", "yaw", -3.14, 3.14, "deg" }, { "Tilt", "pitch", -3.14, 3.14, "deg" }, { "Roll", "roll", -3.14, 3.14, "deg" },
            }
            local function openGesture()
                local p, ent = overlay("gesture", 80, 10, 740, 530, "Gesture", "Gesture studio")
                if not p then return end
                local HttpService = game:GetService("HttpService")
                local G = S.gest

                -- ===== saved gestures + animation frames (NoVR_Gestures.json) =====
                local FILE = "NoVR_Gestures.json"
                local Lib = _G.NoVR_GestLib
                local function cleanPose(t)
                    if type(t) ~= "table" then return nil end
                    local out = { L = {}, R = {} }
                    for _, side in ipairs({ "L", "R" }) do
                        if type(t[side]) ~= "table" then return nil end
                        for _, k in ipairs({ "mid", "ring", "pinky" }) do   -- gestures saved before per-finger control
                            if t[side][k] == nil then t[side][k] = t[side].fist end
                        end
                        for _, f in ipairs(FIELDS) do
                            local v = t[side][f[2]]
                            if type(v) ~= "number" or v ~= v then return nil end
                            out[side][f[2]] = math.clamp(v, f[3] * ((f[2] == "reach" or f[5] == "pct") and 1 or 2), f[4] * ((f[2] == "reach" or f[5] == "pct") and 1 or 2))
                        end
                    end
                    return out
                end
                if type(Lib) ~= "table" then
                    Lib = { slots = {}, frames = {} }
                    local okR, raw = pcall(function() return isfile and isfile(FILE) and readfile(FILE) or nil end)
                    if okR and type(raw) == "string" then
                        local okJ, d = pcall(HttpService.JSONDecode, HttpService, raw)
                        if okJ and type(d) == "table" then
                            if type(d.slots) == "table" then
                                for i = 1, 4 do local cp = cleanPose(d.slots[tostring(i)]); if cp then Lib.slots[i] = cp end end
                            end
                            if type(d.frames) == "table" then
                                for _, fr in ipairs(d.frames) do
                                    local cp = type(fr) == "table" and cleanPose(fr.pose)
                                    if cp and #Lib.frames < 12 then
                                        Lib.frames[#Lib.frames + 1] = { pose = cp, dur = math.clamp(tonumber(fr.dur) or 0.8, 0.1, 5), hold = 0 }
                                    end
                                end
                            end
                        end
                    end
                    Lib.loop = true
                    _G.NoVR_GestLib = Lib
                end
                local function saveLib()
                    pcall(function()
                        if not writefile then return end
                        local slots = {}
                        for i = 1, 4 do if Lib.slots[i] then slots[tostring(i)] = Lib.slots[i] end end
                        writefile(FILE, HttpService:JSONEncode({ slots = slots, frames = Lib.frames }))
                    end)
                end

                -- ===== small UI helpers =====
                local pages = { Instance.new("Frame"), Instance.new("Frame") }
                for _, pg in ipairs(pages) do
                    pg.Size = UDim2.fromScale(1, 1)
                    pg.BackgroundTransparency = 1
                    pg.BorderSizePixel = 0
                    pg.Active = false
                    pg.Parent = p
                end
                local function mkBtn(parent, text, x, y, w, h, size)
                    local b = Instance.new("TextButton")
                    b.Position = UDim2.fromOffset(x, y)
                    b.Size = UDim2.fromOffset(w, h)
                    b.AutoButtonColor = false
                    b.BackgroundColor3 = PINK
                    b.BackgroundTransparency = 0.8
                    b.BorderSizePixel = 0
                    b.Text = text
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = size or 11
                    b.TextColor3 = WHITE
                    b.TextTruncate = Enum.TextTruncate.AtEnd
                    b.ZIndex = 5
                    b.Parent = parent
                    corner(b, 9)
                    b.InputBegan:Connect(function(io) if isPress(io) then ripple(b, io, fit.Scale) end end)
                    return b
                end
                local tabH = mkBtn(p, "HANDS", 20, 50, 100, 28, 11)
                local tabG = mkBtn(p, "GESTURES", 126, 50, 110, 28, 11)
                local msg = lbl(p, "", 250, 56, 400, 16, 11, MUTED, Enum.Font.GothamBold)
                msg.Size = UDim2.fromOffset(380, 16)
                local function say(t) if msg.Parent then msg.Text = t end end
                local function showPage(i)
                    pages[1].Visible = (i == 1)
                    pages[2].Visible = (i == 2)
                    tabH.BackgroundTransparency = (i == 1) and 0.15 or 0.8
                    tabG.BackgroundTransparency = (i == 2) and 0.15 or 0.8
                end

                -- ===== page 1: 3D preview + sliders =====
                local P1 = pages[1]
                local side, mirror = "L", false
                local vp = Instance.new("ViewportFrame")
                vp.Position = UDim2.fromOffset(20, 88)
                vp.Size = UDim2.fromOffset(310, 246)
                vp.BackgroundColor3 = C(14, 8, 40)
                vp.BackgroundTransparency = 0
                vp.BorderSizePixel = 0
                vp.Ambient = Color3.fromRGB(190, 180, 220)
                vp.LightColor = Color3.fromRGB(255, 255, 255)
                vp:SetAttribute("tc", true)
                vp.Parent = P1
                corner(vp, 12)
                stroke(vp, WHITE, 1.5, 0.7)
                local vcam = Instance.new("Camera")
                vcam.FieldOfView = 55
                vcam.Parent = vp
                vp.CurrentCamera = vcam
                local world = Instance.new("Model")
                world.Parent = vp
                local function part(size, color, ball)
                    local pt = Instance.new("Part")
                    pt.Anchored = true
                    pt.CanCollide = false
                    pt.CanTouch = false
                    pt.Material = Enum.Material.SmoothPlastic
                    pt.Size = size
                    pt.Color = color
                    if ball then pt.Shape = Enum.PartType.Ball end
                    pt.Parent = world
                    return pt
                end
                local head = part(Vector3.new(0.5, 0.5, 0.5), Color3.fromRGB(150, 120, 230), true)   -- where your head is
                head.CFrame = CFrame.new(0, 0, 0)
                local FING = {   -- name, kind, base x (towards the thumb side is +), segment lengths, width
                    { "index", "index", 0.14, { 0.2, 0.16, 0.13 }, 0.08 }, { "middle", "mid", 0.047, { 0.22, 0.17, 0.14 }, 0.08 },
                    { "ring", "ring", -0.047, { 0.2, 0.16, 0.13 }, 0.075 }, { "pinky", "pinky", -0.135, { 0.15, 0.12, 0.1 }, 0.07 },
                    { "thumb", "thumb", 0.2, { 0.16, 0.13 }, 0.095 },
                }
                local hands = {}
                for _, sd in ipairs({ "L", "R" }) do
                    local col = (sd == "L") and Color3.fromRGB(255, 205, 175) or Color3.fromRGB(235, 195, 255)
                    local h = { palm = part(Vector3.new(0.42, 0.1, 0.45), col), fingers = {} }
                    for _, f in ipairs(FING) do
                        local rec = { kind = f[2], bx = f[3], segs = {}, thumb = (f[1] == "thumb") }
                        for i, len in ipairs(f[4]) do
                            rec.segs[i] = { len = len, part = part(Vector3.new(f[5], f[5], len), col) }
                        end
                        h.fingers[#h.fingers + 1] = rec
                    end
                    hands[sd] = h
                end
                local orbit = 0.4
                local function draw()
                    for _, sd in ipairs({ "L", "R" }) do
                        local g, m, h = G[sd], S.GMAP[sd], hands[sd]
                        local sgn = (sd == "L") and -1 or 1   -- left hand sits left, its thumb points inward (+x for the left hand)
                        local pos = Vector3.new(sgn * S.spread + S[m.x], S.height + S[m.y], -S[m.reach])
                        local palm = CFrame.new(pos) * CFrame.fromEulerAnglesYXZ(S[m.pitch], S[m.yaw], S[m.roll])
                        h.palm.CFrame = palm
                        for _, f in ipairs(h.fingers) do
                            local bx = (sd == "L") and f.bx or -f.bx
                            local cf, curl, maxc
                            if f.thumb then
                                curl, maxc = 1 - g.thumb, 1.1
                                cf = palm * CFrame.new(bx, 0, 0.08) * CFrame.Angles(0, -sgn * (0.2 + 0.5 * g.thumb) * -1, 0)
                            else
                                curl = g[f.kind]
                                maxc = 1.35
                                cf = palm * CFrame.new(bx, 0, -0.225)
                            end
                            for _, sg in ipairs(f.segs) do
                                cf = cf * CFrame.Angles(-curl * maxc, 0, 0)
                                sg.part.CFrame = cf * CFrame.new(0, 0, -sg.len / 2)
                                cf = cf * CFrame.new(0, 0, -sg.len)
                            end
                        end
                    end
                    local target = Vector3.new(0, 0, -1.4)
                    local eye = target + Vector3.new(math.sin(orbit) * 3.6, 1.3, math.cos(orbit) * 3.6)
                    vcam.CFrame = CFrame.lookAt(eye, target)
                end

                -- side selector + sliders
                local tabL = mkBtn(P1, "LEFT HAND", 350, 88, 185, 28, 11)
                local tabR = mkBtn(P1, "RIGHT HAND", 545, 88, 185, 28, 11)
                local rows = {}
                local function fmt(f, v)
                    if f[5] == "pct" then return math.floor(v * 100 + 0.5) .. "%" end
                    if f[5] == "deg" then return math.floor(math.deg(v) + 0.5) .. " deg" end
                    return string.format("%.2f", v)
                end
                local function getV(sd, key)
                    if key == "fist" then return (G[sd].mid + G[sd].ring + G[sd].pinky) / 3 end
                    if key == "index" or key == "thumb" or key == "mid" or key == "ring" or key == "pinky" then return G[sd][key] end
                    return S[S.GMAP[sd][key]]
                end
                local function setV(sd, key, v)
                    if key == "fist" then
                        G[sd].mid, G[sd].ring, G[sd].pinky = v, v, v
                        G[sd].fist = v
                        G[sd].on = true
                    elseif key == "index" or key == "thumb" or key == "mid" or key == "ring" or key == "pinky" then
                        G[sd][key] = v
                        G[sd].fist = (G[sd].mid + G[sd].ring + G[sd].pinky) / 3
                        G[sd].on = true
                    else
                        S[S.GMAP[sd][key]] = v
                    end
                end
                local function refreshRows()
                    for _, r in ipairs(rows) do
                        local v = getV(side, r.f[2])
                        local fr = math.clamp((v - r.f[3]) / (r.f[4] - r.f[3]), 0, 1)
                        r.val.Text = fmt(r.f, v)
                        r.thumb.Position = UDim2.new(fr, 0, 0.5, 0)
                    end
                    tabL.BackgroundTransparency = (side == "L") and 0.15 or 0.8
                    tabR.BackgroundTransparency = (side == "R") and 0.15 or 0.8
                end
                for i, f in ipairs(FIELDS) do
