    -- ===== CHARACTER DESYNC: others keep seeing your character where it was; you move freely. Needs an executor with the raknet library =====
    S.desync = { on = false }
    do
    local function dsNote(text)
        pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Character Desync", Text = text, Duration = 5 }) end)
    end
    local function dsLib()
        local gl = (getgenv and getgenv()) or _G
        return gl.raknet
    end
    local function dsDiag(rk)
        if not rk then return end
        local names = {}
        for k, v in pairs(rk) do names[#names + 1] = tostring(k) .. " = " .. typeof(v) end
        table.sort(names)
        if writefile then pcall(writefile, "NoVR_raknet_diag.txt", "raknet functions in this executor:\n" .. table.concat(names, "\n")) end
        local txt = "raknet functions: " .. table.concat(names, ", ")
        print("[NoVR] " .. txt)   -- also in the developer console (F9)
        local gl = (getgenv and getgenv()) or _G
        if gl.setclipboard then pcall(gl.setclipboard, txt) end   -- and on your clipboard: just paste it into the chat
    end
    function S.desyncSet(on)
        local d = S.desync
        local rk = dsLib()
        if on == d.on then return end
        if not rk then
            dsNote("Your executor has no raknet library, so desync can't run.")
            return
        end
        dsDiag(rk)
        local fn = rk.desync or rk.Desync or rk.set_desync
        if type(fn) ~= "function" then
            dsNote("This raknet has no desync function. The list of what it has was saved to NoVR_raknet_diag.txt - send it to me.")
            return
        end
        local ch = lp.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if on then
            if not hrp then dsNote("No character to desync.") return end
            local ok, err = pcall(fn, true)
            if not ok then dsNote("Desync failed: " .. tostring(err):sub(1, 100)) return end
            d.on = true
            d.pos = hrp.CFrame
            -- a marker where everybody else still sees you
            local m = Instance.new("Part")
            m.Name = "NoVR_DesyncMarker"
            m.Anchored, m.CanCollide, m.CanTouch, m.CanQuery = true, false, false, false
            m.Size = Vector3.new(2, 5, 1)
            m.Material = Enum.Material.ForceField
            m.Color = Color3.fromRGB(190, 120, 255)
            m.Transparency = 0.35
            m.CFrame = d.pos
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.fromOffset(140, 26)
            bb.StudsOffset = Vector3.new(0, 3.6, 0)
            bb.AlwaysOnTop = true
            bb.Adornee = m
            local tl = Instance.new("TextLabel")
            tl.Size = UDim2.fromScale(1, 1)
            tl.BackgroundTransparency = 1
            tl.Text = "Others see you here"
            tl.Font = Enum.Font.GothamBold
            tl.TextSize = 12
            tl.TextColor3 = Color3.new(1, 1, 1)
            tl.TextStrokeTransparency = 0.4
            tl.Parent = bb
            bb.Parent = m
            m.Parent = workspace
            d.marker = m
            local bb2 = S.ball and S.ball.att
            if bb2 and bb2.part and bb2.part:IsA("BasePart") then   -- riding an object: the marker stays fixed to that object too
                d.rel = bb2.part.CFrame:ToObjectSpace(d.pos)
                d.obj = bb2.part
                d.follow = RunService.Heartbeat:Connect(function()
                    if d.obj and d.obj.Parent and d.marker then d.marker.CFrame = d.obj.CFrame * d.rel end
                end)
            end
            dsNote("Desync ON. Others still see you at the purple marker.")
        else
            pcall(fn, false)
            d.on = false
            if d.follow then d.follow:Disconnect() d.follow = nil end
            d.obj = nil
            if d.marker then pcall(function() d.marker:Destroy() end) d.marker = nil end
            dsNote("Desync OFF.")
        end
    end
    pcall(function()
        lp.CharacterRemoving:Connect(function()
            if S.desync.on then S.desyncSet(false) end
        end)
    end)

    end

    -- ===== RIG REFRESH: change your avatar, then rebuild the VR rig so it shows the new assets =====
    S.rigAuto = true
    S.rigStamp = os.clock()
    do
        local busy = false
        local function note(text)
            pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "VR Rig", Text = text, Duration = 3 }) end)
        end
        -- the game builds a NEW rig model whenever you respawn: adopt it, so every part of the script follows the new one instead of the dead one
        local function adopt(nr)
            if not nr or nr == rig then return end
            nr:WaitForChild("VRHead", 20)
            nr:WaitForChild("LeftHand", 20)
            nr:WaitForChild("RightHand", 20)
            rig = nr
            scaleVal = nr:FindFirstChild("VRScale")
            S.rigStamp = os.clock()
        end
        if not U.emu then
            vrPlayers.ChildAdded:Connect(function(c)
                if c.Name == uid then task.spawn(adopt, c) end
            end)
        end
        -- a quick fingerprint of the rig's look, so a refreshed rig (same model, new parts) is noticed too
        local function rigSig(r)
            if not (r and r.Parent) then return "gone" end
            local n, h = 0, 0
            for _, d in ipairs(r:GetDescendants()) do
                n += 1
                local s = d.Name
                if d:IsA("MeshPart") then s = s .. d.MeshId .. d.TextureID elseif d:IsA("SpecialMesh") then s = s .. d.MeshId .. d.TextureId end
                h = (h + #s * 31 + n) % 1000003
            end
            return n .. ":" .. h
        end
        -- VR Hands can run with NO normal character: then the game's own remotes are the only way to ask for a new rig
        local function askRejoin()   -- last resort: a pop-up with a REJOIN button (rejoining always loads the new avatar)
            pcall(function()
                local bf = Instance.new("BindableFunction")
                bf.OnInvoke = function(choice)
                    if choice == "Rejoin" then
                        local ha = S.hudApi
                        if ha and ha.queueSelf then pcall(ha.queueSelf) end
                        pcall(function()
                            local TS = game:GetService("TeleportService")
                            if game.PrivateServerId ~= "" then TS:Teleport(game.PlaceId, lp) else TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp) end
                        end)
                    end
                end
                game:GetService("StarterGui"):SetCore("SendNotification", { Title = "VR Rig", Text = "I could not reset the rig from inside this game. Rejoin the server to load your new avatar? (the script comes back by itself)", Duration = 15, Button1 = "Rejoin", Button2 = "No", Callback = bf })
            end)
        end
        -- VR Hands may have no normal character, or ignore respawns: then try the game's own remotes, safest names first, and remember the one that works
        local function viaRemote(auto)
            local rs = game:GetService("ReplicatedStorage")
            local names, cands, seen = {}, {}, {}
            local GOOD = { "resetrig", "rigreset", "refreshrig", "rebuildrig", "resetvr", "refreshavatar", "resetavatar", "updateavatar", "respawn", "reloadchar", "resetchar", "updaterig", "vrrig", "rig", "avatar", "appearance", "vr", "character", "reset", "refresh", "reload", "init" }
            local BAD = { "kick", "ban", "report", "admin", "purchase", "buy", "teleport", "damage", "kill", "shoot", "fire", "hit", "chat", "message", "trade", "gift", "donat", "robux", "vote", "grab", "throw", "drop", "equip" }
            local function add(r, score)
                if not seen[r] then seen[r] = true cands[#cands + 1] = { r = r, s = score } end
            end
            local saved
            pcall(function() if isfile and readfile and isfile("NoVR_rigremote.txt") then saved = readfile("NoVR_rigremote.txt") end end)
            for _, d in ipairs(rs:GetDescendants()) do
                if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                    names[#names + 1] = d.ClassName .. " " .. d:GetFullName()
                    local ln = string.lower(d.Name)
                    local bad = false
                    for _, k in ipairs(BAD) do if string.find(ln, k, 1, true) then bad = true break end end
                    if saved and d:GetFullName() == saved then add(d, 0)
                    elseif not bad then
                        for i, k in ipairs(GOOD) do
                            if string.find(ln, k, 1, true) then add(d, i) break end
                        end
                    end
                end
            end
            local list = table.concat(names, "\n")
            pcall(function() if writefile then writefile("NoVR_COM_remotes.txt", list) end end)
            local gl = (getgenv and getgenv()) or _G
            pcall(function() if gl.setclipboard then gl.setclipboard(list) end end)
            table.sort(cands, function(x, y) return x.s < y.s end)
            if #cands == 0 then
                note("No rig reset found in this game. The game's remote list was copied - send it to me.")
                askRejoin()
                return
            end
            busy = true
            local old = rig
            local sig0 = rigSig(old)
            note((auto and "Your avatar changed - " or "") .. "trying the game's own rig reset (" .. math.min(#cands, 12) .. " ways)...")
            task.spawn(function()
                local worked
                local ARGS = { {}, { lp }, { true } }
                for i = 1, math.min(#cands, 12) do
                    local r = cands[i].r
                    for _, a in ipairs(ARGS) do
                        task.spawn(function()
                            pcall(function()
                                if r:IsA("RemoteEvent") then r:FireServer(table.unpack(a)) else r:InvokeServer(table.unpack(a)) end
                            end)
                        end)
                        local t0 = os.clock()
                        while os.clock() - t0 < 1.2 and rig == old and rigSig(rig) == sig0 do task.wait(0.1) end
                        if rig ~= old or rigSig(rig) ~= sig0 then worked = r break end
                    end
                    if worked then break end
                end
                S.rigStamp = os.clock()
                busy = false
                if worked then
                    pcall(function() if writefile then writefile("NoVR_rigremote.txt", worked:GetFullName()) end end)
                    note("VR rig reset (" .. worked.Name .. "). I will use that one next time.")
                else
                    note("None of the game's remotes reset the rig. The list was copied - send it to me.")
                    askRejoin()
                end
            end)
        end
        function S.rigReset(auto)
            if U.emu then note("Reset VR Rig is for the VR Hands game.") return end
            if busy then return end
            local ch = lp.Character
            local hum = ch and ch:FindFirstChildWhichIsA("Humanoid", true)
            local hrp = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
            if not hum then viaRemote(auto) return end
            busy = true
            local home, old = hrp and hrp.CFrame, rig
            note(auto and "Your avatar changed - rebuilding the VR rig..." or "Rebuilding your VR rig with your current avatar...")
            hum.Health = 0   -- the game builds a fresh rig from your avatar when you respawn
            task.spawn(function()
                local sig0 = rigSig(old)
                local t0 = os.clock()
                local h2
                repeat   -- wait for the respawn, then put you back
                    task.wait(0.2)
                    local c2 = lp.Character
                    h2 = c2 and c2 ~= ch and c2:FindFirstChild("HumanoidRootPart")
                until h2 or os.clock() - t0 > 6
                if not h2 then   -- Humanoid.Health = 0 did nothing: kill the character harder
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
                    pcall(function() ch:BreakJoints() end)
                    local t2 = os.clock()
                    repeat
                        task.wait(0.2)
                        local c2 = lp.Character
                        h2 = c2 and c2 ~= ch and c2:FindFirstChild("HumanoidRootPart")
                    until h2 or os.clock() - t2 > 5
                end
                if not h2 then   -- this game does not respawn you: ask it for a new rig through its own remotes
                    busy = false
                    viaRemote(auto)
                    return
                end
                if h2 and home then h2.CFrame = home end
                -- the game may build a new rig model OR refresh the same one: either counts as a reset
                local t1 = os.clock()
                while os.clock() - t1 < 6 and rig == old and rigSig(rig) == sig0 do task.wait(0.25) end
                S.rigStamp = os.clock()
                busy = false
                note(h2 and "VR rig reset." or "The reset did not go through. Try again in a moment.")
            end)
        end
        -- watch for avatar changes (hats, clothes, body colours) on your character and rebuild the rig a moment after they stop
        local function watch(ch)
            local born = os.clock()
            local function hit(d)
                if not S.rigAuto or U.emu or busy then return end
                if ch ~= lp.Character or not ch.Parent or os.clock() - born < 10 then return end
                if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("BodyColors") or d:IsA("CharacterMesh") then
                    S.rigDirty = os.clock()
                end
            end
            ch.DescendantAdded:Connect(hit)
            ch.DescendantRemoving:Connect(hit)
        end
        if lp.Character then watch(lp.Character) end
        lp.CharacterAdded:Connect(watch)
        task.spawn(function()
            while true do
                task.wait(0.5)
                local d = S.rigDirty
                if d and os.clock() - d > 2.5 then
                    S.rigDirty = nil
                    -- if the game already made a new rig by itself, nothing to do
                    if S.rigStamp < d and S.rigAuto then pcall(S.rigReset, true) end
                end
            end
        end)
    end

