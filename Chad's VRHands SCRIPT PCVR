        -- ===== TON 618 built from your Black Hole model (spheres, disk unions, rings of beams), placed far away and fixed in the world, with its own spins re-created =====
        function S.bhB64(s)
            local A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            local map = {}
            for i = 1, 64 do map[string.byte(A, i)] = i - 1 end
            local out, buf, n, bits, acc = {}, {}, 0, 0, 0
            for i = 1, #s do
                local v = map[string.byte(s, i)]
                if v then
                    acc = acc * 64 + v
                    bits = bits + 6
                    if bits >= 8 then
                        bits = bits - 8
                        local p2 = 2 ^ bits
                        n = n + 1
                        buf[n] = math.floor(acc / p2) % 256
                        acc = acc % p2
                        if n == 2048 then out[#out + 1] = string.char(table.unpack(buf, 1, n)) n = 0 end
                    end
                end
            end
            if n > 0 then out[#out + 1] = string.char(table.unpack(buf, 1, n)) end
            return table.concat(out)
        end
        -- ===== GAME SETTINGS: opens (or closes) the game's own "Game Settings" menu from this menu =====
        function S.gsNote(t)
            pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Game Settings", Text = t, Duration = 4 }) end)
        end
        function S.gsPress(b)   -- sends the clicks of a finger / laser press to a button
            for _, n in ipairs({ "MouseButton1Down", "MouseButton1Click", "MouseButton1Up", "Activated", "TouchTap" }) do
                local ok, sig = pcall(function() return b[n] end)
                if ok and sig then
                    if firesignal then
                        pcall(firesignal, sig)
                    elseif getconnections then
                        local ok2, cs = pcall(getconnections, sig)
                        if ok2 and cs then for _, cn in ipairs(cs) do pcall(function() cn:Fire() end) end end
                    end
                end
            end
        end
        function S.gsScan()   -- looks for the settings panel (by its title) and for buttons that could open it
            local res = { openers = {}, cands = {}, panels = {} }
            local lp = game:GetService("Players").LocalPlayer
            local cam = workspace.CurrentCamera
            local n = 0
            for _, r in ipairs({ lp:FindFirstChildOfClass("PlayerGui"), workspace }) do
                if r then
                    for _, d in ipairs(r:GetDescendants()) do
                        n = n + 1
                        if n % 2500 == 0 then task.wait() end
                        local cn = d.ClassName
                        if cn == "TextLabel" or cn == "TextButton" then
                            local ok, t = pcall(function() return string.lower((d.Text:gsub("^%s+", ""):gsub("%s+$", ""))) end)
                            if ok and t then
                                local mine = cam and d:IsDescendantOf(cam)   -- the menus of this script live there
                                if t == "game settings" and cn == "TextLabel" and not mine then
                                    local root, gui = d, nil
                                    local a = d.Parent
                                    while a do
                                        if a:IsA("GuiObject") then root = a elseif a:IsA("LayerCollector") then gui = a break end
                                        a = a.Parent
                                    end
                                    local part
                                    if gui and (gui:IsA("SurfaceGui") or gui:IsA("BillboardGui")) then
                                        part = gui.Adornee or gui.Parent
                                        if part and not part:IsA("BasePart") then part = nil end
                                    end
                                    local pp = { title = d, root = root, gui = gui, part = part }
                                    res.panels[#res.panels + 1] = pp
                                    if not res.panel then res.panel = pp end
                                elseif not mine and (t == "settings" or t == "setting" or string.find(t, "settings", 1, true)) and cn == "TextButton" then
                                    res.openers[#res.openers + 1] = d
                                end
                                if not mine and string.find(t, "setting", 1, true) and #res.cands < 30 then res.cands[#res.cands + 1] = d:GetFullName() .. "  [" .. t .. "]" end
                            end
                        elseif (cn == "ImageButton" or cn == "ClickDetector" or cn == "ProximityPrompt") and #res.cands < 30 then
                            local nm = string.lower(cn == "ImageButton" and d.Name or (d.Parent and d.Parent.Name or d.Name))
                            if string.find(nm, "setting", 1, true) and not (cam and d:IsDescendantOf(cam)) then
                                res.cands[#res.cands + 1] = d:GetFullName() .. "  [" .. cn .. "]"
                                res.openers[#res.openers + 1] = d
                            end
                        end
                    end
                end
            end
            return res
        end
        function S.gsVisible(p)
            local d = p.title
            while d and d:IsA("GuiObject") do
                if not d.Visible then return false end
                d = d.Parent
            end
            if p.gui and p.gui:IsA("LayerCollector") and not p.gui.Enabled then return false end
            return true
        end
        function S.gsSetOpen(p, on)
            local d = p.title
            while d and d:IsA("GuiObject") do
                if on then d.Visible = true end
                d = d.Parent
            end
            if not on and p.root then p.root.Visible = false end
            if p.gui and p.gui:IsA("LayerCollector") then p.gui.Enabled = on end
        end
        function S.gsPlace(p)   -- the game puts its own panel where it wants it, so it is left alone; only a panel parked far away is brought over, once
            local part = p.part
            if not part then return end
            task.wait(0.4)   -- let the game place it first
            local cam = workspace.CurrentCamera
            if not (cam and part.Parent) then return end
            if (part.Position - cam.CFrame.Position).Magnitude < 120 then return end
            local face = (p.gui and p.gui:IsA("SurfaceGui")) and p.gui.Face or Enum.NormalId.Front
            local M = {
                [Enum.NormalId.Front] = CFrame.new(),
                [Enum.NormalId.Back] = CFrame.Angles(0, math.pi, 0),
                [Enum.NormalId.Right] = CFrame.Angles(0, math.pi / 2, 0),
                [Enum.NormalId.Left] = CFrame.Angles(0, -math.pi / 2, 0),
                [Enum.NormalId.Top] = CFrame.Angles(-math.pi / 2, 0, 0),
                [Enum.NormalId.Bottom] = CFrame.Angles(math.pi / 2, 0, 0),
            }
            local sz = part.Size
            local h = math.max(sz.X, sz.Y, sz.Z)
            local dist = math.clamp(h * 2.2, 4, 60)
            local cf = cam.CFrame
            part.CFrame = CFrame.lookAt(cf.Position + cf.LookVector * dist, cf.Position) * (M[face] or CFrame.new())
        end
        function S.gsRun()
            local sc = S.gsScan()
            local p = sc.panel
            local shown = {}
            for _, q in ipairs(sc.panels) do if S.gsVisible(q) then shown[#shown + 1] = q end end
            if #shown > 0 then   -- it is open: close every copy that is showing
                if S.gsPin then pcall(function() S.gsPin:Disconnect() end) S.gsPin = nil end
                for _, q in ipairs(shown) do S.gsSetOpen(q, false) end
                S.gsNote("Closed the game settings.")
                return
            end
            if not p and #sc.openers > 0 then   -- not built yet: press the game's own settings button(s)
                for i, o in ipairs(sc.openers) do
                    if i > 4 then break end
                    if o:IsA("GuiButton") then
                        S.gsPress(o)
                    elseif o:IsA("ClickDetector") and fireclickdetector then
                        pcall(fireclickdetector, o)
                    elseif o:IsA("ProximityPrompt") and fireproximityprompt then
                        pcall(fireproximityprompt, o)
                    end
                end
                task.wait(0.7)
                p = S.gsScan().panel
            end
            if p then
                S.gsSetOpen(p, true)
                S.gsPlace(p)
                S.gsNote("Opened. Press it again to close it.")
                return
            end
            warn("[NoVR] game settings: not found. Things with 'setting' in them:\n" .. (#sc.cands > 0 and table.concat(sc.cands, "\n") or "(nothing)"))
            S.gsNote("Couldn't find the menu here. This only works in the VR Hands game. Details are in the console (F9).")
        end
        function S.openGameSettings()
            if S.gsBusy then return end
            S.gsBusy = true
            task.spawn(function()
                local ok, err = pcall(S.gsRun)
                S.gsBusy = false
                if not ok then
                    warn("[NoVR] game settings: " .. tostring(err))
                    S.gsNote("Something went wrong, see the console (F9).")
                end
            end)
        end
        S.BH_DIM = 0.62   -- how bright the glowing parts of the black hole are (1 = the model's own very bright cream)
        S.BH_TINTS = { Color3.fromRGB(255, 214, 150), Color3.fromRGB(255, 160, 85), Color3.fromRGB(255, 120, 60), Color3.fromRGB(255, 195, 150) }
        function S.bhMakeTex(fn, W, H, px)   -- draws a picture from a pixel function, saves it as a png file and gives back its asset
            local gca = getcustomasset or getsynasset
            if not (writefile and gca and buffer and bit32 and S.bhPng) then return nil end
            if not (isfile and isfile(fn)) then
                local raw = buffer.create(H * (1 + W * 4))
                local t0 = os.clock()
                for y = 0, H - 1 do
                    local ro = y * (1 + W * 4)
                    for x = 0, W - 1 do
                        local r, g, b, a = px(x, y)
                        buffer.writeu32(raw, ro + 1 + x * 4, r + g * 256 + b * 65536 + a * 16777216)
                    end
                    if os.clock() - t0 > 0.006 then task.wait() t0 = os.clock() end
                end
                writefile(fn, S.bhPng(raw, W, H))
            end
            local ok, a = pcall(gca, fn)
            if ok and a then return a end
            return nil
        end
        function S.bhRingPx(N)   -- the accretion disc picture: soft, white-cream inside and brown-orange outside, with slow swirls; brighter on one side
            local floor, sin, cos, sqrt = math.floor, math.sin, math.cos, math.sqrt
            local function hash(i, j) local v = sin(i * 127.1 + j * 311.7) * 43758.5453 return v - floor(v) end
            local function vnoise(a, b, P)   -- value noise that repeats every P steps along a
                local ia, ib = floor(a), floor(b)
                local fa, fb = a - ia, b - ib
                fa = fa * fa * (3 - 2 * fa)
                fb = fb * fb * (3 - 2 * fb)
                local i0, i1 = ia % P, (ia + 1) % P
                local v0 = hash(i0, ib) + (hash(i1, ib) - hash(i0, ib)) * fa
                local v1 = hash(i0, ib + 1) + (hash(i1, ib + 1) - hash(i0, ib + 1)) * fa
                return v0 + (v1 - v0) * fb
            end
            local function ss(e0, e1, x) local t = math.clamp((x - e0) / (e1 - e0), 0, 1) return t * t * (3 - 2 * t) end
            local RIN = 0.22
            return function(x, y)
                local px, py = (x + 0.5) / N * 2 - 1, (y + 0.5) / N * 2 - 1
                local r = sqrt(px * px + py * py)
                local t = (r - RIN) / (1 - RIN)
                if t <= 0 or r >= 1 then return 255, 200, 120, 0 end
                local th = math.atan2(py, px) / (2 * math.pi) + 0.5
                local nA = vnoise((th + 0.25 * t) * 18, t * 6, 18)
                local nB = vnoise((th - 0.4 * t) * 48, t * 14, 48)
                local streak = 0.6 * nA + 0.4 * nB
                local bands = 0.88 + 0.12 * sin(t * 50 + nA * 5)
                local dop = 1 + 0.3 * cos((th - 0.12) * 2 * math.pi)
                local body = ss(0, 0.04, t) * (1 - ss(0.2, 1, t)) ^ 1.3
                local heat = math.clamp(1 - t * 1.6 + (streak - 0.5) * 0.35, 0, 1)
                local lum = math.min(1, (0.8 + 0.4 * (streak - 0.5)) * bands * dop)
                local cr = 255 * (0.62 + 0.38 * heat ^ 0.5) * lum
                local cg = 255 * (0.36 + 0.64 * heat) * lum
                local cb = 255 * (0.16 + 0.72 * heat ^ 1.4) * lum
                local a = body * math.clamp(0.55 + 0.6 * heat, 0, 1)
                return floor(cr + 0.5), floor(cg + 0.5), floor(cb + 0.5), floor(a * 255 + 0.5)
            end
        end
        function S.bhLensPx(N)   -- the bent light around the dark middle: a thin bright ring hugging the shadow, and a soft halo that is brighter above and below
            local floor, sqrt, exp = math.floor, math.sqrt, math.exp
            local R0 = 0.34   -- the shadow's edge (the picture is 3 shadow radii wide, so this is 1/3 plus a hair)
            return function(x, y)
                local px, py = (x + 0.5) / N * 2 - 1, (y + 0.5) / N * 2 - 1
                local r = sqrt(px * px + py * py)
                if r <= R0 or r >= 1 then return 255, 230, 180, 0 end
                local s = (r - R0) / (1 - R0)
                local yy = py / r
                local arcs = 0.4 + 0.6 * yy * yy
                local halo = (0.85 * exp(-s * 8) + 0.22 * exp(-s * 2.4)) * arcs
                local ring = 1.1 * exp(-((s - 0.015) / 0.02) ^ 2)
                local v = math.clamp(halo + ring, 0, 1)
                local heat = math.clamp(1 - s * 3, 0, 1)
                local cr = 255
                local cg = 150 + 105 * heat
                local cb = 70 + 170 * heat ^ 1.3
                return cr, floor(cg), floor(cb), floor(v * 255 * (1 - s ^ 3) + 0.5)
            end
        end
        function S.bhGlowPx(N)   -- a soft round glow for the dust
            return function(x, y)
                local dx, dy = (x + 0.5) / N * 2 - 1, (y + 0.5) / N * 2 - 1
                local r2 = dx * dx + dy * dy
                local a = r2 < 1 and (1 - r2) ^ 2.2 or 0
                return 255, 210, 150, math.floor(a * 255 + 0.5)
            end
        end
        function S.hexPx(N, sides)   -- one dome panel: a soft see-through fill with a bright edge and a thin inner line (white, tinted later)
            local floor, exp = math.floor, math.exp
            local normals = {}
            for k = 0, sides - 1 do
                local a = -math.pi / 2 + k * 2 * math.pi / sides
                normals[k + 1] = { math.cos(a), math.sin(a) }
            end
            local ap = 0.98 * math.cos(math.pi / sides)   -- apothem, so the corners reach 98% of the picture
            local function ss(e0, e1, x) local t = math.clamp((x - e0) / (e1 - e0), 0, 1) return t * t * (3 - 2 * t) end
            return function(x, y)
                local px, py = (x + 0.5) / N * 2 - 1, (y + 0.5) / N * 2 - 1
                local m = -1e9
                for _, nr in ipairs(normals) do
                    local d = px * nr[1] + py * nr[2]
                    if d > m then m = d end
                end
                local e = m / ap   -- 0 in the middle, 1 on the edge
                if e >= 1 then return 255, 255, 255, 0 end
                local fill = 0.3 + 0.12 * e * e
                local band = ss(0.84, 0.92, e)
                local line = 0.35 * exp(-((e - 0.7) / 0.014) ^ 2)
                local a = math.max(fill, band, line) * (1 - ss(0.985, 1, e))
                return 255, 255, 255, floor(a * 255 + 0.5)
            end
        end
