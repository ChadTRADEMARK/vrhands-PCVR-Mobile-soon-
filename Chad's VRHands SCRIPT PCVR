            local function openRoblox()
                local p, ent = overlay("roblox", 24, 10, 860, 470, "Roblox", "Roblox Home")
                if not p then return end
                local HttpService     = game:GetService("HttpService")
                local PlayersSvc      = game:GetService("Players")
                local TeleportService = game:GetService("TeleportService")
                local req  = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
                local clip = setclipboard or toclipboard
                local Info = _G.NoVR_RbInfo   -- universeId -> what we know about it (shared by every row / pop-up, kept while the game runs)
                if type(Info) ~= "table" then Info = {}; _G.NoVR_RbInfo = Info end
                local session = HttpService:GenerateGUID(false)
                local device  = IS_MOBILE and "phone" or "computer"
                local CARD_W  = 122
                local ROW_H   = 190
                local mode, lastQuery = "home", ""
                local loadToken = 0   -- bumps on every refresh / search, so an old answer can never overwrite a newer page
                local joining = false

                -- ===== web requests =====
                -- returns the decoded JSON, or nil + the reason. Tries request() first (it reports the status code), then HttpGet.
                local function rbGet(url)
                    local code
                    for attempt = 1, 2 do
                        local body
                        if req then
                            local ok, r = pcall(req, { Url = url, Method = "GET", Headers = { Accept = "application/json" } })
                            if ok and type(r) == "table" then
                                code = r.StatusCode
                                if r.Success or r.StatusCode == 200 then body = r.Body end
                            end
                        end
                        if not body then
                            local ok, res = pcall(function() return game:HttpGet(url, true) end)
                            if ok and type(res) == "string" and #res > 0 then body = res end
                        end
                        if body then
                            local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
                            if ok and type(data) == "table" then return data end
                            return nil, "bad data"
                        end
                        if code == 429 and attempt == 1 then task.wait(1.5) else break end
                    end
                    return nil, code == 429 and "rate limited" or ("HTTP " .. tostring(code or "blocked"))
                end

                -- Roblox's endpoints answer in slightly different shapes, so instead of trusting one layout this walks the
                -- reply and picks up every game-shaped entry in order (universeId + name, or contentId for search results).
                local function collectGames(node, out, seen, depth)
                    if type(node) ~= "table" or depth > 7 then return end
                    local uid = tonumber(node.universeId) or (node.contentType == "Game" and tonumber(node.contentId)) or nil
                    if uid and uid > 0 and type(node.name) == "string" then
                        if not seen[uid] then
                            seen[uid] = true
                            out[#out + 1] = {
                                u = uid, n = node.name,
                                p = tonumber(node.rootPlaceId) or tonumber(node.placeId),
                                live = tonumber(node.playerCount) or tonumber(node.playing),
                                up = tonumber(node.totalUpVotes), down = tonumber(node.totalDownVotes),
                            }
                        end
                        return
                    end
                    if #node > 0 then
                        for i = 1, #node do collectGames(node[i], out, seen, depth + 1) end
                    else
                        for _, v in pairs(node) do collectGames(v, out, seen, depth + 1) end
                    end
                end

                local function remember(g)
                    local inf = Info[g.u] or {}
                    for k, v in pairs({ p = g.p, live = g.live, up = g.up, down = g.down, n = g.n }) do inf[k] = v end
                    Info[g.u] = inf
                    return inf
                end

                local function idChunks(ids, fn)
                    for i = 1, #ids, 40 do
                        local chunk = {}
                        for j = i, math.min(i + 39, #ids) do chunk[#chunk + 1] = ids[j] end
                        fn(table.concat(chunk, ","))
                    end
                end
                local function fetchDetails(ids)
                    idChunks(ids, function(csv)
                        local data = rbGet("https://games.roblox.com/v1/games?universeIds=" .. csv)
                        if data and type(data.data) == "table" then
                            for _, d in ipairs(data.data) do
                                local u = type(d) == "table" and tonumber(d.id)
                                if u then
                                    local inf = Info[u] or {}
                                    inf.p = tonumber(d.rootPlaceId) or inf.p
                                    inf.live = tonumber(d.playing) or inf.live
                                    inf.visits, inf.fav, inf.max = tonumber(d.visits), tonumber(d.favoritedCount), tonumber(d.maxPlayers)
                                    if type(d.description) == "string" then inf.desc = d.description end
                                    if type(d.creator) == "table" and type(d.creator.name) == "string" then inf.by = d.creator.name end
                                    if type(d.name) == "string" then inf.n = d.name end
                                    Info[u] = inf
                                end
                            end
                        end
                    end)
                end
                local function fetchVotes(ids)
                    idChunks(ids, function(csv)
                        local data = rbGet("https://games.roblox.com/v1/games/votes?universeIds=" .. csv)
                        if data and type(data.data) == "table" then
                            for _, v in ipairs(data.data) do
                                local u = type(v) == "table" and tonumber(v.id)
                                if u then
                                    local inf = Info[u] or {}
                                    inf.up, inf.down = tonumber(v.upVotes), tonumber(v.downVotes)
                                    Info[u] = inf
                                end
                            end
                        end
                    end)
                end
                -- fills in only what a list didn't already tell us (place id, players now, votes)
                local function enrichList(list)
                    local needD, needV = {}, {}
                    for _, g in ipairs(list) do
                        local inf = remember(g)
                        if not inf.p or inf.live == nil then needD[#needD + 1] = g.u end
                        if inf.up == nil or inf.down == nil then needV[#needV + 1] = g.u end
                    end
                    if #needD > 0 then fetchDetails(needD) end
                    if #needV > 0 then fetchVotes(needV) end
                end

                -- the game lists of Roblox's home page: explore-api first, the older games list as a fallback.
                -- onRow(name, games) is called for each list as soon as it is ready. Returns how many lists were shown + why not.
                local function fetchHome(onRow, stopped)
                    local count, why = 0, nil
                    local sorts, w1 = rbGet("https://apis.roblox.com/explore-api/v1/get-sorts?sessionId=" .. session
                        .. "&device=" .. device .. "&country=all")
                    why = w1
                    if sorts and type(sorts.sorts) == "table" then
                        for _, s in ipairs(sorts.sorts) do
                            if count >= 8 or stopped() then break end
                            local id = type(s) == "table" and (s.sortId or s.id)
                            local ct = type(s) == "table" and s.contentType
                            if type(id) == "string" and (ct == nil or ct == "Games") then
                                local base = "https://apis.roblox.com/explore-api/v1/get-sort-content?sessionId=" .. session
                                    .. "&sortId=" .. HttpService:UrlEncode(id)
                                local data = rbGet(base .. "&device=" .. device .. "&country=all") or rbGet(base)
                                local list = {}
                                if data then collectGames(data, list, {}, 0) end
                                while #list > 30 do list[#list] = nil end
                                if #list > 0 then
                                    enrichList(list)
                                    if stopped() then break end
                                    count += 1
                                    onRow(tostring(s.sortDisplayName or s.displayName or id), list)
                                end
                                task.wait(0.1)
                            end
                        end
                    end
                    if count == 0 and not stopped() then
                        local ls, w2 = rbGet("https://games.roblox.com/v1/games/sorts?gameSortsContext=GamesDefaultSorts")
                        why = why or w2
                        if ls and type(ls.sorts) == "table" then
                            for _, s in ipairs(ls.sorts) do
                                if count >= 6 or stopped() then break end
                                if type(s) == "table" and type(s.token) == "string" then
                                    local d = rbGet("https://games.roblox.com/v1/games/list?sortToken=" .. s.token .. "&startRows=0&maxRows=24")
                                    local list = {}
                                    if d then collectGames(d, list, {}, 0) end
                                    while #list > 16 do list[#list] = nil end
                                    if #list > 0 then
                                        enrichList(list)
                                        if stopped() then break end
                                        count += 1
                                        onRow(tostring(s.displayName or s.name or "Games"), list)
                                    end
                                    task.wait(0.1)
                                end
                            end
                        end
                    end
                    return count, why
                end

                local function searchGames(q)
                    local list, seen = {}, {}
                    local why
                    local digits = string.match(q, "^%d+$")
                    if digits and #digits >= 5 then   -- a place id: look that game up directly
                        local d = rbGet("https://apis.roblox.com/universes/v1/places/" .. digits .. "/universe")
                        local u = d and tonumber(d.universeId)
                        if u then
                            fetchDetails({ u })
                            local inf = Info[u]
                            if inf and inf.n then list[1] = { u = u, n = inf.n, p = inf.p }; seen[u] = true end
                        end
                    end
                    local enc = HttpService:UrlEncode(q)
                    local data, w1 = rbGet("https://apis.roblox.com/search-api/omni-search?searchQuery=" .. enc
                        .. "&sessionId=" .. session .. "&pageType=all")
                    why = w1
                    if data then collectGames(data, list, seen, 0) end
                    if #list == 0 then
                        local d2, w2 = rbGet("https://games.roblox.com/v1/games/list?keyword=" .. enc .. "&startRows=0&maxRows=32")
                        why = why or w2
                        if d2 then collectGames(d2, list, seen, 0) end
                    end
                    while #list > 40 do list[#list] = nil end
                    if #list > 0 then enrichList(list) end
                    return list, why
                end

                -- your friends: the full list (names) merged with who is online / in which game right now
                local function loadFriendData()
                    local online = {}
                    pcall(function()
                        for _, f in ipairs(lp:GetFriendsOnline(200) or {}) do
                            local id = type(f) == "table" and tonumber(f.VisitorId)
                            if id then online[id] = f end
                        end
                    end)
                    local all = {}
                    local okA = pcall(function()
                        local pages = PlayersSvc:GetFriendsAsync(lp.UserId)
                        for _ = 1, 3 do
                            for _, f in ipairs(pages:GetCurrentPage()) do all[#all + 1] = f end
                            if pages.IsFinished then break end
                            pages:AdvanceToNextPageAsync()
                        end
                    end)
                    local list, seen = {}, {}
                    local function add(id, name, display, f)
                        if not id or seen[id] then return end
                        seen[id] = true
                        local o = online[id]
                        local gid = o and o.GameId and tostring(o.GameId) ~= "" and tostring(o.GameId) or nil
                        list[#list + 1] = {
                            id = id, name = name, display = (type(display) == "string" and display ~= "") and display or name,
                            online = (o ~= nil) or (type(f) == "table" and f.IsOnline == true),
                            placeId = o and tonumber(o.PlaceId) or nil, gameId = gid,
                            loc = o and type(o.LastLocation) == "string" and o.LastLocation or nil,
                        }
                    end
                    for _, f in ipairs(all) do add(tonumber(f.Id), tostring(f.Username or "?"), f.DisplayName, f) end
                    for id, o in pairs(online) do add(id, tostring(o.UserName or "?"), o.DisplayName, o) end
                    local function rank(f) if f.gameId and f.placeId then return 0 elseif f.online then return 1 end return 2 end
                    table.sort(list, function(a, b)
                        local ra, rb = rank(a), rank(b)
                        if ra ~= rb then return ra < rb end
                        return string.lower(a.display) < string.lower(b.display)
                    end)
                    local total = #list
                    local cnt = rbGet("https://friends.roblox.com/v1/users/" .. lp.UserId .. "/friends/count")
                    if cnt and tonumber(cnt.count) then total = tonumber(cnt.count) end
                    while #list > 150 do list[#list] = nil end
                    local err
                    if #list == 0 then err = okA and "No friends to show." or "Couldn't read your friends list on this executor." end
                    return { list = list, total = total, err = err }
                end

                -- ===== little formatting helpers =====
                local function short(n)
                    n = tonumber(n)
                    if not n then return "-" end
                    local s
                    if n >= 1e9 then s = string.format("%.1fB", n / 1e9)
                    elseif n >= 1e6 then s = string.format("%.1fM", n / 1e6)
                    elseif n >= 1e3 then s = string.format("%.1fK", n / 1e3)
                    else s = tostring(math.floor(n)) end
                    return (string.gsub(s, "%.0([KMB])$", "%1"))
                end
                local function ratingOf(inf)
                    if inf and inf.up and inf.down and inf.up + inf.down > 0 then
                        return math.floor(inf.up / (inf.up + inf.down) * 100 + 0.5)
                    end
                end

