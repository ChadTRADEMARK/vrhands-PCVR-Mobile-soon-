        S.TAG_COLORS = { { "PURPLE", 176, 98, 255 }, { "GREEN", 130, 255, 70 }, { "BLUE", 80, 170, 255 }, { "RED", 255, 80, 90 }, { "GOLD", 255, 200, 60 },
