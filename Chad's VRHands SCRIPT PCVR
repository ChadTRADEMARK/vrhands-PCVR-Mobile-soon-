        end
        function S.suckTravel(c, ob)   -- the path of one piece: lift, spiral in, plunge
            local rnd = c.suckRnd
            local v0 = ob.cf0.Position - c.S0
            local ha = v0:Dot(c.suckA)
            local vr = v0 - c.suckA * ha
            ob.r0, ob.ha = vr.Magnitude, ha
            ob.phi0 = math.atan2(vr:Dot(c.suckE2), vr:Dot(c.suckE1))
            ob.sgn = 1
            ob.turns = 0.05 + rnd:NextNumber() * 0.15
            ob.lift = 25 + rnd:NextNumber() * 70
            ob.spinAxis = Vector3.new(rnd:NextNumber() - 0.5, rnd:NextNumber() - 0.5, rnd:NextNumber() - 0.5).Unit
            ob.spinRate = 0.3 + rnd:NextNumber() * 1.1
            ob.rot0 = ob.cf0.Rotation
        end
        -- ===== destruction physics: every torn-off piece is a real body with gravity, bounces, tumbling and friction; once it has left the ground the pull of the black hole grows until it wins =====
        function S.dbrAdd(c, p, isModel, cf, v, w, o)
            local b = { p = p, model = isModel, cf = cf, v = v, w = w, t0 = o.t0, liftT = o.liftT, rampT = o.rampT or 1.6, gy = o.gy or (cf.Position.Y - 0.5), dim = o.dim or 8, water = o.water, col = (typeof(p) == "Instance" and p:IsA("BasePart")) and p.Color or nil, ob = o.ob, main = o.main, frag = o.frag, ph = o.ph or 0, breakAt = o.breakAt }
            local dist = (c.S0 - cf.Position).Magnitude
            local deadline = c.dbrDeadline or 25
            local left = math.max(deadline - (b.t0 + b.liftT), 3)
            b.aMax = math.clamp(3.4 * dist / (left * left), 40, 900)   -- strong enough to arrive before the end
