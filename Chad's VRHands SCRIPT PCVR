        -- ============ SCRIPT CHAT (people running this script) + OWNER ANNOUNCEMENTS ============
        -- Chat: messages go through the free public relay ntfy.sh (one topic shared by every copy of the script), so
        --   only people running the script see them. Nothing is stored by the script except what you type.
        -- Announcements: the owner publishes announce.json to the GitHub repo (needs the owner's own GitHub token, kept
        --   only on the owner's computer); every copy of the script polls that file and shows a pop-up. Nobody else can
        --   write to your repo, so nobody else can send one.
        local CHAT_TOPIC = "novrhands-chat-9c41e7b2a65d03f8"
