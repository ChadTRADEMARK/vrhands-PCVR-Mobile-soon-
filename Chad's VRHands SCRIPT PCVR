        local function fmtN(n)
            n = tonumber(n)
            if not n then return "?" end
            local r = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1,")
            r = r:reverse()
            if r:sub(1, 1) == "," then r = r:sub(2) end
            return r
        end

        local function devicePlatform()
            local raw = "Unknown"
            local okp, v = pcall(function() return UIS:GetPlatform() end)
            if okp and v then raw = (tostring(v):gsub("^Enum%.Platform%.", "")) end
            local name, binary = raw, "WindowsPlayer"
            if raw == "Windows" or raw == "UWP" then
                name = "Windows PC"
            elseif raw == "OSX" then
                name, binary = "macOS", "MacPlayer"
            elseif raw == "IOS" then
                name, binary = "iOS", "iOS"
            elseif raw == "Android" then
                name, binary = "Android", "AndroidApp"
            elseif raw == "XBoxOne" or raw == "PS4" or raw == "PS5" or raw == "XBox360" then
                name = "Console (" .. raw .. ")"
            elseif UIS.TouchEnabled and not UIS.KeyboardEnabled then
                name, binary = "Mobile / tablet", "AndroidApp"
            elseif UIS.KeyboardEnabled then
                name = "PC"
            end
            return name, binary
        end

        -- GET + JSON decode. bust = add a changing query so GitHub's cache doesn't serve an old copy
        local function jsonGet(url, bust)
            if type(url) ~= "string" or url == "" then return nil end
            if bust then
                url = url .. (string.find(url, "?", 1, true) and "&" or "?") .. "t=" .. tostring(os.time())
            end
            local body = rawGet(url)
            if not body then return nil end
            local ok, data = pcall(HttpSvcD.JSONDecode, HttpSvcD, body)
            if ok and type(data) == "table" then return data end
            return nil
        end

        -- fetches every source at the same time
        local function collectStats(platBinary)
            local d = {}
            local pending = 4
            local function run(f)
                task.spawn(function()
                    pcall(f)
                    pending = pending - 1
                end)
            end
            run(function()
                local live = jsonGet("https://clientsettingscdn.roblox.com/v2/client-version/" .. platBinary)
                if not (live and live.clientVersionUpload) then
                    live = jsonGet("https://clientsettings.roblox.com/v2/client-version/" .. platBinary)
                end
                d.live = live
            end)
            run(function() d.status = jsonGet(STATUS_URL, true) end)
            run(function() d.roles = jsonGet(ROLES_URL, true) end)
            run(function() d.discord = jsonGet("https://discord.com/api/v10/invites/" .. DISCORD_CODE .. "?with_counts=true") end)
            local t0 = os.clock()
            while pending > 0 and os.clock() - t0 < 15 do task.wait(0.1) end
            return d
        end

