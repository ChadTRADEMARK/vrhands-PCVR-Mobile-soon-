-- ============ VERSION SCHEME ============
-- MAJOR.MINOR.PATCH, each number counts 0..ROLLOVER then wraps and carries (2.0.12 -> 2.1.0, 2.12.12 -> 3.0.0).
local Ver = { ROLLOVER = 12 }
function Ver.parse(v)
    if v == nil then return nil end
    local a, b, c = tostring(v):match("^v?(%d+)%.(%d+)%.(%d+)$")
    if not a then return nil end
    return { tonumber(a), tonumber(b), tonumber(c) }
end
function Ver.cmp(x, y)            -- 1 if x is newer, -1 if older, 0 if equal, nil if either is not a version
    local px, py = Ver.parse(x), Ver.parse(y)
    if not (px and py) then return nil end
    for i = 1, 3 do
        if px[i] ~= py[i] then return px[i] > py[i] and 1 or -1 end
    end
    return 0
end
function Ver.bump(v)              -- next version in the pattern
    local p = Ver.parse(v) or { 0, 0, 0 }
    p[3] = p[3] + 1
    if p[3] > Ver.ROLLOVER then p[3] = 0; p[2] = p[2] + 1 end
    if p[2] > Ver.ROLLOVER then p[2] = 0; p[1] = p[1] + 1 end
    return p[1] .. "." .. p[2] .. "." .. p[3]
end
-- Works out what the Status screens show. `feed` = version in your Discord/status feed, `file` = version
-- inside the script at UPDATE_URL. The newest valid one counts as "latest".
local function versionInfo(feed, file)
    local feedV  = Ver.parse(feed) and tostring(feed):gsub("^v", "") or nil
    local fileV  = Ver.parse(file) and tostring(file):gsub("^v", "") or nil
    local latest = feedV
    if fileV and (not latest or Ver.cmp(fileV, latest) == 1) then latest = fileV end
    local info = { latest = latest }
    if not latest then
        info.state, info.text = "warn", "Can't check for updates"
    else
        local c = Ver.cmp(latest, SCRIPT_VERSION)
        if c == 1 then info.state, info.text = "warn", "Update available"
        elseif c == -1 then info.state, info.text = "ok", "Up to date (ahead of feed)"
        else info.state, info.text = "ok", "Up to date" end
    end
    if not feedV then
        info.feedText, info.feedState = (feed ~= nil) and ("Invalid (" .. tostring(feed) .. ")") or "Not in feed", feed ~= nil and "warn" or nil
    else
        local c = Ver.cmp(feedV, SCRIPT_VERSION)
        if c == 0 then info.feedText, info.feedState = "v" .. feedV .. "  (in sync)", "ok"
        elseif c == 1 then info.feedText, info.feedState = "v" .. feedV .. "  (update available, you have v" .. SCRIPT_VERSION .. ")", "warn"
        else info.feedText, info.feedState = "v" .. feedV .. "  (you have v" .. SCRIPT_VERSION .. ", newer than feed)", "ok" end
    end
    return info
end

