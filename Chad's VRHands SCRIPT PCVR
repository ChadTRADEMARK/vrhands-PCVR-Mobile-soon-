                            return
                        end
                        lastList = arrange(raw, m)
                        if #lastList == 0 then
                            status.Text = (why == "rate") and "Roblox is rate limiting - wait a few seconds and press REFRESH."
                                or (why and "Couldn't load servers (HttpGet / request blocked?)." or "No servers found.")
                        else
                            status.Text = #lastList .. " servers found" .. (why == "rate" and " (partial - rate limited)" or "")
