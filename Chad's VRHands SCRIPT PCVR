                end
                lbl(P2, "ANIMATION  (add poses as frames, then play them in a loop)", 20, 240, 700, 14, 11, MUTED)
                local frameDur = 0.8
                local chips = Instance.new("Frame")
                chips.Position = UDim2.fromOffset(20, 340)
