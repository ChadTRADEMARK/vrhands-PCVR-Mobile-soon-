                end)
                infoB.Activated:Connect(function()
                    local txt = S.fingerSummary() .. "\n" .. table.concat(S.fr.dump, "\n")
                    local ok = pcall(function() setclipboard(txt) end)
                    say(ok and "Joint list copied - paste it to me if the finger bend looks wrong." or "Your executor cannot copy to the clipboard.")
                end)
                axB.Activated:Connect(function()
                    local nx = { X = "Y", Y = "Z", Z = "X" }
                    S.fr.axis = nx[S.fr.axis]
                    axB.Text = "AXIS: " .. S.fr.axis
                end)
                modeB.Activated:Connect(function()
                    S.fr.mode = (S.fr.mode == "Transform") and "C0" or "Transform"
                    modeB.Text = "MODE: " .. S.fr.mode
                    say("Bend mode: " .. S.fr.mode .. (S.fr.mode == "C0" and " (moves the joint itself)" or " (animation offset)"))
                end)
                flipB.Activated:Connect(function() S.fr.sign = -S.fr.sign; say("Finger bend direction flipped.") end)
                local relB = mkBtn(P1, "RELEASE FINGERS", 180, 394, 150, 28, 11)
                relB.Activated:Connect(function()
                    S.animStop()
                    S.gestSet("L", false); S.gestSet("R", false)
                    say("Fingers released: the hands follow the mouse / keys again.")
