                if not b:IsA("GuiButton") or b:GetAttribute("NoVR_fx") then return end
                local sg = b:FindFirstAncestorWhichIsA("ScreenGui")
                if not sg or string.sub(sg.Name, 1, 5) ~= "NoVR_" or SKIP[sg.Name] then return end
