                                pad.PaddingLeft = UDim.new(0, 12)
                                pad.Parent = b
                                b.InputBegan:Connect(function(io) if isPress(io) then ripple(b, io, fit.Scale) end end)
                                b.Activated:Connect(function()
                                    local pos = headPos(vrPlayers:FindFirstChild(tostring(pl.UserId)))
                                    if not pos then
                                        status.Text = pl.DisplayName .. " has no VR rig right now."
                                        return
                                    end
                                    -- land a few head-sizes behind them, on the side you are looking from
                                    local look = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0).LookVector
                                    camPos = pos - look * (headUnit() * 3)
                                    status.Text = "Teleported to " .. pl.DisplayName .. "."
                                end)
                            end
                        end
