        function S.suckCracks(c, cf, size, n)   -- the ground splits: dark jagged cracks run out from the spot before it is torn up
            if c.suckFreed or not c.suckf then return end
            local lowP = S.perfLow()
            local cap = lowP and 50 or 120
            c.crkN = c.crkN or 0
            local rnd = c.suckRnd
            c.crk = c.crk or {}
            n = lowP and math.ceil(n / 2) or n
            for i = 1, n do
                if c.crkN >= cap then return end
                local ang = (i / n) * math.pi * 2 + rnd:NextNumber() * 0.6
                local pos0 = cf * CFrame.new(math.cos(ang) * size * 0.2, 0.18, math.sin(ang) * size * 0.2)
                local dir = cf:VectorToWorldSpace(Vector3.new(math.cos(ang), 0, math.sin(ang)))
                for seg = 1, 2 do   -- two bent segments make it jagged
                    local len = size * (0.5 + rnd:NextNumber() * 0.6) * (seg == 1 and 1 or 0.7)
                    local p = Instance.new("Part")
                    p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
                    p.Material = Enum.Material.Slate
                    p.Color = Color3.fromRGB(20, 16, 14)
                    p.Transparency = 1
                    p.Size = Vector3.new(0.6 + rnd:NextNumber() * 1.0, 0.2, 0.1)
                    p.Parent = c.suckf
                    local base = CFrame.lookAt(pos0.Position, pos0.Position + dir, cf.UpVector)
                    c.crk[#c.crk + 1] = { p = p, cf = base, len = len, t0 = os.clock() + (seg - 1) * 0.35 + rnd:NextNumber() * 0.2 }
                    c.crkN = c.crkN + 1
                    pos0 = base * CFrame.new(0, 0, -len)
                    dir = (CFrame.Angles(0, (rnd:NextNumber() - 0.5) * 1.3, 0) * CFrame.fromMatrix(Vector3.zero, base.RightVector, base.UpVector)):VectorToWorldSpace(-Vector3.zAxis)
                    dir = (CFrame.fromAxisAngle(base.UpVector, (rnd:NextNumber() - 0.5) * 1.3)):VectorToWorldSpace(base.LookVector)
