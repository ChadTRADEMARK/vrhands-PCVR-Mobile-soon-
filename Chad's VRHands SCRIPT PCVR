            -- It never asks for a password or a .ROBLOSECURITY cookie and never stores one. Roblox cannot switch accounts from inside a
            -- running game, so this is for keeping track of your alts and opening their public profiles. The PIN only locks this panel
            -- (a hash is saved in NoVR_Accounts.json); it is a lock, not encryption.
            local ACC_FILE = "NoVR_Accounts.json"
            local ACC = { list = {}, pin = nil, salt = nil }
            local accUnlocked = false
            local function accHash(s, salt)
                local h1, h2 = 2166136261, 5381
                local str = tostring(salt) .. "|" .. s
                for _ = 1, 400 do
                    for i = 1, #str do
                        local b = string.byte(str, i)
                        h1 = bit32.band(bit32.bxor(h1, b) * 16777619, 0xFFFFFFFF)
                        h2 = bit32.band(h2 * 33 + b + bit32.rshift(h1, 7), 0xFFFFFFFF)
                    end
                end
                return string.format("%08x%08x", h1, h2)
            end
