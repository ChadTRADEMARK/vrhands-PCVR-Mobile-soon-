                end
                lbl(P2, "MY GESTURES  (SAVE stores both hands as they are now)", 20, 152, 700, 14, 11, MUTED)
                local slotB = {}
                local function slotText(i) return Lib.slots[i] and ("PLAY  " .. i) or ("empty  " .. i) end
                for i = 1, 4 do
                    local x = 20 + (i - 1) * 178
                    slotB[i] = mkBtn(P2, slotText(i), x, 172, 170, 28, 12)
                    slotB[i].Activated:Connect(function()
