        local function promptUpdate(newVer)
            local pg = lp:WaitForChild("PlayerGui")
            local old = pg:FindFirstChild("NoVR_UpdateToast")
            if old then old:Destroy() end

            local tg = Instance.new("ScreenGui")
            tg.Name = "NoVR_UpdateToast"
            tg.ResetOnSpawn = false
            tg.IgnoreGuiInset = true
            pcall(function() tg.ScreenInsets = Enum.ScreenInsets.None end)
            tg.DisplayOrder = 250   -- above the welcome / loading screens
            tg.Parent = pg

            local card = Instance.new("Frame")
            card.AnchorPoint = Vector2.new(0.5, 0)
            card.Position = UDim2.new(0.5, 0, 0, -90)
            card.Size = UDim2.fromOffset(360, 66)
            card.BackgroundColor3 = C(40, 20, 96)
            card.BackgroundTransparency = 0.08
            card.BorderSizePixel = 0
            card.Parent = tg
            corner(card, 12)
            stroke(card, C(215, 185, 255), 1.5, 0.3)
            lbl(card, "UPDATE FOUND", 14, 8, 200, 18, 12, GREEN)
            local msg = lbl(card, "", 14, 28, 250, 30, 11, WHITE, Enum.Font.GothamMedium)
            msg.TextWrapped = true
            msg.TextTruncate = Enum.TextTruncate.None
            msg.TextYAlignment = Enum.TextYAlignment.Top

            local cancel = Instance.new("TextButton")
            cancel.AnchorPoint = Vector2.new(1, 0.5)
            cancel.Position = UDim2.new(1, -10, 0.5, 0)
            cancel.Size = UDim2.fromOffset(78, 30)
            cancel.AutoButtonColor = false
            cancel.BackgroundColor3 = PINK
            cancel.BackgroundTransparency = 0.3
            cancel.BorderSizePixel = 0
            cancel.Text = "CANCEL"
            cancel.Font = Enum.Font.GothamBold
            cancel.TextSize = 12
            cancel.TextColor3 = WHITE
            cancel.Parent = card
            corner(cancel, 8)
            Theme.recolor(tg)
            tw(card, 0.6, { Position = UDim2.new(0.5, 0, 0, 12) }, Enum.EasingStyle.Back)

            local cancelled = false
            cancel.Activated:Connect(function() cancelled = true end)
            for i = 5, 1, -1 do
                if cancelled then break end
                msg.Text = "v" .. SCRIPT_VERSION .. "  ->  " .. (newVer and ("v" .. newVer) or "new version")
                    .. "\nRestarting in " .. i .. "s"
                task.wait(1)
            end
            if cancelled then
                tw(card, 0.4, { Position = UDim2.new(0.5, 0, 0, -90) }, Enum.EasingStyle.Sine)
                task.delay(0.5, function() tg:Destroy() end)
                return false
            end
            cancel.Visible = false
            msg.Text = "Updating..."
            performUpdate(function(m, isErr)
                if msg.Parent then
                    msg.Text = m
                    msg.TextColor3 = isErr and C(255, 130, 140) or GREEN
                    msg:SetAttribute("tc", true)
                end
