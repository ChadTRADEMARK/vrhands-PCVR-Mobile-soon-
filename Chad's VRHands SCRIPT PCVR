                rf.BorderSizePixel = 0
                rf.Text = "REFRESH"
                rf.Font = Enum.Font.GothamBold
                rf.TextSize = 11
                rf.TextColor3 = WHITE
                rf.ZIndex = 9
                rf.Visible = false
                rf.Parent = root
