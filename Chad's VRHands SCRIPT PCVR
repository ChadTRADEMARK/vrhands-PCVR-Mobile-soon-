        local BRAND = { wm = { "NoVR_wm_v2.png", "" }, m3d = { "NoVR_m3d_v1.png", "" } }
        local function b64dec2(s)
            local A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            local map = {}
            for i = 1, 64 do map[string.sub(A, i, i)] = i - 1 end
            local out, n, acc, bits = {}, 0, 0, 0
            for c in string.gmatch(s, "[%w%+/]") do
                acc = acc * 64 + map[c]
                bits = bits + 6
                if bits >= 8 then
                    bits = bits - 8
                    local v = math.floor(acc / 2 ^ bits)
                    acc = acc - v * 2 ^ bits
                    n = n + 1
                    out[n] = string.char(v)
                end
            end
            return table.concat(out)
        end
