                    local knobSize = math.floor(diameter * 0.43)
                    local knob = Instance.new("Frame")
                    knob.AnchorPoint = Vector2.new(0.5, 0.5)
                    knob.Position = UDim2.fromScale(0.5, 0.5)
                    knob.Size = UDim2.fromOffset(knobSize, knobSize)
                    knob.BackgroundColor3 = tint
                    knob.BackgroundTransparency = 0.2
                    knob.Active = false
                    knob.ZIndex = 4
                    knob.Parent = base
                    local kc = Instance.new("UICorner")
                    kc.CornerRadius = UDim.new(1, 0)
                    kc.Parent = knob

                    local radius = diameter / 2
                    local travel = radius - knobSize / 2 + 4
                    local current = nil
                    local conns = {}

                    local function update(phase)
                        if not current then return end
                        local c = base.AbsolutePosition + base.AbsoluteSize / 2
                        local raw = (screenPos(current) - c) / math.max(base.AbsoluteSize.X / 2, 1)
                        local v = raw.Magnitude > 1 and raw.Unit or raw
                        knob.Position = UDim2.new(0.5, v.X * travel, 0.5, v.Y * travel)  -- knob follows the finger
                        if v.Magnitude < 0.15 then v = Vector2.zero end                   -- dead zone
                        onChange(v, phase, raw)
                    end

                    local function release()
                        if not current then return end
                        current = nil
                        for _, cn in ipairs(conns) do cn:Disconnect() end
                        conns = {}
                        knob.Position = UDim2.fromScale(0.5, 0.5)
                        onChange(Vector2.zero, "end", nil)
                    end

