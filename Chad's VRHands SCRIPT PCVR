        local function joinDiscord(inviteUrl, inviteCode, cb)
            inviteUrl = inviteUrl or DISCORD_INVITE
            inviteCode = inviteCode or DISCORD_CODE
            local clip = setclipboard or toclipboard or (Clipboard and Clipboard.set)
            local copied = false
            if clip then copied = pcall(clip, inviteUrl) end
            task.spawn(function()
                local opened = false
