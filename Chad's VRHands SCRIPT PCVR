                            if type(STATUS_URL) == "string" and STATUS_URL ~= "" then
                                remote = getJson(STATUS_URL .. (string.find(STATUS_URL, "?", 1, true) and "&" or "?") .. "t=" .. tostring(os.time()))
                            end
                            if type(STATUS_URL) ~= "string" or STATUS_URL == "" then
                                rBan.set("Not configured", nil)
                                rDet.set("Not configured", nil)
                                rKey.set("Unknown", nil)
                                rMsg.set("Set STATUS_URL to enable", nil)
                            elseif not remote then
                                rBan.set("Status file unreachable", "warn")
                                rDet.set("Status file unreachable", "warn")
                                rKey.set("Status file unreachable", "warn")
                                rMsg.set("-", nil)
                            else
                                local b = string.lower(tostring(remote.banwave or ""))
                                local note = remote.banwave_note and (" - " .. tostring(remote.banwave_note)) or ""
                                if b == "clear" then rBan.set("Clear" .. note, "ok")
                                elseif b == "warning" then rBan.set("Warning" .. note, "warn")
                                elseif b == "active" then rBan.set("ACTIVE" .. note, "bad")
                                else rBan.set("Unknown", nil) end
                                do local dt, ds = detectionOf(remote); rDet.set(dt, ds) end

                                local k = string.lower(tostring(remote.key_system or ""))
                                if k == "online" then rKey.set("Online", "ok")
                                elseif k == "degraded" then rKey.set("Degraded", "warn")
                                elseif k == "offline" then rKey.set("Offline", "bad")
                                elseif k == "none" then rKey.set("Not used", nil)
                                else rKey.set(k, nil) end

                                rMsg.set(remote.message and tostring(remote.message) or "-", nil)
                            end

                            -- script version: compare with the copy at UPDATE_URL
                            local latest
                            if type(UPDATE_URL) == "string" and UPDATE_URL ~= "" then
                                local text = fetchSource(UPDATE_URL)
                                if text then latest = text:match('SCRIPT_VERSION%s*=%s*"([%w%.%-]+)"') end
                            end
                            local vi = versionInfo(remote and remote.version, latest)
                            local sState, sText = vi.state, vi.text
                            rNew.set(vi.latest and ("v" .. vi.latest) or "Unavailable", vi.latest and vi.state or "warn")
