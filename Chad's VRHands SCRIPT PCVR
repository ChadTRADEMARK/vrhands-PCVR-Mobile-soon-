        -- ============ UPDATER ============
        -- Downloads the newest copy of the script from UPDATE_URL and runs it.
        -- The new copy rejoins the game the same way a normal launch does.
        local function fetchSource(url)
            local sep = string.find(url, "?", 1, true) and "&" or "?"
            local full = url .. sep .. "nocache=" .. tostring(os.time())   -- skip cached copies
            local ok, res = pcall(function() return game:HttpGet(full, true) end)
            if ok and type(res) == "string" and #res > 0 then return res end
            local req = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
            if req then
                local ok2, r = pcall(req, { Url = full, Method = "GET", Headers = { ["Cache-Control"] = "no-cache" } })
                if ok2 and r and (r.Success or r.StatusCode == 200) and type(r.Body) == "string" and #r.Body > 0 then
                    return r.Body
                end
            end
            return nil
        end

        -- only used when the executor can't carry the script across a rejoin
        local function cleanupAll()
            for _, n in ipairs({ "NoVR_HeadVis", "NoVR_Control", "NoVR_Crosshair", "NoVR_CamHead", "NoVR_CamView" }) do
                pcall(function() RunService:UnbindFromRenderStep(n) end)
            end
            local pg = lp:FindFirstChild("PlayerGui")
            if pg then
                for _, n in ipairs({ "NoVR_Mobile", "NoVR_MobileToggle", "NoVR_HUD", "NoVR_StartToggle", "NoVR_Start", "NoVR_Crosshair", "NoVR_Loader", "NoVR_Welcome", "NoVR_UpdateToast" }) do
                    local o = pg:FindFirstChild(n)
                    if o then o:Destroy() end
                end
            end
            local b = Lighting:FindFirstChild("NoVR_Blur")
            if b then b:Destroy() end
            local lb = Lighting:FindFirstChild("NoVR_LoadBlur")
            if lb then lb:Destroy() end
            local wb = Lighting:FindFirstChild("NoVR_WelcomeBlur")
            if wb then wb:Destroy() end
            local h = workspace:FindFirstChild("NoVR_LocalHead")
            if h then h:Destroy() end
            UIS.MouseBehavior = Enum.MouseBehavior.Default
            UIS.MouseIconEnabled = true
        end

        local updating = false
        local function performUpdate(setStatus)
            if updating then return end
            if type(UPDATE_URL) ~= "string" or UPDATE_URL == "" or string.find(UPDATE_URL, "PUT_YOUR", 1, true) then
                setStatus("Set UPDATE_URL at the top of the script first.", true)
                return
            end
            updating = true
            setStatus("Downloading the latest version...", false)
            local src = fetchSource(UPDATE_URL)
            if not src then
                updating = false
                setStatus("Download failed - check the link / HttpGet.", true)
                return
            end
            local fn, err = (EXEC.loadstring or loadstring or load)(src)
            if not fn then
                updating = false
                setStatus("New version has an error: " .. tostring(err):sub(1, 60), true)
                return
            end
            if EXEC.queue then
                setStatus("Updated! Restarting...", false)
                task.wait(0.4)
            else
                setStatus("Updated! Restarting (no rejoin on this executor)...", false)
                task.wait(0.4)
                cleanupAll()
            end
            local ok, e = pcall(fn)
            if not ok then
                updating = false
                warn("[NoVR] update failed to start: " .. tostring(e))
            end
        end
