                f.BackgroundColor3 = violet
                f.BackgroundTransparency = 0.9
                f.BorderSizePixel = 0
                local cr = Instance.new("UICorner"); cr.CornerRadius = UDim.new(0.5, 0); cr.Parent = f
                f.Parent = sg
            end
            for k = 6, 1, -1 do fxCircle(sg, 0.86, 10 + k * 16, 0.55 + 0.07 * k, pinkc) end   -- glow around the ring, softer the further out
            local mr, ms = fxCircle(sg, 0.86, 12, 0, Color3.new(1, 1, 1))
            local gr = Instance.new("UIGradient")   -- a bright band that circles the ring
            gr.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(0.5, pinkc), ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)) })
            gr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.45, 0.55), NumberSequenceKeypoint.new(0.5, 0.55), NumberSequenceKeypoint.new(1, 0) })
            gr.Parent = ms
            FX.grad = gr
            fxCircle(sg, 0.74, 3, 0.35, pinkc)
            local tk = Instance.new("Frame")   -- tick marks, slowly turning
            tk.AnchorPoint = Vector2.new(0.5, 0.5)
            tk.Position = UDim2.fromScale(0.5, 0.5)
            tk.Size = UDim2.fromScale(1, 1)
            tk.BackgroundTransparency = 1
            tk.Parent = sg
            FX.ticks = tk
            for i = 1, 72 do
                local a = (i - 1) / 72 * 2 * math.pi
                local t = Instance.new("Frame")
                t.AnchorPoint = Vector2.new(0.5, 0.5)
                t.Position = UDim2.fromOffset(512 + math.sin(a) * 372, 512 - math.cos(a) * 372)
                t.Size = UDim2.fromOffset(i % 6 == 1 and 5 or 3, i % 6 == 1 and 30 or 16)
                t.Rotation = math.deg(a)
                t.BackgroundColor3 = pinkc
                t.BackgroundTransparency = i % 6 == 1 and 0.1 or 0.45
                t.BorderSizePixel = 0
                t.Parent = tk
            end
            FX.rip = {}
            for i = 1, 3 do   -- ripples that travel out from the middle
                local f, st = fxCircle(sg, 0.86, 5, 0.3, pinkc)
                local us = Instance.new("UIScale")
                us.Parent = f
                FX.rip[i] = { st = st, sc = us }
            end
            -- outer base ring of the dome
            local part2, sg2 = fxDisc(math.min(DOME_R, 1000), "NoVR_DomeBase")   -- (a flat disc can be 2048 studs wide at most)
            FX.part2, FX.sg2 = part2, sg2
            for k = 4, 1, -1 do fxCircle(sg2, 0.97, 8 + k * 14, 0.6 + 0.08 * k, pinkc) end
            fxCircle(sg2, 0.97, 7, 0.1, Color3.new(1, 1, 1))
            -- the dome: glass plates laid on a half sphere, they close up from the horizon to the top
            local model = Instance.new("Model")
            model.Name = "NoVR_Dome"
            local pivot = Instance.new("Part")
            pivot.Name = "Pivot"
            pivot.Anchored, pivot.CanCollide, pivot.CanQuery, pivot.CanTouch, pivot.CastShadow = true, false, false, false, false
            pivot.Transparency = 1
            pivot.Size = Vector3.new(1, 1, 1)
            pivot.CFrame = CFrame.new(0, 0, 0)
            pivot.Parent = model
            model.PrimaryPart = pivot
            local lowC, highC = fxCol(C(70, 40, 175)), fxCol(C(210, 150, 255))
            local imgs = S.hexImgs
            for _, cell in ipairs(S.domeCells()) do
                local ur = cell.dir
                local pos = ur * DOME_R
                local th = math.asin(math.clamp(ur.Y, -1, 1))
                local ph = math.atan2(ur.X, -ur.Z)
                local circ = (cell.dn * DOME_R / 2) / math.cos(math.pi / cell.sides)   -- corner radius of the cell
                local L = math.min(2 * circ * 1.12 / 0.98, 2040)   -- the panel is a bit bigger than its cell so neighbours overlap and no gap shows
                local col = lowC:Lerp(highC, math.abs(th) / (math.pi / 2))
                local pl = Instance.new("Part")
                pl.Name = "Plate"
                pl.Anchored, pl.CanCollide, pl.CanQuery, pl.CanTouch, pl.CastShadow = true, false, false, false, false
                pl.Transparency = 1
                pl.Size = Vector3.new(L * 0.3, L * 0.3, 0.15)
                pl.CFrame = CFrame.lookAt(pos, Vector3.zero, cell.tan)
                pl.Parent = model
                local sg = Instance.new("SurfaceGui")   -- the front face looks at the middle of the dome: that is where the hexagon is drawn
                sg.Face = Enum.NormalId.Front
                sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
                sg.CanvasSize = Vector2.new(256, 256)
                sg.LightInfluence = 0
                sg.Brightness = 2.2
                sg.AlwaysOnTop = false
                sg.Active = false
                sg.Enabled = false
                sg.Adornee = pl
                sg.Parent = pl
                local setCol, setTr
                local img = imgs and imgs[cell.sides]
                if img then
                    local im = Instance.new("ImageLabel")
                    im.Size = UDim2.fromScale(1, 1)
                    im.BackgroundTransparency = 1
                    im.Image = img
                    im.ImageColor3 = col
                    im.ImageTransparency = 1
                    im.Parent = sg
                    setCol = function(c3) im.ImageColor3 = c3 end
                    setTr = function(t) im.ImageTransparency = t end
                else   -- the pictures are not ready (or this executor can't make them): plain panels
                    local fr = Instance.new("Frame")
                    fr.Size = UDim2.fromScale(1, 1)
                    fr.BorderSizePixel = 0
                    fr.BackgroundColor3 = col
                    fr.BackgroundTransparency = 1
                    fr.Parent = sg
                    setCol = function(c3) fr.BackgroundColor3 = c3 end
                    setTr = function(t) fr.BackgroundTransparency = t end
                end
                local dph = math.abs(((ph - ph0 + math.pi) % (2 * math.pi)) - math.pi) / math.pi   -- 0 on the impact side, 1 on the far side
                FX.plates[#FX.plates + 1] = { p = pl, sg = sg, setCol = setCol, setTr = setTr, col = col, d = (math.abs(th) / (math.pi / 2)) * 0.52 + dph * 0.26 + math.random() * 0.02, w = L, h = L, th = th, ph = ph, dir = ur }
            end
            model.Parent = S.domeFolder
            FX.model = model
            local lp_ = Instance.new("Part")   -- carries a soft violet light and floating sparkles around you
            lp_.Name = "Glow"
            lp_.Anchored, lp_.CanCollide, lp_.CanQuery, lp_.CanTouch, lp_.CastShadow = true, false, false, false, false
            lp_.Transparency = 1
            lp_.Size = Vector3.new(22, 8, 22)
            lp_.Parent = S.domeFolder
            local pl2 = Instance.new("PointLight")
            pl2.Color = fxCol(C(170, 110, 255))
            pl2.Brightness = 1.4
            pl2.Range = 34
            pl2.Parent = lp_
            local em = Instance.new("ParticleEmitter")
            em.Texture = "rbxasset://textures/particles/sparkles_main.dds"
            em.Shape = Enum.ParticleEmitterShape.Sphere
            em.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
            em.Rate = 14
            em.Lifetime = NumberRange.new(4, 7)
            em.Speed = NumberRange.new(0.2, 0.9)
            em.Rotation = NumberRange.new(0, 360)
            em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.35), NumberSequenceKeypoint.new(1, 0) })
            em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, 0.25), NumberSequenceKeypoint.new(1, 1) })
            em.LightEmission = 1
            em.Color = ColorSequence.new(fxCol(C(235, 200, 255)), fxCol(C(150, 100, 255)))
            em.Acceleration = Vector3.new(0, 0.25, 0)
            em.Parent = lp_
            FX.glowPart = lp_
            FX.sound = false
            FX.em = em
            em.Enabled = false
            local okc, ec = pcall(S.ringCineBuild, cam.CFrame.Position - Vector3.new(0, FLOOR_DY, 0), FX.D)
            if not okc then
                warn("[NoVR] dome scene build: " .. tostring(ec))
                S.ringCineFail()
            end
        end
        function S.ringMusicSet(on)   -- music while the dome is open (fades in / out)
            if not FX then return end
            if on then
                if FX.musicS or S.pop.nosnd or FX.closing then return end
                pcall(function()
                    local m = Instance.new("Sound")
                    m.Name = "NoVR_DomeMusic"
                    m.SoundId = S.SND.music
                    m.Looped = true
                    m.Volume = 0
                    m.Parent = SoundSvc
                    m:Play()
                    tw(m, 3, { Volume = 0.22 }, Enum.EasingStyle.Sine)
                    FX.musicS = m
                end)
            elseif FX.musicS then
                local m = FX.musicS
                FX.musicS = nil
                pcall(function()
                    tw(m, 0.4, { Volume = 0 }, Enum.EasingStyle.Sine)
                    task.delay(0.5, function() m:Destroy() end)
                end)
            end
        end
        function S.ringFxClose(force)
            if not FX then return end
            if S.domeLock and not force then S.ringMusicSet(false) return end   -- locked: the dome stays, only the music stops
            if not FX.closing then FX.closing = os.clock() end
        end
        -- the wall: keeps a position inside the dome (and pushes back with a glow + a soft bump)
        function S.domeClamp(pos)
            if not (S.domeLock and FX and FX.lockC) then return pos end
            local d = pos - FX.lockC
            local lim = DOME_R - 1.8
            if d.Magnitude <= lim then return pos end
            local dir = d.Unit
            if os.clock() - (FX.bumpT or 0) > 0.4 then FX.bumpT = os.clock() S.softPop(0.7, 0.4, 0.09) end
            FX.hitDir, FX.hitT = dir, os.clock()
            return FX.lockC + dir * lim
        end
        function S.domeLockSet(on)
            local function note(t) pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Dome", Text = t, Duration = 3 }) end) end
            if on == (S.domeLock == true) then return true end
            if on then
                if not FX then note("The dome only exists in the 3D menu.") return false end
                local p = cam.CFrame.Position
                for _, r in ipairs(W.roots) do if r.ring then p = r.p end end
                FX.lockRo = { p = p }
                FX.lockC = p
                local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                FX.charIn = hrp ~= nil and (hrp.Position - FX.lockC).Magnitude < DOME_R - 1.8
                S.domeLock = true
                S.menuSpeed = ({ 0.08, 0.15, 0.3 })[S.pop.domeSpd or 2]
                S.softPop(1.2, 0.6, 0.09)
                note("Locked. Walk around inside, the plates are a wall. Press the key again to unlock.")
            else
                S.domeLock = false
                S.menuSpeed = nil
                if S.startOpen and not S.startOpen() and S.ringFxClose then pcall(S.ringFxClose, true) end   -- unlocked with the menu already closed: the dome goes away now
                S.softPop(0.9, 1.4, 0.07)
                note("Unlocked.")
            end
            return true
        end
        function S.ringFxIsClosing() return FX ~= nil and FX.closing ~= nil end
        function S.ringFxFree()
            if FX then
                pcall(S.ringCineFree, true)
                for _, o in ipairs({ FX.part, FX.part2, FX.model, FX.glowPart, FX.musicS }) do pcall(function() o:Destroy() end) end
            end
            FX = nil
            W.floor = nil
            pcall(function() if S.domeFolder then for _, ch in ipairs(S.domeFolder:GetChildren()) do ch:Destroy() end end end)
        end
        function S.ringFxStep(ro, dt, now, t0)
            if not FX or not FX.part or not FX.part.Parent then return end
            local age0 = now - t0
            local age = age0 - FX.tForm   -- seconds since the dome started to form (after the white-out)
            if FX.em then FX.em.Enabled = age >= 0 end
            if FX.cine and not FX.cine.done then
                local okc, ec = pcall(S.ringCineStep, age0, now, ro)
                if not okc then
                    if not W.cineWarned then W.cineWarned = true warn("[NoVR] dome scene: " .. tostring(ec)) end
                    S.ringCineFree()
                end
            end
            if FX.cine and FX.cine.display and FX.cine.bhf and FX.cine.bhf.Parent then
                local okd, ed = pcall(S.cineBHStep, FX.cine, age0, now, cam.CFrame.Position)
                if not okd and not W.bhWarned then W.bhWarned = true warn("[NoVR] black hole display: " .. tostring(ed)) end
            end
            local closing = FX.closing and (now - FX.closing) or nil
            local seal = closing and (1 - math.clamp(closing / 0.45, 0, 1)) or math.clamp(age / FX.sealT, 0, 1)
            local center = ro.p - Vector3.new(0, FLOOR_DY, 0)
            local fe = closing and seal or math.clamp(easeBack(math.clamp((age - (FX.quick and 0 or FX.sealT * 0.55)) / 1.0, 0, 1)), 0.001, 1.15)
            local flat = CFrame.new(center + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.pi / 2)
            FX.part.Size = Vector3.new(0.2, 2 * RING_R * math.max(fe, 0.001), 2 * RING_R * math.max(fe, 0.001))
            FX.part.CFrame = flat
            FX.part2.Size = Vector3.new(0.2, 2 * math.min(DOME_R, 1000) * math.max(fe, 0.001), 2 * math.min(DOME_R, 1000) * math.max(fe, 0.001))
            FX.part2.CFrame = flat
            FX.glowPart.CFrame = CFrame.new(ro.p)
            FX.grad.Rotation = (now * 70) % 360
            FX.ticks.Rotation = (now * 9) % 360
            for i, rp in ipairs(FX.rip) do
                local ph = (now / 3.2 + i / 3) % 1
                rp.sc.Scale = 0.04 + 0.96 * ph
                rp.st.Transparency = 0.1 + 0.9 * ph
            end
            local boost = (age > FX.sealT - 0.1 and age < FX.sealT + 0.5 and not closing) and (1 - (age - FX.sealT + 0.1) / 0.6) or 0   -- a flash as the dome closes
            FX.sg.Brightness = 2 + math.sin(now * 2) * 0.35 + boost * 2.2
            FX.sg2.Brightness = 1.6 + boost * 1.6
            -- sound: the startup sound comes from the menu opening, every plate plays its own closing sound, music plays while the dome is open
            if not closing then
                if not FX.music and age > FX.sealT - 0.2 then
                    FX.music = true
                    if not S.pop.noMusic then S.ringMusicSet(true) end
                end
            elseif not FX.closeSound then
                FX.closeSound = true
                S.ringMusicSet(false)
                S.softPop(1.0, 0.45, 0.06)
            end
            FX.model:PivotTo(CFrame.new(center + Vector3.new(0, FLOOR_DY, 0)))
            FX.frame += 1
            local moving = closing or age < FX.sealT + 0.8
            if moving or FX.frame % 3 == 0 then
                for _, pl in ipairs(FX.plates) do
                    local a = math.clamp((seal * 1.25 - pl.d) / 0.28, 0, 1)
                    if a > 0 and not pl.snd and not closing then pl.snd = true S.plateSnd(pl.p) end
                    local sh = 0.5 + 0.5 * math.sin(now * 1.3 + pl.th * 5 + pl.ph * 3)
                    local hitK = 0
                    if FX.hitT and FX.hitDir and pl.dir and now - FX.hitT < 0.7 then
                        local dd = pl.dir:Dot(FX.hitDir)
                        if dd > 0.88 then hitK = 0.6 * (dd - 0.88) / 0.12 * (1 - (now - FX.hitT) / 0.7) end
                    end
                    local fk = 0   -- plates start glowing orange from the blast and cool down to purple
                    if moving and a > 0 and not closing then
                        pl.base = pl.base or pl.col
                        fk = math.clamp(1 - (seal * 1.25 - pl.d) / 0.45, 0, 1)
                        pl.setCol(pl.base:Lerp(FIRE, fk))
                    end
                    pl.sg.Enabled = a > 0.001
                    pl.setTr(math.clamp(1 - 2 * (a * (0.3 + 0.08 * sh + fk * 0.28) + boost * 0.12 * a + hitK * a * 0.5), 0.05, 1))
                    if moving then
                        local k = 0.3 + 0.7 * a
                        if pl.cap then pl.p.Size = Vector3.new(pl.w * k, 0.15, pl.h * k)
                        else pl.p.Size = Vector3.new(pl.w * k, pl.h * k, 0.15) end
                    end
                end
            end
        end
        local function planeHit(r, o, d)
            local pcf = r.part.CFrame
            local n = pcf.LookVector
            local dn = d:Dot(n)
            if math.abs(dn) < 1e-4 then return nil end
            local tt = (pcf.Position - o):Dot(n) / dn
            if tt <= 0 then return nil end
            local l = pcf:PointToObjectSpace(o + d * tt)
            if math.abs(l.X) > r.w / 2 or math.abs(l.Y) > r.h / 2 then return nil end
            return (0.5 - l.X / r.w) * r.sg.CanvasSize.X, (0.5 - l.Y / r.h) * r.sg.CanvasSize.Y
        end
        local ROOMDIR = { Vector3.xAxis, -Vector3.xAxis, Vector3.yAxis, -Vector3.yAxis, Vector3.zAxis, -Vector3.zAxis }
        local ROOMCOL = { C(30, 12, 80), C(30, 12, 80), C(30, 12, 80), C(30, 12, 80), C(30, 12, 80), C(30, 12, 80) }   -- one colour on all six walls, so the corners / edges can't be seen

        RunService.RenderStepped:Connect(function(dt)
            -- 1) head turning: the mouse turns your view (smoothed), the panels never move
            if W.free and W.count == 0 then W.free = false end
            if hudg then hudg.Enabled = not W.free end
            if W.free then   -- Alt: the real cursor is back, click the panel with it (Alt again to go back to head-turning)
                sm = Vector2.zero
                UIS.MouseBehavior = Enum.MouseBehavior.Default
                UIS.MouseIconEnabled = true
            elseif S.uiLook and not UIS:GetFocusedTextBox() then
                local md = UIS:GetMouseDelta()
                sm = sm:Lerp(md, 1 - math.exp(-dt * 16))
                S.lookTurn(sm.X, sm.Y)
                UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
                UIS.MouseIconEnabled = false
            else
                sm = Vector2.zero
            end
            -- 2) place the panels
            local base = cam.CFrame
            local vs = cam.ViewportSize
            local tanH = math.tan(math.rad(cam.FieldOfView) / 2)
            local top, veilT, anyBg = nil, 1, false
            for i = #W.roots, 1, -1 do
                local r = W.roots[i]
                if not r.sg.Parent then
                    r.part:Destroy()
                    table.remove(W.roots, i)
                else
                    local ea = easeBack(math.clamp((os.clock() - r.t0) / 0.6, 0, 1))
                    local d = DIST - (r.order - 100) * 0.01
                    local zs = r.zoom and math.clamp(S.pop.zoom or 1.5, 0.6, 2.5) or 1   -- "3D menu size"
                    local h = 2 * d * tanH * 0.84 * zs
                    local w = h * vs.X / math.max(vs.Y, 1)
                    local k = 0.85 + 0.15 * ea
                    r.part.Size = Vector3.new(w * k, h * k, 0.1)
                    -- the panel leans a little toward where you are aiming and bobs gently, so it feels like a real object
                    local sk = 1 - math.exp(-dt * 6)
                    r.tx = (r.tx or 0) + ((r.tgx or 0) - (r.tx or 0)) * sk
                    r.ty = (r.ty or 0) + ((r.tgy or 0) - (r.ty or 0)) * sk
                    local bob = math.sin(os.clock() * 0.9 + r.t0) * 0.07
                    if not (S.domeLock and r.ring) then r.p = r.p:Lerp(base.Position, 1 - math.exp(-dt * 3)) end   -- walking slowly: the panel drifts along with you, same direction
                    r.part.CFrame = (CFrame.new(r.p) * r.rot0) * CFrame.lookAt(Vector3.new(0, 0, -d * (0.75 + 0.25 * ea)), Vector3.zero)
                        * CFrame.new(0, bob, 0) * CFrame.Angles(-r.ty * 0.05, -r.tx * 0.06, 0)
                    r.w, r.h, r.ea = w * k, h * k, ea
                    if r.sg.CanvasSize.X ~= vs.X or r.sg.CanvasSize.Y ~= vs.Y then r.sg.CanvasSize = Vector2.new(vs.X, vs.Y) end
                    if not top or r.order > top.order then top = r end
                    if not r.nobg then veilT = math.min(veilT, r.veil) anyBg = true end   -- the Start menu hangs alone: no room, no blur, no bubbles
                end
            end
            -- the ring: every card sits on a circle around the spot where the menu was opened (and drifts along when you walk)
            do
                local ppuK = S.ringPPU()
                local now = os.clock()
                local ro
                if #W.cards == 0 then S.ringSpin, S.ringSpinT = 0, 0 end
                local aimD = base.LookVector
                if W.free then
                    local ml0 = UIS:GetMouseLocation()
                    aimD = cam:ViewportPointToRay(ml0.X, ml0.Y).Direction
                end
                for _, r in ipairs(W.roots) do
                    if r.ring and r.yawT then
                        local dy = ((r.yawT - r.yaw + math.pi) % (2 * math.pi)) - math.pi
                        r.yaw = r.yaw + dy * (1 - math.exp(-dt * 5))
                        r.rot0 = CFrame.Angles(0, r.yaw, 0)
                        if math.abs(dy) < 0.003 then r.yawT = nil end
                    end
                end
                S.ringSpin = (S.ringSpin or 0) + ((S.ringSpinT or 0) - (S.ringSpin or 0)) * (1 - math.exp(-dt * 5))
                for i = #W.cards, 1, -1 do
                    local c = W.cards[i]
                    local r0
                    for _, r in ipairs(W.roots) do if r.sg == c.owner then r0 = r break end end
                    if not c.sg.Parent or not r0 or (c.pp and not c.pp.Parent) then
                        c.part:Destroy()
                        table.remove(W.cards, i)
                    else
                        ro = r0
                        local age = now - c.t0 - c.delay
                        local ea = easeBack(math.clamp(age / 0.65, 0, 1))
                        c.ea = ea
                        c.sg.Enabled = age >= 0
                        -- dragged: the window follows where you aim (the spot you grabbed stays under the crosshair)
                        local spinT = c.fixed and 0 or (S.ringSpin or 0)
                        if c.dragging then
                            local lvr = r0.rot0:VectorToObjectSpace(aimD)
                            local aimYaw = math.atan2(lvr.X, -lvr.Z)
                            local tp = math.tan(math.asin(math.clamp(lvr.Y, -0.99, 0.99))) * S.ringDist * (c.level or 1)
                            if not c.grab then
                                c.grab = { a = ((c.ang + spinT - aimYaw + math.pi) % (2 * math.pi)) - math.pi, y = (c.y0 or 0) - tp }
                            end
                            c.gAng = aimYaw - spinT + c.grab.a
                            c.gY = math.clamp(tp + c.grab.y, -9, 9)
                        else
                            c.grab = nil
                        end
                        local ek = 1 - math.exp(-dt * (c.dragging and 20 or 7))
                        c.ang = c.ang + ((((c.gAng or c.ang) - c.ang + math.pi) % (2 * math.pi)) - math.pi) * ek
                        c.y0 = (c.y0 or 0) + ((c.gY or c.y0 or 0) - (c.y0 or 0)) * ek
                        c.level = (c.level or 1) + ((c.gLv or c.level or 1) - (c.level or 1)) * ek
                        local lv = c.level or 1
                        if c.ent then   -- the window was resized / scaled with its own handle: the card follows
                            local us = c.ent.userScale or 1
                            local ncw, nch = math.floor(c.ent.cw * us + 40), math.floor(c.ent.ch * us + 56)
                            if ncw ~= c.cw or nch ~= c.ch then c.cw, c.ch = ncw, nch; c.sg.CanvasSize = Vector2.new(ncw, nch) end
                        end
                        c.hov = (c.hov or 0) + ((W.top == c and 1 or 0) - (c.hov or 0)) * (1 - math.exp(-dt * 10))
                        c.sz = (c.sz or 1) + ((c.szT or 1) - (c.sz or 1)) * (1 - math.exp(-dt * 9))
                        local k = (0.8 + 0.2 * ea) * lv * (1 + 0.035 * c.hov) * c.sz   -- the window you aim at grows a little
                        local w, h = c.cw / ppuK * k, c.ch / ppuK * k
                        c.part.Size = Vector3.new(math.max(w, 0.05), math.max(h, 0.05), 0.1)
                        local ep = math.clamp(age / 0.95, 0, 1)
                        ep = 1 - (1 - ep) ^ 3   -- swirl in: the cards spin in from the side, rise up and settle on their spot
                        local a = c.ang + spinT + (1 - ep) * 1.3
                        local yy = (c.y0 or 0) - (1 - ep) * 2.5
                        local rad = S.ringDist * lv * (0.62 + 0.38 * ea)
                        local sk = 1 - math.exp(-dt * 6)
                        c.tx = (c.tx or 0) + ((c.tgx or 0) - (c.tx or 0)) * sk
                        c.ty = (c.ty or 0) + ((c.tgy or 0) - (c.ty or 0)) * sk
                        local bob = math.sin(now * 0.8 + c.ang * 3) * 0.08
                        local origin = CFrame.new(r0.p) * r0.rot0
                        local pos = Vector3.new(math.sin(a) * rad, yy, -math.cos(a) * rad)
                        c.part.CFrame = origin * CFrame.lookAt(pos, Vector3.new(0, yy * 0.4, 0)) * CFrame.new(0, bob, 0) * CFrame.Angles(-c.ty * 0.05, -c.tx * 0.06, 0)
                        c.w, c.h = w, h
                    end
                end
                do   -- watchdog
                    local menuUp = S.startOpen and S.startOpen()
                    if FX and S.startOpen and not menuUp and not S.domeLock and not FX.closing then pcall(S.ringFxClose, true) end
                    if FX and FX.closing and now - FX.closing > 1.2 then pcall(S.ringFxFree) end
