                    tb.PlaceholderColor3 = MUTED
                    tb.ClearTextOnFocus = false
                    tb.Font = Enum.Font.GothamMedium
                    tb.TextSize = 12
                    tb.TextColor3 = WHITE
                    tb.TextXAlignment = Enum.TextXAlignment.Left
                    tb.ZIndex = 5
                    tb.Parent = inputRow
                    corner(tb, 9)
                    local sendB = pbtn(inputRow, "SEND", 0, 0, 86, 32, 12)
                    sendB.Position = UDim2.new(1, -86, 0, 0)
                    local function send()
                        local t = tb.Text
                        if t == "" then return end
                        tb.Text = ""
                        local ok = false
                        if channel then ok = pcall(function() channel:SendAsync(t) end) end
                        if not ok then   -- the older chat system
                            pcall(function()
                                local ev = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
                                ev = ev and ev:FindFirstChild("SayMessageRequest")
                                if ev then ev:FireServer(t, "All"); ok = true end
                            end)
                        end
                        if not ok then status.Text = "Could not send: this game's chat could not be reached." end
                    end
                    sendB.Activated:Connect(send)
                    tb.FocusLost:Connect(function(enter) if enter then send() end end)
                    addLine("system", channel and "Connected. New messages show up here." or "No chat channel found in this game.", false)
                    Theme.recolor(page)
                end

