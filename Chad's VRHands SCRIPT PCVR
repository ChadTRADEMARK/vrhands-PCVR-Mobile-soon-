    while os.clock() - t0 < 30 do
        populate(workspace.CurrentCamera)
        task.wait(0.1)
    end
end)

-- ============ UNIVERSAL MODE ============
-- For VR games that are NOT this game's own VR Hands rig. The script makes the game believe VR is on, answers the standard
-- VR functions (head / left hand / right hand positions) from the keyboard and mouse, and turns mouse + keys into controller
-- buttons. It is best effort: games that build their own VR system may need their own adapter.
function U.start(lp, S)   -- S = the main script's settings table when the full menu is running (emulator mode), nil for the small stand-alone panel
    local emu = S ~= nil
    Boot.stage("Universal mode: this game has no VR Hands rig, using the standard VR functions.")
    Boot.close()
    U.active = true
    local cam = workspace.CurrentCamera
    local HttpService = game:GetService("HttpService")
    local FILE = "NoVR_Universal.json"
    local cfg = { reach = 1.6, spread = 0.5, height = -0.45, scale = 1, sens = 0.004 }
    if not emu then pcall(function()
        if isfile and isfile(FILE) then
            local d = HttpService:JSONDecode(readfile(FILE))
            for k, v in pairs(cfg) do if type(d[k]) == "number" and d[k] == d[k] then cfg[k] = d[k] end end
        end
    end) end
    local function saveCfg() pcall(function() if writefile then writefile(FILE, HttpService:JSONEncode(cfg)) end end) end
    local off = { L = Vector3.new(0, 0, 0), R = Vector3.new(0, 0, 0) }   -- hand offsets from the mouse (hold Alt)
    local reachAdd = 0
    local down = {}
    local altHeld, frozen, savedType, savedCF = false, false, nil, nil
    -- emulator options (saved in NoVR_Emu.json, per game as well)
    U.opt = { moveCtl = true, povAmt = 1, smooth = true, bodyHands = true, camKey = "F6",
              keymap = { R1 = "E", L1 = "Q", A = "F", B = "G", X = "R", Y = "T" } }
    U.stat = U.stat or {}
    U.cfg = cfg
    U.handYaw = 0
    U.camNext = { free = "first", first = "pov", pov = "smooth", smooth = "own", own = "game", game = "free" }
    local smL, smR
    U.mult = 1.3   -- studs per hand unit in emulator mode
    local zoom, zoomBase, lastT = 1, nil, os.clock()

    -- ---- camera: smooth mouse look instead of the VR camera's snap turns ----
    -- "smooth": the game's own PlayerModule is told VR is OFF (every other script is told it is ON), so it uses the normal PC camera.
    -- "own":    this script drives a first-person camera from the mouse (smooth turning, look up / down freely).
    -- "game":   leave the game's VR camera alone.
    U.camMode = emu and "free" or (C.getcallingscript and "smooth" or "own")
    -- "free":   normal PC third-person camera driven by this script: the mouse turns it freely, I / O change the distance.
    local freeDist = 10
    local OWNCAM = { free = true, first = true, pov = true }   -- modes this script drives itself
    local sy, sp, focusS, headOffS, bobT, hideT, drove = 0, 0, nil, nil, 0, 0, false
    -- "first":  first-person view from your eyes.   "pov": the same, like a handheld camera (sway, bob, trailing look).
    local yaw, pitch = 0, 0
    do
        local lv = cam.CFrame.LookVector
        yaw = math.atan2(-lv.X, -lv.Z)
        pitch = math.asin(math.clamp(lv.Y, -1, 1))
    end
    local function nudgeCameraModule()   -- make the PlayerModule re-read "is VR on" so it swaps camera right away
        pcall(function()
            if C.getconnections then
                for _, sig in ipairs({ VRService:GetPropertyChangedSignal("VREnabled"), UIS:GetPropertyChangedSignal("VREnabled") }) do
                    for _, con in ipairs(C.getconnections(sig)) do pcall(function() con:Fire() end) end
                end
            end
        end)
    end
    local function setCamMode(m)
        local was = U.camMode
        U.camMode = m
        if OWNCAM[was] and m ~= was then
            focusS, headOffS = nil, nil
            pcall(function()
                local ch = lp.Character
                local h = ch and ch:FindFirstChildOfClass("Humanoid")
                if h then h.AutoRotate = true end
                if ch then for _, d in ipairs(ch:GetDescendants()) do if d:IsA("BasePart") and d.LocalTransparencyModifier == 1 then d.LocalTransparencyModifier = 0 end end end
            end)
        end
        if (was == "own" or OWNCAM[was]) and m ~= was and not OWNCAM[m] and m ~= "own" then
            cam.CameraType = Enum.CameraType.Custom
            UIS.MouseBehavior = Enum.MouseBehavior.Default
        end
        if m == "own" or OWNCAM[m] then
            local lv = cam.CFrame.LookVector
            yaw = math.atan2(-lv.X, -lv.Z)
            pitch = math.asin(math.clamp(lv.Y, -1, 1))
            sy, sp = yaw, pitch
        end
        if m == "smooth" or was == "smooth" then nudgeCameraModule() end
    end
    U.setCamMode = setCamMode

    -- ---- fake controller input ----
    local KC = Enum.KeyCode
    local MAP = {}   -- real input -> controller button
    local BTN = { R1 = KC.ButtonR1, L1 = KC.ButtonL1, A = KC.ButtonA, B = KC.ButtonB, X = KC.ButtonX, Y = KC.ButtonY }
    local function kcOf(n)
        local ok, v = pcall(function() return KC[n] end)
        return ok and typeof(v) == "EnumItem" and v or nil
    end
    function U.rebuildMap()
        for k in pairs(MAP) do MAP[k] = nil end
        MAP[Enum.UserInputType.MouseButton1] = KC.ButtonR2
        MAP[Enum.UserInputType.MouseButton2] = KC.ButtonL2
        for name, key in pairs(U.opt.keymap) do
            local kc = kcOf(key)
            if kc and BTN[name] then MAP[kc] = BTN[name] end
        end
    end
    U.rebuildMap()

    -- ---- saved settings: one default set + one set per game (NoVR_Emu.json) ----
    local EMU_FILE, gameKey = "NoVR_Emu.json", tostring(game.PlaceId)
    local emuDB = { default = {}, games = {} }
    local VALID_CAM = { free = true, first = true, pov = true, smooth = true, own = true, game = true }
    local function pack()
        return { camMode = U.camMode, moveCtl = U.opt.moveCtl, povAmt = U.opt.povAmt, smooth = U.opt.smooth, bodyHands = U.opt.bodyHands,
                 camKey = U.opt.camKey, keymap = U.opt.keymap, sens = cfg.sens,
                 hands = emu and { reachL = S.reachL, reachR = S.reachR, spread = S.spread, height = S.height, handSens = S.handSens, aimSens = S.aimSens } or nil }
    end
    local function applyProf(d)
        if type(d) ~= "table" then return end
        for _, k in ipairs({ "moveCtl", "smooth", "bodyHands" }) do if type(d[k]) == "boolean" then U.opt[k] = d[k] end end
        if type(d.povAmt) == "number" and d.povAmt == d.povAmt then U.opt.povAmt = math.clamp(d.povAmt, 0, 2) end
        if type(d.sens) == "number" and d.sens == d.sens then cfg.sens = math.clamp(d.sens, 0.0005, 0.02) end
        if type(d.camKey) == "string" and kcOf(d.camKey) then U.opt.camKey = d.camKey end
        if type(d.keymap) == "table" then
            for name in pairs(BTN) do if type(d.keymap[name]) == "string" and kcOf(d.keymap[name]) then U.opt.keymap[name] = d.keymap[name] end end
        end
        U.rebuildMap()
        if emu and type(d.hands) == "table" then
            for _, k in ipairs({ "reachL", "reachR", "spread", "height", "handSens", "aimSens" }) do
                if type(d.hands[k]) == "number" and d.hands[k] == d.hands[k] then S[k] = d.hands[k] end
            end
        end
        if VALID_CAM[d.camMode] then setCamMode(d.camMode) end
    end
    local function writeDB() pcall(function() if writefile then writefile(EMU_FILE, HttpService:JSONEncode(emuDB)) end end) end
    function U.profileLoad()
        pcall(function()
            if isfile and isfile(EMU_FILE) then
                local d = HttpService:JSONDecode(readfile(EMU_FILE))
                if type(d) == "table" then
                    emuDB = { default = type(d.default) == "table" and d.default or {}, games = type(d.games) == "table" and d.games or {} }
                end
            end
        end)
        applyProf(emuDB.default)
        applyProf(emuDB.games[gameKey])
        return emuDB.games[gameKey] ~= nil
    end
    function U.profileHas() return emuDB.games[gameKey] ~= nil end
    function U.profileSave()
        emuDB.games[gameKey] = pack()
        emuDB.default = pack()   -- the newest settings also become the starting point for games without a profile
        writeDB()
        U.dirty = nil
    end
    function U.profileDelete()
        emuDB.games[gameKey] = nil
        writeDB()
    end
    function U.touch() U.dirty = os.clock() end   -- the panel calls this after every change; saved a moment later
    function U.compat()
        local L, function_ok = {}, nil
        local function add(ok, t) L[#L + 1] = (ok and "[OK] " or "[!!] ") .. t end
        add(C.hookmetamethod ~= nil, "hookmetamethod: " .. (C.hookmetamethod and "found (VR answers can be faked)" or "missing - the game cannot be told VR is on"))
        add(C.getconnections ~= nil, "getconnections: " .. (C.getconnections and "found (controller buttons can be sent)" or "missing - controller buttons may not reach the game"))
        add(C.firesignal ~= nil, "firesignal: " .. (C.firesignal and "found" or "missing"))
        add(C.getcallingscript ~= nil, "getcallingscript: " .. (C.getcallingscript and "found (smooth camera possible)" or "missing - use FREE or OWN camera"))
        add(writefile ~= nil, "writefile: " .. (writefile and "found (settings can be saved)" or "missing - nothing is saved"))
        add(U.active, "emulator hooks: " .. (U.active and "on" or "OFF"))
        local ucf, vren, pad = U.stat.ucf or 0, U.stat.vren or 0, U.stat.pad or 0
        L[#L + 1] = ("Game asked for hand positions: %d times"):format(ucf)
        L[#L + 1] = ("Game asked if VR is on: %d times"):format(vren)
        L[#L + 1] = ("Game asked about a gamepad: %d times"):format(pad)
        if C.getconnections then
            for _, row in ipairs({ { "UserCFrameChanged (UIS)", UIS.UserCFrameChanged }, { "UserCFrameChanged (VRService)", VRService.UserCFrameChanged },
                                   { "InputBegan", UIS.InputBegan }, { "InputChanged", UIS.InputChanged } }) do
                local okc, list = pcall(C.getconnections, row[2])
                L[#L + 1] = ("Scripts listening to %s: %s"):format(row[1], okc and type(list) == "table" and tostring(#list) or "?")
            end
        end
        local ch = lp.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        add(hum ~= nil, "character: " .. (hum and "normal Roblox character found (walking / turning work)" or "no Humanoid - walking and turning are off, turn off 'Own movement'"))
        local ps = lp:FindFirstChild("PlayerScripts")
        add(ps and ps:FindFirstChild("PlayerModule") ~= nil, "PlayerModule: " .. ((ps and ps:FindFirstChild("PlayerModule")) and "found" or "not found"))
        L[#L + 1] = "Camera mode: " .. tostring(U.camMode) .. "   Own movement: " .. tostring(U.opt.moveCtl)
        L[#L + 1] = ""
        if ucf > 0 or vren > 0 then L[#L + 1] = "VERDICT: the game is reading VR data from the emulator."
        else L[#L + 1] = "VERDICT: the game has not asked for VR data yet. Play for a moment and press CHECK again; if it stays 0 the game may not use the standard VR functions." end
        return table.concat(L, "\n")
    end
    -- getconnections is slow: the list of listeners is looked up once every few seconds, not on every call
    -- (calling it every frame for four signals is what froze the game)
    local consCache = {}
    local function fireK(key, sig, ...)
        local args = table.pack(...)
        if C.getconnections then
            local c = consCache[key]
            local nowT = os.clock()
            if not c or nowT - c.at > 3 then
                local ok, list = pcall(C.getconnections, sig)
                c = (ok and type(list) == "table") and { at = nowT, list = list } or nil
                consCache[key] = c
            end
            if c then
                for _, con in ipairs(c.list) do
                    pcall(function()
                        if con.Fire then con:Fire(table.unpack(args, 1, args.n))
                        elseif con.Function then task.spawn(con.Function, table.unpack(args, 1, args.n)) end
                    end)
                end
                return true
            end
        end
        if C.firesignal then return pcall(C.firesignal, sig, ...) end
        return false
    end
    local function fire(sig, ...) return fireK(tostring(sig), sig, ...) end
    local function mkInput(kc, state, pos)
        return { UserInputType = Enum.UserInputType.Gamepad1, KeyCode = kc, UserInputState = state, Position = pos or Vector3.new(0, 0, 0), Delta = Vector3.new(0, 0, 0) }
    end
    local function press(kc, on)
        U.buttons[kc] = on or nil
        local analog = (kc == KC.ButtonR2 or kc == KC.ButtonL2)
        local pos = Vector3.new(0, 0, on and 1 or 0)
        if analog then fire(UIS.InputChanged, mkInput(kc, Enum.UserInputState.Change, pos), false) end
        if on then fire(UIS.InputBegan, mkInput(kc, Enum.UserInputState.Begin, pos), false)
        else fire(UIS.InputEnded, mkInput(kc, Enum.UserInputState.End, pos), false) end
    end
    local stick1, stick2 = Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)
    local function sticks()
        local function axis(a, b) return (down[a] and 1 or 0) - (down[b] and 1 or 0) end
        local s1 = Vector3.new(axis(KC.D, KC.A), axis(KC.W, KC.S), 0)
        local s2 = Vector3.new(axis(KC.Right, KC.Left), axis(KC.Up, KC.Down), 0)
        if s1 ~= stick1 then stick1 = s1; U.stick[KC.Thumbstick1] = s1; fire(UIS.InputChanged, mkInput(KC.Thumbstick1, Enum.UserInputState.Change, s1), false) end
        if s2 ~= stick2 then stick2 = s2; U.stick[KC.Thumbstick2] = s2; fire(UIS.InputChanged, mkInput(KC.Thumbstick2, Enum.UserInputState.Change, s2), false) end
    end
    U.stick = {}

    UIS.InputBegan:Connect(function(io, gp)
        if io.UserInputType == Enum.UserInputType.Keyboard then
            if UIS:GetFocusedTextBox() then return end
            if U.capture then   -- the panel is waiting for a key to bind
                local fn = U.capture
                U.capture = nil
                fn(io.KeyCode)
                return
            end
            down[io.KeyCode] = true
            if io.KeyCode == KC.LeftAlt then altHeld = true end
            if emu and io.KeyCode.Name == U.opt.camKey then
                setCamMode(U.camNext[U.camMode] or "free")
                U.touch()
            end
        end
        local btn = MAP[io.UserInputType] or MAP[io.KeyCode]
        if btn and not (io.UserInputType == Enum.UserInputType.Keyboard and UIS:GetFocusedTextBox()) then
            if io.UserInputType == Enum.UserInputType.Gamepad1 then return end
            press(btn, true)
        end
    end)
    UIS.InputEnded:Connect(function(io, gp)
        if io.UserInputType == Enum.UserInputType.Keyboard then
            down[io.KeyCode] = nil
            if io.KeyCode == KC.LeftAlt then altHeld = false end
        end
        local btn = MAP[io.UserInputType] or MAP[io.KeyCode]
        if btn and io.UserInputType ~= Enum.UserInputType.Gamepad1 then press(btn, false) end
    end)
    UIS.InputChanged:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseWheel and altHeld and not emu then reachAdd = math.clamp(reachAdd + io.Position.Z * 0.15, -3, 4) end
    end)

    -- ---- hand positions every frame ----
    local lastCF, lastFireT = {}, {}
    local function handCF(side)
        local sgn = (side == "L") and -1 or 1
        if emu then   -- the main menu's hand settings drive the fake VR hands
            local L = (side == "L")
            local pos = Vector3.new(sgn * S.spread + (L and S.handLX or S.handRX), S.height + (L and S.handLY or S.handRY), -(L and S.reachL or S.reachR))
            local r = CFrame.fromEulerAnglesYXZ(L and S.aimLPitch or S.aimRPitch, L and S.aimLYaw or S.aimRYaw, L and S.aimLRoll or S.aimRRoll)
            local A = U.opt.povAmt
            if (U.camMode == "first" or U.camMode == "pov") and A > 0 then
                -- realistic hands: they breathe and drift, bounce while you walk, and trail behind when you turn
                local t, ph = os.clock(), L and 0 or 3.1
                local sway = Vector3.new(math.noise(t * 0.8, ph + 1) * 0.05, math.noise(t * 0.7, ph + 2) * 0.05 + math.sin(t * 1.7 + ph) * 0.012, 0)
                local walk = Vector3.new(math.cos(U.bobT + ph) * 0.025, math.sin(U.bobT * 2 + ph) * 0.035, 0) * U.walkAmt
                local lag = Vector3.new(math.clamp(-U.yawVel * 0.025, -0.18, 0.18), math.clamp(U.pitchVel * 0.02, -0.12, 0.12), 0)
                pos = pos + (sway + walk + lag) * A
                r = r * CFrame.fromEulerAnglesYXZ((math.noise(t * 0.6, ph + 4) * 0.05 + lag.Y * 0.8) * A, (math.noise(t * 0.5, ph + 6) * 0.05 - lag.X * 0.8) * A, math.noise(t * 0.55, ph + 9) * 0.07 * A)
            end
            return CFrame.Angles(0, U.handYaw or 0, 0) * CFrame.new(pos * U.mult) * r
        end
        local o = off[side]
        return CFrame.new((Vector3.new(sgn * cfg.spread + o.X, cfg.height + o.Y, -(cfg.reach + reachAdd))) * cfg.scale)
    end
    -- the camera is set in its own render step that runs LAST, after the game's camera scripts, so nothing overwrites it
    -- (two scripts setting the camera in the same frame is what makes the view jitter)
    local lastCam, prevYaw, prevPitch, bodyYaw = os.clock(), nil, nil, nil
    U.bobT, U.walkAmt, U.yawVel, U.pitchVel = 0, 0, 0, 0
    U.dolly = 0
    local dollyApplied, dollyBase = false, nil
    pcall(function() RunService:UnbindFromRenderStep("NoVR_UDolly") end)
    RunService:BindToRenderStep("NoVR_UDolly", Enum.RenderPriority.First.Value, function()
        if dollyApplied then dollyApplied = false; cam.CFrame = dollyBase end
    end)
    local function camStep()
        if U.normal then lastCam = os.clock() return end
        local now = os.clock()
        local dt = math.clamp(now - lastCam, 1 / 240, 0.1)
        lastCam = now
        if frozen then pcall(function() cam.CFrame = savedCF end) end
        if U.camMode == "own" and not frozen and not (emu and (S.menuOpen or UIS:GetFocusedTextBox())) then
            pcall(function()
                local char = lp.Character
                local head = char and char:FindFirstChild("Head")
                if not head then return end
                cam.CameraType = Enum.CameraType.Scriptable
                UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
                local md = UIS:GetMouseDelta()
                yaw = yaw - md.X * cfg.sens
                pitch = math.clamp(pitch - md.Y * cfg.sens, -1.5, 1.5)
                cam.CFrame = CFrame.new(head.Position + Vector3.new(0, 0.15, 0)) * CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
            end)
        end
        if OWNCAM[U.camMode] and not frozen and not (emu and (S.menuOpen or UIS:GetFocusedTextBox())) then
            pcall(function()
                local char = lp.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = hum and hum.RootPart
                local head = char and char:FindFirstChild("Head")
                if not root then return end
                local mode = U.camMode
                cam.CameraType = Enum.CameraType.Scriptable
                UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
                local md = UIS:GetMouseDelta()
                yaw = yaw - md.X * cfg.sens
                pitch = math.clamp(pitch - md.Y * cfg.sens, -1.5, 1.5)
                local zk = (down[KC.O] and 1 or 0) - (down[KC.I] and 1 or 0)
                if zk ~= 0 and mode == "free" then freeDist = math.clamp(freeDist * math.exp(zk * dt * 1.2), 0.5, 200) end
                -- the focus point follows the root part (not the head: the game moves the head from the camera, which would shake the view)
                local fp = mode ~= "free"
                local offY = head and math.clamp(head.Position.Y - root.Position.Y, 0.5, 6) or 1.5
                headOffS = headOffS and (headOffS + (offY - headOffS) * (1 - math.exp(-dt * 8))) or offY
                local target = root.Position + Vector3.new(0, headOffS + (fp and 0 or 0.3), 0)
                focusS = focusS and focusS:Lerp(target, 1 - math.exp(-dt * (fp and 60 or 35))) or target
                local moving = hum.MoveDirection.Magnitude > 0.1
                if mode == "pov" then
                    -- handheld camera: the view trails your mouse a little, drifts, rolls and bobs while you walk
                    local k = 1 - math.exp(-dt * 11)
                    local dy = (yaw - sy + math.pi) % (2 * math.pi) - math.pi
                    sy = sy + dy * k
                    sp = sp + (pitch - sp) * k
                    local A = U.opt.povAmt
                    U.bobT = U.bobT + dt * (moving and math.max(hum.WalkSpeed, 6) * 0.55 or 0)
                    local t = os.clock()
                    local bobY = moving and math.sin(U.bobT * 2) * 0.07 * A or 0
                    local bobX = moving and math.cos(U.bobT) * 0.05 * A or 0
                    local roll = (math.noise(t * 0.6, 1.3) * 0.03 + (moving and math.cos(U.bobT) * 0.012 or 0)) * A
                    local rot = CFrame.fromEulerAnglesYXZ(sp + math.noise(t * 0.5, 7.1) * 0.025 * A, sy + math.noise(t * 0.45, 13.7) * 0.025 * A, roll)
                    cam.CFrame = CFrame.new(focusS + rot.RightVector * bobX + Vector3.new(0, bobY, 0) + rot.LookVector * 0.25) * rot
                elseif mode == "first" then
                    sy, sp = yaw, pitch
                    local rot = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
                    cam.CFrame = CFrame.new(focusS + rot.LookVector * 0.25) * rot
                else
                    sy, sp = yaw, pitch
                    local rotc = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
                    local pos = focusS + rotc * Vector3.new(0, 0, freeDist)
                    -- walls: pull the camera in front of whatever is between you and it
                    local rp = RaycastParams.new()
                    rp.FilterType = Enum.RaycastFilterType.Exclude
                    rp.FilterDescendantsInstances = { char }
                    local hit = workspace:Raycast(focusS, pos - focusS, rp)
                    if hit then pos = hit.Position + hit.Normal * 0.3 end
                    cam.CFrame = CFrame.new(pos) * rotc
                end
                -- first person: hide your own head and hats
                if fp and os.clock() - hideT > 0.5 then
                    hideT = os.clock()
                    for _, d in ipairs(char:GetDescendants()) do
                        if d:IsA("BasePart") and (d.Name == "Head" or d:FindFirstAncestorWhichIsA("Accessory")) then d.LocalTransparencyModifier = 1 end
                    end
                end
                -- walking is relative to where the camera looks. In first person the body turns with the camera,
                -- in the third-person PC camera it turns toward the way you walk (the Roblox default), like a normal PC game.
                if U.opt.moveCtl then hum.AutoRotate = not fp end
                if fp and U.opt.moveCtl then
                    bodyYaw = bodyYaw or yaw
                    bodyYaw = bodyYaw + ((yaw - bodyYaw + math.pi) % (2 * math.pi) - math.pi) * (1 - math.exp(-dt * 20))
                    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, bodyYaw, 0)
                else bodyYaw = nil end
                -- how fast you are turning / walking, so the hands can trail the view like real held controllers
                if prevYaw then
                    local yv = ((yaw - prevYaw + math.pi) % (2 * math.pi) - math.pi) / dt
                    local pv = (pitch - prevPitch) / dt
                    local k2 = 1 - math.exp(-dt * 10)
                    U.yawVel = U.yawVel + (math.clamp(yv, -8, 8) - U.yawVel) * k2
                    U.pitchVel = U.pitchVel + (math.clamp(pv, -8, 8) - U.pitchVel) * k2
                end
                prevYaw, prevPitch = yaw, pitch
                U.walkAmt = U.walkAmt + ((moving and 1 or 0) - U.walkAmt) * (1 - math.exp(-dt * 6))
                if mode ~= "pov" then U.bobT = U.bobT + dt * (moving and math.max(hum.WalkSpeed, 6) * 0.55 or 0) end
