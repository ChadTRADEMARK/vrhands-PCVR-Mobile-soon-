                if pmMT and rawget(pmMT, "GetBestGrabPartInRadius") then
                    local orig = pmMT.GetBestGrabPartInRadius
                    C.setreadonly(pmMT, false)
                    pmMT.GetBestGrabPartInRadius = function(self, root, prox, radius, scale, ...)
                        return orig(self, root, prox, (radius or 0) * 3.5, scale, ...)
                    end
                    C.setreadonly(pmMT, true)
                end
                local cmMT = C.getrawmetatable(vrm.CharacterManager)
                if cmMT and rawget(cmMT, "GetClosestCharacterInRadius") then
                    local orig = cmMT.GetClosestCharacterInRadius
                    C.setreadonly(cmMT, false)
                    cmMT.GetClosestCharacterInRadius = function(self, pos, radius, ...)
                        return orig(self, pos, (radius or 0) * 3.5, ...)
                    end
                    C.setreadonly(cmMT, true)
                end
            end)
        elseif not NORIG then
            Boot.set("Gestures not found - hands move, grab / poses won't work")
            warn("[NoVR] Input object not found - gestures will not work")
        end
    end)

    task.spawn(function()
        for _ = 1, 100 do
            pcall(function() RunService:UnbindFromRenderStep("Inputs") end)
            task.wait(0.1)
        end
    end)

    local function setScale(n)
        n = math.clamp(math.floor(n + 0.5), 1, 100)
        S.scale = n
        if scaleVal then pcall(function() scaleVal.Value = n / 100 end) end
        if vrm and vrm.DataManager and vrm.DataManager.SettingsManager then
            pcall(function() vrm.DataManager.SettingsManager:SetValue("vrscale", n) end)
        end
    end
    setScale(10)

    cam.HeadLocked = true
    local yaw, pitch
    do
        local lv = cam.CFrame.LookVector
        yaw   = math.atan2(-lv.X, -lv.Z)
        pitch = math.asin(math.clamp(lv.Y, -1, 1))
    end
    -- camPos is the position of your HEAD. In third person the camera sits
    -- behind it; in first person they are the same point.
    local camPos = cam.CFrame.Position
    local headCF = cam.CFrame   -- where your head should be (camPos + your look direction)
    local camBack = cam.CFrame  -- where the screen is drawn from (head pulled back in 3rd person)
    local keys = {}
    local mouseDown = { L = false, R = false }

    -- Reach / zoom for each hand. Hold LMB = left hand only, hold RMB = right
    -- hand only, neither (or both) held = both hands together.
    local REACH_LIM = 2000000000.5
    local function addReach(d)
        local moveL = mouseDown.L or not mouseDown.R
        local moveR = mouseDown.R or not mouseDown.L
        if moveL then S.reachL = math.clamp(S.reachL + d, -REACH_LIM, REACH_LIM) end
        if moveR then S.reachR = math.clamp(S.reachR + d, -REACH_LIM, REACH_LIM) end
    end

    -- state fed by the mobile HUD (all zero/false on PC)
    local touch = {
        move = Vector2.zero,   -- joystick: x = strafe, y = back/forward
        look = Vector2.zero,   -- drag deltas waiting to be applied this frame
        zoomIn = false, zoomOut = false,
        reachDir = 0,          -- -1 / 0 / 1 : hand reach buttons
        handL = Vector2.zero,  -- left hand joystick  (-1..1, y is screen-down positive)
        handR = Vector2.zero,  -- right hand joystick (-1..1, y is screen-down positive)
    }

    local function setLook(v)
        if NORIG then v = false end   -- no rig = we never take over the mouse / camera
        S.look = v
        UIS.MouseBehavior    = v and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
        UIS.MouseIconEnabled = not v
    end
    setLook(true)
