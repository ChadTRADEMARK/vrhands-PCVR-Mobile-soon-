    -- ============ HEAD SIZE / THIRD-PERSON HEAD ============
    -- Size of your head in studs (including anything worn on it), used so the
    -- camera distance always makes sense at any avatar scale.
    local unitCache, unitAt = 1, 0
    local function headUnit()
        local now = os.clock()
        if now - unitAt < 0.25 then return unitCache end
        unitAt = now
        local head = rig:FindFirstChild("VRHead")
        if not head then return unitCache end
        local base
        if head:IsA("BasePart") then base = head.Position
        elseif head:IsA("Model") then base = head:GetPivot().Position
        else return unitCache end
        -- size of the main head part; stray parts far from it are ignored so
        -- one oversized/offset part can't make the "head size" absurdly big
        local r0 = head:IsA("BasePart") and head.Size.Magnitude / 2 or 1
        local r = r0
        local function consider(p)
            if p:IsA("BasePart") then
                local dist = (p.Position - base).Magnitude + p.Size.Magnitude / 2
                if dist <= r0 * 6 then r = math.max(r, dist) end
            end
        end
        for _, d in ipairs(head:GetDescendants()) do consider(d) end
        unitCache = math.max(r * 2, 0.5)
        return unitCache
    end

    -- Your real head is owned by your client and replicated to everyone, so
    -- moving it made OTHER players see it jump between two places. We never
    -- touch it. Instead we draw a copy that exists only on your screen,
    -- sitting at the true head position (camPos).
    local refMap, refTried = nil, 0
    local cloneFolder, headModel, headClone = nil, nil, nil
    local accList, lastBuild = {}, 0

    -- Other players' heads are shown correctly to you, so copy how THEIR head
    -- parts look (which are visible / invisible) onto the copy of yours.
    local function buildRefMap()
        for _, other in ipairs(vrPlayers:GetChildren()) do
            if other ~= rig then
                local oh = other:FindFirstChild("VRHead")
                if oh then
                    local map, prefix = {}, #oh:GetFullName()
                    local function add(p)
                        if p:IsA("BasePart") then
                            map[p:GetFullName():sub(prefix + 1)] = p.Transparency
                        end
                    end
                    add(oh)
                    for _, d in ipairs(oh:GetDescendants()) do add(d) end
                    return map
                end
            end
        end
        return nil
    end

    local function findAtt(root, name, exclude)
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("Attachment") and d.Name == name and not d:IsDescendantOf(exclude) then
                return d
            end
        end
        return nil
    end

    -- a copy must not run scripts, weld, or be pulled around by constraints
    local function cleanClone(inst)
        for _, d in ipairs(inst:GetDescendants()) do
            if d:IsA("LuaSourceContainer") or d:IsA("JointInstance") or d:IsA("WeldConstraint")
               or d:IsA("Constraint") or d:IsA("BodyMover") then
                d:Destroy()
            end
        end
    end

    local function anchorAll(inst)
        local list = inst:GetDescendants()
        table.insert(list, inst)
        for _, p in ipairs(list) do
            if p:IsA("BasePart") then
                p.Anchored = true
                p.CanCollide = false
                p.CanTouch = false
                p.CanQuery = false
            end
        end
    end

    local function revealPart(p)
        if p:IsA("BasePart") then
            p.LocalTransparencyModifier = 0
            if p.Transparency > 0.99 then p.Transparency = 0 end
        end
    end

    local function applyLook(c)
        if not refMap and os.clock() - refTried > 1 then
            refTried = os.clock()
            refMap = buildRefMap()
        end
        local prefix = #c:GetFullName()
        local list = c:GetDescendants()
        table.insert(list, c)
        for _, p in ipairs(list) do
            if p:IsA("BasePart") then
                p.LocalTransparencyModifier = 0
                local t = refMap and refMap[p:GetFullName():sub(prefix + 1)]
                if t ~= nil then p.Transparency = t end
            end
        end
        if not refMap and c:IsA("BasePart") and c.Transparency > 0.99 then
            c.Transparency = 0
        end
    end

    local function destroyClones()
        if cloneFolder then cloneFolder:ClearAllChildren() end
        headModel, headClone, accList = nil, nil, {}
    end

    local function buildClones()
        local realHead = rig:FindFirstChild("VRHead")
        if not realHead then return end
        if not cloneFolder then
            cloneFolder = Instance.new("Folder")
            cloneFolder.Name = "NoVR_LocalHead"
            cloneFolder.Parent = workspace
        end
        local okc, c = pcall(function() return realHead:Clone() end)
        if not okc or not c then return end
        cleanClone(c)

        local model
        if c:IsA("Model") then
            model = c
        else
            model = Instance.new("Model")
            c.Parent = model
            if c:IsA("BasePart") then model.PrimaryPart = c end
        end
        model.Name = "NoVR_Head"
        anchorAll(model)
        applyLook(c)

        local list = {}

        -- accessories that were part of the head: already in the copy, just show them
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("Accessory") then
                local h = d:FindFirstChild("Handle")
                if h and h:IsA("BasePart") then
                    revealPart(h)
                    list[#list + 1] = { h = h, attach = false }
                end
            end
        end

        -- accessories kept elsewhere in your rig: copy the handle and seat it on the head
        local realCF = realHead:IsA("BasePart") and realHead.CFrame
            or (realHead:IsA("Model") and realHead:GetPivot()) or CFrame.new()
        for _, d in ipairs(rig:GetDescendants()) do
            if d:IsA("Accessory") and not d:IsDescendantOf(realHead) then
                local oh = d:FindFirstChild("Handle")
                if oh and oh:IsA("BasePart") then
                    local h = oh:Clone()
                    cleanClone(h)
                    h.Anchored = true
                    h.CanCollide = false
                    h.CanTouch = false
                    h.CanQuery = false
                    revealPart(h)
                    h.Parent = model
                    list[#list + 1] = { h = h, attach = true, rel = realCF:ToObjectSpace(oh.CFrame), rs = 1 }
                end
            end
        end

        -- nothing in the rig at all: show copies of what your avatar is wearing
        if #list == 0 then
            local char = lp.Character
            local charHead = char and char:FindFirstChild("Head")
            if charHead and charHead:IsA("BasePart") then
                local rs = 1
                if realHead:IsA("BasePart") then
                    rs = realHead.Size.Magnitude / math.max(charHead.Size.Magnitude, 0.001)
                end
                for _, a in ipairs(char:GetChildren()) do
                    if a:IsA("Accessory") then
                        local oh = a:FindFirstChild("Handle")
                        if oh and oh:IsA("BasePart") then
                            local h = oh:Clone()
                            cleanClone(h)
                            h.Anchored = true
                            h.CanCollide = false
                            h.CanTouch = false
                            h.CanQuery = false
                            h.Transparency = 0
                            h.LocalTransparencyModifier = 0
                            local m = Instance.new("Model")
                            h.Parent = m
                            m.PrimaryPart = h
                            pcall(function() m:ScaleTo(rs) end)
                            h.Parent = model
                            m:Destroy()
                            list[#list + 1] = {
                                h = h, attach = true, rs = rs,
                                rel = charHead.CFrame:ToObjectSpace(oh.CFrame),
                            }
                        end
                    end
                end
            end
        end

        model.Parent = cloneFolder
        headModel, headClone, accList = model, c, list
    end

    local function ensureClones()
        if headModel and headModel.Parent then return end
        if os.clock() - lastBuild < 1 then return end
        lastBuild = os.clock()
        buildClones()
    end

    local function updateClones()
        if not headModel then return end
        headModel:PivotTo(headCF)
        for _, e in ipairs(accList) do
            if e.attach and e.h.Parent then
                local placed = false
                for _, a in ipairs(e.h:GetChildren()) do
                    if a:IsA("Attachment") then
                        local t = headClone and findAtt(headClone, a.Name, e.h)
                        if t then
                            e.h.CFrame = t.WorldCFrame * a.CFrame:Inverse()
                            placed = true
                            break
                        end
                    end
                end
                if not placed and e.rel then
                    e.h.CFrame = headCF * (CFrame.new(e.rel.Position * (e.rs or 1)) * e.rel.Rotation)
                end
            end
        end
    end

    local lastTP = false
    U.bind("NoVR_HeadVis", Enum.RenderPriority.Last.Value, function()
        if S.thirdPerson or S.camView ~= "Normal" then
            lastTP = true
            ensureClones()
            updateClones()
        elseif lastTP then
            lastTP = false
            destroyClones()
        end
    end)
