    -- ============ MOBILE HUD (touch controls) ============
    -- A black "M" circle opens/closes this touch HUD. Every button feeds the
    -- same handlers the keyboard and mouse use, so it behaves exactly like PC.
    --
    -- Layout (landscape):
    --   bottom-left   : move joystick + UP / DOWN
    --   bottom-right  : GRAB / PINCH buttons
    --   top row       : 3rd Person | Hand Mode | Reset Hands | More | Hide
    --   Hand Mode ON  : two extra joysticks appear, one per hand
    --                   (left = LEFT hand, right = RIGHT hand)
    --   empty screen  : drag to look around
    do
        task.spawn(function()
            local okUI, errUI = pcall(function()
                local pg = lp:WaitForChild("PlayerGui")
                local GuiService = game:GetService("GuiService")
                local TweenService = game:GetService("TweenService")

                -- scale all sizes to the screen so buttons stay finger-sized
                local vp = cam.ViewportSize
                -- Everything is laid out in fixed "design units" (a 760x380 screen).
                -- One UIScale (rootScale, below) then fits it to the real screen and is
                -- re-fitted whenever the screen size changes (rotation, window resize...).
                local function px(n) return n end
                local function fitScale()
                    local v = cam.ViewportSize
                    return math.clamp(math.min(v.X / 760, v.Y / 380), 0.7, 1.6) * Theme.size
                end

                local mobileOpen = false
                local gui = Instance.new("ScreenGui")
                gui.Name = "NoVR_Mobile"
                gui.ResetOnSpawn = false
                gui.IgnoreGuiInset = true
                pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
                gui.DisplayOrder = 50
                gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
                gui.Enabled = false   -- closed until the M circle is pressed
                gui.Parent = pg

                local root = Instance.new("Frame")
                root.Name = "Root"
                root.BackgroundTransparency = 1
                root.BorderSizePixel = 0
                root.Active = false
                root.ZIndex = 5
                local rootScale = Instance.new("UIScale")
                rootScale.Scale = fitScale()
                rootScale.Parent = root
                root.Size = UDim2.fromScale(1 / rootScale.Scale, 1 / rootScale.Scale)  -- ends up exactly full-screen
                root.Parent = gui

                -- theme: dark flat panels, soft green "deploy" buttons, red tab underline
                local IDLE   = Color3.fromRGB(86, 50, 175)     -- glass violet buttons (start-menu colour)
                local ACTIVE = Color3.fromRGB(186, 98, 255)   -- bright purple (toggled on)
                local RED    = Color3.fromRGB(225, 190, 255)  -- active-tab underline (light lavender)
                local PANEL  = Color3.fromRGB(40, 20, 96)     -- window / bar background (deep violet)
                local STROKE = Color3.fromRGB(215, 185, 255)  -- soft white-violet glass edge
                local TEXTC  = Color3.fromRGB(240, 240, 240)
                local LEFT_C  = Color3.fromRGB(186, 98, 255)   -- same colours as the PC menu
                local RIGHT_C = Color3.fromRGB(225, 205, 255)
                local LOOK_MULT = 1.6

                local function isPress(input)
                    return input.UserInputType == Enum.UserInputType.Touch
                        or input.UserInputType == Enum.UserInputType.MouseButton1
                end

                -- Finger / mouse position in the SAME space as AbsolutePosition
                -- (our ScreenGuis use IgnoreGuiInset = true).
                --  * Touch: input.Position excludes the top-bar inset, so add it back.
                --  * Mouse: a MouseButton1 input object never updates its Position,
                --    so read the live cursor instead.
                local function screenPos(input)
                    if input.UserInputType == Enum.UserInputType.Touch then
                        local inset = GuiService:GetGuiInset()
                        return Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
                    end
                    return UIS:GetMouseLocation()
                end

                -- fake keyboard / mouse events into the real handlers
                local function kev(kc, down)
                    local io = { UserInputType = Enum.UserInputType.Keyboard, KeyCode = kc }
                    if down then onInputBegan(io, false) else onInputEnded(io, false) end
                end
                local function mev(btn, down)
                    local io = { UserInputType = btn, KeyCode = Enum.KeyCode.Unknown }
                    if down then onInputBegan(io, false) else onInputEnded(io, false) end
                end


                -- ---------- liquid motion helpers ----------
                local function liquidTw(inst, t, props, style, dir)
                    TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props):Play()
                end
                -- colours flow into each other instead of snapping
                local function liquidColor(b, c)
                    c = Theme.tint(c)
                    if b:GetAttribute("tc") ~= c then
                        b:SetAttribute("tc", c)
                        liquidTw(b, 0.45, { BackgroundColor3 = c }, Enum.EasingStyle.Sine)
                    end
                end
                -- a soft ring of light spreads from the finger
                local function ripple(host, input)
                    local ap, as = host.AbsolutePosition, host.AbsoluteSize
                    local p = screenPos(input)
                    local k = math.max(rootScale.Scale, 0.01)
                    local r = Instance.new("Frame")
                    r.AnchorPoint = Vector2.new(0.5, 0.5)
                    r.Position = UDim2.fromOffset((p.X - ap.X) / k, (p.Y - ap.Y) / k)
                    r.Size = UDim2.fromOffset(0, 0)
                    r.BackgroundColor3 = Color3.new(1, 1, 1)
                    r.BackgroundTransparency = 0.55
                    r.BorderSizePixel = 0
                    r.ZIndex = host.ZIndex + 1
                    r.Active = false
                    local rc = Instance.new("UICorner")
                    rc.CornerRadius = UDim.new(1, 0)
                    rc.Parent = r
                    r.Parent = host
                    local d = math.max(as.X, as.Y) / k * 2.3
                    liquidTw(r, 0.6, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 })
                    task.delay(0.65, function() r:Destroy() end)
                end
                -- panels pop open like a drop of liquid settling
                local function popOpen(frame, sc)
                    local target = sc.Scale
                    sc.Scale = target * 0.9
                    frame.Visible = true
                    liquidTw(sc, 0.5, { Scale = target }, Enum.EasingStyle.Quint)
                end

                local function style(b)
                    b.AutoButtonColor = false
                    b.BackgroundColor3 = IDLE
                    b.BackgroundTransparency = 0.25
                    b.TextColor3 = TEXTC
                    b.Font = Enum.Font.GothamBold
                    b.Text = string.upper(b.Text)
                    b.TextSize = px(13)
                    b.TextWrapped = true
                    b.BorderSizePixel = 0
                    b.Active = true
                    b.Selectable = false
                    local c = Instance.new("UICorner")
                    c.CornerRadius = UDim.new(0, 10)
                    c.Parent = b
                    local s = Instance.new("UIStroke")
                    s.Color = STROKE
                    s.Thickness = 1.5
                    s.Transparency = 0.4
                    s.Parent = b
                    -- liquid press: squish down, jelly back up, ripple from the finger
                    b.ClipsDescendants = true
                    local sc = Instance.new("UIScale")
                    sc.Parent = b
                    b.InputBegan:Connect(function(input)
                        if isPress(input) then
                            liquidTw(sc, 0.15, { Scale = 0.9 }, Enum.EasingStyle.Quad)
                            ripple(b, input)
                        end
                    end)
                    b.InputEnded:Connect(function(input)
                        if isPress(input) then liquidTw(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end
                    end)
                end

                local function mkBtn(parent, text, anchor, pos, size)
                    local b = Instance.new("TextButton")
                    b.Text = text
                    b.AnchorPoint = anchor
                    b.Position = pos
                    b.Size = size
                    style(b)
                    b.Parent = parent
                    return b
                end

                -- onDown when a finger lands, onUp when it lifts.
                -- Each finger is tracked on its own so several buttons can be
                -- held at the same time (e.g. move stick + GRAB).
                local function bindHold(b, onDown, onUp)
                    local held = false
                    b.InputBegan:Connect(function(input)
                        if held or not isPress(input) then return end
                        held = true
                        b.BackgroundTransparency = 0
                        onDown()
                        local conn
                        conn = input.Changed:Connect(function()
                            if input.UserInputState == Enum.UserInputState.End
                               or input.UserInputState == Enum.UserInputState.Cancel then
                                conn:Disconnect()
                                held = false
                                b.BackgroundTransparency = 0.25
                                onUp()
                            end
                        end)
