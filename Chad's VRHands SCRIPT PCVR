                    local found = type(mine) == "string" and mine ~= ""
                    local mineText = found and mine or "No role (not linked)"
                    R.role.set(mineText, found and "ok" or nil)

                    local counts, total = {}, 0
                    for _, v in pairs(d.roles) do
                        if type(v) == "table" then v = v.role end
                        if type(v) == "string" and v ~= "" then
                            counts[v] = (counts[v] or 0) + 1
                            total = total + 1
                        end
                    end
                    R.linked.set(fmtN(total), nil)
                    local list = {}
                    for name, n in pairs(counts) do list[#list + 1] = { name = name, n = n } end
                    table.sort(list, function(a, b)
                        if a.n ~= b.n then return a.n > b.n end
                        return a.name < b.name
                    end)
                    for i = 1, math.min(#list, #R.slots) do
                        R.slots[i].label(list[i].name)
                        R.slots[i].set(fmtN(list[i].n) .. (list[i].n == 1 and " member" or " members"), nil)
                        R.slots[i].show(true)
