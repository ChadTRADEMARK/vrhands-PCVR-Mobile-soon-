                local gca = ge.getcustomasset or ge.getsynasset or getcustomasset or getsynasset
                local fn, data = BRAND[key][1], BRAND[key][2]
                if writefile and gca then
                    if not (isfile and isfile(fn)) then writefile(fn, b64dec2(data)) end
                    brandCache[key] = gca(fn)
                end
            end)
            return brandCache[key] or nil
        end
