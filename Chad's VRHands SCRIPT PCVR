                    -- ---- web requests ----
                    local function httpGet(url)
                        local req = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
                        if req then
                            local ok, res = pcall(req, { Url = url, Method = "GET", Headers = { ["Cache-Control"] = "no-cache" } })
                            if ok and res and (res.Success or res.StatusCode == 200)
                               and type(res.Body) == "string" and #res.Body > 0 then
                                return res.Body
                            end
                        end
                        local ok, body = pcall(function() return hget(url, true) end)
                        if ok and type(body) == "string" and #body > 0 then return body end
                        return nil
                    end
                    local function getJson(url)
                        local body = httpGet(url)
                        if not body then return nil end
                        local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
                        return (ok and type(data) == "table") and data or nil
                    end

                    local busy = false
                    local function refreshWeb()
                        if busy then return end
                        busy = true
                        statusL.Text = "Checking..."
                        task.spawn(function()
                            -- Roblox client version + hash (Roblox's own client settings API)
                            local localVer
                            pcall(function() localVer = version() end)
                            rLocal.set(localVer and tostring(localVer) or "unknown", (not localVer) and "warn" or nil)
                            local live = getJson("https://clientsettingscdn.roblox.com/v2/client-version/" .. platBinary)
                            if not (live and live.clientVersionUpload) then
                                live = getJson("https://clientsettings.roblox.com/v2/client-version/" .. platBinary)
                            end
                            if live and live.clientVersionUpload then
                                rLive.set(tostring(live.version or "?"), "ok")
                                rHash.set(tostring(live.clientVersionUpload), "ok")
                                if localVer and live.version then
                                    if tostring(localVer) == tostring(live.version) then
                                        rBuild.set("Up to date", "ok")
                                    else
                                        rBuild.set("Different from live", "warn")
                                    end
                                else
                                    rBuild.set("Can't compare", "warn")
                                end
                            else
                                rLive.set("Unavailable", "warn")
                                rHash.set("Unavailable", "warn")
                                rBuild.set("Unavailable", "warn")
                            end

                            -- your own status file (banwave / key system / script / notice)
                            local remote
                            if type(STATUS_URL) == "string" and STATUS_URL ~= "" then
                                remote = getJson(STATUS_URL .. (string.find(STATUS_URL, "?", 1, true) and "&" or "?") .. "t=" .. tostring(os.time()))
                            end
                            if type(STATUS_URL) ~= "string" or STATUS_URL == "" then
                                rBan.set("Not configured", nil)
                                rDet.set("Not configured", nil)
                                rKey.set("Unknown", nil)
                                rMsg.set("Set STATUS_URL to enable", nil)
                            elseif not remote then
                                rBan.set("Status file unreachable", "warn")
                                rDet.set("Status file unreachable", "warn")
                                rKey.set("Status file unreachable", "warn")
                                rMsg.set("-", nil)
                            else
                                local b = string.lower(tostring(remote.banwave or ""))
                                local note = remote.banwave_note and (" - " .. tostring(remote.banwave_note)) or ""
                                if b == "clear" then rBan.set("Clear" .. note, "ok")
                                elseif b == "warning" then rBan.set("Warning" .. note, "warn")
                                elseif b == "active" then rBan.set("ACTIVE" .. note, "bad")
                                else rBan.set("Unknown", nil) end
                                do local dt, ds = detectionOf(remote); rDet.set(dt, ds) end

                                local k = string.lower(tostring(remote.key_system or ""))
                                if k == "online" then rKey.set("Online", "ok")
                                elseif k == "degraded" then rKey.set("Degraded", "warn")
                                elseif k == "offline" then rKey.set("Offline", "bad")
                                elseif k == "none" then rKey.set("Not used", nil)
                                else rKey.set(k, nil) end

                                rMsg.set(remote.message and tostring(remote.message) or "-", nil)
                            end

                            -- script version: compare with the copy at UPDATE_URL
                            local latest
                            if type(UPDATE_URL) == "string" and UPDATE_URL ~= "" then
                                local text = fetchSource(UPDATE_URL)
                                if text then latest = text:match('SCRIPT_VERSION%s*=%s*"([%w%.%-]+)"') end
                            end
                            local vi = versionInfo(remote and remote.version, latest)
                            local sState, sText = vi.state, vi.text
                            rNew.set(vi.latest and ("v" .. vi.latest) or "Unavailable", vi.latest and vi.state or "warn")
                            rFeed.set(vi.feedText, vi.feedState)
                            local override = remote and string.lower(tostring(remote.script or "")) or ""
                            if override == "working" then sState, sText = "ok", "Working"
                            elseif override == "updating" then sState, sText = "warn", "Updating"
                            elseif override == "patched" then sState, sText = "bad", "Patched" end
                            rScript.set(sText, sState)

                            statusL.Text = "Updated " .. os.date("%H:%M:%S")
                            busy = false
                        end)
