            function Mic.find()
                if Mic.input and Mic.input.Parent then return Mic.input end
                Mic.input = lp:FindFirstChildOfClass("AudioDeviceInput")
                if not Mic.input then
                    for _, d in ipairs(lp:GetDescendants()) do
