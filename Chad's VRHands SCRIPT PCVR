        -- ============ SHARED 3D "M" LOGO ============
        -- Builds the extruded 3D "M" out of plain frames inside `parent`, centred at (px, py).
        -- A stack of darker copies behind the front face makes the depth; call logo.step(t)
        -- every frame (t = seconds since it appeared) and the stack sways like a spinning letter.
        -- Returns { hold = CanvasGroup, scale = UIScale, step = function(t) }.
        local function buildLogoM(parent, px, py)
            local W, H, T = 150, 130, 34
            local NL = 18                                  -- depth layers
            local CW, CH = W + 90, H + 90                  -- canvas around the letter
            local cx0, cy0 = CW / 2, CH / 2

            local mHold = Instance.new("CanvasGroup")
            mHold.AnchorPoint = Vector2.new(0.5, 0.5)
            mHold.Position = UDim2.fromOffset(px, py)
            mHold.Size = UDim2.fromOffset(CW, CH)
            mHold.BackgroundTransparency = 1
            mHold.BorderSizePixel = 0
            mHold.GroupTransparency = 1
            mHold.Parent = parent
            local mScale = Instance.new("UIScale")
            mScale.Scale = 0.6
            mScale.Parent = mHold

            local function makeHolder(z)
                local h = Instance.new("Frame")
                h.AnchorPoint = Vector2.new(0.5, 0.5)
                h.Position = UDim2.fromOffset(cx0, cy0)
                h.Size = UDim2.fromOffset(W, H)
                h.BackgroundTransparency = 1
                h.ZIndex = z
                h.Parent = mHold
                return h
            end
            -- four bars: left, right, and the two diagonals that meet in the middle
            local function makePieces(holder, col)
                local list = {}
                local function piece(x, y, w, h, rot)
                    local f = Instance.new("Frame")
                    f.AnchorPoint = Vector2.new(0.5, 0.5)
                    f.Position = UDim2.fromOffset(x, y)
                    f.Size = UDim2.fromOffset(w, h)
                    f.Rotation = rot
                    f.BackgroundColor3 = col
                    f.BorderSizePixel = 0
                    f.Parent = holder
                    corner(f, 8)
                    list[#list + 1] = f
                end
                piece(T / 2, H / 2, T, H, 0)
                piece(W - T / 2, H / 2, T, H, 0)
                local sx, sy = T / 2 + 3, T * 0.55
                local ex, ey = W / 2, H * 0.68
                local dx, dy = ex - sx, ey - sy
                local len = math.sqrt(dx * dx + dy * dy) + T * 0.5
                local ang = math.deg(math.atan2(dy, dx))
                piece((sx + ex) / 2, (sy + ey) / 2, len, T, ang)
                piece(W - (sx + ex) / 2, (sy + ey) / 2, len, T, -ang)
                return list
            end

            -- depth layers, back (dark) to front
            local layers = {}
            for k = NL, 1, -1 do
                local a = k / NL
                local h = makeHolder(NL + 1 - k)
                makePieces(h, C(104, 58, 224):Lerp(C(12, 7, 40), a))
                layers[k] = h
            end
            -- front face with a light-to-deep violet gradient
            local front = makeHolder(NL + 2)
            for _, f in ipairs(makePieces(front, Color3.new(1, 1, 1))) do
                local gr = Instance.new("UIGradient")
                gr.Color = ColorSequence.new(C(232, 200, 255), C(118, 84, 246))
                gr.Rotation = 90 - f.Rotation
                gr.Parent = f
            end
            -- shine: a bright band that sweeps across the front face
            local shine = makeHolder(NL + 3)
            local shineGr = {}
            for _, f in ipairs(makePieces(shine, Color3.new(1, 1, 1))) do
                local gr = Instance.new("UIGradient")
                gr.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(0.38, 1),
                    NumberSequenceKeypoint.new(0.5, 0.25),
                    NumberSequenceKeypoint.new(0.62, 1),
                    NumberSequenceKeypoint.new(1, 1),
                })
                gr.Rotation = 45 - f.Rotation
                gr.Offset = Vector2.new(-1, 0)
                gr.Parent = f
                shineGr[#shineGr + 1] = gr
            end

            local logo = { hold = mHold, scale = mScale }
            -- per-frame motion: extrusion sway, bob, tilt, shine sweep
            function logo.step(tt)
                local x = math.clamp((tt - 0.15) / 1.2, 0, 1)
                local depthK = 1 - (1 - x) ^ 3
                local ox = math.sin(tt * 1.3) * 1.7
                local oy = 1.15 + math.cos(tt * 1.05) * 0.4
                for k = 1, NL do
                    layers[k].Position = UDim2.fromOffset(cx0 + ox * k * depthK, cy0 + oy * k * depthK)
                end
                mHold.Position = UDim2.fromOffset(px, py + math.sin(tt * 2.0) * 5)
                mHold.Rotation = math.sin(tt * 1.1) * 2.5

                local phase = (tt % 3.2) / 3.2
                local off = -1 + 2 * math.clamp(phase / 0.45, 0, 1)
                for _, gr in ipairs(shineGr) do gr.Offset = Vector2.new(off, 0) end
            end
            return logo
        end
        -- ================================================================

        -- ============ LOADING SCREEN (animated 3D "M" logo) ============
        -- Shows after the welcome screen, before the Start Menu.
        local loaderActive = false
        local welcomeActive = false
        local rawOpenStart = openStart
        openStart = function()
            if loaderActive or welcomeActive then return end
            rawOpenStart()
        end

        local function showLoader()
            loaderActive = true
            S.menuOpen = true
            setLook(false)

            local old = Lighting:FindFirstChild("NoVR_LoadBlur")
            if old then old:Destroy() end
            local lblur = Instance.new("BlurEffect")
            lblur.Name = "NoVR_LoadBlur"
            lblur.Size = 0
            lblur.Parent = Lighting
            tw(lblur, 0.6, { Size = 30 }, Enum.EasingStyle.Sine)

            local g = Instance.new("ScreenGui")
            g.Name = "NoVR_Loader"
            g.ResetOnSpawn = false
            g.IgnoreGuiInset = true
            g.DisplayOrder = 200
            g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            g.Parent = lp:WaitForChild("PlayerGui")

            local back = Instance.new("Frame")   -- dark backdrop, also swallows clicks
            back.Size = UDim2.fromScale(1, 1)
            back.BackgroundColor3 = Color3.new(1, 1, 1)
            back.BackgroundTransparency = 1
            back.BorderSizePixel = 0
            back.Active = true
            back.Parent = g
            grad(back, C(46, 20, 112), C(8, 5, 28), 60)
            tw(back, 0.5, { BackgroundTransparency = 0.04 })

            local stage = Instance.new("Frame")
            stage.AnchorPoint = Vector2.new(0.5, 0.5)
            stage.Position = UDim2.fromScale(0.5, 0.5)
            stage.Size = UDim2.fromOffset(520, 470)
            stage.BackgroundTransparency = 1
            stage.Parent = g
            local fitS = Instance.new("UIScale")
            fitS.Parent = stage
            local function refit()
                local v = cam.ViewportSize
                fitS.Scale = math.clamp(math.min(v.X / 560, v.Y / 500), 0.5, 1.5)
            end
            refit()

            -- glow behind the logo
            local glow = softBox(stage, 160, 105, 200, 170, PINK, 70, 14, 0.9, 40)
            local glowSc = Instance.new("UIScale")
            glowSc.Parent = glow
            task.delay(0.2, function() if g.Parent then softFade(glow, true, 1.2) end end)

            -- ground shadow
            local shadowF = Instance.new("Frame")
            shadowF.AnchorPoint = Vector2.new(0.5, 0.5)
            shadowF.Position = UDim2.fromOffset(260, 322)
            shadowF.Size = UDim2.fromOffset(150, 16)
            shadowF.BackgroundColor3 = C(4, 0, 22)
            shadowF.BackgroundTransparency = 1
            shadowF.BorderSizePixel = 0
            shadowF.Parent = stage
            corner(shadowF, 8)
            tw(shadowF, 1.0, { BackgroundTransparency = 0.55 }, Enum.EasingStyle.Sine)

            -- ===== the M =====
            local logo = buildLogoM(stage, 260, 190)
            local mHold, mScale = logo.hold, logo.scale

            -- ===== texts + loading bar =====
            local texts = {}
            local title = lbl(stage, "V R   H A N D S", 0, 340, 520, 36, 28, WHITE, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
            grad(title, C(255, 255, 255), C(190, 150, 255), 0)
            local sub = lbl(stage, "No-VR  |  Edited by @N4THAFTER", 0, 376, 520, 18, 12, MUTED, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)
            local status = lbl(stage, "Starting up...", 0, 432, 520, 16, 11, MUTED, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)
            local pct = lbl(stage, "0%", 396, 400, 60, 16, 11, WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Left)
            for _, t in ipairs({ title, sub, status, pct }) do
                t.TextTransparency = 1
                texts[#texts + 1] = t
            end

            local track = Instance.new("Frame")
            track.Position = UDim2.fromOffset(130, 405)
            track.Size = UDim2.fromOffset(260, 6)
            track.BackgroundColor3 = Color3.new(1, 1, 1)
            track.BackgroundTransparency = 1
            track.BorderSizePixel = 0
            track.Parent = stage
            corner(track, 3)
            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BackgroundColor3 = Color3.new(1, 1, 1)
            fill.BackgroundTransparency = 1
            fill.BorderSizePixel = 0
            fill.Parent = track
            corner(fill, 3)
            grad(fill, PINK, VIOLET, 0)

            -- entrance
            tw(mHold, 0.9, { GroupTransparency = 0 }, Enum.EasingStyle.Quint)
            tw(mScale, 1.0, { Scale = 1 }, Enum.EasingStyle.Back)
            tw(track, 0.6, { BackgroundTransparency = 0.82 })
            tw(fill, 0.6, { BackgroundTransparency = 0 })
            for i, t in ipairs(texts) do
                task.delay(0.35 + i * 0.1, function()
                    if t.Parent then tw(t, 0.6, { TextTransparency = 0 }) end
                end)
            end

            -- per-frame motion: extrusion sway, bob, glow pulse, shine sweep
            local t0 = os.clock()
            local conn
            conn = RunService.Heartbeat:Connect(function()
                local tt = os.clock() - t0
                refit()
                logo.step(tt)
                glowSc.Scale = 1 + 0.07 * math.sin(tt * 2.4)
                shadowF.Size = UDim2.fromOffset(150 + 10 * math.sin(tt * 2.0 + math.pi), 16)

                pct.Text = math.floor(fill.Size.X.Scale * 100 + 0.5) .. "%"
            end)

            -- loading steps
            task.spawn(function()
                local function step(p, txt, wait)
                    status.Text = txt
                    tw(fill, 0.55, { Size = UDim2.new(p, 0, 1, 0) }, Enum.EasingStyle.Sine)
                    task.wait(wait)
                end
                task.wait(0.5)
                step(0.2,  "Initializing...", 0.6)
                step(0.45, "Hooking VR input...", 0.7)
                step(0.7,  Input and "Hands ready" or "Hands ready (no gestures)", 0.7)
                step(0.92, "Building menu...", 0.6)
                step(1,    "Ready!", 0.5)

                -- exit: the M grows and fades, then the Start Menu opens
                tw(mScale, 0.55, { Scale = 1.4 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                tw(mHold, 0.55, { GroupTransparency = 1 }, Enum.EasingStyle.Sine)
                softFade(glow, false, 0.5)
                tw(shadowF, 0.4, { BackgroundTransparency = 1 })
                for _, t in ipairs(texts) do tw(t, 0.4, { TextTransparency = 1 }) end
                tw(track, 0.4, { BackgroundTransparency = 1 })
                tw(fill, 0.4, { BackgroundTransparency = 1 })
                tw(back, 0.6, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
                tw(lblur, 0.6, { Size = 0 }, Enum.EasingStyle.Sine)
                task.wait(0.65)
                conn:Disconnect()
                g:Destroy()
                lblur:Destroy()
                loaderActive = false
                rawOpenStart()
            end)
        end
        -- ================================================================

        -- ============ WELCOME SCREEN (before the loading screen) ============
        -- 3D "M" in the middle with three buttons under it:
        --   left   JOIN DISCORD       (same invite + same code the other Discord button uses)
        --   middle START SCRIPT       (continues to the loading screen, then the Start Menu)
        --   right  CHECK FOR UPDATES  (looks at UPDATE_URL; if a newer version exists the
        --                              button turns into UPDATE NOW and installs it)
        local function showWelcome()
            welcomeActive = true
            S.menuOpen = true
            setLook(false)

            local old = Lighting:FindFirstChild("NoVR_WelcomeBlur")
            if old then old:Destroy() end
            local wblur = Instance.new("BlurEffect")
            wblur.Name = "NoVR_WelcomeBlur"
            wblur.Size = 0
            wblur.Parent = Lighting
            tw(wblur, 0.6, { Size = 30 }, Enum.EasingStyle.Sine)

            local g = Instance.new("ScreenGui")
            g.Name = "NoVR_Welcome"
            g.ResetOnSpawn = false
            g.IgnoreGuiInset = true
            g.DisplayOrder = 200
            g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            g.Parent = lp:WaitForChild("PlayerGui")

            local back = Instance.new("Frame")   -- dark backdrop, also swallows clicks
            back.Size = UDim2.fromScale(1, 1)
            back.BackgroundColor3 = Color3.new(1, 1, 1)
            back.BackgroundTransparency = 1
            back.BorderSizePixel = 0
            back.Active = true
            back.Parent = g
            grad(back, C(46, 20, 112), C(8, 5, 28), 60)
            tw(back, 0.5, { BackgroundTransparency = 0.04 })

            local SW, SH = 640, 480
            local stage = Instance.new("Frame")
            stage.AnchorPoint = Vector2.new(0.5, 0.5)
            stage.Position = UDim2.fromScale(0.5, 0.5)
            stage.Size = UDim2.fromOffset(SW, SH)
            stage.BackgroundTransparency = 1
            stage.Parent = g
            local fitS = Instance.new("UIScale")
            fitS.Parent = stage
            local function refit()
                local v = cam.ViewportSize
                fitS.Scale = math.clamp(math.min(v.X / (SW + 40), v.Y / (SH + 40)), 0.5, 1.5)
            end
            refit()

            -- glow + ground shadow behind / under the logo
            local glow = softBox(stage, 220, 85, 200, 170, PINK, 70, 14, 0.9, 40)
            local glowSc = Instance.new("UIScale")
            glowSc.Parent = glow
            task.delay(0.2, function() if g.Parent then softFade(glow, true, 1.2) end end)

            local shadowF = Instance.new("Frame")
            shadowF.AnchorPoint = Vector2.new(0.5, 0.5)
            shadowF.Position = UDim2.fromOffset(320, 290)
            shadowF.Size = UDim2.fromOffset(150, 16)
            shadowF.BackgroundColor3 = C(4, 0, 22)
            shadowF.BackgroundTransparency = 1
            shadowF.BorderSizePixel = 0
            shadowF.Parent = stage
            corner(shadowF, 8)
            tw(shadowF, 1.0, { BackgroundTransparency = 0.55 }, Enum.EasingStyle.Sine)

            -- the 3D M
            local logo = buildLogoM(stage, 320, 160)
            local mHold, mScale = logo.hold, logo.scale

            -- texts
            local texts = {}
            local title = lbl(stage, "V R   H A N D S", 0, 306, SW, 36, 28, WHITE, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
            grad(title, C(255, 255, 255), C(190, 150, 255), 0)
            local sub = lbl(stage, "No-VR  |  Edited by @N4THAFTER", 0, 342, SW, 18, 12, MUTED, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)
            local status = lbl(stage, "", 0, 436, SW, 30, 11, MUTED, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)
            status.TextWrapped = true
            status.TextTruncate = Enum.TextTruncate.None
            status.TextYAlignment = Enum.TextYAlignment.Top
            local ver = lbl(stage, "v" .. SCRIPT_VERSION, 0, 460, SW, 14, 10, MUTED, Enum.Font.GothamMedium, Enum.TextXAlignment.Center)
            for _, t in ipairs({ title, sub, status, ver }) do
                t.TextTransparency = 1
                texts[#texts + 1] = t
            end

            -- the three buttons live in one CanvasGroup so they can fade in together
            local row = Instance.new("CanvasGroup")
            row.Size = UDim2.fromOffset(SW, SH)
            row.BackgroundTransparency = 1
            row.BorderSizePixel = 0
            row.GroupTransparency = 1
            row.Parent = stage

            local function wbtn(text, x, w, h, primary)
                local b = Instance.new("TextButton")
                b.AnchorPoint = Vector2.new(0.5, 0.5)
                b.Position = UDim2.fromOffset(x, 394)
                b.Size = UDim2.fromOffset(w, h)
                b.AutoButtonColor = false
                b.BackgroundColor3 = Color3.new(1, 1, 1)
                b.BorderSizePixel = 0
                b.Text = text
                b.Font = Enum.Font.GothamBlack
                b.TextSize = primary and 15 or 12
                b.TextColor3 = WHITE
                b.TextWrapped = true
                b.Parent = row
                local pd = Instance.new("UIPadding")
                pd.PaddingLeft, pd.PaddingRight = UDim.new(0, 8), UDim.new(0, 8)
                pd.Parent = b
                corner(b, 12)
                if primary then
                    grad(b, C(214, 128, 255), C(104, 132, 255), 0)
                else
                    grad(b, PINK, VIOLET, 0)
                end
                stroke(b, Color3.new(1, 1, 1), primary and 2 or 1.5, 0.2)
                local s = Instance.new("UIScale")
                s.Parent = b
                b.MouseEnter:Connect(function() tw(s, 0.5, { Scale = 1.06 }, Enum.EasingStyle.Back) end)
                b.MouseLeave:Connect(function() tw(s, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end)
                b.InputBegan:Connect(function(io) if isPress(io) then tw(s, 0.1, { Scale = 0.94 }); ripple(b, io, fitS.Scale) end end)
                b.InputEnded:Connect(function(io) if isPress(io) then tw(s, 0.45, { Scale = 1.06 }, Enum.EasingStyle.Back) end end)
                return b
            end

            local dcBtn = wbtn("JOIN DISCORD", 130, 170, 52, false)
            local goBtn = wbtn("START SCRIPT", 320, 190, 62, true)
            local upBtn = wbtn("CHECK FOR UPDATES", 510, 170, 52, false)

            -- left: Discord (same invite link / same join function as the Start Menu button)
            dcBtn.Activated:Connect(function()
                dcBtn.Text = joinDiscord()
                task.delay(2.2, function() if dcBtn.Parent then dcBtn.Text = "JOIN DISCORD" end end)
            end)

            -- right: check for updates, then (if one exists) install it on the next press
            local function setStatus(msg, isErr)
                if not status.Parent then return end
                status.Text = msg
                status.TextColor3 = isErr and C(255, 130, 140) or GREEN
                status:SetAttribute("tc", true)
            end
            local pendingVer, checking = nil, false
            upBtn.Activated:Connect(function()
                if checking then return end
                if pendingVer then
                    task.spawn(performUpdate, setStatus)
                    return
                end
                if type(UPDATE_URL) ~= "string" or UPDATE_URL == "" or string.find(UPDATE_URL, "PUT_YOUR", 1, true) then
                    setStatus("Set UPDATE_URL at the top of the script first.", true)
                    return
                end
                checking = true
                upBtn.Text = "CHECKING..."
                setStatus("Checking for updates...", false)
                task.spawn(function()
                    local src = fetchSource(UPDATE_URL)
                    if not src then
                        upBtn.Text = "CHECK FOR UPDATES"
                        setStatus("Couldn't reach the update link.", true)
                    else
                        local newVer = src:match('SCRIPT_VERSION%s*=%s*"([%w%.%-]+)"')
                        if newVer and newVer ~= SCRIPT_VERSION then
                            pendingVer = newVer
                            upBtn.Text = "UPDATE NOW  (v" .. newVer .. ")"
                            setStatus("Update found: v" .. SCRIPT_VERSION .. "  ->  v" .. newVer .. "   (press again to install)", false)
                        else
                            upBtn.Text = "CHECK FOR UPDATES"
                            setStatus("You're up to date (v" .. SCRIPT_VERSION .. ").", false)
                        end
                    end
                    checking = false
                end)
            end)

            -- entrance
            tw(mHold, 0.9, { GroupTransparency = 0 }, Enum.EasingStyle.Quint)
            tw(mScale, 1.0, { Scale = 1 }, Enum.EasingStyle.Back)
            for i, t in ipairs(texts) do
                task.delay(0.3 + i * 0.1, function()
                    if t.Parent then tw(t, 0.6, { TextTransparency = 0 }) end
                end)
            end
            task.delay(0.6, function()
                if row.Parent then tw(row, 0.7, { GroupTransparency = 0 }, Enum.EasingStyle.Quint) end
            end)

            -- per-frame motion
            local t0 = os.clock()
            local conn
            conn = RunService.Heartbeat:Connect(function()
                local tt = os.clock() - t0
                refit()
                logo.step(tt)
                glowSc.Scale = 1 + 0.07 * math.sin(tt * 2.4)
                shadowF.Size = UDim2.fromOffset(150 + 10 * math.sin(tt * 2.0 + math.pi), 16)
            end)

            -- middle: start the script -> exit animation -> loading screen -> Start Menu
            local leaving = false
            goBtn.Activated:Connect(function()
                if leaving then return end
                leaving = true
                tw(mScale, 0.5, { Scale = 1.3 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                tw(mHold, 0.5, { GroupTransparency = 1 }, Enum.EasingStyle.Sine)
                tw(row, 0.4, { GroupTransparency = 1 }, Enum.EasingStyle.Sine)
                softFade(glow, false, 0.4)
                tw(shadowF, 0.4, { BackgroundTransparency = 1 })
                for _, t in ipairs(texts) do tw(t, 0.4, { TextTransparency = 1 }) end
                tw(back, 0.55, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
                tw(wblur, 0.55, { Size = 0 }, Enum.EasingStyle.Sine)
                task.wait(0.6)
                conn:Disconnect()
                g:Destroy()
                wblur:Destroy()
                welcomeActive = false
                showLoader()
            end)
        end
        -- ================================================================

        hudApi.openStart = openStart
        hudApi.closeStart = closeStart

        -- always-visible button that opens / closes the start menu
        task.spawn(function()
            local tg = Instance.new("ScreenGui")
            tg.Name = "NoVR_StartToggle"
            tg.ResetOnSpawn = false
            tg.IgnoreGuiInset = true
            tg.DisplayOrder = 101
            tg.Parent = lp:WaitForChild("PlayerGui")

            local btn = Instance.new("TextButton")
            btn.AnchorPoint = Vector2.new(1, 0)
            btn.Position = UDim2.new(1, -14, 0, 64)
            btn.Size = UDim2.fromOffset(46, 46)
            btn.AutoButtonColor = false
            btn.BackgroundColor3 = C(86, 50, 175)
            btn.BackgroundTransparency = 0.2
            btn.BorderSizePixel = 0
            btn.Text = ""
            btn.Parent = tg
            corner(btn, 23)
            local st = stroke(btn, C(215, 185, 255), 2, 0.3)
            drawIcon(btn, "list")
            local sc = Instance.new("UIScale")
            sc.Parent = btn
            btn.MouseEnter:Connect(function() tw(sc, 0.4, { Scale = 1.1 }, Enum.EasingStyle.Back) end)
            btn.MouseLeave:Connect(function() tw(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end)
            btn.InputBegan:Connect(function(io) if isPress(io) then tw(sc, 0.1, { Scale = 0.9 }) end end)
            btn.InputEnded:Connect(function(io) if isPress(io) then tw(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end end)
            btn.Activated:Connect(function()
                if startGui then closeStart() else openStart() end
            end)
            RunService.Heartbeat:Connect(function()
                local on = startGui ~= nil
                local c = Theme.tint(on and C(186, 98, 255) or C(86, 50, 175))
                if btn:GetAttribute("tc") ~= c then
                    btn:SetAttribute("tc", c)
                    tw(btn, 0.4, { BackgroundColor3 = c }, Enum.EasingStyle.Sine)
                end
            end)
        end)
        UIS.InputBegan:Connect(function(io)
            if io.KeyCode == Enum.KeyCode.Escape and startGui then closeStart() end
            if io.KeyCode == Enum.KeyCode.Home and not UIS:GetFocusedTextBox() then
                if startGui then closeStart() else openStart() end
            end
        end)

        showWelcome()   -- welcome screen -> loading screen -> start menu
    end

    print("[NoVR] control active.")
end)
]==]

if C.queue then
    C.queue(hrs)
    TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
else
    -- no way to carry the script across a teleport, so just run it now
    task.spawn(function()
        local f, err = (C.loadstring or loadstring or load)(hrs)
        if f then
            local ok, e = pcall(f)
            if not ok then warn("[VR Hands No-VR] " .. tostring(e)) end
        else
            warn("[VR Hands No-VR] load failed: " .. tostring(err))
        end
    end)
