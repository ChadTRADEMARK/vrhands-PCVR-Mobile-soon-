-- Executor compatibility layer: finds whichever version of each function this
-- executor provides, and falls back gracefully when something is missing.
local env = (getgenv and getgenv()) or _G
local function pick(...)
    for _, n in ipairs({...}) do
        local f = env[n]
        if type(f) == "function" then return f end
    end
    return nil
end

