            Chat.badgeWatched = setmetatable({}, { __mode = "k" })
            Chat.badgeHooked = setmetatable({}, { __mode = "k" })
            local CHECK_B64 = ""
            local function b64dec(s)
                local A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
                local map = {}
                for i = 1, 64 do map[string.sub(A, i, i)] = i - 1 end
                local out, n = {}, 0
                local acc, bits = 0, 0
                for c in string.gmatch(s, "[%w%+/]") do
                    acc = acc * 64 + map[c]
                    bits = bits + 6
                    if bits >= 8 then
                        bits = bits - 8
                        local v = math.floor(acc / 2 ^ bits)
                        acc = acc - v * 2 ^ bits
                        n = n + 1
                        out[n] = string.char(v)
                    end
                end
                return table.concat(out)
            end
            local badgeImage
