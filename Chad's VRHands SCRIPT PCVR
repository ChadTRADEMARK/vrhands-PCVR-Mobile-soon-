-- Third person works by leaving the CAMERA as the free camera you steer, and
-- telling the game your HEAD (and hands) sit TP.D studs in front of it.
-- Zooming only changes TP.D, so the head never moves when you zoom.
local TP = { D = 0, scale = 1 }

do
    local function makeIndex(old)
        return C.newcclosure(function(self, k)
            if k == "VREnabled" and (self == VRService or self == UIS) then return true end
            return old(self, k)
        end)
    end
    local function makeNamecall(old)
        return C.newcclosure(function(self, ...)
            if self == VRService then
                local m = C.getnamecallmethod()
                if m == "GetUserCFrameEnabled" then return true end
                if m == "GetUserCFrame" then
                    local which = ...
                    -- third person no longer offsets the head: the game always
                    -- sees the camera sitting exactly on your head
                    return identity
                end
            end
            return old(self, ...)
        end)
    end

    local hooked = false

    -- method 1: swap the metatable entries directly
    if C.getrawmetatable then
        hooked = pcall(function()
            local mt = C.getrawmetatable(game)
            local oldIndex, oldNamecall = mt.__index, mt.__namecall
            C.setreadonly(mt, false)
            mt.__index = makeIndex(oldIndex)
            if C.getnamecallmethod then mt.__namecall = makeNamecall(oldNamecall) end
            C.setreadonly(mt, true)
        end)
    end

    -- method 2: executors that only offer hookmetamethod
    if not hooked and C.hookmetamethod then
        hooked = pcall(function()
            local oldIndex
            oldIndex = C.hookmetamethod(game, "__index", makeIndex(function(...) return oldIndex(...) end))
            if C.getnamecallmethod then
                local oldNamecall
                oldNamecall = C.hookmetamethod(game, "__namecall", makeNamecall(function(...) return oldNamecall(...) end))
            end
        end)
    end

    if not hooked then warn("[NoVR] could not hook the game metatable - VR spoof may not work") end
end

