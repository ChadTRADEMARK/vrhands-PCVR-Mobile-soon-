                local dir = fw * ((down[KC.W] and 1 or 0) - (down[KC.S] and 1 or 0)) + rt * ((down[KC.D] and 1 or 0) - (down[KC.A] and 1 or 0))
                if U.opt.moveCtl and dir.Magnitude > 0 then hum:Move(dir.Unit, false); drove = true
                elseif drove then hum:Move(Vector3.zero, false); drove = false end
                -- third person: keep the hands in front of the BODY (which faces where you walk), not in front of the camera
