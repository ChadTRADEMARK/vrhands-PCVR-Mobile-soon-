                end)
                netB.Activated:Connect(function()
                    local ok, why = S.netStart(30)
                    if not ok then say("Cannot record: " .. tostring(why)); return end
                    say("Recording for 30 seconds - use gestures and the FLIP OFF preset now.")
                    netB.Text = "recording..."
                    task.spawn(function()
                        task.wait(30.6)
                        netB.Text = "NET LOG (30s)"
                        local rep = S.netReport()
                        local okc = pcall(function() setclipboard(rep) end)
                        say(okc and "Network log copied - paste it to me." or "Recorded, but your executor cannot copy to the clipboard.")
                    end)
                end)
                local pauseB = mkBtn(P2, "PAUSE", 533, 422, 187, 26, 11)
                pauseB.Activated:Connect(function() S.animPause(); say(S.keyNote or "") end)
                local function refreshKeys()
                    for _, kd in ipairs(KEYDEF) do
                        local b = keyB[kd[1]]
                        b.Text = (S.keyCapture == kd[1]) and "press a key..." or (kd[2] .. " KEY: " .. S.keyLabel(S[kd[1]]))
                        b.BackgroundTransparency = (S.keyCapture == kd[1]) and 0.1 or 0.8
                    end
                    pauseB.Text = S.animPaused and "RESUME" or "PAUSE"
                    pauseB.BackgroundTransparency = S.animPaused and 0.1 or 0.8
                end
                local playing, playTok = false, -1
                local function setPlaying(on)
                    playing = on
                    playB.Text = on and "STOP" or "PLAY"
                    playB.BackgroundTransparency = on and 0.1 or 0.8
                end
                addB.Activated:Connect(function()
                    if #Lib.frames >= 12 then say("12 frames is the maximum."); return end
                    Lib.frames[#Lib.frames + 1] = { pose = S.poseGet(), dur = frameDur, hold = 0 }
                    saveLib(); drawChips()
                    say("Frame " .. #Lib.frames .. " added.")
                end)
                clrB.Activated:Connect(function()
                    S.animStop(); setPlaying(false)
                    Lib.frames = {}
                    saveLib(); drawChips()
                    say("Animation cleared.")
                end)
                playB.Activated:Connect(function()
                    if playing then S.animStop(); setPlaying(false); say("Stopped."); return end
                    if #Lib.frames == 0 then say("Add at least one frame first (or LOAD CLAP / WAVE)."); return end
                    S.animLast = { frames = Lib.frames, loop = Lib.loop }
                    playTok = S.animPlay(Lib.frames, Lib.loop)
                    setPlaying(true)
                    say("Playing. Tap STOP to end.")
                end)
                loopB.Activated:Connect(function()
                    Lib.loop = not Lib.loop
                    loopB.Text = Lib.loop and "LOOP: ON" or "LOOP: OFF"
                end)
                local function loadAnim(name)
                    S.animStop(); setPlaying(false)
                    Lib.frames = {}
                    for _, fr in ipairs(GEST_ANIMS[name].frames) do
                        Lib.frames[#Lib.frames + 1] = { pose = fr.pose, dur = fr.dur, hold = fr.hold or 0 }
                    end
                    Lib.loop = GEST_ANIMS[name].loop
                    S.animLast = { frames = Lib.frames, loop = Lib.loop }
                    loopB.Text = Lib.loop and "LOOP: ON" or "LOOP: OFF"
                    saveLib(); drawChips()
                    say(name .. " loaded. Tap PLAY.")
                end
                clapB.Activated:Connect(function() loadAnim("CLAP") end)
                wavB.Activated:Connect(function() loadAnim("WAVE") end)
                foB.Activated:Connect(function() loadAnim("FLIP OFF") end)
                drawChips()

                local masterB = mkBtn(p, "MASTER RESET", 636, 50, 94, 28, 9)
                masterB.Activated:Connect(function()
                    S.handsMasterReset()
                    mirror = false; mirB.Text = "MIRROR: OFF"; mirB.BackgroundTransparency = 0.8
