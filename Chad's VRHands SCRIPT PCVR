            local function overlay(slot, x, y, w, h, name, title)
                local cascade = 0
                for _, other in ipairs({ "controls", "settings", "crosshair", "teleport", "profile", "servers", "roblox", "search", "gesture", "emu", "people", "accounts", "chat", "owner", "live", "req", "mic", "keys", "spec", "ball", "esp", "catalog", "versions", "countdown" }) do
