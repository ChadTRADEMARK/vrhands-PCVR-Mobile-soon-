                    say("Auto capture: the hands will go through every finger combination. Keep still for about 25 seconds.")
                    task.spawn(function()
                        local text, why = S.netAuto(function(n, total, name) autoB.Text = n .. "/" .. total .. " " .. string.sub(name, 6, 12) end)
                        autoB.Text = "AUTO CAPTURE"
