                -- ===== Add Friends: Roblox only lets a script open its own "send friend request" prompt for a player who is in
                -- your server, so this lists them (and takes a typed username). Someone who isn't here gets a profile link instead.
                local function showAddFriend()
                    local d = popup()
                    local function say(t) if detail == d and popMsg then popMsg.Text = t end end
                    lbl(d, "Add friends", 16, 12, 300, 24, 17, WHITE, Enum.Font.GothamBlack)
                    local ubox = Instance.new("TextBox")
                    ubox.Position = UDim2.fromOffset(16, 44)
                    ubox.Size = UDim2.new(1, -156, 0, 32)
                    ubox.BackgroundColor3 = PINK
                    ubox.BackgroundTransparency = 0.85
                    ubox.BorderSizePixel = 0
                    ubox.Text = ""
                    ubox.PlaceholderText = "Type a username..."
                    ubox.PlaceholderColor3 = MUTED
                    ubox.ClearTextOnFocus = false
                    ubox.Font = Enum.Font.GothamMedium
                    ubox.TextSize = 12
                    ubox.TextColor3 = WHITE
                    ubox.TextXAlignment = Enum.TextXAlignment.Left
                    ubox.Parent = d
                    corner(ubox, 9)
                    local upad = Instance.new("UIPadding"); upad.PaddingLeft = UDim.new(0, 12); upad.Parent = ubox

                    local function prompt(pl)
                        local ok, err = pcall(function() game:GetService("StarterGui"):SetCore("PromptSendFriendRequest", pl) end)
                        say(ok and ("Friend request window opened for " .. pl.DisplayName .. " - confirm it there.")
                            or ("Couldn't open the request window: " .. string.sub(tostring(err), 1, 50)))
                    end
                    local function inServer(name)
                        local q = string.lower(name)
                        local prefix
                        for _, pl in ipairs(PlayersSvc:GetPlayers()) do
                            if pl ~= lp then
                                local n1, n2 = string.lower(pl.Name), string.lower(pl.DisplayName)
                                if n1 == q or n2 == q then return pl end
                                if not prefix and (string.sub(n1, 1, #q) == q or string.sub(n2, 1, #q) == q) then prefix = pl end
                            end
                        end
                        return prefix
                    end
                    local function sendTyped()
                        local q = string.match(ubox.Text or "", "^%s*@?(.-)%s*$") or ""
                        if q == "" then say("Type a username first."); return end
                        local pl = inServer(q)
                        if pl then prompt(pl); return end
                        say("Looking up " .. q .. "...")
                        task.spawn(function()
                            local ok, id = pcall(function() return PlayersSvc:GetUserIdFromNameAsync(q) end)
                            if ok and tonumber(id) then
                                if clip then pcall(clip, "https://www.roblox.com/users/" .. tonumber(id) .. "/profile") end
                                say(q .. " isn't in this server, so a request can't be sent from here." .. (clip and " Their profile link was copied." or ""))
                            else
                                say('No Roblox user named "' .. q .. '".')
                            end
                        end)
                    end
                    local send = popButton(d, "SEND REQUEST", 0, 124, true, sendTyped)
                    send.AnchorPoint = Vector2.new(1, 0)
                    send.Position = UDim2.new(1, -16, 0, 44)
                    send.Size = UDim2.fromOffset(124, 32)
                    ubox.FocusLost:Connect(function(enter) if enter then sendTyped() end end)

                    lbl(d, "Players in this server (ADD opens Roblox's request window)", 16, 84, 500, 16, 11, MUTED, Enum.Font.GothamBold)
                    local list = Instance.new("ScrollingFrame")
                    list.Position = UDim2.fromOffset(16, 106)
                    list.Size = UDim2.new(1, -32, 1, -168)
                    list.BackgroundTransparency = 1
                    list.BorderSizePixel = 0
                    list.ScrollBarThickness = 4
                    list.CanvasSize = UDim2.new()
                    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
                    list.ScrollingDirection = Enum.ScrollingDirection.Y
                    list.Parent = d
                    local ll = Instance.new("UIListLayout")
                    ll.Padding = UDim.new(0, 6)
                    ll.SortOrder = Enum.SortOrder.LayoutOrder
                    ll.Parent = list
                    local listNote = lbl(d, "Checking who is here...", 16, 110, 500, 18, 12, MUTED, Enum.Font.GothamMedium)

                    task.spawn(function()
                        local shown = 0
                        for _, pl in ipairs(PlayersSvc:GetPlayers()) do
                            if detail ~= d then return end
                            if pl ~= lp and shown < 40 then
                                local okF, isF = pcall(function() return lp:IsFriendsWith(pl.UserId) end)
                                if not (okF and isF) then
                                    shown += 1
                                    local row = Instance.new("Frame")
                                    row.LayoutOrder = shown
                                    row.Size = UDim2.new(1, -8, 0, 44)
                                    row.BackgroundColor3 = PINK
                                    row.BackgroundTransparency = 0.82
                                    row.BorderSizePixel = 0
                                    row.Parent = list
                                    corner(row, 10)
                                    artBox(row, 6, 6, 32, 32, "rbxthumb://type=AvatarHeadShot&id=" .. pl.UserId .. "&w=150&h=150", pl.DisplayName, 16)
                                    lbl(row, pl.DisplayName, 46, 5, 260, 18, 12, WHITE, Enum.Font.GothamBold)
                                    lbl(row, "@" .. pl.Name, 46, 23, 260, 14, 10, MUTED, Enum.Font.GothamMedium)
                                    local add = Instance.new("TextButton")
                                    add.AnchorPoint = Vector2.new(1, 0.5)
                                    add.Position = UDim2.new(1, -8, 0.5, 0)
                                    add.Size = UDim2.fromOffset(70, 28)
                                    add.AutoButtonColor = false
                                    add.BackgroundColor3 = PINK
                                    add.BackgroundTransparency = 0.1
                                    add.BorderSizePixel = 0
