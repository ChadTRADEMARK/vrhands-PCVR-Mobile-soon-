                local e1 = c.suckA:Cross(Vector3.xAxis)
                if e1.Magnitude < 0.1 then e1 = c.suckA:Cross(Vector3.zAxis) end
                c.suckE1 = e1.Unit
                c.suckE2 = c.suckA:Cross(c.suckE1)
                c.shots, c.shotCuts = {}, {}   -- the cutscene cameras: ground tearing, the tower falling, the pond floating up, an island breaking apart, the flood into the black hole
                local used = {}
