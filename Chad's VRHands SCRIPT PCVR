                    local h = 5381
                    for i = 1, #s do h = (h * 33 + string.byte(s, i)) % 4294967296 end
                    return string.format("%08x", h)
                end
                -- turns what the user typed into something an ImageLabel can show (or nil + reason)
                local function resolve(src)
                    if S.bgCache[src] then return S.bgCache[src] end
                    local asset
                    if string.match(src, "^%d+$") then
                        asset = "rbxassetid://" .. src
                    elseif string.sub(src, 1, 13) == "rbxassetid://" or string.sub(src, 1, 9) == "rbxthumb:" or string.sub(src, 1, 7) == "rbxasset" then
                        asset = src
                    else
                        local gca = getcustomasset or getsynasset
                        if not gca then return nil, "This executor can't show your own pictures." end
                        local file = src
                        if string.match(src, "^https?://") then
                            if not writefile then return nil, "This executor can't save files." end
                            local req = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
                            local body
                            if req then
                                local ok, r = pcall(req, { Url = src, Method = "GET" })
                                if ok and type(r) == "table" and (r.Success or r.StatusCode == 200) then body = r.Body end
                            end
                            if not body then
                                local ok, r = pcall(function() return hget(src, true) end)
                                if ok then body = r end
                            end
                            if type(body) ~= "string" or #body < 16 then return nil, "Couldn't download that link." end
                            local ext
                            if string.sub(body, 1, 4) == "\137PNG" then ext = "png"
                            elseif string.sub(body, 1, 3) == "\255\216\255" then ext = "jpg"
                            elseif string.sub(body, 1, 2) == "BM" then ext = "bmp" end
                            if not ext then return nil, "That link isn't a PNG / JPG picture (WebP and GIF don't work)." end
                            file = "NoVR_bg_" .. djb(src) .. "." .. ext
                            if not pcall(writefile, file, body) then return nil, "Couldn't save the picture." end
                        else
                            if not (isfile and isfile(file)) then return nil, "No such file in your workspace folder: " .. file end
                        end
                        local ok, a = pcall(gca, file)
                        if not (ok and a) then return nil, "This executor couldn't open that picture." end
