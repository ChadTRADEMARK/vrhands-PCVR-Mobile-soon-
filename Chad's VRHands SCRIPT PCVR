        -- the top-to-bottom ZIndex path of an object inside a root (to find which of two overlapping buttons is on top)
        local function pathOf(o, root)
            local p, n = {}, 0
            local x = o
            while x and x ~= root do
                if x:IsA("GuiObject") then n = n + 1 p[n] = x.ZIndex end
                x = x.Parent
            end
            local rev = {}
            for i = n, 1, -1 do rev[#rev + 1] = p[i] end
            return rev
        end
        local function above(a, b)
            for i = 1, math.max(#a, #b) do
                local x, y = a[i] or -1, b[i] or -1
                if x ~= y then return x > y end
            end
            return false
        end
        local function inside(o, px, py)
            local ap, as = o.AbsolutePosition, o.AbsoluteSize
            return px >= ap.X and px <= ap.X + as.X and py >= ap.Y and py <= ap.Y + as.Y
        end
        -- is this point really on the object (every parent visible and not clipping it away)?
        local function reachable(o, root, px, py)
            local x = o.Parent
            while x and x ~= root do
                if x:IsA("GuiObject") then
                    if not x.Visible then return false end
                    if x:IsA("CanvasGroup") and x.GroupTransparency >= 0.98 then return false end
                    if (x.ClipsDescendants or x:IsA("ScrollingFrame") or x:IsA("CanvasGroup")) and not inside(x, px, py) then return false end
                end
                x = x.Parent
            end
            return true
        end
        local function refresh(r)
            r.btns, r.scrs = {}, {}
            for _, d in ipairs(r.sg:GetDescendants()) do
                if d:IsA("GuiButton") or d:IsA("TextBox") then r.btns[#r.btns + 1] = d
                elseif d:IsA("ScrollingFrame") then r.scrs[#r.scrs + 1] = d end
            end
            r.at = os.clock()
        end
        local function bestAt(r, px, py)
            if not r.btns or os.clock() - r.at > 0.35 then refresh(r) end
            local best, bp
            for _, b in ipairs(r.btns) do
                if b.Parent and b.Visible and (b:IsA("TextBox") or b.Active) and inside(b, px, py) and reachable(b, r.sg, px, py) then
                    local p = pathOf(b, r.sg)
                    if not best or above(p, bp) or (not above(bp, p) and true) then best, bp = b, p end
                end
            end
            return best
        end
        local function scrollAt(r, px, py)
            if not r.scrs or os.clock() - (r.at or 0) > 0.35 then refresh(r) end
            local best, bd = nil, -1
            for _, s in ipairs(r.scrs or {}) do
                if s.Parent and s.Visible and inside(s, px, py) and reachable(s, r.sg, px, py) then
                    local d = 0
                    local x = s
                    while x and x ~= r.sg do d = d + 1 x = x.Parent end
                    if d > bd then best, bd = s, d end
                end
            end
            return best
        end
