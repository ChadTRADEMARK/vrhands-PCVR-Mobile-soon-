                    local h = hMin + rnd:NextNumber() * (hMax - hMin)
                    local tw = (2 * math.pi * r / n) * (1.05 + rnd:NextNumber() * 0.3)
                    local rr = r + (rnd:NextNumber() - 0.5) * 2
