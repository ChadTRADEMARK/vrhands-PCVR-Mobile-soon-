                acg.Parent = accent
                local ps = Instance.new("UIScale")
                ps.Scale = 0.93
                ps.Parent = p
                local ent = { p = p, s = ps, x = x, y = y }
                me.panels[#me.panels + 1] = ent
                if name == "Dock" or name == "Panel" or name == "Side" then p.Visible = false; sh.Visible = false; halo.Visible = false; glow.Visible = false; ent.noShadow = true end
                -- windows overlap like normal windows: the one you touch comes to the front (with its shadow)
                local function front()
                    me.zTop = (me.zTop or 10) + 3
                    p.ZIndex = me.zTop
                    sh.ZIndex = me.zTop - 2
                    halo.ZIndex = me.zTop - 2
                    glow.ZIndex = me.zTop - 1
