                local i00 = (j0 * NP + p0) * 4
                local i10 = ((j0 + 1) * NP + p0) * 4
                local a = buffer.readf32(utab, i00) * (1 - tp) + buffer.readf32(utab, i00 + 4) * tp
                local bb = buffer.readf32(utab, i10) * (1 - tp) + buffer.readf32(utab, i10 + 4) * tp
                return a * (1 - tj) + bb * tj
            end
            local sin, cos, sqrt, log, exp, floor, atan2, min, max = math.sin, math.cos, math.sqrt, math.log, math.exp, math.floor, math.atan2, math.min, math.max
            local PI = math.pi
            local function smooth(a, b_, x)
                local t = (x - a) / (b_ - a)
                if t < 0 then t = 0 elseif t > 1 then t = 1 end
                return t * t * (3 - 2 * t)
            end
            local function render(ti, pi)
                local tilt = math.rad(tilts[ti])
                local ci, si = sin(tilt), cos(tilt)   -- cos / sin of the angle between the view and the disk's normal
                local raw = buffer.create(H * (1 + W * 4))
                local rowBytes = 1 + W * 4
                local ph = pi * 1.0
                for iy = 0, H - 1 do
                    local ro = iy * rowBytes
                    buffer.writeu8(raw, ro, 0)
                    local y = -((iy + 0.5) - H / 2) / (H / 2) * EXT
                    for ix = 0, W - 1 do
                        local x = ((ix + 0.5) - W / 2) / (W / 2) * EXT
                        local b = sqrt(x * x + y * y)
                        local cp, sp = 1, 0
                        if b > 1e-6 then cp, sp = x / b, y / b end
                        local A, Cr, Cg, Cb = 0, 0, 0, 0
                        local phi1 = atan2(-ci, sp * si)
                        if phi1 < 0 then phi1 = phi1 + PI end
                        for k = 0, 2 do
                            local phi = phi1 + k * PI
                            if phi > 0.02 and phi < (NP - 2) * DPH then
                                local u = lookup(b, phi)
                                if u > 0.02 and u < 0.999 then
                                    local r = 1 / u
                                    if r > RIN - 0.1 and r < ROUT + 0.5 then
                                        local sphi = sin(phi)
                                        local pz, px, py = cos(phi), sphi * cp, sphi * sp
                                        local th = atan2(py * ci - pz * si, px)
                                        local vv = sqrt(0.5 / r)
                                        local los = vv * (-si * px)
                                        local g = sqrt(max(1 - 1 / r, 0.01)) * sqrt(1 - vv * vv) / (1 - los)
                                        local thp = th - ph * 2.2 * r ^ -1.5
                                        local s1 = 0.5 + 0.5 * sin(thp * 4 + 6.0 * log(r))
                                        local s2 = 0.5 + 0.5 * sin(r * 9 + 2.0 * sin(thp * 3 + r * 1.3))
                                        local s3 = 0.5 + 0.5 * sin(r * 21 + thp * 5 + 3 * s1)
                                        local gr = sin(ix * 12.9898 + iy * 78.233 + k * 3.1) * 43758.5453
                                        gr = gr - floor(gr)
                                        local tx = 0.30 * s1 + 0.34 * s2 + 0.2 * s3 + 0.16 * gr
                                        local T = min(2, (2.4 / r) ^ 0.75 * g)
                                        local B = (g ^ 1.6) * (2.4 / r) ^ 1.6 * (0.35 + 0.9 * tx) * 5.0
                                        local edge = smooth(RIN - 0.1, RIN + 0.35, r) * (1 - smooth(ROUT - 4, ROUT, r))
                                        local al = edge * min(1, B * 2.0)
                                        if al > 0.003 then
                                            local er = 1 - exp(-B * 1.0)
                                            local eg = 1 - exp(-B * min(1, 0.18 + 0.55 * T))
                                            local eb = 1 - exp(-B * min(1, 0.03 + 0.5 * T * T))
                                            local w = (1 - A) * al
                                            Cr, Cg, Cb = Cr + w * er, Cg + w * eg, Cb + w * eb
                                            A = A + w
                                        end
                                    end
                                end
                            end
                        end
                        if b < BCRIT then
                            A = 1                      -- the shadow: nothing comes back
                        elseif b < BCRIT * 1.06 and A < 1 then
                            local f = 1 - (b - BCRIT) / (BCRIT * 0.06)   -- the thin bright photon ring right at its edge
                            local al = 0
                            local w = (1 - A) * al
                            Cr, Cg, Cb = Cr + w * 1.0, Cg + w * 0.86, Cb + w * 0.6
                            A = A + w
                        end
                        local o = ro + 1 + ix * 4
                        if A > 0.002 then
                            local inv = 1 / A
                            local r8 = min(255, floor(Cr * inv * 255 + 0.5))
                            local g8 = min(255, floor(Cg * inv * 255 + 0.5))
                            local b8 = min(255, floor(Cb * inv * 255 + 0.5))
                            local a8 = min(255, floor(A * 255 + 0.5))
                            buffer.writeu32(raw, o, r8 + g8 * 256 + b8 * 65536 + a8 * 16777216)
                        else
                            buffer.writeu32(raw, o, 0)
                        end
                    end
                    slice()
                    if iy % 16 == 0 and not alive() then return nil end
                end
                return raw
            end
            for _, nd in ipairs(todo) do
                local ti, pi = nd[1], nd[2]
                local raw = render(ti, pi)
                if not raw then return end
                local png = S.bhPng(raw, W, H)
                slice()
                local fn = fname(ti, pi)
                if pcall(writefile, fn, png) then
                    local okA, a = pcall(gca, fn)
                    if okA and a and alive() then addLabel(ti, pi, a) end
                end
                slice()
            end
        end
        -- shows the pictures that fit the current viewing angle: two neighbouring tilts crossfaded, and two swirl phases crossfaded
        function S.bhTexShow(c, age0)
            local tilts = S.BH_TILTS
            local labs = c.texLab
            if not labs then return end
            -- the disk is a real plane in the world (its normal slowly wanders); what we see is decided by the real direction to the camera and the camera's roll.
            -- The black hole is treated as if it were closer, so walking / flying around it swings the view clearly, like parallax of a real 3D object.
            local cf = cam.CFrame
            local dirBH = (c.S0 - c.center).Unit
            local vv = cf.Position - (c.center + dirBH * 900)
            vv = vv.Magnitude > 1 and vv.Unit or Vector3.yAxis
            local aN = math.rad(40 + 24 * math.sin(age0 * 0.045))
            local bN = age0 * 0.05 + 0.6
            local nW = Vector3.new(math.sin(aN) * math.cos(bN), math.cos(aN), math.sin(aN) * math.sin(bN))
            local dN = nW:Dot(vv)
            if dN < 0 then nW, dN = -nW, -dN end   -- seen from below it is the same shape, the normal just points to us
            local tdeg = 90 - math.deg(math.acos(math.clamp(dN, 0, 1)))
            local rotT = math.deg(math.atan2(nW:Dot(cf.RightVector), nW:Dot(cf.UpVector)))
            local prev = c.texRot or rotT
            local dd = ((rotT - prev + 540) % 360) - 180
            c.texRot = prev + dd * 0.2
            for _, g in pairs(labs) do for _, l in pairs(g) do l.Rotation = c.texRot + 4 end end
            local tau = math.clamp((tdeg - tilts[1]) / (tilts[#tilts] - tilts[1]) * (#tilts - 1), 0, #tilts - 1)
            local it = math.min(math.floor(tau), #tilts - 2)
            local f = tau - it
            for _, g in pairs(labs) do for _, l in pairs(g) do l.Visible = false end end
            local lo
            for i = it + 1, 1, -1 do if labs[i] and labs[i][0] then lo = labs[i] break end end
            local hi = labs[it + 2]
            local wp = 0.5 - 0.5 * math.cos(age0 * 1.2)
            if lo then
                lo[0].Visible, lo[0].ImageTransparency = true, 0
                if lo[1] then lo[1].Visible, lo[1].ImageTransparency = true, 1 - wp end
            end
            if hi and hi[0] and f > 0.002 then
                hi[0].Visible, hi[0].ImageTransparency = true, 1 - f
                if hi[1] then hi[1].Visible, hi[1].ImageTransparency = true, 1 - f * wp end
            end
        end
        function S.cineBHStep(c, age0, now, camPos)   -- spins the smoke, makes the whole black hole swell when it explodes and shrink back to a far away display
            local t = age0 - FX.tImp
            local G = 1
            if t > 0 then
                if t < 9 then
                    G = 1 + 2.4 * (1 - (1 - math.clamp(t / 7, 0, 1)) ^ 3)
                else
                    local k = math.clamp((t - 9) / 9, 0, 1)
                    k = k * k * (3 - 2 * k)
                    G = 3.4 + (0.75 - 3.4) * k
                end
            end
            if t > 0.4 then pcall(S.novaStep, c, t - 0.4, false) end
            local bmul = c.texReady and 3.2 or 1   -- the picture has a smaller shadow and a wide disk, so the billboard is bigger
            c.bb.Size = UDim2.fromScale(c.bbs * G * bmul, c.bbs * G * bmul)
            -- the disc is a real tilted plane seen from an angle that slowly changes: edge-on it is a thin glowing line with the bent light of its far side
            -- arching over the shadow; tilted, it opens into a warped ring (like the reference video)
            local tilt = math.rad(7 + 55 * (0.5 - 0.5 * math.cos(age0 * 0.2)))   -- how far we look down on the disc
            local ci, si = math.sin(tilt), math.cos(tilt)   -- cos / sin of the angle between the view and the disc's normal
            local phi = math.rad(90 - 16)   -- on screen, the "up" side of the disc's normal
            local px, py = math.cos(phi), math.sin(phi)
            local qx, qy = -math.sin(phi), math.cos(phi)
            if c.bhModelReady then
                local mdt = math.clamp(now - (c.mLast or now), 0, 0.1)
                c.mLast = now
                pcall(S.bhModelStep, c, mdt)
            end
            if c.texReady then pcall(S.bhTexShow, c, age0) end
            for _, ring in ipairs((c.texReady or c.bhModelReady) and {} or c.puffRings) do
                for _, it in ipairs(ring.items) do
                    if ring.kind == "disk" then
                        local th = it.a + ring.spin * age0
                        local ct, st_ = math.cos(th), math.sin(th)
                        local X = ring.a * (ct * qx - st_ * ci * px)
                        local Y = ring.a * (ct * qy - st_ * ci * py)
                        it.f.Position = UDim2.fromScale(0.5 + X, 0.5 - Y)
                        it.f.ZIndex = (st_ * si > 0) and 6 or 3   -- the near half passes in front of the hole, the far half behind it
                    else
                        -- bent light of the back of the disc: a halo hugging the shadow, thickest on top (and fainter underneath), strongest edge-on
                        local th = it.a + ring.spin * 0.3 * age0
                        it.f.Position = UDim2.fromScale(0.5 + ring.a * math.cos(th), 0.5 - ring.a * math.sin(th))
                        local dd = th - phi
                        local emph = math.max(math.cos(dd), -0.45 * math.cos(dd))
                        local m = (0.25 + 0.75 * si) * (0.3 + 0.7 * math.max(emph, 0))
                        it.f.Size = UDim2.fromScale(it.d * m * 1.35, it.d * m * 1.35)
                    end
                end
            end
        end
        function S.ringCineStep(age0, now, ro)
            local c = FX.cine
            if not c or c.done then return end
            if FX.closing then S.ringCineFree() return end
            local tI, quick = FX.tImp, FX.quick
            local cc, bl = c.cc, c.bloom
            local Lt = game:GetService("Lighting")
            local dt = math.clamp(now - (c.lastT or now), 0, 0.1)
            c.lastT = now
            -- black bars + subtitles + skip hint
            local H = quick and 0 or 0.115 * easeBack(math.clamp(age0 / 2.5, 0, 1))
            if age0 > FX.tEnd - 4 then H = H * math.clamp(1 - (age0 - (FX.tEnd - 4)) / 3, 0, 1) end
            c.top.Size = UDim2.fromScale(1, H)
            if not quick then
                local dip = 0
                for _, tb in ipairs({ 5.5, 11, 19, tI, tI + 3 }) do
                    local inside = false
                    for _, sh in ipairs(c.shots or {}) do if tb > sh.t0 + 0.05 and tb < sh.t1 - 0.05 then inside = true end end
                    if not inside then dip = math.max(dip, 1 - math.abs(age0 - tb) / 0.09) end
                end
                for _, tb in ipairs(c.shotCuts or {}) do dip = math.max(dip, 1 - math.abs(age0 - tb) / 0.09) end   -- a quick cut between camera shots
                c.blk.BackgroundTransparency = math.min(math.clamp((age0 - 0.3) / 2.2, 0, 1) ^ 1.2, 1 - math.clamp(dip, 0, 1))
            end
            c.bot.Size = UDim2.fromScale(1, H)
            local txt, al = "", 0
            if not quick then
                for _, sb in ipairs(S.CINE_SUBS) do
                    if age0 >= sb[1] and age0 <= sb[2] then
                        txt = sb[3]
                        al = math.min((age0 - sb[1]) / 0.7, (sb[2] - age0) / 0.7, 1)
                    end
                end
            end
            if txt ~= "" then c.sub.Text = txt end
            c.sub.TextTransparency = 1 - math.clamp(al, 0, 1)
            c.skip.TextTransparency = (quick or age0 < 1.5 or age0 > FX.tEnd - 4) and 1 or 0.35
            if not quick and not c.camRel then
                S.cineCamPose(c, age0, now, ro)
                if c.camCF and not c.camRel then pcall(function() cam.CFrame = c.camCF cam.FieldOfView = c.camFov end) end
            end
            local camPos = (c.camCF and c.camCF.Position) or ro.p
            S.cineBHStep(c, age0, now, camPos)
            c.lightPart.CFrame = CFrame.new(ro.p)
            if age0 < tI then
                -- ===== deep space: everything is slowly pulled into the black hole, faster and faster =====
                if not c.spaceOn then S.cineSpace(c, true) end
                local ap = math.clamp(age0 / tI, 0, 1)
                local sp = math.clamp(age0 / (quick and 0.3 or 2.5), 0, 1)
                local o = c.lt
                if o then
                    local amb = Color3.fromRGB(78 + 60 * ap ^ 3, 82 + 20 * ap ^ 3, 108)
                    Lt.Ambient = o.Ambient:Lerp(amb, sp)
                    Lt.OutdoorAmbient = o.OutdoorAmbient:Lerp(amb, sp)
                    Lt.Brightness = o.Brightness + (2.2 - o.Brightness) * sp
                end
                local BH = c.S0
                local axis = (c.center - BH).Unit
                for _, rk in ipairs(c.rocks) do   -- every red block drifts, then gets sucked in in a spiral and stretched into a streak
                    local g = math.clamp((age0 - rk.t0) / rk.dur, 0, 1)
                    local base = rk.pos + rk.vel * age0
                    if g >= 1 then
                        if rk.p.Transparency < 1 then rk.p.Transparency = 1 end
                    elseif g <= 0 then
                        rk.p.CFrame = CFrame.new(base) * CFrame.fromEulerAnglesXYZ(rk.rot.X + age0 * rk.sp, rk.rot.Y + age0 * rk.sp * 0.7, rk.rot.Z)
                    else
                        local gg = g ^ 3.2
                        local rel = CFrame.fromAxisAngle(axis, gg * 2.4) * (base - BH)
                        local pos2 = BH + rel * (1 - gg)
                        rk.p.Size = Vector3.new(rk.sz.X, rk.sz.Y, rk.sz.Z * (1 + 9 * gg))
                        rk.p.CFrame = CFrame.lookAt(pos2, BH)
                        rk.p.Color = rk.col:Lerp(Color3.fromRGB(255, 205, 130), gg)
                        rk.p.Transparency = math.clamp((gg - 0.75) / 0.25, 0, 1)
                    end
                end
                pcall(S.suckStep, c, age0, now, dt)
                pcall(S.suckAmb, c, age0)
                for _, b in ipairs(c.bodies) do   -- moons and planets spiral in from super far away: slow, then faster; stretched and reddened by the warp as they get close
                    local g = math.clamp((age0 - b.t0) / b.dur, 0, 1)
                    if g >= 1 then
                        b.p.Transparency = 1
                        if b.halo then b.halo.Transparency = 1 end
                    else
                        local gg = g ^ 2.4
                        local rad = (b.rad0 + (0.55 - b.rad0) * gg) * c.bhR
                        local ang = b.a0 + 0.015 * age0 + 6 * gg
                        local pos = BH + (c.pa * math.cos(ang) + c.pb * math.sin(ang)) * rad
                        local tan = -c.pa * math.sin(ang) + c.pb * math.cos(ang)
                        local sh = 1 - 0.55 * gg
                        local cf = CFrame.lookAt(pos, pos + tan)
                        b.p.Size = Vector3.new(b.d * sh, b.d * sh, math.min(2000, b.d * (1 + 8 * gg ^ 1.3)))
                        b.p.CFrame = cf
                        b.p.Color = b.col:Lerp(Color3.fromRGB(255, 150, 70), gg)
                        b.p.Transparency = math.clamp((gg - 0.85) / 0.15, 0, 1)
                        if b.halo then
                            b.halo.Size = b.p.Size * 1.12
                            b.halo.CFrame = cf
                            b.halo.Transparency = 0.86 + 0.14 * math.clamp((gg - 0.85) / 0.15, 0, 1)
                        end
                    end
                end
                cc.Brightness = 0.02 * ap
                cc.Saturation = 0.25 * ap
                cc.Contrast = 0.12 * ap
                cc.TintColor = Color3.new(1, 1 - 0.1 * ap, 1 - 0.14 * ap)
                bl.Intensity = 0.6 + 1.4 * ap
                if not c.startSnd and age0 > 0.2 then c.startSnd = true S.domeStartSnd(0.5, 0.5) end   -- the startup sound: slowed down, low pitched
                if age0 >= c.nextPulse then   -- a deep rumble, a heartbeat that speeds up
                    c.nextPulse = age0 + (quick and 0.5 or (2.6 - 1.7 * ap))
                    S.softPop(0.32 - 0.1 * ap, 0.16, 0.12 + 0.35 * ap)
                end
                return
            end
            -- ===== the black hole explodes: red and white sky, everything bright =====
            local t = age0 - tI
            if not c.hit then
                c.hit = true
                pcall(S.suckFree, c)
                pcall(S.sfxGlobal, "boomL", 0.85, 1)
                task.delay(0.35, function() pcall(S.sfxGlobal, "whoosh", 1.0, 0.6) end)
                for _, b in ipairs(c.bursts) do b.e:Emit(b.n) end
                c.flash.BackgroundTransparency = 0
                pcall(function()
                    local at = Instance.new("Atmosphere")
                    at.Name = "NoVR_CineAtmo"
                    at.Density, at.Offset, at.Haze, at.Glare = 0.6, 0.35, 4, 4
                    at.Color, at.Decay = Color3.fromRGB(255, 110, 80), Color3.fromRGB(255, 140, 100)
                    at.Parent = Lt
                    c.atmo = at
                end)
                pcall(function() Lt.Ambient, Lt.OutdoorAmbient, Lt.Brightness = Color3.fromRGB(255, 150, 130), Color3.fromRGB(255, 160, 140), 3 end)
                S.domeStartSnd(0.35, 1, 0)
                S.domeStartSnd(0.22, 0.85, 0.15)
                S.domeStartSnd(0.15, 0.7, 0.4)
                S.softPop(0.25, 0.1, 0.6)
            end
            if not c.aft and t > 1.3 then   -- aftershock
                c.aft = true
                for _, b in ipairs(c.bursts) do b.e:Emit(math.floor(b.n * 0.5)) end
                S.softPop(0.3, 0.12, 0.4)
            end
            if not c.after and t > FX.sealT + (FX.tForm - tI) then c.after = true S.domeStartSnd(0.5, 0.45) end
            -- two glowing spheres swell out of the black hole
            local ek = 1 - (1 - math.clamp(t / 6, 0, 1)) ^ 3
            c.novaA.Size = Vector3.one * (2 * c.bhR * (1 + 4 * ek))
            c.novaA.Transparency = 0.05 + 0.95 * math.clamp(t / 5, 0, 1) ^ 1.3
            c.novaB.Size = Vector3.one * (2 * c.bhR * (1 + 8 * ek))
            c.novaB.Transparency = 0.35 + 0.65 * math.clamp(t / 7, 0, 1) ^ 1.2
            -- the whole sky red on top, white at the horizon, the whole game bright
            local bump = math.clamp(t / 1.2, 0, 1) * (1 - math.clamp((t - 4) / 5, 0, 1))
            c.heat.BackgroundTransparency = 1 - 0.62 * bump
            if c.atmo then
                c.atmo.Density = 0.6 * bump
                c.atmo.Haze = 4 * bump
                c.atmo.Color = Color3.fromRGB(255, 110, 80):Lerp(Color3.fromRGB(255, 235, 225), math.clamp(t / 4, 0, 1))
                if t > 9.5 then pcall(function() c.atmo:Destroy() end) c.atmo = nil end
            end
            if t > 4.5 and not c.night then S.cineNight(c) end   -- the sky stays dark
            c.flash.BackgroundTransparency = math.clamp((t - 1.6) / 3.4, 0, 1) ^ 1.6
            local wk = 1 - math.clamp((t - 1.0) / 4.5, 0, 1)
            cc.Brightness = 0.9 * wk * wk
            cc.Saturation = -0.35 * wk
            cc.Contrast = 0.1 * wk
            cc.TintColor = Color3.new(1, 1 - 0.1 * wk, 1 - 0.18 * wk)
            bl.Intensity = 0.2 + 6 * math.exp(-t * 0.5)
            if age0 > FX.tEnd + 0.3 then S.ringCineFree() end
        end
        function S.ringFxBuild()
            FX = { t0 = os.clock(), plates = {}, frame = 0 }
            DOME_R = S.domeRadiusFor(cam.CFrame.Position - Vector3.new(0, FLOOR_DY, 0))
            FX.tImp, FX.sealT, FX.tEnd = S.domeTimes()
            FX.quick = S.pop.domeQuick == true
            FX.tForm = FX.quick and FX.tImp or FX.tImp + 3   -- the white-out lasts a few seconds, then the dome starts to form
            local look0 = cam.CFrame.LookVector
            local D0 = Vector3.new(look0.X, 0, look0.Z)
            D0 = D0.Magnitude > 0.05 and D0.Unit or Vector3.new(0, 0, -1)
            FX.D = D0
            local ph0 = math.atan2(D0.X, -D0.Z)
            local pinkc, violet = fxCol(C(225, 175, 255)), fxCol(C(120, 70, 230))
            -- inner ring on the floor
            local part, sg = fxDisc(RING_R, "NoVR_FloorRing")
