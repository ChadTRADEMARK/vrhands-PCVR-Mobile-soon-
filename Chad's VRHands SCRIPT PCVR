                    b.Size = UDim2.fromOffset(w, h)
                    b.AutoButtonColor = false
                    b.BackgroundColor3 = PINK
                    b.BackgroundTransparency = 0.8
                    b.BorderSizePixel = 0
                    b.Text = text
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = size or 11
                    b.TextColor3 = WHITE
                    b.TextTruncate = Enum.TextTruncate.AtEnd
                    b.ZIndex = 5
                    b.Parent = parent
                    corner(b, 9)
