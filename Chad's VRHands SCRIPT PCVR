            end
            function Mic.find()
                if Mic.input and Mic.input.Parent then return Mic.input end
                Mic.input = lp:FindFirstChildOfClass("AudioDeviceInput")
                if not Mic.input then
                    for _, d in ipairs(lp:GetDescendants()) do
                        if d:IsA("AudioDeviceInput") then Mic.input = d break end
                    end
                end
                return Mic.input
            end
            function Mic.apply()
                local m = Mic.find()
                if m then pcall(function() m.Volume = Mic.gain end) end
                return m ~= nil
            end
            -- where the playback / meter pieces live: out of the Player object first (games with an anti voice-chat-tool script watch that), then other places
            function Mic.parents()
                local list = {}
                pcall(function() if gethui then local h = gethui(); if h then list[#list + 1] = h end end end)
                list[#list + 1] = game:GetService("SoundService")
                pcall(function() list[#list + 1] = game:GetService("CoreGui") end)
                pcall(function() if workspace.CurrentCamera then list[#list + 1] = workspace.CurrentCamera end end)
                list[#list + 1] = lp
                return list
            end
            function Mic.scanAnti()   -- looks for anti voice-chat-tool scripts / objects (names with "vcb" or "anti vc")
                local hits = {}
                local function chk(n)
                    local l = string.lower(n)
                    return string.find(l, "vcb", 1, true) ~= nil or string.find(l, "antivc", 1, true) ~= nil or string.find(l, "anti_vc", 1, true) ~= nil
                end
                local n = 0
                for _, d in ipairs(game:GetDescendants()) do
                    n = n + 1
                    if n > 60000 then break end
                    if chk(d.Name) then hits[#hits + 1] = d:GetFullName(); if #hits >= 4 then break end end
                end
                pcall(function()
                    local gs = (getgenv and getgenv().getscripts) or _G.getscripts
                    if gs then
                        for _, s in ipairs(gs()) do
                            if chk(s.Name) then hits[#hits + 1] = s:GetFullName() end
                        end
                    end
                end)
                return hits
            end
            local function micGuid() return game:GetService("HttpService"):GenerateGUID(false) end
            local function monBuild(parent, m)
                local f = Instance.new("AudioFader")
                f.Name = micGuid()
                f.Volume = 1
                f.Parent = parent
                local o = Instance.new("AudioDeviceOutput")
                o.Name = micGuid()
                o.Parent = parent
                local w1 = Instance.new("Wire")
                w1.Name = micGuid()
                w1.SourceInstance = m
                w1.TargetInstance = f
                w1.Parent = f
                local w2 = Instance.new("Wire")
                w2.Name = micGuid()
                w2.SourceInstance = f
                w2.TargetInstance = o
                w2.Parent = o
                return f, o
            end
            local function monAlive() return Mic.mon and Mic.mon.Parent and Mic.monOut and Mic.monOut.Parent end
            local function monTry()   -- builds the playback in the first place that survives; returns ok
                local m = Mic.find()
                if not m then return false end
                local order = Mic.parents()
                if Mic.monGoodIdx then table.insert(order, 1, order[Mic.monGoodIdx]) end
                for i, parent in ipairs(order) do
                    local ok, f, o = pcall(monBuild, parent, m)
                    if ok and f then
                        task.wait(0.8)   -- a game that removes these pieces does it right away
                        if f.Parent and o.Parent and m.Parent then
                            Mic.mon, Mic.monOut = f, o
                            Mic.monGoodIdx = nil
                            return true
                        end
                        pcall(function() f:Destroy() end)
                        pcall(function() o:Destroy() end)
                    end
                end
                return false
            end
            function Mic.setMonitor(on)   -- hear your own mic through your speakers / headphones (local only, nobody else hears this). Returns ok, message
                if on then
                    if not Mic.find() then return false, "No mic control in this game, so there is nothing to play back." end
                    if not monAlive() then
                        if not monTry() then
                            local hits = Mic.scanAnti()
                            if #hits > 0 then
                                return false, "The game removes the playback pieces (anti voice-chat tool found: " .. hits[1] .. ")."
                            end
                            return false, "The game removed the playback pieces every time I put them somewhere."
                        end
                    end
                    Mic.monitorOn = true
                    if not Mic.monWatch then   -- if the game removes them later, they are put back (a few tries, then it stops and says so)
                        Mic.monWatch = true
                        task.spawn(function()
                            local fails = 0
                            while true do
                                task.wait(1)
                                if Mic.monitorOn and not monAlive() then
                                    if monTry() then fails = fails + 1 end
                                    if not monAlive() or fails > 6 then
                                        Mic.monitorOn = false
                                        Mic.monNote = "The game keeps removing the playback, so Hear myself was turned off."
                                        fails = 0
                                    end
                                end
                            end
                        end)
                    end
                else
                    Mic.monitorOn = false
                    pcall(function() if Mic.mon then Mic.mon:Destroy() end end)
                    pcall(function() if Mic.monOut then Mic.monOut:Destroy() end end)
                    Mic.mon, Mic.monOut = nil, nil
                end
                return true
            end
            function Mic.meter()   -- a level meter fed from your mic (peak / rms)
                local m = Mic.find()
                if not m then return nil end
                if not (Mic.analyzer and Mic.analyzer.Parent) then
                    pcall(function()
                        local an = Instance.new("AudioAnalyzer")
                        an.Name = micGuid()
                        an.Parent = Mic.parents()[1]
                        local w = Instance.new("Wire")
                        w.Name = micGuid()
                        w.SourceInstance = m
                        w.TargetInstance = an
                        w.Parent = an
                        Mic.analyzer = an
                    end)
                end
                return Mic.analyzer
            end
            task.spawn(function()   -- keeps your level applied, and does the auto-level when it is on
                while true do
                    task.wait(0.1)
                    if Mic.auto or Mic.touched then
                        local m = Mic.find()
                        if m then
                            if math.abs(m.Volume - Mic.gain) > 0.01 then pcall(function() m.Volume = Mic.gain end) end
                        end
                    end
                end
            end)
            -- compressor on the mic volume (same maths as piano_compressor.py): loud notes down, soft notes and fading tails up, no lift for hiss
            do
                local THR, RATIO, LIFT_BELOW, LIFT_RATIO, MAXB, FLOOR, MAKEUP = -18, 3, -26, 3, 18, -52, 3
                local env, gdb = 1e-5, 0
                game:GetService("RunService").Heartbeat:Connect(function(dt)
                    if not Mic.auto then env, gdb = 1e-5, 0 return end
                    local m = Mic.find()
                    local an = m and Mic.meter()
                    if not an then return end
                    dt = math.min(dt, 0.05)
                    local raw = an.PeakLevel / math.max(m.Volume, 0.05)   -- level before our own gain, so it can't feed back on itself
                    local atk, rel = math.exp(-dt / 0.008), math.exp(-dt / 0.35)
                    env = raw + (env - raw) * (raw > env and atk or rel)
                    local ldb = 20 * math.log10(math.max(env, 1e-6))
                    local tgt = 0
                    if ldb > THR then
                        tgt = -(ldb - THR) * (1 - 1 / RATIO)
                    elseif ldb < LIFT_BELOW and ldb > FLOOR then
                        tgt = math.min((LIFT_BELOW - ldb) * (1 - 1 / LIFT_RATIO), MAXB) * math.min(1, (ldb - FLOOR) / 6)
                    end
                    gdb = tgt + (gdb - tgt) * (tgt < gdb and atk or rel)
                    Mic.gain = math.clamp(10 ^ ((gdb + MAKEUP) / 20), 0.1, 8)
                    pcall(function() m.Volume = Mic.gain end)
                end)
            end
