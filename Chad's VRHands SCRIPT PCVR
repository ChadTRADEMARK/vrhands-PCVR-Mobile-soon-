                    end
                    return best
                end
                local function addShot(t0, t1, sh) sh.t0, sh.t1 = t0, t1 c.shots[#c.shots + 1] = sh c.shotCuts[#c.shotCuts + 1] = t0 end
                if okT(6.0, 10.0) then
                    local ob = pick("chunk", true) or pick("chunk")
                    if ob then used[ob] = true ob.ts, ob.dur = 6.6, 5.4 addShot(6.0, 10.0, { ob = ob, mode = "rip" }) end
