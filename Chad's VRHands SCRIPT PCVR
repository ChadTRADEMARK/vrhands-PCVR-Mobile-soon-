            -- ===== CATALOG window: browse the Roblox catalog, try things on, buy them (Roblox's own purchase prompt) and save your avatar =====
            local function openCatalog()
                local p, ent = overlay("catalog", 60, 14, 430, 570, "Catalog", "Avatar catalog")
                if not p then return end
                local HttpS = game:GetService("HttpService")
                local MP = game:GetService("MarketplaceService")
                local PlrS = game:GetService("Players")
                local gl = (getgenv and getgenv()) or _G
                local reqf = gl.request or gl.http_request or (gl.syn and gl.syn.request) or (gl.http and gl.http.request)
                local GREENc = Color3.fromRGB(40, 170, 105)
                local function getJson(url)
                    local body
                    if reqf then
                        local ok, r = pcall(reqf, { Url = url, Method = "GET", Headers = { Accept = "application/json" } })
                        if ok and type(r) == "table" and (r.Success or r.StatusCode == 200) then body = r.Body end
                    end
                    if not body then
                        local ok, res = pcall(function() return hget(url, true) end)
                        if ok and type(res) == "string" and #res > 0 then body = res end
                    end
                    if not body then return nil end
                    local ok, d = pcall(HttpS.JSONDecode, HttpS, body)
                    return ok and type(d) == "table" and d or nil
                end
                -- asset type number -> the HumanoidDescription field that holds it
                local PROP = { [8] = "HatAccessory", [41] = "HairAccessory", [42] = "FaceAccessory", [43] = "NeckAccessory", [44] = "ShoulderAccessory",
                               [45] = "FrontAccessory", [46] = "BackAccessory", [47] = "WaistAccessory", [11] = "Shirt", [12] = "Pants", [2] = "GraphicTShirt", [18] = "Face" }
                local TYPES = { { "All" }, { "Hats", 8 }, { "Hair", 41 }, { "Face", 42 }, { "Neck", 43 }, { "Shoulder", 44 }, { "Front", 45 }, { "Back", 46 },
                                { "Waist", 47 }, { "Shirts", 11, 2 }, { "Pants", 12 }, { "Faces", 18 }, { "Bundles", "Bundle" } }
                local results, tab, sel = {}, 1, nil
                local tried = {}
                local invOnly, invCache, wearB, invB = false, nil, nil, nil
                -- YOUR items only: Roblox asks you once for permission to read your inventory, then lists what you own
                local invWhy = ""
                local NAME2NUM = { Hat = 8, HairAccessory = 41, FaceAccessory = 42, NeckAccessory = 43, ShoulderAccessory = 44, FrontAccessory = 45,
                                   BackAccessory = 46, WaistAccessory = 47, TShirt = 2, Shirt = 11, Pants = 12, Face = 18 }
                local function loadInventory()
                    if invCache then return invCache end
                    local out = {}
                    local why = {}
                    -- 1) Roblox's own in-game inventory service (asks you for permission once)
                    local AES
                    pcall(function() AES = game:GetService("AvatarEditorService") end)
                    if AES then
                        local allowed = false
                        local okA, errA = pcall(function()
                            AES:PromptAllowInventoryReadAccess()
                            local res = AES.PromptAllowInventoryReadAccessCompleted:Wait()
                            allowed = res == Enum.AvatarPromptResult.Success
                            if not allowed then why[#why + 1] = "permission: " .. tostring(res.Name or res) end
                        end)
                        if not okA then why[#why + 1] = "permission window: " .. tostring(errA):sub(1, 60) end
                        if allowed then
                            local types = {}
                            for n in pairs(NAME2NUM) do
                                local ok, e = pcall(function() return Enum.AvatarAssetType[n] end)
                                if ok and e then types[#types + 1] = e end
                            end
                            local okI, errI = pcall(function()
                                local pages = AES:GetInventory(types)
                                for _ = 1, 12 do
                                    for _, e in ipairs(pages:GetCurrentPage()) do
                                        local at = e.AssetType
                                        out[#out + 1] = { id = e.AssetId or e.Id, itemType = "Asset", assetType = at and tonumber(at.Value or at) or nil, name = tostring(e.Name or "?"), owned = true }
                                    end
                                    if pages.IsFinished then break end
                                    pages:AdvanceToNextPageAsync()
                                end
                            end)
                            if not okI then why[#why + 1] = "inventory: " .. tostring(errI):sub(1, 60) end
                        end
                    else
                        why[#why + 1] = "no AvatarEditorService"
                    end
                    -- 2) fallback: Roblox's website inventory (works when your inventory is public)
                    if #out == 0 then
                        local names = {}
                        for n in pairs(NAME2NUM) do names[#names + 1] = n end
                        local cursor, got = "", 0
                        for _ = 1, 10 do
                            local url = "https://inventory.roblox.com/v2/users/" .. lp.UserId .. "/inventory?assetTypes=" .. table.concat(names, ",") .. "&limit=100&sortOrder=Desc"
                                .. (cursor ~= "" and ("&cursor=" .. cursor) or "")
                            local d = getJson(url)
                            if not (d and type(d.data) == "table") then
                                why[#why + 1] = got == 0 and "website inventory unreachable or private" or nil
                                break
                            end
                            for _, e in ipairs(d.data) do
                                local at = e.assetType
                                local num = tonumber(at) or NAME2NUM[tostring(at)]
                                out[#out + 1] = { id = tonumber(e.assetId), itemType = "Asset", assetType = num, name = tostring(e.assetName or e.name or "?"), owned = true }
                                got += 1
                            end
                            if not d.nextPageCursor then break end
                            cursor = d.nextPageCursor
                        end
                    end
                    invWhy = table.concat(why, "; ")
                    if #out > 0 then invCache = out end
                    return out
                end
                lbl(p, "", 22, 50, 10, 10, 10, MUTED)
                local box = Instance.new("TextBox")
                box.Position = UDim2.fromOffset(22, 48)
                box.Size = UDim2.fromOffset(290, 30)
                box.BackgroundColor3 = Color3.new(1, 1, 1)
                box.BackgroundTransparency = 0.9
                box.BorderSizePixel = 0
                box.ClearTextOnFocus = false
                box.PlaceholderText = "Search the catalog (hat, hair, shirt...)"
                box.Text = ""
                box.Font = Enum.Font.GothamMedium
                box.TextSize = 12
                box.TextColor3 = WHITE
                box.PlaceholderColor3 = MUTED
                box.ZIndex = 5
                box.Parent = p
                corner(box, 10)
                local function pill(parent, x, y, w, h, text, fn)
                    local b = Instance.new("TextButton")
                    b.Position = UDim2.fromOffset(x, y)
                    b.Size = UDim2.fromOffset(w, h)
                    b.AutoButtonColor = false
                    b.BackgroundColor3 = Color3.new(1, 1, 1)
                    b.BackgroundTransparency = 0.88
                    b.BorderSizePixel = 0
                    b.Text = text
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = 10
                    b.TextColor3 = WHITE
                    b.ZIndex = 5
                    b.Parent = parent
                    corner(b, 10)
                    b.Activated:Connect(fn)
                    return b
                end
                local status = lbl(p, "Searching...", 22, 118, 270, 14, 10, MUTED, Enum.Font.GothamMedium)
                local list = Instance.new("ScrollingFrame")
                list.Position = UDim2.fromOffset(22, 138)
                list.Size = UDim2.fromOffset(386, 270)
                list.BackgroundTransparency = 1
                list.BorderSizePixel = 0
                list.ScrollBarThickness = 4
                list.CanvasSize = UDim2.fromOffset(0, 0)
                list.Parent = p
                local detail = lbl(p, "Pick something from the list.", 22, 416, 386, 32, 11, WHITE, Enum.Font.GothamBold)
                detail.TextWrapped = true
                detail.TextYAlignment = Enum.TextYAlignment.Top

                local function thumb(it)
                    return "rbxthumb://type=" .. (it.itemType == "Bundle" and "BundleThumbnail" or "Asset") .. "&id=" .. it.id .. "&w=150&h=150"
                end
                local function priceText(it)
                    if it.owned then return "Owned" end
                    if it.priceStatus == "Free" or it.price == 0 then return "Free" end
                    if it.price then return tostring(it.price) .. " R$" end
                    return it.priceStatus or "Not for sale"
                end
                local build
                local function select_(it)
                    sel = it
                    detail.Text = it.name .. "   -   " .. priceText(it) .. (it.creator and ("   -   by " .. it.creator) or "")
                    build()
                end
                local function matches(it)
                    local T = TYPES[tab]
                    if #T == 1 then return true end
                    if T[2] == "Bundle" then return it.itemType == "Bundle" end
                    if it.itemType == "Bundle" then return false end
                    for i = 2, #T do if it.assetType == T[i] then return true end end
                    return false
                end
                build = function()
                    for _, c in ipairs(list:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
                    local y, n = 0, 0
                    for _, it in ipairs(results) do
                        if matches(it) then
                            n += 1
                            local f = Instance.new("Frame")
                            f.Position = UDim2.fromOffset(0, y)
                            f.Size = UDim2.fromOffset(370, 56)
                            f.BackgroundColor3 = (sel and sel.id == it.id) and GREENc or Color3.new(1, 1, 1)
                            f.BackgroundTransparency = (sel and sel.id == it.id) and 0.6 or 0.92
                            f.BorderSizePixel = 0
                            f.Parent = list
                            f:SetAttribute("tc", (sel and sel.id == it.id) and true or nil)
                            corner(f, 10)
                            local img = Instance.new("ImageLabel")
                            img.Position = UDim2.fromOffset(6, 4)
                            img.Size = UDim2.fromOffset(48, 48)
                            img.BackgroundTransparency = 1
                            img.Image = thumb(it)
                            img.ZIndex = 3
                            img.Parent = f
                            corner(img, 8)
                            local nm = lbl(f, it.name, 62, 8, 230, 18, 12, WHITE, Enum.Font.GothamBold)
                            nm.TextTruncate = Enum.TextTruncate.AtEnd
                            lbl(f, priceText(it) .. (it.itemType == "Bundle" and "   (bundle)" or ""), 62, 30, 230, 16, 10, MUTED, Enum.Font.GothamMedium)
                            local hit = Instance.new("TextButton")
                            hit.Text = ""
                            hit.BackgroundTransparency = 1
                            hit.Size = UDim2.fromScale(1, 1)
                            hit.ZIndex = 5
                            hit.Parent = f
                            hit.Activated:Connect(function() select_(it) end)
                            y += 62
                        end
                    end
                    list.CanvasSize = UDim2.fromOffset(0, y + 4)
                    if n == 0 then status.Text = "Nothing here. Try another word or tab." end
                    Theme.recolor(p)
                end
                local busy = false
                local function search()
                    if busy then return end
                    busy = true
                    status.Text = invOnly and "Reading your inventory..." or "Searching..."
                    task.spawn(function()
                        if invOnly then
                            local inv = loadInventory()
                            local ql = string.lower(box.Text)
                            local mine = {}
                            for _, e in ipairs(inv) do
                                if ql == "" or string.find(string.lower(e.name), ql, 1, true) then mine[#mine + 1] = e end
                            end
                            results = mine
                            status.Text = #mine > 0 and (#mine .. " of your items. Pick one, then CHANGE INTO IT.")
                                or (#inv == 0 and ("Could not read your inventory (" .. (invWhy ~= "" and invWhy or "empty") .. ").") or "No matching items in your inventory.")
                            busy = false
                            if p.Parent then build() end
                            return
                        end
                        local q = box.Text
                        local url = "https://catalog.roblox.com/v1/search/items/details?Keyword=" .. HttpS:UrlEncode(q) .. "&Limit=120&SortType=0"
                        local d = getJson(url)
                        local out = {}
                        if d and type(d.data) == "table" then
                            for _, e in ipairs(d.data) do
                                if tonumber(e.id) then
                                    out[#out + 1] = { id = tonumber(e.id), itemType = e.itemType or "Asset", assetType = tonumber(e.assetType), name = tostring(e.name or "?"),
                                                      price = tonumber(e.price) or tonumber(e.lowestPrice), priceStatus = e.priceStatus, creator = e.creatorName }
                                end
                            end
                        end
                        if #out == 0 then   -- fallback: Roblox's own in-game catalog service
                            pcall(function()
                                local AES = game:GetService("AvatarEditorService")
                                local sp = CatalogSearchParams.new()
                                sp.SearchKeyword = q
                                sp.SortType = Enum.CatalogSortType.Relevance
                                local pg = AES:SearchCatalog(sp)
                                local items = pg:GetCurrentPage()
                                local ids = {}
                                for _, it in ipairs(items) do if it.ItemType == Enum.AvatarItemType.Asset or it.ItemType == "Asset" then ids[#ids + 1] = it.Id end end
                                local det = AES:GetBatchItemDetails(ids, Enum.AvatarItemType.Asset)
                                for _, e in ipairs(det) do
                                    out[#out + 1] = { id = e.Id, itemType = "Asset", assetType = e.AssetType and tonumber(e.AssetType.Value or e.AssetType) or nil, name = e.Name, price = e.Price, creator = e.CreatorName }
                                end
                            end)
                        end
                        results = out
                        status.Text = #out > 0 and (#out .. " items. Pick one, then TRY ON, BUY or WEAR.") or "Could not load the catalog (no connection to Roblox from here)."
                        busy = false
                        if p.Parent then build() end
                    end)
                end
                pill(p, 318, 48, 90, 30, "SEARCH", search)
                box.FocusLost:Connect(function(enter) if enter then search() end end)

                -- type tabs
                local tabs = Instance.new("ScrollingFrame")
                tabs.Position = UDim2.fromOffset(22, 84)
                tabs.Size = UDim2.fromOffset(386, 30)
                tabs.BackgroundTransparency = 1
                tabs.BorderSizePixel = 0
                tabs.ScrollBarThickness = 0
                tabs.CanvasSize = UDim2.fromOffset(#TYPES * 66, 0)
                tabs.ScrollingDirection = Enum.ScrollingDirection.X
                tabs.Parent = p
                local tabB = {}
                local function paintTabs()
                    for i, b in ipairs(tabB) do b.BackgroundTransparency = (i == tab) and 0.55 or 0.9 end
                end
                for i, T in ipairs(TYPES) do
                    tabB[i] = pill(tabs, (i - 1) * 66, 0, 62, 26, T[1], function() tab = i paintTabs() build() end)
                end
                paintTabs()

                -- actions
                local function tryOn()
                    if not sel then return end
                    if sel.itemType == "Bundle" then status.Text = "Bundles can't be tried on here - use BUY or WEAR." return end
                    status.Text = "Loading it onto your avatar (only you see this)..."
                    task.spawn(function()
                        local obj
                        pcall(function() obj = game:GetObjects("rbxassetid://" .. sel.id)[1] end)
                        if not obj then pcall(function() obj = game:GetService("InsertService"):LoadAsset(sel.id):GetChildren()[1] end) end
                        local ch = lp.Character
                        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                        if not (obj and hum) then status.Text = "Could not load that item for a preview." return end
                        if obj:IsA("Accessory") then
                            hum:AddAccessory(obj)
                        elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
                            local old = ch:FindFirstChildOfClass(obj.ClassName)
                            if old then old:Destroy() end
                            obj.Parent = ch
                        else
                            obj:Destroy()
                            status.Text = "That type can't be previewed - use WEAR."
                            return
                        end
                        tried[#tried + 1] = obj
                        status.Text = "Tried on: " .. sel.name .. " (only you see it)."
                    end)
                end
                local function undo()
                    for _, o in ipairs(tried) do pcall(function() o:Destroy() end) end
                    tried = {}
                    status.Text = "Preview removed."
                end
                local function buy()
                    if not sel then return end
                    local ok, err = pcall(function()
                        if sel.itemType == "Bundle" then MP:PromptBundlePurchase(lp, sel.id) else MP:PromptPurchase(lp, sel.id) end
                    end)
                    status.Text = ok and "Roblox's purchase window opened - confirm there." or ("Could not open the purchase window: " .. tostring(err):sub(1, 70))
                end
                pcall(function()
                    MP.PromptPurchaseFinished:Connect(function(plr, id, bought)
                        if plr == lp and p.Parent then status.Text = bought and "Bought! Now press WEAR to put it on your avatar." or "Purchase cancelled." end
                    end)
                end)
                local function wear()
                    if not sel then return end
                    if sel.itemType == "Bundle" or not PROP[sel.assetType or -1] then status.Text = "That kind of item can't be added here - use the Roblox avatar editor." return end
                    status.Text = "Building your outfit..."
                    task.spawn(function()
                        local ok, desc = pcall(function() return PlrS:GetHumanoidDescriptionFromUserId(lp.UserId) end)
                        if not ok or not desc then status.Text = "Could not read your current avatar." return end
                        local prop = PROP[sel.assetType]
                        if prop == "Shirt" or prop == "Pants" or prop == "GraphicTShirt" or prop == "Face" then
                            desc[prop] = sel.id
                        else
                            local cur = desc[prop]
                            desc[prop] = (cur and cur ~= "") and (cur .. "," .. sel.id) or tostring(sel.id)
                        end
                        local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                        local AES = game:GetService("AvatarEditorService")
                        local conn, done = nil, false
                        conn = AES.PromptSaveAvatarCompleted:Connect(function(result)
                            done = true
                            conn:Disconnect()
                            if result == Enum.AvatarPromptResult.Success then
                                status.Text = "Saved to your Roblox avatar. Rebuilding your VR rig..."
                                if S.rigReset then pcall(S.rigReset, false) end
                            else
                                status.Text = "Not saved (" .. tostring(result.Name or result) .. "). You may need to own the item first - press BUY."
                            end
                        end)
                        local ok2, err2 = pcall(function() AES:PromptSaveAvatar(desc, hum and hum.RigType or Enum.HumanoidRigType.R15) end)
                        if not ok2 then
                            if conn then conn:Disconnect() end
                            status.Text = "Could not open the save window: " .. tostring(err2):sub(1, 70)
                        else
                            status.Text = "Confirm in Roblox's window to save this to your avatar."
                        end
                    end)
                end
                pill(p, 22, 456, 90, 32, "TRY ON", tryOn)
                pill(p, 118, 456, 90, 32, "UNDO", undo)
                pill(p, 214, 456, 90, 32, "BUY", buy)
                wearB = pill(p, 310, 456, 98, 32, "WEAR (SAVE)", wear)
                invB = pill(p, 298, 112, 110, 22, "MY INVENTORY: OFF", function()
                    invOnly = not invOnly
                    sel = nil
                    detail.Text = "Pick something from the list."
                    invB.Text = invOnly and "MY INVENTORY: ON" or "MY INVENTORY: OFF"
                    invB.BackgroundColor3 = invOnly and GREENc or Color3.new(1, 1, 1)
                    invB.BackgroundTransparency = invOnly and 0.35 or 0.88
                    invB:SetAttribute("tc", invOnly and true or nil)
                    wearB.Text = invOnly and "CHANGE INTO IT" or "WEAR (SAVE)"
                    results = {}
                    build()
                    search()
                end)
                invB.TextSize = 9
                local note = lbl(p, "TRY ON is only on your screen. BUY and WEAR use Roblox's own prompts - the script never sees your login.", 22, 498, 386, 40, 10, MUTED, Enum.Font.GothamMedium)
                note.TextWrapped = true
                note.TextYAlignment = Enum.TextYAlignment.Top
                Theme.recolor(p)
                search()
            end
            S.ovl.catalog = openCatalog

            -- ===== COUNTDOWN window: every holiday look, with a live clock to when it turns on =====
            local function openCountdown()
                local p, ent = overlay("countdown", 70, 24, 400, 420, "Countdown", "Season countdown")
                if not p then return end
