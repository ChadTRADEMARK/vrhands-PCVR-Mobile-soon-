            local tg = S.pop.tag
            local known, tags = {}, {}
            local function colorOf(ci, now)
                local c = S.TAG_COLORS[ci] or S.TAG_COLORS[1]
                if c[1] == "RAINBOW" then return Color3.fromHSV((now * 0.12) % 1, 0.65, 1) end
                return Color3.fromRGB(c[2], c[3], c[4])
