                    joining = true
                    if popMsg then popMsg.Text = "Joining " .. label .. "..." end
                    if sameGame then
                        local payload = queuePayload()
                        if EXEC.queue and payload then pcall(EXEC.queue, payload)
                        elseif popMsg then popMsg.Text = "Joining " .. label .. " (this executor can't carry the script across)..." end
                    end
                    local ok, err = pcall(function()
                        if jobId then TeleportService:TeleportToPlaceInstance(placeId, jobId, lp)
                        else TeleportService:Teleport(placeId, lp) end
                    end)
                    if not ok then
                        joining = false
                        if popMsg then popMsg.Text = "Join failed: " .. string.sub(tostring(err), 1, 60) end
                    end
                    task.delay(20, function() joining = false end)
                end
