local SHIM = [=[
-- Executor compatibility layer: finds whichever version of each function this
-- executor provides, and falls back gracefully when something is missing.
local env = (getgenv and getgenv()) or _G
local function pick(...)
    for _, n in ipairs({...}) do
        local f = env[n]
        if type(f) == "function" then return f end
    end
    return nil
end

local C = {}
C.loadstring = loadstring or load
C.getrawmetatable = pick("getrawmetatable", "get_raw_metatable") or (debug and debug.getmetatable)

local mw = pick("make_writeable", "makewriteable", "make_writable")
local mr = pick("make_readonly", "makereadonly")
C.setreadonly = pick("setreadonly", "set_readonly") or function(t, ro)
    if ro then
        if mr then pcall(mr, t) end
    else
        if mw then pcall(mw, t) end
    end
end

C.newcclosure = pick("newcclosure", "new_cclosure") or function(f) return f end
C.getnamecallmethod = pick("getnamecallmethod", "get_namecall_method") or (debug and debug.getnamecallmethod)
C.hookmetamethod = pick("hookmetamethod", "hook_metamethod")
C.getgc = pick("getgc", "get_gc_objects")
C.queue = pick("queue_on_teleport", "queueonteleport")
    or (syn and syn.queue_on_teleport)
    or (fluxus and fluxus.queue_on_teleport)
return C
]=]

