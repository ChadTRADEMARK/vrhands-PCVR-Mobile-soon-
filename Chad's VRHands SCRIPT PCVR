        -- soft shadow / glow: stacked rounded frames fade out from the edge (no image needed)
        local function softBox(parent, x, y, w, h, color, spread, layers, layerT, radius)
            local box = Instance.new("Frame")
            box.BackgroundTransparency = 1
            box.Position = UDim2.fromOffset(x, y)
            box.Size = UDim2.fromOffset(w, h)
            box.ZIndex = 1
            box.Active = false
            box.Parent = parent
            local N = math.min(34, math.max(layers, math.ceil(spread / 1.1)))
            local A = 1 - layerT ^ layers   -- total strength stays what it was
            for i = 1, N do
                local e = spread * (i / N)
                local a = math.min(2 * A / N * (1 - (i - 1) / N), 0.5)   -- eased falloff: dense at the edge, melts away outward
                local f = Instance.new("Frame")
                f.AnchorPoint = Vector2.new(0.5, 0.5)
                f.Position = UDim2.fromScale(0.5, 0.5)
                f.Size = UDim2.new(1, e * 2, 1, e * 2)
                f.BackgroundColor3 = color
                f.BackgroundTransparency = 1
                f.BorderSizePixel = 0
                f.ZIndex = 1
                f.Active = false
                f:SetAttribute("T", 1 - a)
                f.Parent = box
                corner(f, radius + e)
            end
            return box
        end
        local function softFade(box, on, t, style)
            for _, f in ipairs(box:GetChildren()) do
                if f:IsA("Frame") then
                    tw(f, t, { BackgroundTransparency = on and f:GetAttribute("T") or 1 }, style or Enum.EasingStyle.Sine)
                end
            end
        end
