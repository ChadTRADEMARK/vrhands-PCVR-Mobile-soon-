                end
                local function show(tr, t, style)
                    if not ensure() then return end
                    tw(fx, t, { BackgroundTransparency = tr }, style or Enum.EasingStyle.Quad)
                end
                local function isP(io) return io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch end
                b.MouseEnter:Connect(function() hover = true; if not down then show(0.93, 0.15) end end)
                b.MouseLeave:Connect(function() hover = false; if not down then show(1, 0.2) end end)
                b.InputBegan:Connect(function(io)
                    if not isP(io) then return end
                    down = true
                    show(0.8, 0.07)
