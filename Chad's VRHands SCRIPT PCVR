            end
            task.spawn(function()   -- keeps your level applied, and does the auto-level when it is on
                while true do
                    task.wait(0.1)
                    if Mic.auto or Mic.touched then
                        local m = Mic.find()
                        if m then
                            if math.abs(m.Volume - Mic.gain) > 0.01 then pcall(function() m.Volume = Mic.gain end) end
                        end
                    end
                end
            end)
            -- compressor on the mic volume (same maths as piano_compressor.py): loud notes down, soft notes and fading tails up, no lift for hiss
            do
                local THR, RATIO, LIFT_BELOW, LIFT_RATIO, MAXB, FLOOR, MAKEUP = -18, 3, -26, 3, 18, -52, 3
                local env, gdb = 1e-5, 0
                game:GetService("RunService").Heartbeat:Connect(function(dt)
                    if not Mic.auto then env, gdb = 1e-5, 0 return end
                    local m = Mic.find()
                    local an = m and Mic.meter()
                    if not an then return end
                    dt = math.min(dt, 0.05)
                    local raw = an.PeakLevel / math.max(m.Volume, 0.05)   -- level before our own gain, so it can't feed back on itself
                    local atk, rel = math.exp(-dt / 0.008), math.exp(-dt / 0.35)
                    env = raw + (env - raw) * (raw > env and atk or rel)
                    local ldb = 20 * math.log10(math.max(env, 1e-6))
                    local tgt = 0
                    if ldb > THR then
                        tgt = -(ldb - THR) * (1 - 1 / RATIO)
                    elseif ldb < LIFT_BELOW and ldb > FLOOR then
                        tgt = math.min((LIFT_BELOW - ldb) * (1 - 1 / LIFT_RATIO), MAXB) * math.min(1, (ldb - FLOOR) / 6)
                    end
                    gdb = tgt + (gdb - tgt) * (tgt < gdb and atk or rel)
                    Mic.gain = math.clamp(10 ^ ((gdb + MAKEUP) / 20), 0.1, 8)
                    pcall(function() m.Volume = Mic.gain end)
                end)
            end
