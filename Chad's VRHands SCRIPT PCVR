            Chat.badgeOf = setmetatable({}, { __mode = "k" })
            function Chat.badgeTag(d)
                local txt = string.gsub(string.gsub(d.Text, VERIFIED, ""), "^%s*(.-)%s*$", "%1")
                local b = Chat.badgeOf[d]
                if b and not b.Parent then b = nil; Chat.badgeOf[d] = nil end
                if not Chat.badgeNames[txt] then
                    if b then b:Destroy(); Chat.badgeOf[d] = nil end
                    return
                end
                -- the badge lives on the top-level gui (not inside the name label), so the game's own layout (voice icon, list layouts) is never disturbed
                local root = d:FindFirstAncestorWhichIsA("LayerCollector")
                if not root then return end
                if not b then
                    b = makeBadge(root)
                    Chat.badgeOf[d] = b
                    for _, prop in ipairs({ "AbsoluteSize", "AbsolutePosition", "TextBounds", "Visible" }) do
                        d:GetPropertyChangedSignal(prop):Connect(function() pcall(Chat.badgeTag, d) end)
                    end
                    d.Destroying:Connect(function() if b then b:Destroy() end end)
                    d.AncestryChanged:Connect(function() pcall(Chat.badgeTag, d) end)
                end
                local w, h = d.AbsoluteSize.X, d.AbsoluteSize.Y
                local tb = d.TextBounds
                local shown = d.Visible and w >= 1 and h >= 1 and tb.X >= 1 and d:IsDescendantOf(root)
                local p = d.Parent
                while shown and p and p ~= root do
                    if p:IsA("GuiObject") and not p.Visible then shown = false end
                    p = p.Parent
                end
                b.Visible = shown
                if not shown then return end
                local sz = math.max(8, math.min(tb.Y * 0.8, h))
                local x
                if d.TextXAlignment == Enum.TextXAlignment.Center then x = (w + tb.X) / 2 + 4
                elseif d.TextXAlignment == Enum.TextXAlignment.Right then x = w + 4
                else x = tb.X + 4 end
                local ox = d.AbsolutePosition.X - root.AbsolutePosition.X
                local oy = d.AbsolutePosition.Y - root.AbsolutePosition.Y
                b.Size = UDim2.fromOffset(sz, sz)
                b.AnchorPoint = Vector2.new(0, 0.5)
                b.Position = UDim2.fromOffset(ox + x, oy + h / 2)
                if not b:IsA("ImageLabel") then
                    local us = b:FindFirstChildOfClass("UIScale")
                    if not us then us = Instance.new("UIScale") us.Parent = b end
                    us.Scale = sz / 18
                    b.Size = UDim2.fromOffset(18, 18)
