                -- follows the finger / mouse for as long as it is held
                local function track(handle, onBegin, onMove)
                    handle.InputBegan:Connect(function(input)
                        if not isPress(input) then return end
                        local start = screenPos(input)
                        local st = onBegin()
                        local conns = {}
                        local held = true
                        local target, cur = Vector2.zero, Vector2.zero
                        local function stop()
                            for _, c in ipairs(conns) do c:Disconnect() end
                            conns = {}
                        end
                        conns[1] = RunService.RenderStepped:Connect(function(dt)
                            if held then target = screenPos(input) - start end
                            -- ease toward the finger so movement glides
                            cur = cur:Lerp(target, 1 - math.exp(-dt * 18))
                            if not held and (target - cur).Magnitude < 0.4 then
                                onMove(st, target)
                                stop()
                            else
                                onMove(st, cur)
                            end
                        end)
                        conns[2] = UIS.InputEnded:Connect(function(io)
                            if io == input then held = false end
                        end)
                        conns[3] = input.Changed:Connect(function()
                            if input.UserInputState == Enum.UserInputState.End
                               or input.UserInputState == Enum.UserInputState.Cancel then
                                held = false
                            end
                        end)
                    end)
                end

                -- move (offset based, kept on screen)
                track(moveBar, function()
                    return Vector2.new(menu.Position.X.Offset, menu.Position.Y.Offset)
                end, function(st, d)
                    local v = cam.ViewportSize
                    local w, h = menu.AbsoluteSize.X, menu.AbsoluteSize.Y
                    -- the whole menu stays on screen: drag it anywhere, it just stops at the border
                    menu.Position = UDim2.fromOffset(
                        math.clamp(st.X + d.X, 0, math.max(0, v.X - w)),
