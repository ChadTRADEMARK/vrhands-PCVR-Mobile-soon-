                function run(q)
                    q = string.match(q or "", "^%s*(.-)%s*$") or ""
                    hideSug()
                    if q == "" then return end
                    token = token + 1
                    local my = token
                    lastQ = q
                    box.Text = q
                    lastRes = nil
                    do   -- remember it (most recent first, no duplicates)
                        for i = #Cfg.recent, 1, -1 do if string.lower(Cfg.recent[i]) == string.lower(q) then table.remove(Cfg.recent, i) end end
                        table.insert(Cfg.recent, 1, string.sub(q, 1, 60))
                        while #Cfg.recent > 8 do table.remove(Cfg.recent) end
                        saveCfg()
                    end
                    clearPage()
                    status.Text = 'Searching "' .. q .. '"...'
                    task.spawn(function()
                        local res, src, code = search(q)
                        if my ~= token or ent.closed then return end
                        if #res == 0 then
                            status.Text = "No results came back" .. (code and (" (HTTP " .. tostring(code) .. ")") or "") .. ". Google may be blocking this request - try again in a moment."
                            return
                        end
                        status.Text = #res .. ' results for "' .. q .. '" via ' .. src .. ".  Tap a result to copy its link."
                        lastRes, lastSrc = res, src
                        renderResults()
                    end)
                end

                -- suggestions while typing (checked a few times a second, so it never hammers the server)
                task.spawn(function()
                    local shown = ""
                    while p.Parent and not ent.closed do
                        task.wait(0.4)
                        local txt = string.match(box.Text or "", "^%s*(.-)%s*$") or ""
                        if txt ~= shown and txt ~= lastQ then
                            shown = txt
                            if #txt < 2 then
                                hideSug()
                            else
                                local items = suggest(txt)
