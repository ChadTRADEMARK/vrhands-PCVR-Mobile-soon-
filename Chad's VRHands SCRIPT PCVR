            -- ---------- SEARCH panel (Google search without leaving the game) ----------
            -- Results come from Google's plain-HTML results page, and from DuckDuckGo when Google refuses the request (it often
            -- blocks scripts). The suggestions under the box come from Google's public suggest endpoint. No account or key needed.
            -- Tap a result to copy its link (Roblox can't open a web browser from here).
            local function openSearch()
                local p, ent = overlay("search", 24, 10, 740, 440, "Search", "Google Search")
                if not p then return end
                local HttpService = game:GetService("HttpService")
                local req  = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
                local clip = setclipboard or toclipboard

                -- saved settings: result layout + recent searches
                local CFG_FILE = "NoVR_Search.json"
                local LAYOUTS = { "Classic", "Cards", "Compact" }
                local Cfg = _G.NoVR_SearchCfg
                if type(Cfg) ~= "table" then
                    Cfg = { layout = "Classic", recent = {} }
                    local okR, raw = pcall(function() return isfile and isfile(CFG_FILE) and readfile(CFG_FILE) or nil end)
                    if okR and type(raw) == "string" then
                        local okJ, d = pcall(HttpService.JSONDecode, HttpService, raw)
                        if okJ and type(d) == "table" then
                            for _, l in ipairs(LAYOUTS) do if d.layout == l then Cfg.layout = l end end
                            if type(d.recent) == "table" then
                                for _, s in ipairs(d.recent) do
                                    if type(s) == "string" and #s > 0 and #s < 80 and #Cfg.recent < 8 then Cfg.recent[#Cfg.recent + 1] = s end
                                end
                            end
                        end
                    end
                    _G.NoVR_SearchCfg = Cfg
                end
                local function saveCfg()
                    pcall(function() if writefile then writefile(CFG_FILE, HttpService:JSONEncode(Cfg)) end end)
                end

                local function webGet(url, headers)
                    local code
                    if req then
                        local ok, r = pcall(req, { Url = url, Method = "GET", Headers = headers or { Accept = "*/*" } })
                        if ok and type(r) == "table" then
                            code = r.StatusCode
                            if (r.Success or r.StatusCode == 200) and type(r.Body) == "string" and #r.Body > 0 then return r.Body, code end
                        end
                    end
                    local ok, res = pcall(function() return game:HttpGet(url, true) end)
                    if ok and type(res) == "string" and #res > 0 then return res, 200 end
                    return nil, code
                end
                local function urlDecode(s)
                    s = string.gsub(s, "+", " ")
                    return (string.gsub(s, "%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end))
                end
                local function clean(s)
                    s = tostring(s or "")
                    s = string.gsub(s, "<[^>]*>", "")
                    s = string.gsub(s, "&#x(%x+);", function(h) local n = tonumber(h, 16); return (n and n < 128) and string.char(n) or "'" end)
                    s = string.gsub(s, "&#(%d+);", function(d) local n = tonumber(d); return (n and n < 128) and string.char(n) or "'" end)
                    s = string.gsub(s, "&amp;", "&"); s = string.gsub(s, "&quot;", '"'); s = string.gsub(s, "&lt;", "<")
                    s = string.gsub(s, "&gt;", ">"); s = string.gsub(s, "&nbsp;", " "); s = string.gsub(s, "&#39;", "'")
                    s = string.gsub(s, "%s+", " ")
                    return (string.match(s, "^%s*(.-)%s*$"))
                end
                local function hostOf(u) return string.match(u, "^https?://([^/]+)") or u end

                -- Google basic-HTML results: <a href="/url?q=REAL_URL&sa=..."> ... <h3>title</h3> ... snippet
                local function parseGoogle(body)
                    local out, pos = {}, 1
                    while #out < 12 do
                        local s, e, link = string.find(body, '<a href="/url%?q=([^"&]+)[^"]*"', pos)
                        if not s then break end
                        pos = e + 1
                        local nextS = string.find(body, '<a href="/url%?q=', pos) or #body
                        local chunk = string.sub(body, e, math.min(nextS, e + 2500))
                        local url = urlDecode(link)
                        local title = string.match(chunk, "<h3[^>]*>(.-)</h3>")
                        if title and string.match(url, "^https?://") and not string.find(url, "google.com/", 1, true) then
                            local snippet = ""
                            local after = string.match(chunk, "</h3>(.*)") or ""
                            for div in string.gmatch(after, "<div[^>]*>(.-)</div>") do
                                local c = clean(div)
                                if #c > 40 then snippet = c break end
                            end
                            out[#out + 1] = { title = clean(title), url = url, snippet = snippet }
                        end
                    end
                    return out
                end
                -- DuckDuckGo HTML results
                local function parseDDG(body)
                    local out, pos = {}, 1
                    while #out < 12 do
                        local s, e, href, title = string.find(body, 'class="result__a"[^>]-href="([^"]+)"[^>]*>(.-)</a>', pos)
                        if not s then break end
                        pos = e + 1
                        local nextS = string.find(body, 'class="result__a"', pos) or #body
                        local chunk = string.sub(body, pos, nextS)
                        local url = string.match(href, "uddg=([^&]+)")
                        url = url and urlDecode(url) or href
                        if string.sub(url, 1, 2) == "//" then url = "https:" .. url end
                        local snippet = string.match(chunk, 'class="result__snippet"[^>]*>(.-)</a>') or ""
                        if string.match(url, "^https?://") then
                            out[#out + 1] = { title = clean(title), url = url, snippet = clean(snippet) }
                        end
                    end
                    return out
                end

                local function search(q)
                    local enc = HttpService:UrlEncode(q)
                    local ua = { ["User-Agent"] = "Lynx/2.8.9rel.1 libwww-FM/2.14 SSL-MM/1.4.1 OpenSSL/1.1.1", ["Accept-Language"] = "en-US,en;q=0.9" }
                    local body = webGet("https://www.google.com/search?q=" .. enc .. "&hl=en&num=10&gbv=1", ua)
                    if body then
                        local list = parseGoogle(body)
                        if #list > 0 then return list, "Google" end
                    end
                    local body2, code = webGet("https://html.duckduckgo.com/html/?q=" .. enc, ua)
                    if body2 then
                        local list = parseDDG(body2)
                        if #list > 0 then return list, "DuckDuckGo (Google didn't answer)" end
                    end
                    return {}, nil, code
                end
                local function suggest(q)
                    local body = webGet("https://suggestqueries.google.com/complete/search?client=firefox&q=" .. HttpService:UrlEncode(q))
                    if not body then return {} end
                    local ok, d = pcall(HttpService.JSONDecode, HttpService, body)
                    local out = {}
                    if ok and type(d) == "table" and type(d[2]) == "table" then
                        for _, s in ipairs(d[2]) do
                            if type(s) == "string" and #out < 6 then out[#out + 1] = s end
                        end
                    end
                    return out
                end

