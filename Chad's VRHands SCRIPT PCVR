                    if sameGame and EXEC.queue and payload then
                        pcall(EXEC.queue, payload)
                    elseif sameGame and not EXEC.queue then
                        status.Text = "Joining " .. label .. " (this executor can't carry the script across)..."
                    end
                    local ok, err = pcall(function() TeleportService:TeleportToPlaceInstance(placeId, jobId, lp) end)
                    if not ok then
                        joining = false
                        status.Text = "Join failed: " .. tostring(err):sub(1, 60)
                    end
                    task.delay(20, function() joining = false end)
                end
                failConn = TeleportService.TeleportInitFailed:Connect(function(_, result, msg)
                    if ent.closed then failConn:Disconnect() return end
                    joining = false
                    status.Text = "Join failed: " .. tostring(msg ~= "" and msg or result):sub(1, 60)
                end)

