    local function isTyping()
        return UIS:GetFocusedTextBox() ~= nil
    end

    function U.emuStep(dt)
        if S.menuOpen or isTyping() then return end
        local md = UIS:GetMouseDelta()
        if S.handMode then
            local moveL = mouseDown.L or not mouseDown.R
            local moveR = mouseDown.R or not mouseDown.L
            if moveL then
                S.handLX = math.clamp(S.handLX + md.X * S.handSens, -4, 4)
                S.handLY = math.clamp(S.handLY - md.Y * S.handSens, -4, 4)
            end
            if moveR then
                S.handRX = math.clamp(S.handRX + md.X * S.handSens, -4, 4)
                S.handRY = math.clamp(S.handRY - md.Y * S.handSens, -4, 4)
            end
        elseif S.aimMode then
            local moveL = mouseDown.L or not mouseDown.R
            local moveR = mouseDown.R or not mouseDown.L
            local rolling = keys[Enum.KeyCode.Y]
            if moveL then
                if rolling then S.aimLRoll = S.wrapAng(S.aimLRoll - md.X * S.aimSens)
                else S.aimLYaw = S.wrapAng(S.aimLYaw - md.X * S.aimSens) end
                S.aimLPitch = S.wrapAng(S.aimLPitch - md.Y * S.aimSens)
            end
            if moveR then
                if rolling then S.aimRRoll = S.wrapAng(S.aimRRoll - md.X * S.aimSens)
                else S.aimRYaw = S.wrapAng(S.aimRYaw - md.X * S.aimSens) end
                S.aimRPitch = S.wrapAng(S.aimRPitch - md.Y * S.aimSens)
            end
        end
        local kd = 0
        if UIS:IsKeyDown(Enum.KeyCode.KeypadPlus) then kd += 1 end
        if UIS:IsKeyDown(Enum.KeyCode.KeypadMinus) then kd -= 1 end
        if kd ~= 0 then addReach(kd * 3 * dt) end
    end

    local reachHold, reachHoldDir = 0, 0   -- how long Numpad +/- has been held (for acceleration)

    U.bind("NoVR_Control", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if S.look and not isTyping() then
            local md = UIS:GetMouseDelta()
            if S.handMode then
                -- PC: mouse right = hand right, mouse up = hand up.
                -- Hold LMB = left hand only, hold RMB = right hand only,
                -- nothing (or both) held = both hands together.
                local moveL = mouseDown.L or not mouseDown.R
                local moveR = mouseDown.R or not mouseDown.L
                if moveL then
                    S.handLX = math.clamp(S.handLX + md.X * S.handSens, -4, 4)
                    S.handLY = math.clamp(S.handLY - md.Y * S.handSens, -4, 4)
                end
                if moveR then
                    S.handRX = math.clamp(S.handRX + md.X * S.handSens, -4, 4)
                    S.handRY = math.clamp(S.handRY - md.Y * S.handSens, -4, 4)
                end
                -- Mobile: dragging on empty screen still turns the camera,
                -- because the hands are driven by the two joysticks instead.
                S.lookTurn(touch.look.X, touch.look.Y)
            elseif S.aimMode then
                -- PC: mouse right = gun turns right, mouse up = gun tilts up.
                -- Hold LMB = left hand only, hold RMB = right hand only,
                -- nothing (or both) held = both hands together.
                local moveL = mouseDown.L or not mouseDown.R
                local moveR = mouseDown.R or not mouseDown.L
                -- full 360 degrees: no limits, the angle just wraps around. Hold Y to roll the hand instead of turning it.
                local rolling = keys[Enum.KeyCode.Y]
                if moveL then
                    if rolling then S.aimLRoll = S.wrapAng(S.aimLRoll - md.X * S.aimSens)
                    else S.aimLYaw = S.wrapAng(S.aimLYaw - md.X * S.aimSens) end
                    S.aimLPitch = S.wrapAng(S.aimLPitch - md.Y * S.aimSens)
                end
                if moveR then
                    if rolling then S.aimRRoll = S.wrapAng(S.aimRRoll - md.X * S.aimSens)
                    else S.aimRYaw = S.wrapAng(S.aimRYaw - md.X * S.aimSens) end
                    S.aimRPitch = S.wrapAng(S.aimRPitch - md.Y * S.aimSens)
                end
                -- touch drag still turns the camera
                S.lookTurn(touch.look.X, touch.look.Y)
            else
                local d = md + touch.look
                S.lookTurn(d.X, d.Y)
            end
            UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
        elseif isTyping() then
            UIS.MouseBehavior = Enum.MouseBehavior.Default
            UIS.MouseIconEnabled = true
        end

        touch.look = Vector2.zero   -- drag deltas are used up (or ignored) each frame

        -- (Mobile hand joysticks now move the hands directly from their own
        -- drag handlers, so nothing needs to be integrated here.)

        if S.freeHead then
            local r = 0
            if not isTyping() then
                if UIS:IsKeyDown(Enum.KeyCode.KeypadFour) then r = r + 1 end    -- roll left
                if UIS:IsKeyDown(Enum.KeyCode.KeypadSix) then r = r - 1 end     -- roll right
                if UIS:IsKeyDown(Enum.KeyCode.KeypadFive) then               -- level the head (keep where you look)
                    local lv0 = S.freeRot.LookVector
                    if math.abs(lv0.Y) < 0.999 then S.freeRot = CFrame.lookAt(Vector3.zero, lv0) end
                end
            end
            if r ~= 0 then S.freeRot = S.freeRot * CFrame.fromAxisAngle(Vector3.new(0, 0, 1), r * 1.6 * dt) end
            S.freeRot = CFrame.fromMatrix(Vector3.zero, S.freeRot.RightVector, S.freeRot.UpVector)   -- keep it a clean rotation
        end
        local rot
        if S.freeHead then
            rot = S.freeRot
        else
            local goal = S.flip and math.pi or 0
            S.flipAng = S.flipAng + (goal - S.flipAng) * math.min(1, dt * 12)
            if math.abs(goal - S.flipAng) < 0.01 then S.flipAng = goal end
            rot = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
            if S.flipAng ~= 0 then rot = rot * CFrame.fromAxisAngle(Vector3.new(0, 0, 1), S.flipAng) end
        end

        local hs  = cam.HeadScale; if hs <= 1 then hs = S.scale * 60 end
        local spd = (100 + S.scale * 4) * hs * S.moveK

        if keys[Enum.KeyCode.LeftControl] and not isTyping() then
            spd = spd * S.slowFactor
        end

        local mv  = Vector3.zero

        if not isTyping() then
            if keys[Enum.KeyCode.W] then mv += Vector3.new(0,0,-1) end
            if keys[Enum.KeyCode.S] then mv += Vector3.new(0,0, 1) end
            if keys[Enum.KeyCode.A] then mv += Vector3.new(-1,0,0) end
            if keys[Enum.KeyCode.D] then mv += Vector3.new( 1,0,0) end
            if keys[Enum.KeyCode.Space]     then mv += Vector3.new(0, 1,0) end
            if keys[Enum.KeyCode.LeftShift] then mv += Vector3.new(0,-1,0) end
            mv += Vector3.new(touch.move.X, 0, touch.move.Y)   -- mobile joystick
        else
            for k in pairs(keys) do keys[k] = false end
        end

        if S.menuOpen then mv = Vector3.zero end   -- opening menu is up: don't fly around
        -- amt is 1 for keys, and less than 1 for a partly pushed joystick
        if mv.Magnitude > 0 then
            local amt = math.min(mv.Magnitude, 1)
            camPos = camPos + (rot * mv.Unit) * spd * dt * amt
        end

        -- mobile hand reach buttons (same job as the mouse wheel)
        if touch.reachDir ~= 0 then
            addReach(touch.reachDir * 3 * dt)
        end
        -- Numpad + / - : hand reach out / in (hold to keep going)
        if not isTyping() then
            local kd = 0
            if UIS:IsKeyDown(Enum.KeyCode.KeypadPlus)  then kd += 1 end
            if UIS:IsKeyDown(Enum.KeyCode.KeypadMinus) then kd -= 1 end
            if kd ~= 0 then
                if kd ~= reachHoldDir then reachHold = 0 end   -- switched direction: start slow again
                reachHoldDir = kd
                reachHold = reachHold + dt
                -- starts at 3 studs/sec and speeds up the longer you hold
                -- (REACH_ACCEL = how fast it ramps, REACH_MAX = top speed)
                local REACH_ACCEL, REACH_MAX = 1.5, 1000000
                local speed = math.min(3 * math.exp(reachHold * REACH_ACCEL), REACH_MAX)
                addReach(kd * speed * dt)
            else
                reachHold, reachHoldDir = 0, 0
            end
        end
        headCF = CFrame.new(camPos) * rot

        -- Third person zoom: hold I = zoom in, O = zoom out.
        -- (IsKeyDown so the game can't swallow the keys; exponential speed.)
        if not isTyping() then
            local zoomRate = 0.9
            -- Hard limit on how far the camera can go IN STUDS, so the map can
            -- never be pushed out past the draw distance (it vanishes there).
            -- Bigger avatars are allowed proportionally more room.
            local maxMult = math.max(1500 / headUnit(), 3)
            S.tpDist = math.min(S.tpDist, maxMult)
            if UIS:IsKeyDown(Enum.KeyCode.O) or touch.zoomOut then
                S.tpDist = math.clamp(S.tpDist * math.exp(zoomRate * dt), 0.3, maxMult)
            end
            if UIS:IsKeyDown(Enum.KeyCode.I) or touch.zoomIn then
                S.tpDist = math.clamp(S.tpDist * math.exp(-zoomRate * dt), 0.3, maxMult)
            end
        end

        -- How far in front of the camera the head sits (0 in first person).
        local D = 0
        if S.thirdPerson then D = S.tpDist * headUnit() end
        S.curD   = D
        TP.D     = D
        TP.scale = resolveScale()

        cam.CameraType = Enum.CameraType.Scriptable
        -- The game positions your real (replicated) head from the camera, so the
        -- camera stays ON the head while the game runs. It is only pulled back
        -- right before the frame is drawn (see NoVR_CamView below), so other
        -- players never see your head follow the third-person camera.
        camBack = CFrame.new(camPos - rot.LookVector * D) * rot
        if S.camView ~= "Normal" then
            -- zoom (I / O) sets how far the camera sits from whatever it follows
            local dist = math.max(S.tpDist * headUnit(), 0.5)
            local sc = resolveScale()
            local function handPos(side)
                local off
                if side < 0 then off = Vector3.new(-S.spread + S.handLX, S.height + S.handLY, -S.reachL)
                else off = Vector3.new(S.spread + S.handRX, S.height + S.handRY, -S.reachR) end
                return headCF:PointToWorldSpace(off * sc)
            end
            if S.camView == "Front" then
                -- 2nd POV: camera in front of you, looking back at your avatar
                camBack = CFrame.lookAt(camPos + rot.LookVector * dist, camPos)
            else
                -- Hand POV: the camera rides along with the hand(s) (your head stays put).
                -- You still steer with the mouse; reach out far and the view follows your hand out there.
                local target
                if S.camView == "Left Hand" then target = handPos(-1)
                elseif S.camView == "Right Hand" then target = handPos(1)
                else target = (handPos(-1) + handPos(1)) / 2 end
                camBack = CFrame.new(target - rot.LookVector * dist) * rot
            end
        end
        cam.CFrame = headCF

        if Input then
            Input.directionLateral  = Vector2.zero
            Input.directionVertical = 0
            Input.turnDirection     = 0

            for _, pose in pairs(poseData) do
                if pose.locked then pose.apply() end
            end
            S.gestApply()   -- a held custom gesture wins over everything else

            -- J = pull the trigger on every hand that is gripping something
            if trigger.held then
                if Input.lFist == 1 then Input.lIndex = 1 end
                if Input.rFist == 1 then Input.rIndex = 1 end
            end
        end
    end)

    -- camera sits on the head at the start of every frame (what the game reads)...
    U.bind("NoVR_CamHead", Enum.RenderPriority.First.Value, function()
        cam.CFrame = headCF
    end)
    -- ...and is moved back to the third-person view after everything else ran,
    -- so only YOUR screen sees it there.
    -- Sound: the game's voice chat is positional, and it is heard from the camera. Since your head stays where it
    -- is while the camera rides along with a hand (or the front view), the listener is pinned to the VIEW camera
    -- in every non-Normal view, so you hear whoever is near the camera / hand. Normal view = Roblox default.
    local SoundService = game:GetService("SoundService")
    local listenerPinned = false
    -- Newer voice chat setups put their own AudioListener on the character / head, and then SetListener is ignored.
    -- So in a non-Normal view every AudioListener the game made is moved onto an invisible part that rides on the
    -- view camera, and is put back when you return to Normal view.
    local viewPart
    local movedListeners = {}   -- AudioListener -> its original parent
    local lastListenerScan = -100
    local function ensureViewPart()
        if viewPart and viewPart.Parent then return viewPart end
        viewPart = Instance.new("Part")
        viewPart.Name = "NoVR_ListenerPart"
        viewPart.Anchored = true
        viewPart.CanCollide = false
        viewPart.CanQuery = false
        viewPart.CanTouch = false
        viewPart.Transparency = 1
        viewPart.Size = Vector3.new(0.2, 0.2, 0.2)
        viewPart.Parent = workspace
        return viewPart
    end
    local function scanListeners(part)
        local n = 0
        for _, d in ipairs(game:GetDescendants()) do
            if d.ClassName == "AudioListener" and d.Parent ~= part and movedListeners[d] == nil then
                movedListeners[d] = d.Parent
                local ok = pcall(function() d.Parent = part end)
                if ok then n = n + 1 else movedListeners[d] = nil end
            end
        end
        if n > 0 then print("[NoVR] audio: moved " .. n .. " AudioListener(s) onto the view camera") end
    end
    local function releaseListeners()
        for l, par in pairs(movedListeners) do
            pcall(function()
                if l.Parent == viewPart and par and par.Parent then l.Parent = par end
            end)
            movedListeners[l] = nil
        end
    end
    S.zoom = 1
    S.dolly = 0   -- studs the view has flown forward past full zoom
    U.bind("NoVR_CamView", Enum.RenderPriority.Last.Value + 10000, function()
        cam.CFrame = camBack
        do   -- zoom: hold Z to zoom in, X to zoom out. The field of view narrows (down to 1 degree, about 70x)
            local now = os.clock()
            local dt = math.min(now - (S.zoomT or now), 0.1)
            S.zoomT = now
            local zin, zout = keys[Enum.KeyCode.Z], keys[Enum.KeyCode.X]
            if zin ~= zout then
                if not S.zoomBase then S.zoomBase = cam.FieldOfView end
                local zmax = math.max(S.zoomBase, 1)
                local f = math.exp(dt * 1.6)
                if zin then
                    if S.zoom < zmax - 0.01 then S.zoom = math.min(S.zoom * f, zmax)
                    else S.dolly = math.min(math.max(S.dolly, 3) * math.exp(dt * 3), 1e9) end   -- fully zoomed in: the view flies forward, no limit
                elseif S.dolly > 0 then
                    S.dolly = S.dolly / math.exp(dt * 3)
                    if S.dolly < 3 then S.dolly = 0 end
                else
                    S.zoom = math.max(S.zoom / f, 1)
                end
            end
            if S.zoomBase then
                if S.zoom <= 1.001 and S.dolly == 0 then
                    S.zoom = 1
                    cam.FieldOfView = S.zoomBase
                    S.zoomBase = nil
                else
                    cam.FieldOfView = math.max(S.zoomBase / S.zoom, 1)
                end
            end
            if S.dolly > 0 then cam.CFrame = cam.CFrame + cam.CFrame.LookVector * S.dolly end
        end
        if S.camView ~= "Normal" then
            if not listenerPinned then
                listenerPinned = true
                lastListenerScan = -100
                print("[NoVR] audio: listening from the " .. S.camView .. " camera")
            end
            pcall(function() SoundService:SetListener(Enum.ListenerType.CFrame, camBack) end)
            local part = ensureViewPart()
            part.CFrame = camBack
            if os.clock() - lastListenerScan > 3 then
                lastListenerScan = os.clock()
                pcall(scanListeners, part)
            end
        elseif listenerPinned then
            listenerPinned = false
            pcall(releaseListeners)
            pcall(function() SoundService:SetListener(Enum.ListenerType.Camera) end)
        end
    end)

    -- ============ CROSSHAIR (shows where a held gun points) ============
    -- Settings live in XH and are edited from Start Menu > dock > crosshair icon.
    -- A crosshair only shows for a hand that is gripping something (see "detect").
    local XH = {
