                        local best
                        for _, e in ipairs(me.panels) do
                            if e.front and e.p and e.p.Parent and e.p.Visible and not e.closed and not e.noShadow then
                                local ap, as = e.p.AbsolutePosition, e.p.AbsoluteSize
                                if pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
                                    if not best or e.p.ZIndex > best.p.ZIndex then best = e end
                                end
                            end
                        end
                        if best and best.p.ZIndex < (me.zTop or 0) then best.front() end
                    end)
                end
                ent.cw, ent.ch, ent.homeX, ent.homeY, ent.accent = w, h, x, y, accent
                local ssc = Instance.new("UIScale"); ssc.Parent = sh
                local hsc = Instance.new("UIScale"); hsc.Parent = halo
                local function layout()
                    local k = ent.userScale or 1
                    local on = S.ui.shadow ~= false and not ent.noShadow
                    if not ent.noShadow then sh.Visible, halo.Visible = on, on end
                    accent.Visible = S.ui.accent ~= false
                    ssc.Scale, hsc.Scale = k, k
                    sh.Position = UDim2.fromOffset(ent.x, ent.y + 12 * k)
                    sh.Size = UDim2.fromOffset(ent.cw, ent.ch)
                    halo.Position = UDim2.fromOffset(ent.x - 2 * k, ent.y + 3 * k)
                    halo.Size = UDim2.fromOffset(ent.cw + 4, ent.ch + 4)
                    glow.Position = UDim2.fromOffset(ent.x - 6, ent.y - 6)
                    glow.Size = UDim2.fromOffset(ent.cw * k + 12, ent.ch * k + 12)
                end
                ent.layout = layout
                -- keeps the whole panel inside the Roblox window (works out where a target position would land on screen)
                local function clampXY(nx, ny)
                    local v = cam.ViewportSize
                    local kf = math.max(fit.Scale, 0.01)
                    local ap, as = p.AbsolutePosition, p.AbsoluteSize
                    local ax = ap.X + (nx - ent.x) * kf
                    local ay = ap.Y + (ny - ent.y) * kf
                    -- like the Mois7 window: fully on screen, and never under Roblox's top bar
                    -- bounds come from the gui this panel lives in, so the limit is the real screen edge on every side
                    local root = p:FindFirstAncestorWhichIsA("LayerCollector")
                    local rp = root and root.AbsolutePosition or Vector2.new(0, 0)
                    local rs = (root and root.AbsoluteSize.X > 0 and root.AbsoluteSize.Y > 0) and root.AbsoluteSize or v
                    local cx = math.clamp(ax, rp.X, math.max(rp.X, rp.X + rs.X - as.X))
                    local cy = math.clamp(ay, rp.Y, math.max(rp.Y, rp.Y + rs.Y - as.Y))
                    return nx + (cx - ax) / kf, ny + (cy - ay) / kf
                end
                ent.clampXY = clampXY
                layout()
                task.delay(delay, function()
                    if startGui ~= g then return end
                    tw(p, 1.0, { GroupTransparency = 0, Position = UDim2.fromOffset(ent.x, ent.y) }, Enum.EasingStyle.Exponential)
                    tw(ps, 0.9, { Scale = ent.userScale or 1 }, Enum.EasingStyle.Quint)
                end)

                -- ===== drag handle (top strip of every panel) =====
                local function moveTo(nx, ny)
                    ent.x, ent.y = nx, ny
                    p.Position = UDim2.fromOffset(nx, ny)
