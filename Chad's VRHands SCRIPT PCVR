-- Third person works by leaving the CAMERA as the free camera you steer, and
-- telling the game your HEAD (and hands) sit TP.D studs in front of it.
-- Zooming only changes TP.D, so the head never moves when you zoom.
local TP = { D = 0, scale = 1 }
-- Universal mode state (see U.start): fake VR positions and controller buttons for games that are not VR Hands
local U = { active = false, cf = {}, buttons = {}, stick = {}, stat = {} }
-- ---- FAR VIEW: no fog, full-detail meshes and top quality so far-away things stay visible (End key, or the Far View button) ----
-- What a script cannot do: make the server send parts it has not streamed to you, or lift the engine's own far limit.
-- It removes everything else that hides distant things.
do
    local Lighting = game:GetService("Lighting")
    local StarterGui = game:GetService("StarterGui")
    local saved
    local token = 0
    local function note(t) pcall(function() StarterGui:SetCore("SendNotification", { Title = "Far view", Text = t, Duration = 2.5 }) end) end
    local function applyFog()
        pcall(function()
            Lighting.FogEnd = 1e8
            Lighting.FogStart = 1e8
            for _, a in ipairs(Lighting:GetChildren()) do
                if a:IsA("Atmosphere") then
                    if saved and not saved.atmo[a] then saved.atmo[a] = { a.Density, a.Haze } end
                    a.Density = 0; a.Haze = 0
                end
            end
        end)
    end
    function U.setFar(on)
        token += 1
        local my = token
        if on and not U.far then
            U.far = true
            saved = { fogEnd = Lighting.FogEnd, fogStart = Lighting.FogStart, atmo = {}, quality = nil, mesh = nil }
            pcall(function() saved.quality = settings().Rendering.QualityLevel end)
            pcall(function() saved.mesh = settings().Rendering.MeshPartDetailLevel end)
            applyFog()
            pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level21 end)
            pcall(function() settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04 end)
            if sethiddenproperty then   -- may do nothing: the server decides what streams in
                for _, name in ipairs({ "StreamingTargetRadius", "StreamingMinRadius" }) do pcall(sethiddenproperty, workspace, name, 1e6) end
            end
            task.spawn(function()   -- full-detail meshes, a few hundred at a time so the game never stalls
                local okL, list = pcall(function() return workspace:GetDescendants() end)
                if not okL then return end
                local n = 0
                for _, d in ipairs(list) do
                    if my ~= token then return end
                    if d:IsA("MeshPart") and d.RenderFidelity ~= Enum.RenderFidelity.Precise then
                        pcall(function() d.RenderFidelity = Enum.RenderFidelity.Precise end)
                    end
                    n += 1
                    if n % 200 == 0 then task.wait() end
                end
            end)
            task.spawn(function()   -- games that set their own fog again get overruled
                while U.far and my == token do task.wait(1.5); applyFog() end
            end)
            note("ON - fog removed, detail raised.")
        elseif not on and U.far then
            U.far = nil
            pcall(function()
                if saved then
                    Lighting.FogEnd, Lighting.FogStart = saved.fogEnd, saved.fogStart
                    for a, v in pairs(saved.atmo) do if a.Parent then a.Density, a.Haze = v[1], v[2] end end
                    if saved.quality then settings().Rendering.QualityLevel = saved.quality end
                    if saved.mesh then settings().Rendering.MeshPartDetailLevel = saved.mesh end
                end
            end)
            note("OFF")
        end
    end
    UIS.InputBegan:Connect(function(io)
        if io.KeyCode == Enum.KeyCode.End and not UIS:GetFocusedTextBox() then U.setFar(not U.far) end
    end)
end

do
    local function makeIndex(old)
        return C.newcclosure(function(self, k)
            if U.normal then return old(self, k) end   -- Normal Avatar mode: the game sees the real (non-VR) answers
            if k == "VREnabled" and (self == VRService or self == UIS) then
                U.stat.vren = (U.stat.vren or 0) + 1
                -- smooth camera: the game's own PlayerModule (camera + controls) is told VR is off, every other script is told it is on
                if U.active and U.camMode == "smooth" and C.getcallingscript then
                    local okc, cs = pcall(C.getcallingscript)
                    if okc and typeof(cs) == "Instance" and (cs.Name == "PlayerModule" or cs:FindFirstAncestor("PlayerModule")) then return false end
                end
                return true
            end
            if U.active and k == "GamepadEnabled" and self == UIS then return true end
            return old(self, k)
        end)
    end
    local function makeNamecall(old)
        return C.newcclosure(function(self, ...)
            if U.normal then return old(self, ...) end
            if self == VRService then
                local m = C.getnamecallmethod()
                if m == "GetUserCFrameEnabled" then return true end
                if m == "GetUserCFrame" then
                    local which = ...
                    -- third person no longer offsets the head: the game always
                    -- sees the camera sitting exactly on your head
                    if U.active and U.cf[which] then return U.cf[which] end
                    return identity
                end
            end
            if U.active and self == UIS then   -- Universal mode: the standard VR / gamepad questions are answered from keyboard + mouse
                local m = C.getnamecallmethod()
                if m == "GetUserCFrame" then
                    local which = ...
                    U.stat.ucf = (U.stat.ucf or 0) + 1
                    return U.cf[which] or identity
                elseif m == "GetUserCFrameEnabled" or m == "GetGamepadConnected" then
                    U.stat.pad = (U.stat.pad or 0) + 1
                    return true
                elseif m == "GetConnectedGamepads" then
                    return { Enum.UserInputType.Gamepad1 }
                elseif m == "IsGamepadButtonDown" then
                    local _, kc = ...
                    return U.buttons[kc] == true
                elseif m == "GetGamepadState" then
                    local out = {}
                    for kc in pairs(U.buttons) do
                        out[#out + 1] = { UserInputType = Enum.UserInputType.Gamepad1, KeyCode = kc, UserInputState = Enum.UserInputState.Begin, Position = Vector3.new(0, 0, 1), Delta = Vector3.new(0, 0, 0) }
                    end
                    for kc, v in pairs(U.stick) do
                        out[#out + 1] = { UserInputType = Enum.UserInputType.Gamepad1, KeyCode = kc, UserInputState = Enum.UserInputState.Change, Position = v, Delta = Vector3.new(0, 0, 0) }
                    end
                    return out
                end
            end
            return old(self, ...)
        end)
    end

    local hooked = false

    -- method 1: swap the metatable entries directly
    if C.getrawmetatable then
        hooked = pcall(function()
            local mt = C.getrawmetatable(game)
            local oldIndex, oldNamecall = mt.__index, mt.__namecall
            C.setreadonly(mt, false)
            mt.__index = makeIndex(oldIndex)
            if C.getnamecallmethod then mt.__namecall = makeNamecall(oldNamecall) end
            C.setreadonly(mt, true)
        end)
    end

    -- method 2: executors that only offer hookmetamethod
    if not hooked and C.hookmetamethod then
        hooked = pcall(function()
            local oldIndex
            oldIndex = C.hookmetamethod(game, "__index", makeIndex(function(...) return oldIndex(...) end))
            if C.getnamecallmethod then
                local oldNamecall
                oldNamecall = C.hookmetamethod(game, "__namecall", makeNamecall(function(...) return oldNamecall(...) end))
            end
        end)
    end

    if not hooked then warn("[NoVR] could not hook the game metatable - VR spoof may not work") end
end

