    local AXES = {
        Forward = function(cf) return cf.LookVector end,
        Back    = function(cf) return -cf.LookVector end,
        Up      = function(cf) return cf.UpVector end,
        Down    = function(cf) return -cf.UpVector end,
        Right   = function(cf) return cf.RightVector end,
        Left    = function(cf) return -cf.RightVector end,
    }

    task.spawn(function()
        local pg = lp:WaitForChild("PlayerGui")
        local gui = Instance.new("ScreenGui")
        gui.Name = "NoVR_Crosshair"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
        gui.DisplayOrder = 40
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.Parent = pg

        local sides = {}
        local function newSide(name)
            local f = Instance.new("Frame")
            f.Name = name
            f.AnchorPoint = Vector2.new(0.5, 0.5)
            f.Size = UDim2.fromOffset(0, 0)
            f.BackgroundTransparency = 1
            f.Visible = false
            f.Parent = gui
            return { f = f }
        end
        sides.L = newSide("Left")
        sides.R = newSide("Right")

        -- centred rectangle (with optional black outline)
        local function mk(parent, x, y, w, h)
            local b = Instance.new("Frame")
            b.AnchorPoint = Vector2.new(0.5, 0.5)
            b.Position = UDim2.fromOffset(x, y)
            b.Size = UDim2.fromOffset(w, h)
            b.BackgroundColor3 = XH.color
            b.BackgroundTransparency = 1 - XH.opacity
            b.BorderSizePixel = 0
            b.Parent = parent
            if XH.outline then
                local st = Instance.new("UIStroke")
                st.Color = Color3.new(0, 0, 0)
                st.Thickness = 1
                st.Transparency = 1 - XH.opacity
                st.Parent = b
            end
            return b
        end
        local function ring(parent, d, th, color)
            local r = Instance.new("Frame")
            r.AnchorPoint = Vector2.new(0.5, 0.5)
            r.Position = UDim2.fromOffset(0, 0)
            r.Size = UDim2.fromOffset(d, d)
            r.BackgroundTransparency = 1
            r.BorderSizePixel = 0
            r.Parent = parent
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(1, 0)
            c.Parent = r
            local s = Instance.new("UIStroke")
            s.Color = color
            s.Thickness = th
            s.Transparency = 1 - XH.opacity
            s.Parent = r
            return r
        end

        local function rebuild()
            XH.dirty = false
            for _, s in pairs(sides) do
                s.f:ClearAllChildren()
                local t, g, L, st = XH.thickness, XH.gap, XH.size, XH.style
                if st == "Cross" or st == "T" then
                    local off = g + L / 2
                    mk(s.f, -off, 0, L, t)
                    mk(s.f, off, 0, L, t)
                    mk(s.f, 0, off, t, L)
                    if st == "Cross" then mk(s.f, 0, -off, t, L) end
                elseif st == "Circle" then
                    local d = L * 2
                    if XH.outline then ring(s.f, d, t + 2, Color3.new(0, 0, 0)) end
                    ring(s.f, d, t, XH.color)
                end
                if st == "Dot" or XH.dot then
                    mk(s.f, 0, 0, t + 2, t + 2)
                end
            end
        end

        local ovp = OverlapParams.new()
        ovp.FilterType = Enum.RaycastFilterType.Exclude
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        local held = { L = nil, R = nil }
        local lastScan = 0

        local function pivotOf(inst)
            if not inst then return nil end
            if inst:IsA("BasePart") then return inst.CFrame end
            if inst:IsA("Model") then return inst:GetPivot() end
            return nil
        end
        local function gripping(side)
            if Input then
                return (side == "L" and Input.lFist or Input.rFist) == 1
            end
            return mouseDown[side] or anyPoseLocked(side)
        end

        -- nearest loose (unanchored) item to the hand, ignoring characters and rigs
        local function scan(handCF)
            local excl = { rig }
            if cloneFolder then excl[#excl + 1] = cloneFolder end
            if lp.Character then excl[#excl + 1] = lp.Character end
            ovp.FilterDescendantsInstances = excl
            local parts = workspace:GetPartBoundsInRadius(handCF.Position, XH.radius, ovp)
            local best, bd = nil, math.huge
            for _, p in ipairs(parts) do
                if not p.Anchored and not p:IsDescendantOf(vrPlayers) then
                    local m = p:FindFirstAncestorOfClass("Model")
                    if not (m and m:FindFirstChildOfClass("Humanoid")) then
                        local d = (p.Position - handCF.Position).Magnitude
                        if d < bd then best, bd = p, d end
                    end
                end
            end
            return best
        end

        U.bind("NoVR_Crosshair", Enum.RenderPriority.Camera.Value + 2, function()
            if XH.dirty then rebuild() end
            local doScan = os.clock() - lastScan > 0.1
            if doScan then lastScan = os.clock() end
            local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
            local toolSide = gripping("R") and "R" or (gripping("L") and "L" or nil)

            for _, side in ipairs({ "L", "R" }) do
                local s = sides[side]
                local show = false
                if XH.enabled and not S.menuOpen then
                    local hcf = pivotOf(rig:FindFirstChild(side == "L" and "LeftHand" or "RightHand"))
                    if hcf then
                        local cf, part, ok = hcf, nil, false
                        if XH.always then
                            ok = true
                        elseif gripping(side) then
                            if XH.detect == "Held object" then
                                if doScan then
                                    local h = nil
                                    if tool and side == toolSide then h = tool:FindFirstChild("Handle") end
                                    held[side] = h or scan(hcf)
                                end
                                part = held[side]
                                if part and not part.Parent then part, held[side] = nil, nil end
                                if part then cf, ok = part.CFrame, true end
                            else
                                ok = true
                            end
                        else
                            held[side] = nil
                        end

                        if ok then
                            local dir = AXES[XH.axis](cf)
                            local ex = { rig }
                            if cloneFolder then ex[#ex + 1] = cloneFolder end
                            if lp.Character then ex[#ex + 1] = lp.Character end
                            if part then
                                ex[#ex + 1] = part
                                local m = part:FindFirstAncestorOfClass("Model")
                                if m and not m:FindFirstChildOfClass("Humanoid") then ex[#ex + 1] = m end
                            end
                            rp.FilterDescendantsInstances = ex
                            local res = workspace:Raycast(cf.Position, dir * 3000, rp)
                            local pt = res and res.Position or (cf.Position + dir * 3000)
                            local v = cam:WorldToViewportPoint(pt)
                            if v.Z > 0 then
                                s.f.Position = UDim2.fromOffset(v.X, v.Y)
                                show = true
                            end
                        end
                    end
                end
                s.f.Visible = show
            end
        end)
    end)
