                if req and not IS_MOBILE then
                    -- the Discord desktop app listens on one of the ports 6463-6472
                    for port = 6463, 6472 do
                        local ok, res = pcall(req, {
                            Url = "http://127.0.0.1:" .. port .. "/rpc?v=1",
                            Method = "POST",
                            Headers = { ["Content-Type"] = "application/json", ["Origin"] = "https://discord.com" },
                            Body = HttpSvcD:JSONEncode({
                                cmd = "INVITE_BROWSER",
                                args = { code = inviteCode },
                                nonce = HttpSvcD:GenerateGUID(false),
                            }),
                        })
                        if ok and type(res) == "table" and (res.Success or res.StatusCode == 200) then
                            local good = true
