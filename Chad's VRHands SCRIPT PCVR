                    if ob then used[ob] = true ob.ts, ob.dur = 10.3, 6.5 addShot(10.0, 14.4, { ob = ob, mode = ob.tower and "rip" or "follow" }) end
                end
                if okT(14.4, 19.0) then   -- the whole pond lifts off together
                    local cen, nw = Vector3.zero, 0
                    for _, ob in ipairs(c.suckObjs) do if ob.kind == "water" then cen = cen + ob.cf0.Position nw = nw + 1 end end
                    if nw > 0 then
                        cen = cen / nw
                        local rad = 0
                        for _, ob in ipairs(c.suckObjs) do
                            if ob.kind == "water" then
                                ob.ts = 14.8 + rnd:NextNumber() * 1.8
                                ob.dur = math.clamp(7 + rnd:NextNumber() * 3, 3, math.max(tI - 0.8 - ob.ts, 3))
                                rad = math.max(rad, (ob.cf0.Position - cen).Magnitude)
