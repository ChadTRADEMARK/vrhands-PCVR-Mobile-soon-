-- ============ THEME ENGINE (menu colour + size) ============
-- hue : how far the menu colours are rotated away from the default violet (degrees)
-- size: multiplier for the menus (0.6 .. 1.4)
local Theme = { hue = 0, size = 1, listeners = {} }
local BASE_HUE = 0.74   -- hue of the default violet menus

-- shifts the hue of a colour (greys / whites are left alone)
function Theme.tint(c)
    if Theme.hue == 0 then return c end
    local h, s, v = c:ToHSV()
    if s < 0.08 then return c end
    return Color3.fromHSV((h + Theme.hue / 360) % 1, s, v)
end

-- remembers each object's ORIGINAL colour in an attribute, so shifting is
-- always done from the original (no drift, and "reset" is exact)
local function baseOf(inst, prop)
    local key = "nb_" .. prop
    local b = inst:GetAttribute(key)
    if b == nil then
        b = inst[prop]
        inst:SetAttribute(key, b)
    end
    return b
end

local function tintSeq(seq)
    local kp = {}
    for _, k in ipairs(seq.Keypoints) do
        kp[#kp + 1] = ColorSequenceKeypoint.new(k.Time, Theme.tint(k.Value))
    end
    return ColorSequence.new(kp)
end

-- Objects with attribute  tc = true  are never recoloured (status dots,
-- colour swatches ...). Objects with a Color3 "tc" (liquid buttons) manage
-- their own colour through liquidColor.
function Theme.recolor(root)
    if not root then return end
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("GuiObject") then
            if d:GetAttribute("tc") == nil then
                d.BackgroundColor3 = Theme.tint(baseOf(d, "BackgroundColor3"))
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    d.TextColor3 = Theme.tint(baseOf(d, "TextColor3"))
                end
            end
        elseif d:IsA("UIStroke") then
            if d.Parent:GetAttribute("tc") ~= true then
                d.Color = Theme.tint(baseOf(d, "Color"))
            end
        elseif d:IsA("UIGradient") then
            if d.Parent:GetAttribute("tc") ~= true then
                local b = d:GetAttribute("nb_Color")
                if b == nil then b = d.Color; d:SetAttribute("nb_Color", b) end
                d.Color = tintSeq(b)
            end
        end
    end
end

function Theme.set(hue, size)
    if hue ~= nil then Theme.hue = hue end
    if size ~= nil then Theme.size = math.clamp(size, 0.6, 1.4) end
    for _, f in ipairs(Theme.listeners) do pcall(f) end
end
