        function hudApi.announce(a)
            annQueue[#annQueue + 1] = a
            if annBusy then return end
            annBusy = true
            task.spawn(function()
                while #annQueue > 0 do
                    local nx = table.remove(annQueue, 1)
                    local fin = false
