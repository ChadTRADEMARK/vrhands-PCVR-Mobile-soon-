                        local conns = {}
                        local function stop()
                            if #conns == 0 then return end
                            for _, c in ipairs(conns) do c:Disconnect() end
                            conns = {}
                            S.panelSize = S.panelSize or {}
                            S.panelSize[slot] = { math.floor(ent.w), math.floor(ent.h) }
