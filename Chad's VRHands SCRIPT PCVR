        end
        local function ring(parent, d, th, color)
            local r = Instance.new("Frame")
            r.AnchorPoint = Vector2.new(0.5, 0.5)
            r.Position = UDim2.fromOffset(0, 0)
            r.Size = UDim2.fromOffset(d, d)
            r.BackgroundTransparency = 1
            r.BorderSizePixel = 0
            r.Parent = parent
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(1, 0)
            c.Parent = r
            local s = Instance.new("UIStroke")
            s.Color = color
            s.Thickness = th
            s.Transparency = 1 - XH.opacity
            s.Parent = r
            return r
        end

        local function rebuild()
            XH.dirty = false
            for _, s in pairs(sides) do
                s.f:ClearAllChildren()
                local t, g, L, st = XH.thickness, XH.gap, XH.size, XH.style
                if st == "Cross" or st == "T" then
                    local off = g + L / 2
                    mk(s.f, -off, 0, L, t)
                    mk(s.f, off, 0, L, t)
                    mk(s.f, 0, off, t, L)
                    if st == "Cross" then mk(s.f, 0, -off, t, L) end
                elseif st == "Circle" then
                    local d = L * 2
                    if XH.outline then ring(s.f, d, t + 2, Color3.new(0, 0, 0)) end
                    ring(s.f, d, t, XH.color)
                end
                if st == "Dot" or XH.dot then
                    mk(s.f, 0, 0, t + 2, t + 2)
                end
            end
        end

        local ovp = OverlapParams.new()
        ovp.FilterType = Enum.RaycastFilterType.Exclude
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        local held = { L = nil, R = nil }
        local lastScan = 0

        local function pivotOf(inst)
            if not inst then return nil end
            if inst:IsA("BasePart") then return inst.CFrame end
            if inst:IsA("Model") then return inst:GetPivot() end
            return nil
        end
        local function gripping(side)
            if Input then
                return (side == "L" and Input.lFist or Input.rFist) == 1
            end
            return mouseDown[side] or anyPoseLocked(side)
        end

        -- nearest loose (unanchored) item to the hand, ignoring characters and rigs
        local function scan(handCF)
            local excl = { rig }
            if cloneFolder then excl[#excl + 1] = cloneFolder end
            if lp.Character then excl[#excl + 1] = lp.Character end
            ovp.FilterDescendantsInstances = excl
            local parts = workspace:GetPartBoundsInRadius(handCF.Position, XH.radius, ovp)
            local best, bd = nil, math.huge
            for _, p in ipairs(parts) do
                if not p.Anchored and not p:IsDescendantOf(vrPlayers) then
                    local m = p:FindFirstAncestorOfClass("Model")
                    if not (m and m:FindFirstChildOfClass("Humanoid")) then
                        local d = (p.Position - handCF.Position).Magnitude
                        if d < bd then best, bd = p, d end
                    end
                end
            end
            return best
        end

        -- AIMBOT: turns the hand (aim angles of the emulator hand) until the gun points at the target. It learns how the hand turns the aim
        -- first (a short wiggle), then steers; everything is measured in camera space, so turning the camera does not confuse it.
        local abSt = {}
        local abParams = RaycastParams.new()
        abParams.FilterType = Enum.RaycastFilterType.Exclude
        local function abTarget(origin, dir)
            local best, bestA = nil, math.rad(XH.abFov)
            for _, pl in ipairs(game:GetService("Players"):GetPlayers()) do
                local ch = pl ~= lp and pl.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local tp = XH.abPart == "Head" and (ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")) or (ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head"))
                    if tp then
                        local to = tp.Position - origin
                        if to.Magnitude > 0.5 then
                            local a = math.acos(math.clamp(dir:Dot(to.Unit), -1, 1))
                            if a < bestA then
                                abParams.FilterDescendantsInstances = { rig, lp.Character, ch }
                                local blocked = workspace:Raycast(origin, to, abParams)
                                if not blocked then best, bestA = tp.Position, a end
                            end
                        end
                    end
                end
            end
            return best
        end
        function S.abStep(side, cf, dir)
            if not XH.aimbot or S.menuOpen or UIS:GetFocusedTextBox() then return end
            if XH.abKey == "Hold right mouse" and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
            if XH.abKey == "Hold shift" and not UIS:IsKeyDown(Enum.KeyCode.LeftShift) then return end
            -- VR Emulator hands have their own aim angles; in the VR Hands game the hand gets an extra turn that only the aimbot uses
            local A, yk, pk = S, side == "L" and "aimLYaw" or "aimRYaw", side == "L" and "aimLPitch" or "aimRPitch"
            if not U.emu then A, yk, pk = U.ab[side], "y", "p" end
            local st = abSt[side]
            if not st then st = { phase = 0, bad = 0, lastErr = 1 } abSt[side] = st end
            local now = os.clock()
            local cc = cam.CFrame
            local dl = cc:VectorToObjectSpace(dir)
            local tgt = abTarget(cf.Position, dir)
            if st.phase == 0 then
                if not tgt then return end
                st.y0, st.p0, st.d0, st.t, st.phase = A[yk], A[pk], dl, now, 1
                A[yk] = S.wrapAng(st.y0 + 0.2)
                return
            elseif st.phase == 1 then
                if now - st.t < 0.35 then return end
                st.jY = (dl - st.d0) / 0.2
                A[yk], A[pk], st.t, st.phase = st.y0, st.p0 + 0.2, now, 2
                return
            elseif st.phase == 2 then
                if now - st.t < 0.35 then return end
                st.jP = (dl - st.d0) / 0.2
                A[pk], st.t, st.phase = st.p0, now, 3
                return
            elseif st.phase == 3 then
                if now - st.t > 0.3 then st.phase = 4 end
                return
            end
            if not tgt then return end
            local want = cc:VectorToObjectSpace((tgt - cf.Position).Unit)
            local err = want - dl
            local em = err.Magnitude
            if em > st.lastErr + 0.0004 then st.bad += 1 else st.bad = math.max(0, st.bad - 1) end
            st.lastErr = em
            if st.bad > 90 then st.phase, st.bad = 0, 0 return end   -- it is not getting closer: learn the hand again
            if em < 0.003 then return end
            local jY, jP = st.jY, st.jP
            local a, b, c = jY:Dot(jY), jY:Dot(jP), jP:Dot(jP)
            local det = a * c - b * b
            if det < 1e-5 then st.phase = 0 return end
            local r1, r2 = jY:Dot(err), jP:Dot(err)
            local k = math.clamp(XH.abSmooth / 100, 0.05, 1) * 0.5
            local dy = math.clamp((c * r1 - b * r2) / det * k, -0.12, 0.12)
            local dp = math.clamp((a * r2 - b * r1) / det * k, -0.12, 0.12)
            A[yk] = S.wrapAng(A[yk] + dy)
            A[pk] = math.clamp(A[pk] + dp, -1.45, 1.45)
        end

        U.bind("NoVR_Crosshair", Enum.RenderPriority.Camera.Value + 2, function()
            if XH.dirty then rebuild() end
            if not XH.aimbot and not U.emu then for _, s2 in pairs(U.ab) do s2.y, s2.p = 0, 0 end end
            local doScan = os.clock() - lastScan > 0.1
            if doScan then lastScan = os.clock() end
            local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
            local toolSide = gripping("R") and "R" or (gripping("L") and "L" or nil)

            for _, side in ipairs({ "L", "R" }) do
                local s = sides[side]
                local show = false
                if XH.enabled and not S.menuOpen then
                    local hcf = pivotOf(rig:FindFirstChild(side == "L" and "LeftHand" or "RightHand"))
                    if hcf then
                        local cf, part, ok = hcf, nil, false
                        if XH.always then
                            ok = true
                        elseif gripping(side) then
                            if XH.detect == "Held object" then
                                if doScan then
                                    local h = nil
                                    if tool and side == toolSide then h = tool:FindFirstChild("Handle") end
                                    held[side] = h or scan(hcf)
                                end
                                part = held[side]
                                if part and not part.Parent then part, held[side] = nil, nil end
                                if part then cf, ok = part.CFrame, true end
                            else
                                ok = true
                            end
                        else
                            held[side] = nil
                        end

                        if ok then
                            local dir = AXES[XH.axis](cf)
                            if XH.aimbot then pcall(S.abStep, side, cf, dir) end
                            local ex = { rig }
                            if cloneFolder then ex[#ex + 1] = cloneFolder end
                            if lp.Character then ex[#ex + 1] = lp.Character end
                            if part then
                                ex[#ex + 1] = part
                                local m = part:FindFirstAncestorOfClass("Model")
                                if m and not m:FindFirstChildOfClass("Humanoid") then ex[#ex + 1] = m end
                            end
                            rp.FilterDescendantsInstances = ex
                            local res = workspace:Raycast(cf.Position, dir * 3000, rp)
                            local pt = res and res.Position or (cf.Position + dir * 3000)
                            local v = cam:WorldToViewportPoint(pt)
                            if v.Z > 0 then
                                s.f.Position = UDim2.fromOffset(v.X, v.Y)
                                show = true
                            end
                        end
                    end
                end
                s.f.Visible = show
            end
        end)
    end)
