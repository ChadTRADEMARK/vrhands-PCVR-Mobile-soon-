            end
            -- generic drag: handle moves `fx,fy` (fractions); a press without movement is a click
            local function dragger(handle, getHalf, keyX, keyY, onClick)
                handle.InputBegan:Connect(function(input)
                    if not isPress(input) then return end
                    local start = sp(input)
                    local v = view()
                    local bx, by = (B[keyX] or B.x) * v.X, (B[keyY] or B.y) * v.Y
                    local moved, held = false, true
                    local conns = {}
                    local function done()
                        if not held then return end
                        held = false
                        for _, c in ipairs(conns) do c:Disconnect() end
                        if not moved and onClick then onClick() end
                    end
                    conns[1] = RunService.RenderStepped:Connect(function()
                        if not held then return end
                        local d = sp(input) - start
                        if not moved and d.Magnitude > 6 then moved = true end
                        if moved then
                            local hw, hh = getHalf()
                            local vv = view()
                            local fx, fy = (bx + d.X) / vv.X, (by + d.Y) / vv.Y
                            local nx, ny = clampFrac(fx, fy, hw, hh)
