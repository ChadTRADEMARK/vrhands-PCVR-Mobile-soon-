        -- tiny HEAD request: the file's ETag. Same ETag = same file, so the ~290 KB download is skipped
        -- (matters on mobile data). nil = executor can't do it -> falls back to downloading every check.
        local function sourceStamp(url)
            local req = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
            if not req then return nil end
            local sep = string.find(url, "?", 1, true) and "&" or "?"
            local ok, res = pcall(req, {
                Url = url .. sep .. "nocache=" .. tostring(os.time()),
                Method = "HEAD",
                Headers = { ["Cache-Control"] = "no-cache" },
            })
            if not (ok and type(res) == "table" and (res.Success or res.StatusCode == 200) and type(res.Headers) == "table") then
                return nil
            end
            local tag, len
            for k, v in pairs(res.Headers) do
                local lk = string.lower(tostring(k))
                if lk == "etag" then tag = tostring(v) elseif lk == "content-length" then len = tostring(v) end
            end
            if tag then return tag .. "|" .. (len or "") end
            return nil
        end

        task.spawn(function()
            if AUTO_UPDATE ~= true then AU.text, AU.level = "Off", nil return end
            if type(UPDATE_URL) ~= "string" or UPDATE_URL == "" or string.find(UPDATE_URL, "PUT_YOUR", 1, true) then
                AU.text, AU.level = "UPDATE_URL not set", "warn"
                return
            end
            local every = math.max(tonumber(AUTO_UPDATE_SECONDS) or 20, 10)
            local baseline, skipped, lastStamp
            task.wait(3)
            while _G.NoVR_Gen == myGen do
                -- pcall: an error in one check must never end the watcher
                local okc, errc = pcall(function()
                    if updating then return end
                    local tag = sourceStamp(UPDATE_URL)
                    if tag and baseline ~= nil and tag == lastStamp then
                        AU.text, AU.level = os.date("%H:%M:%S") .. " - up to date", "ok"   -- same file: no download
                        return
                    end
                    local src = fetchSource(UPDATE_URL)
                    local stamp = os.date("%H:%M:%S")
                    if not (src and #src > 200) then
                        AU.text, AU.level = stamp .. " - download failed", "warn"
                        return
                    end
                    if baseline == nil then baseline = src end
                    lastStamp = tag
                    local newVer = src:match('SCRIPT_VERSION%s*=%s*"([%w%.%-]+)"')
                    AU.latest = newVer
                    local changed = (newVer ~= nil and Ver.cmp(newVer, SCRIPT_VERSION) ~= 0 and Ver.cmp(newVer, SCRIPT_VERSION) ~= nil) or (src ~= baseline)
                    if not changed then
                        AU.text, AU.level = stamp .. " - up to date", "ok"
                        return
                    end
                    if src == skipped then
                        AU.text, AU.level = stamp .. " - update skipped", "warn"
                        return
                    end
                    -- never restart into a broken push
                    local fn = (EXEC.loadstring or loadstring or load)(src)
                    if not fn then
                        skipped = src
                        AU.text, AU.level = stamp .. " - new file has an error", "bad"
                        warn("[NoVR] auto-update: the new file on GitHub does not compile, not applying it")
                        return
                    end
                    AU.text, AU.level = stamp .. " - update found", "warn"
                    print("[NoVR] auto-update: change detected" .. (newVer and (" (v" .. newVer .. ")") or ""))
                    if not promptUpdate(newVer) then
                        skipped = src   -- cancelled: don't ask again for this file
                        AU.text, AU.level = stamp .. " - cancelled", "warn"
                    else
                        -- still running after the countdown = the restart did not go through; don't nag every check
                        skipped = src
                        AU.text, AU.level = stamp .. " - update failed (try UPDATE & RESTART)", "bad"
                    end
                end)
                if not okc then
                    AU.text, AU.level = "error: " .. string.sub(tostring(errc), 1, 40), "bad"
                    warn("[NoVR] auto-update check failed: " .. tostring(errc))
                end
                task.wait(every)
            end
        end)
